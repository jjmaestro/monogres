<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Deviations from the google_checks.xml ruleset that ships with checkstyle.
  Keeping them here leaves the ruleset itself untouched, so a checkstyle
  upgrade brings its rule changes along unmodified and every relaxation stays
  visible in one place.

  Javadoc is not mandated yet: the code carries block comments where intent is
  not obvious, and requiring a Javadoc header on every public type and method
  would mean writing them all at once rather than as the API settles. Drop
  these two entries to turn the requirement back on.
-->
<suppressions>
  <suppress checks="MissingJavadocType" files=".*\.java$"/>
  <suppress checks="MissingJavadocMethod" files=".*\.java$"/>
</suppressions>
