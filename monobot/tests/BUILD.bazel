load("@rules_quarkus//quarkus:defs.bzl", "quarkus_integration_test")
load(":e2e.bzl", "monobot_e2e_test")

exports_files(["e2e_test.sh"])

filegroup(
    name = "config_offline",
    srcs = glob(["config-offline/**"]),
)

filegroup(
    name = "config_noset",
    srcs = glob(["config-noset/**"]),
)

# Bazel has no way to make one target depend on another target's test result, so
# the JVM check is also expressed as a build action. Its output file is an input
# of the native tests below, which is what actually orders the two: a JVM
# application that cannot read its own config fails this action, and the native
# image is then never worth building.
genrule(
    name = "jvm_gate",
    srcs = [":config_offline"],
    outs = ["jvm_gate.ok"],
    cmd = " ".join([
        "$(execpath //tests:e2e_test.sh)",
        "--app $(execpath //:monobot)",
        "--expect monobot-no-such-repository",
        "--expect-status 2",
        "--config-files $(execpaths :config_offline)",
        "> $@ 2>&1 || { cat $@; exit 1; }",
    ]),
    tags = ["block-network"],
    tools = [
        "//:monobot",
        "//tests:e2e_test.sh",
    ],
)

# The offline pair. Cheap, and the shape that catches a packaged application
# which cannot construct its own JSON types.
#
# block-network is what makes them offline. The config names a real host, so
# without it every invocation resolves github.com and asks it for a repository,
# and the two outcomes are indistinguishable: whichever error comes back is
# reported the same way, and the string the run is checked for is printed either
# way. With it the sandbox gives the run loopback and nothing else.
monobot_e2e_test(
    name = "e2e_offline",
    app = "//:monobot",
    config = ":config_offline",
    expect = "monobot-no-such-repository",
    expect_status = 2,
    tags = ["block-network"],
)

# In the default gate on purpose, native image and all: it is the only check
# that proves the image can construct the types it reads its own config with,
# and //tests:jvm_gate keeps it from being built until the JVM run has passed.
monobot_e2e_test(
    name = "e2e_offline_native",
    app = "//:monobot_native",
    config = ":config_offline",
    expect = "monobot-no-such-repository",
    expect_status = 2,
    gate = ":jvm_gate",
    tags = ["block-network"],
)

# The golden pair. A real scan of one extension against the real source, so it
# is out of the default gate: `bazel test //tests:e2e_golden_native` runs it.
# noset is the subject because it is small, three versions, and no longer
# released, so the golden does not go stale behind us.
#
# The golden is the entry's own repo.json rather than a copy kept elsewhere,
# which is what makes config-noset a catalog entry of the shape build/catalog
# holds: monobot.json and repo.json side by side, one generated from the other.
monobot_e2e_test(
    name = "e2e_golden",
    app = "//:monobot",
    config = ":config_noset",
    golden = "config-noset/extensions/noset/repo.json",
    tags = [
        "external",
        "manual",
        "requires-network",
    ],
)

monobot_e2e_test(
    name = "e2e_golden_native",
    app = "//:monobot_native",
    config = ":config_noset",
    gate = ":jvm_gate",
    golden = "config-noset/extensions/noset/repo.json",
    tags = [
        "external",
        "manual",
        "requires-network",
    ],
)

# The gate the whole catalog is run through, over one entry. It exits 0 only if
# what a run would write is already there, byte for byte, so it fails on a
# change in the layout, in a digest, or in what a monobot.json carries, and it
# fails without touching the tree it read.
monobot_e2e_test(
    name = "e2e_check",
    app = "//:monobot",
    config = ":config_noset",
    mode = "check",
    tags = [
        "external",
        "manual",
        "requires-network",
    ],
)

# The same question //tests:e2e_offline_native asks, put the way Quarkus puts
# it: a JUnit test that launches the packaged application. Its sources are a
# library at the root because globs cannot cross packages, but the test belongs
# here with everything else that runs a built artifact.
#
# manual because it asks a question already answered: the native image is in the
# default gate through //tests:e2e_offline_native, and a second harness over the
# same binary buys coverage of the harness rather than of monobot. It is here as
# the shape to copy when a check needs real Java rather than a shell.
quarkus_integration_test(
    name = "it_native",
    app = "//:monobot_native",
    tags = ["manual"],
    deps = ["//:it_lib"],
)
