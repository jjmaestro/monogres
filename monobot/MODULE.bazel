"""monobot: a metadata bot that generates Monogres extension repo.json files.

A standalone Bazel module. It shares no dependency with the module under build/;
the repo.json files it emits are just files at a path as far as monobot is
concerned.
"""

module(
    name = "monobot",
    version = "1.0.0",
    compatibility_level = 1,
)

# The OS and CPU constraints //platforms names. Every module here already pulls
# it in transitively; it is declared because //platforms references it directly.
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")

# sh_test, for the end-to-end tests that run a built application. Already in the
# graph transitively; declared because //tests loads it directly.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Runtime artifacts only. Quarkus deployment artifacts are resolved from these
# by rules_quarkus, which reads each jar's META-INF/quarkus-extension.properties
# rather than guessing a `-deployment` suffix.
#
# The io.quarkus:* versions all track the Quarkus release below.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "io.quarkiverse.jgit:quarkus-jgit:3.6.2",
        "io.quarkus:quarkus-arc:3.33.2",
        "io.quarkus:quarkus-jackson:3.33.2",
        "io.quarkus:quarkus-vertx:3.33.2",
        "io.vertx:vertx-web-client:4.5.27",
        "org.apache.commons:commons-compress:1.28.0",
        # Test only. Nothing imports hamcrest or junit-platform-launcher, but
        # the quarkus_test macro puts them on every test target's compile
        # classpath, so they have to resolve here.
        "io.quarkus:quarkus-junit:3.33.2",
        "io.quarkus:quarkus-junit-mockito:3.33.2",
        "org.hamcrest:hamcrest:3.0",
        "org.junit.jupiter:junit-jupiter:6.0.3",
        "org.junit.platform:junit-platform-console-standalone:6.0.3",
        "org.junit.platform:junit-platform-launcher:6.0.3",
    ],
    known_contributing_modules = [
        "bazel_worker_java",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven")

# Quarkus augmentation. rules_quarkus reads maven_install.json, finds every jar
# carrying META-INF/quarkus-extension.properties, and resolves the exact
# deployment-artifact each descriptor names, so only runtime artifacts are
# declared above. quarkus_version must be one of the two the ruleset supports:
# augmentation emits bytecode tied to the patch version.
bazel_dep(name = "com_clementguillot_rules_quarkus", version = "0.5.2")

# Three fixes, all filed upstream. Drop each once a release carries it.
#
# quarkus_test hands the application jar to Quarkus twice, once as the model's
# application artifact and once more as an application root, so every class in
# it is indexed twice. Only @QuarkusMain notices, because its uniqueness check
# counts annotation instances, and monobot has one: augmentation fails with
# "More than one @QuarkusMain method found" naming Main twice.
#
# quarkus_app's native target hands native-image the C compiler but nothing else
# from the CC toolchain, so a sysroot-configured clang is invoked bare and looks
# for headers in a /usr/include that a hermetic toolchain does not use and NixOS
# does not have.
#
# Every native-image argument comes from application.properties, a resource file
# whose contents cannot vary with the target platform. The arguments naming the
# libc and the link mode are exactly the ones that have to.
single_version_override(
    module_name = "com_clementguillot_rules_quarkus",
    patch_strip = 1,
    patches = [
        "//patches/rules_quarkus:0001-fix-rules-stop-registering-the-app-jar-as-a-quarkus_.patch",
        "//patches/rules_quarkus:0002-fix-rules-pass-the-CC-toolchain-sysroot-to-native-im.patch",
        "//patches/rules_quarkus:0003-fix-rules-let-quarkus_app-pass-native-image-argument.patch",
    ],
)

quarkus = use_extension(
    "@com_clementguillot_rules_quarkus//quarkus:extensions.bzl",
    "quarkus",
)
quarkus.toolchain(
    lock_file = "//:maven_install.json",
    quarkus_version = "3.33.2",
)
use_repo(quarkus, "rules_quarkus")

# The format and lint gate, dev-only: none of it is on the application's
# classpath or in its runfiles, so a module depending on monobot should not
# fetch any of it. Error Prone is absent because it already runs inside every
# javac action rules_java drives, leaving only the tools that are not part of a
# compile.
bazel_dep(name = "aspect_rules_lint", version = "2.7.2", dev_dependency = True)

# Taken as the fat release jars upstream publishes rather than resolved through
# maven.install above, because one resolution is one classpath: a checkstyle
# transitive could otherwise pick the version of a library the application also
# uses. rules_lint's own tools.checkstyle/tools.google_java_format extensions
# hardcode older versions with no way to override them, so fetch the jars here.
# Both are shaded, so neither brings anything else along.
#
# google-java-format decides how the tree is laid out and checkstyle decides
# what it is then held to, so a bump to either reformats or re-gates every file.
# Change them deliberately, on their own.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "google_java_format",
    dev_dependency = True,
    sha256 = "23696de05dd20d85c1449c8de9f2419030799508f5356570e979f7f96e59d8d6",
    url = "https://github.com/google/google-java-format/releases/download/v1.36.0/google-java-format-1.36.0-all-deps.jar",
)

http_jar(
    name = "checkstyle",
    dev_dependency = True,
    sha256 = "4aa042449984e3f2ea670b039e39b29e116a037e823c32f59b84d04739a8a94c",
    url = "https://github.com/checkstyle/checkstyle/releases/download/checkstyle-13.9.0/checkstyle-13.9.0-all.jar",
)

# Everything below exists for //:monobot_native and nothing else.
#
# GraalVM, downloaded and checksummed like the JDK, so native-image is pinned
# here rather than taken from the machine.
#
# GraalVM 25 is not optional. Quarkus 3.33 generates an image configuration that
# older native-image builds cannot satisfy: they initialize
# `io.smallrye.common.net.HostName` while building the image, because
# jboss-logmanager reads the host name when it constructs a log record and
# something always logs during the build, and then reject the image because
# Quarkus asked for that class at run time. 23.1 does not build this
# application; 25 does, unchanged.
#
# Pinned past the last release, because the newest in the BCR is 0.11.1, whose
# version table stops at GraalVM CE 21.0.2 (January 2024) and so cannot express
# the above. This commit is 0.12.0 plus GraalVM 25.1/25.2 support.
bazel_dep(name = "rules_graalvm", version = "0.12.0")

RULES_GRAALVM_COMMIT = "35d47821696b4d96aa579b184338fb5e1ea20885"

archive_override(
    module_name = "rules_graalvm",
    sha256 = "2ae40d3746b4957c07a3b165e8f242bf015fa22f27fd9fe8111aff2e5ba61439",
    strip_prefix = "rules_graalvm-{}".format(RULES_GRAALVM_COMMIT),
    url = "https://github.com/sgammon/rules_graalvm/archive/{}.tar.gz".format(
        RULES_GRAALVM_COMMIT,
    ),
)

gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")

# java_version is GraalVM's own JDK, not the language level: this is the JDK
# native-image itself runs on, and it reads the Java 21 bytecode `.bazelrc` pins
# just fine. The two are deliberately independent, and only the native-image
# toolchain is registered below, so nothing here compiles anything.
gvm.graalvm(
    name = "graalvm",
    distribution = "ce",
    java_version = "25",
    version = "25.0.3",
)
use_repo(gvm, "graalvm", "graalvm_toolchains")

# Only the native-image toolchain. The repo also offers a java_runtime, which
# would compete with remotejdk_21 for ordinary compiles.
register_toolchains("@graalvm_toolchains//:gvm")

# A C toolchain, because native-image emits object code and then links it. No
# target here has a C source file, so this is not for compiling monobot: it is
# the linker GraalVM shells out to.
#
# clang comes from toolchains_llvm and the headers and libc it links against
# come from a pinned sysroot, so the binary does not depend on what the machine
# has installed. The sysroot is not optional on a distro without /usr/include,
# which is where a bare downloaded clang would otherwise look.
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

# One sysroot per target architecture: a sysroot is the target's libc and
# headers, so a build reads that architecture's objects out of its own.
#
# This one is musl rather than glibc, because the binary is linked statically
# and native-image allows that only against musl. See
# //toolchains/sysroot:sysroot.bzl for why Alpine supplies it.
ALPINE = "https://dl-cdn.alpinelinux.org/alpine/v3.22/main/x86_64"

sysroot = use_repo_rule("//toolchains/sysroot:sysroot.bzl", "sysroot")

sysroot(
    name = "sysroot_linux_x86_64",
    archives = {
        "{}/musl-dev-1.2.5-r12.apk".format(ALPINE): "1c2068d910cfdbbcb4eb107a5a478f8b48edf3a6311953c8fa5180c5190efab3",
        "{}/zlib-dev-1.3.2-r0.apk".format(ALPINE): "8f5dde8569e01ad0b64131a397ff26c1f65a8bb0720b9db5738b88cb788fb38f",
        "{}/zlib-static-1.3.2-r0.apk".format(ALPINE): "77daa7f5d46b437ebebd7f5f93f8f535d4f2e4bc6f374b4f32effb33e5a3f106",
    },
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    # Stated rather than detected. Left to itself the ruleset reads
    # /etc/os-release and picks an LLVM build per distro, which makes the
    # compiler a property of the developer's machine. Naming it also means the
    # detection cannot fail on a host that has no /etc/os-release. The
    # architecture is still detected: this names where clang runs, and the
    # `llvm.sysroot` tag below names what it compiles for.
    exec_os = "linux",
    llvm_versions = {"": "19.1.0"},
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

# `:all` registers a cc toolchain per `llvm.sysroot` target above, each
# declaring the CPU it targets, so Bazel picks by `--platforms`.
register_toolchains("@llvm_toolchain//:all")
