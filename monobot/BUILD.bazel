load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_quarkus//quarkus:defs.bzl", "quarkus_app", "quarkus_test")
load("//platforms:targets.bzl", "arch_select")
load("//tools/lint:lint.bzl", "checkstyle_test")

# //tests runs the built applications, so it needs to see them. Nothing else
# does: monobot is a binary, not a library other packages build against.
package(default_visibility = ["//tests:__pkg__"])

exports_files([".checkstyle-suppressions.xml"])

java_library(
    name = "lib",
    srcs = glob(["src/main/java/**/*.java"]),
    # Jackson introspects constructor parameter names to bind json properties,
    # so dropping this changes how records deserialize and serialize.
    javacopts = ["-parameters"],
    resources = glob(["src/main/resources/**/*"]),
    deps = [
        # quarkus-arc, quarkus-vertx and quarkus-jgit are not imported directly,
        # but augmentation needs them in the application model, so strict deps
        # alone would not have asked for them.
        "@maven//:io_quarkiverse_jgit_quarkus_jgit",
        "@maven//:io_quarkus_quarkus_arc",
        "@maven//:io_quarkus_quarkus_vertx",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:io_quarkus_quarkus_core",
        "@maven//:io_quarkus_quarkus_jackson",
        "@maven//:io_vertx_vertx_core",
        "@maven//:io_vertx_vertx_web_client",
        "@maven//:io_vertx_vertx_web_common",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:jakarta_enterprise_jakarta_enterprise_cdi_api",
        "@maven//:jakarta_inject_jakarta_inject_api",
        "@maven//:org_apache_commons_commons_compress",
        "@maven//:org_eclipse_jgit_org_eclipse_jgit",
        "@maven//:org_eclipse_microprofile_config_microprofile_config_api",
        "@maven//:org_jboss_logging_jboss_logging",
    ],
)

# The native-image arguments that describe how the binary is linked, as opposed
# to what the application needs from it: those are in application.properties,
# which holds for every architecture. These do not, so they are here, where
# select() works.
#
# -fuse-ld=lld because native-image invokes the compiler directly, outside
# Bazel's link machinery, and so never sees the toolchain's choice of linker.
# Left alone clang looks for a plain `ld`; an LLVM toolchain ships `ld.lld`.
#
# amd64 links statically, which drops the ELF interpreter and every shared
# library, so the binary runs on any amd64 Linux whatever is installed there.
# native-image allows that only against musl, hence --libc. The compiler-rt
# options are a consequence of linking with clang rather than gcc: without them
# clang reaches for gcc's crtbeginT.o, -lgcc and -lgcc_eh, which a musl sysroot
# has none of. They have to be on the compiler and the linker both, because the
# early "query code" step passes only -H:CCompilerOption through.
#
# arm64 cannot do any of that: GraalVM ships musl static JDK libraries for
# linux-amd64 alone, so that architecture is glibc, and glibc rules out
# --static. --static-nolibc is the closest equivalent, linking everything except
# the libc itself, so the result needs glibc present and nothing else.
#
# It also needs -H:-CheckToolchain, which native-image names itself when it
# refuses. Before compiling anything it runs the compiler with -v and identifies
# it by scanning the output, and that scanner does not accept this one: the only
# architecture its Linux branch knows by name is x86_64, and against a glibc
# sysroot clang reports the sysroot's own bundled GCC as well, which the amd64
# musl sysroot has none of. The check is a heuristic and the toolchain behind it
# is sound: the same clang and sysroot compile and link a working aarch64
# binary, which is what the compile and link steps then go on to use.
NATIVE_BUILD_ARGS = ["-H:CCompilerOption=-fuse-ld=lld"] + arch_select({
    "amd64": [
        "--static",
        "--libc=musl",
        "-H:CCompilerOption=--rtlib=compiler-rt",
        "-H:CCompilerOption=--unwindlib=none",
        "-H:NativeLinkerOption=--rtlib=compiler-rt",
        "-H:NativeLinkerOption=--unwindlib=none",
    ],
    "arm64": [
        "--static-nolibc",
        "-H:-CheckToolchain",
    ],
})

# native gives //:monobot_native. native-image emits object code and then links
# it, so this target needs a real C compiler as well as GraalVM: the rule
# resolves the CC toolchain and hands the compiler to native-image as
# -H:CCompilerPath.
quarkus_app(
    name = "monobot",
    main_class = "dev.monogres.monobot.main.Main",
    native = True,
    native_build_args = NATIVE_BUILD_ARGS,
    version = "1.0.0",
    deps = [":lib"],
)

java_library(
    name = "test_lib",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    resources = glob(["src/test/resources/**/*"]),
    deps = [
        ":lib",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:io_quarkus_quarkus_junit",
        "@maven//:io_quarkus_quarkus_junit_mockito",
        "@maven//:io_quarkus_quarkus_test_common",
        "@maven//:io_vertx_vertx_core",
        "@maven//:jakarta_inject_jakarta_inject_api",
        "@maven//:org_apache_commons_commons_compress",
        "@maven//:org_eclipse_jgit_org_eclipse_jgit",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_mockito_mockito_core",
    ],
)

# One target for the whole suite: quarkus_test is the JUnit console launcher on
# an augmented classpath, so plain tests and @QuarkusTest ones run under the
# same rule.
quarkus_test(
    name = "test",
    deps = [":test_lib"],
)

# Integration test sources. Only the library lives here, because a glob cannot
# reach across packages and there is no BUILD file under src/; the test target
# that runs them is in //tests with the rest of the artifact-level tests. Kept
# out of :test_lib because @QuarkusMainIntegrationTest needs the packaged
# application, so it cannot run under the plain JUnit target.
java_library(
    name = "it_lib",
    testonly = True,
    srcs = glob(["src/it/java/**/*.java"]),
    deps = [
        # Not imported by anything here, but the model assembler resolves the
        # application under test through the test library's direct deps.
        ":lib",
        "@maven//:io_quarkus_quarkus_junit",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

checkstyle_test(
    name = "checkstyle_test",
    srcs = [
        ":it_lib",
        ":lib",
        ":test_lib",
    ],
)
