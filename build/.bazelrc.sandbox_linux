#
# Hermetic Linux sandbox bind-mount manifest: arch-independent entries
#
# `--experimental_use_hermetic_linux_sandbox` starts the chroot **empty**
# (the chroot is a per-action sandbox tree containing only the action's
# hard-linked input artefacts; no `/bin`, `/lib`, `/lib64`, `/usr`,
# `/proc`, `/etc`). Every system path an action might `execve` or `dlopen`
# must be declared here as a bind-mount-pair.
#
# Strategy: keep host exposure minimal and explicit.
#   * Static, zero-deps binaries from the host (`bash-static`,
#     `busybox-static`) cover the shell + POSIX utility surface and remove
#     the need to expose /lib/lib64 just so a shell can run.
#   * Specific libraries are mounted *as individual files*, not via
#     `/lib`/`/lib64` directory mounts, so the chroot only sees what we've
#     enumerated here. Each entry below is paired with the binary that
#     pulls it in.

# ---------------------------------------------------------------------------
# Process / user metadata
# ---------------------------------------------------------------------------

# linux-sandbox itself writes to /proc/self/uid_map during user-namespace
# setup. /proc must be available before chroot pivots; without it the
# sandbox aborts at first action.
build:hermetic-linux --sandbox_add_mount_pair=/proc

# Force `@gawk//:gawk` to link statically (opt-in flag added by
# `//patches/gawk:0001-gawk-add-static-link-bool-flag.patch`). The
# dynamically-linked default carries NEEDED `libc.so.6` / `libm.so.6` and
# would fail at action time inside this hermetic chroot, which only
# bind-mounts the dynamic loader; static linking removes the runtime-lib
# dependency entirely and keeps gawk-using actions (`tar.bzl`'s
# `mtree_mutate` and similar) self-contained.
build:hermetic-linux --@@gawk+//:static=true

# whoami / id / getpwuid lookups (test-setup.sh line 71, rules_distroless,
# msgfmt). Mount the host's /etc/passwd read-only.
build:hermetic-linux --sandbox_add_mount_pair=/etc/passwd

# ---------------------------------------------------------------------------
# Shell + POSIX utilities: static, zero-runtime-dep binaries from the host
# ---------------------------------------------------------------------------
#
# `bash-static` (Debian package: bash-static) is a fully-static build of
# bash 5.x. Bound at /bin/bash because all `#!/bin/bash` shebangs land
# there. The /usr/bin/env binding below covers `#!/usr/bin/env bash`
# (which bazel_tools' test-setup.sh uses) via busybox's env applet.
#
# `busybox-static` (Debian package: busybox-static) provides every POSIX
# utility as a single static binary, dispatched via argv[0] basename.
# Each `:` mapping below pretends busybox is the utility named in the
# destination path.
#
# The destination path must exist on the host (Bazel requires the
# mount-pair target to be pre-existing; it doesn't create empty files for
# us). On Debian 12 the destinations below are all backed by real files
# (typically symlinks under usrmerged /bin, /usr/bin).

build:hermetic-linux --sandbox_add_mount_pair=/usr/bin/bash-static:/bin/bash

