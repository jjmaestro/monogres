load(
    "@babelfish//:all.bzl",
    babelfish_OPTION_SETS = "OPTION_SETS",
    babelfish_VERSIONS = "VERSIONS",
)
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(
    "@ivory//:all.bzl",
    ivory_OPTION_SETS = "OPTION_SETS",
    ivory_VERSIONS = "VERSIONS",
)
load(
    "@openhalo//:all.bzl",
    openhalo_OPTION_SETS = "OPTION_SETS",
    openhalo_VERSIONS = "VERSIONS",
)
load("@pg//:all.bzl", pg_OPTION_SETS = "OPTION_SETS", pg_VERSIONS = "VERSIONS")
load(":gen_pg_introspect_jsons.bzl", "gen_pg_introspect_jsons")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "gen_index",
    srcs = ["gen_index.bzl"],
)

bzl_library(
    name = "gen_contrib",
    srcs = ["gen_contrib.bzl"],
)

bzl_library(
    name = "gen_pg_introspect_jsons_bzl",
    srcs = ["gen_pg_introspect_jsons.bzl"],
)

# Standalone script invoked from `pg_build_make`'s genrule shell action to
# synthesize a meson-shape introspect JSON from the post-`make install` tree +
# the build-time source tree.
exports_files([
    "ext_introspect.py",
    "pg_build_make_introspect.py",
])

# `test_versions` selects which versions also feed the test-enabled `+test`
# introspect variant: each selected version's tap_tests/injection_points-enabled
# build is introspected into `introspect/<flavor>~<v>~<os>+test.json` beside its
# production sibling, and that variant drives the test lane. Every flavor passes
# its full VERSIONS.
gen_pg_introspect_jsons(
    name = "gen_pg_introspect_jsons",
    flavor = "postgres",
    hub = "pg",
    option_sets = pg_OPTION_SETS,
    test_versions = pg_VERSIONS,
    versions = pg_VERSIONS,
)

gen_pg_introspect_jsons(
    name = "gen_ivory_introspect_jsons",
    flavor = "ivorysql",
    hub = "ivory",
    option_sets = ivory_OPTION_SETS,
    test_versions = ivory_VERSIONS,
    versions = ivory_VERSIONS,
)

gen_pg_introspect_jsons(
    name = "gen_openhalo_introspect_jsons",
    flavor = "openhalo",
    hub = "openhalo",
    option_sets = openhalo_OPTION_SETS,
    versions = openhalo_VERSIONS,
)

gen_pg_introspect_jsons(
    name = "gen_babelfish_introspect_jsons",
    flavor = "babelfish",
    hub = "babelfish",
    option_sets = babelfish_OPTION_SETS,
    versions = babelfish_VERSIONS,
)
