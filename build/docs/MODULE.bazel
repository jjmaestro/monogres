module(
    name = "docs",
    bazel_compatibility = [">=9.1.0"],
)

bazel_dep(name = "monogres", version = "", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "protobuf", version = "35.0", dev_dependency = True)

# We need to pin a modern rules_python (>=1.8.0) to have fmeum's fix for the
# _windows_launcher_maker, see:
# https://github.com/bazel-contrib/rules_python/commit/c2ff89f
bazel_dep(name = "rules_python", version = "2.0.2", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)

local_path_override(
    module_name = "monogres",
    path = "..",
)

local_path_override(
    module_name = "starlark_utils",
    path = "../starlark_utils",
)

local_path_override(
    module_name = "sysroots",
    path = "../sysroots",
)

BDA_VERSION = "0.1.0"

archive_override(
    module_name = "download_archives",
    patch_strip = 1,
    patches = [
        "//patches/download_archives:0001-dev-add-flake.nix-and-direnv-for-NixOS-dev-environme.patch",
        "//patches/download_archives:0002-fix-missing-continue-after-integrity-check-wrong-app.patch",
        "//patches/download_archives:0003-docs-fix-SOURCES-VERSIONS-in-repo.bzl-doc.patch",
        "//patches/download_archives:0004-test-add-multi-source-index-test.patch",
        "//patches/download_archives:0005-docs-use-NAME-consistently-in-doc-placeholders.patch",
        "//patches/download_archives:0006-refactor-centralize-patch-matching-in-lib-utils.bzl.patch",
        "//patches/download_archives:0007-refactor-extract-shared-download-helpers-into-lib-do.patch",
        "//patches/download_archives:0008-refactor-extract-Download.try_sources.patch",
        "//patches/download_archives:0009-feat-add-lazy-mode-to-download_archives.patch",
        "//patches/download_archives:0010-feat-add-download_archives-module-extension.patch",
        "//patches/download_archives:0011-chore-privatize-internal-template-names.patch",
        "//patches/download_archives:0012-docs-rewrite-README.patch",
        "//patches/download_archives:0013-feat-support-a-matrix-of-archives-per-version.patch",
    ],
    sha256 = "185e9e328ba59ccdc6f97968b2bbe31d7d2f64590aa321df7ca754cf5777f9e4",
    strip_prefix = "bazel_download_archives-{}".format(BDA_VERSION),
    url = "https://github.com/jjmaestro/bazel_download_archives/archive/refs/tags/v{}.tar.gz".format(BDA_VERSION),
)

# version_utils 0.1.0 defines its own `isinstance` helper, which Bazel 9 rejects
# now that it reserves `isinstance` as a predeclared builtin. The renderer
# reaches version_utils through the monogres introspect rules, so patch the
# helper to a non-reserved name.
single_version_override(
    module_name = "version_utils",
    patch_strip = 1,
    patches = [
        "//patches/version_utils:0001-fix-rename-isinstance-helper-reserved-in-bazel-9.patch",
    ],
)
