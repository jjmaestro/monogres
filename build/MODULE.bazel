# sysroots/
#
# Debian package closures materialized via `//sysroots` from per-toolchain
# manifests, pinned to a single `apt_snapshot` shared across all hubs.

sysroots = use_extension("@sysroots//:extension.bzl", "sysroots")

# `@perl_sysroot`: dedicated Debian-sourced Perl toolchain. Provides the
# build-time perl interpreter (`perl-base`), libperl headers (`libperl-dev`),
# and the runtime shared library (`libperl5.36`) all from the same
# `apt_snapshot`. The three-way ABI lockstep Postgres's plperl build requires
# (interpreter, build-link libperl, runtime libperl all at the same MAJOR.MINOR)
# becomes a property of the toolchain by construction. `libipc-run-perl`
# (IPC::Run) is a TEST-only module: the test-enabled build variant
# (`{v}/{opt}/test`) flips meson `tap_tests=enabled`, whose configure gate
# (`config/check_modules.pl`) `use`s IPC::Run, and the TAP harness drives
# clusters through it. It rides the toolchain (not the per-PG deps) because
# configure runs under the toolchain perl, not the deps sysroot.
sysroots.apt(
    name = "perl_sysroot",
    lock = "//toolchains/perl/locks:perl_sysroot.lock",
    manifest = "//toolchains/perl:debian{}.json".format(RELEASE["version"]),
    snapshot = RELEASE["apt_snapshot"],
    exports = ["usr/bin/perl"],
)
use_repo(sysroots, "perl_sysroot")

# `@python_sysroot`: dedicated Debian-sourced Python toolchain, mirroring
# `@perl_sysroot`. Provides the build-time python3 interpreter + stdlib
# (`python3`) and the libpython headers / shared library + `-embed.pc`
# (`python3-dev`), all from the same `apt_snapshot`. Python is a dual dependency
# (build-time interpreter meson runs via `find_program('python3')` /
# `find_installation()`, and the runtime ABI target plpython links) that is
# version-coupled: the interpreter meson configures plpython against and the
# `python-<ver>-embed.pc` the per-PG sysroot ships must agree at the same
# MAJOR.MINOR. Sourcing both from this snapshot makes that hold by construction,
# so a release bump moves them together (see `//toolchains/python/README.md`).
sysroots.apt(
    name = "python_sysroot",
    lock = "//toolchains/python/locks:python_sysroot.lock",
    manifest = "//toolchains/python:debian{}.json".format(RELEASE["version"]),
    snapshot = RELEASE["apt_snapshot"],
    exports = ["usr/bin/python3"],
)
use_repo(sysroots, "python_sysroot")

# `@libc_sysroot`: hermetic Debian sysroot consumed by `llvm.sysroot` above,
# materialized via `//sysroots` from the package list in
# `//toolchains/libc_sysroot:debian12.json`. The `clang_wrapper.sh` shim is
# Tier-2-injected into the materialized hub at the canonical Debian
# `usr/lib/llvm-14/bin/clang` path so meson's `find_program('clang')` resolves
# to it (the wrapper bakes `--sysroot=` into every clang invocation, which is
# what Postgres's JIT path needs at runtime).
sysroots.apt(
    name = "libc_sysroot",
    extra_files = {
        "//toolchains/libc_sysroot:clang_wrapper.sh": "usr/lib/llvm-{}/bin/clang".format(
            RELEASE["llvm_major"],
        ),
    },
    lock = "//toolchains/libc_sysroot/locks:libc_sysroot.lock",
    manifest = "//toolchains/libc_sysroot:debian{}.json".format(RELEASE["version"]),
    snapshot = RELEASE["apt_snapshot"],
)
use_repo(sysroots, "libc_sysroot")

# `@llvm_sysroot`: Debian-sourced LLVM-14 toolchain hub (clang-14, lld-14,
# llvm-14-dev, libllvm14, libclang-cpp14, libclang-common-14-dev, plus the
# clang-format-14 / clang-tidy-14 / clangd-14 tools that toolchains_llvm
# unconditionally symlinks). The layout adapter in
# `//toolchains/llvm_sysroot:cc_toolchain_layout.bzl` produces the canonical
# `bin/<tool>` + `lib/clang/<ver>/...` shape that `llvm.toolchain_root(label =
# ...)` consumes; this raw apt hub lives behind the adapter.
sysroots.apt(
    name = "llvm_sysroot",
    lock = "//toolchains/llvm_sysroot/locks:llvm_sysroot.lock",
    manifest = "//toolchains/llvm_sysroot:debian{}.json".format(RELEASE["version"]),
    snapshot = RELEASE["apt_snapshot"],
)
use_repo(sysroots, "llvm_sysroot")

# `cc_toolchain_layout` adapts `@llvm_sysroot`'s Debian-layout LLVM tree
# (`usr/lib/llvm-14/bin/<tool>`) into the canonical clang+llvm tarball shape
# (`bin/<tool>`) that `toolchains_llvm` v1.7.0 consumes via
# `llvm.toolchain_root(label = ...)`. One repo per arch so symlinks resolve to
# the matching `@llvm_sysroot//debian/12/<arch>` tree.
cc_toolchain_layout = use_repo_rule(
    "//toolchains/llvm_sysroot:cc_toolchain_layout.bzl",
    "cc_toolchain_layout",
)

cc_toolchain_layout(
    name = "llvm_toolchain_amd64",
    arch = "amd64",
    llvm_version = RELEASE["llvm_version"],
    sysroot = "@llvm_sysroot//debian/{}/amd64:BUILD.bazel".format(RELEASE["version"]),
)

cc_toolchain_layout(
    name = "llvm_toolchain_arm64",
    arch = "arm64",
    llvm_version = RELEASE["llvm_version"],
    sysroot = "@llvm_sysroot//debian/{}/arm64:BUILD.bazel".format(RELEASE["version"]),
)

register_toolchains(
    "//toolchains/perl:perl_amd64",
    "//toolchains/perl:perl_arm64",
    "//toolchains/python:python3_amd64",
    "//toolchains/python:python3_arm64",
)
