# Single source of truth for every Debian-release-derived version fact, keyed by
# release version. `MODULE.bazel` reads `RELEASE` (the active release) inline
# for the facts it needs to declare repos; the `debian_releases` repo rule
# re-exposes the whole table as `@platform_debian//:versions.bzl` so `.bzl` /
# `BUILD` files can `load()` the same data (MODULE files cannot `load()`). The
# table lives here and nowhere else.
RELEASES = {
    "12": {
        "apt_snapshot": "20250113T000000Z",
        "codename": "bookworm",
        "gcc_major": "12",
        "llvm_major": "14",
        "llvm_version": "14.0.6",
        "perl_version": "5.36",
        "python_version": "3.11",
        "tcl_version": "8.6",
        "version": "12",
    },
    "13": {
        "apt_snapshot": "20260316T000000Z",
        "codename": "trixie",
        "gcc_major": "14",
        "llvm_major": "19",
        "llvm_version": "19.1.7",
        "perl_version": "5.40",
        "python_version": "3.13",
        "tcl_version": "8.6",
        "version": "13",
    },
}

RELEASE = RELEASES["13"]

debian_releases = use_repo_rule("//platforms:debian_releases.bzl", "debian_releases")

debian_releases(
    name = "platform_debian",
    active = RELEASE["version"],
    releases = {
        release: ["{}={}".format(field, value) for field, value in fields.items()]
        for release, fields in RELEASES.items()
    },
)

# toolchains/
#
# `toolchains_llvm` in mode 4 (Bazel-package `toolchain_root`): the compiler
# binaries come from the per-host `@llvm_toolchain_<arch>` adapter (the
# `cc_toolchain_layout` wrapping the Debian-sourced `@llvm_sysroot`), NOT from a
# downloaded LLVM tarball. `rules.bzl:48` short-circuits when `toolchain_roots`
# is non-empty so `@llvm_toolchain_llvm` is never created.
#
# `targets` on `llvm.toolchain_root` keys by EXEC arch (where clang RUNS): one
# tag per build-host arch (linux-x86_64 -> the amd64 adapter, linux-aarch64 ->
# the arm64 adapter), so the compiler runs natively on either host and toolchain
# resolution picks the entry matching the exec platform. `extra_compiler_files`
# is an `arch_select` filegroup that likewise tracks the exec arch (the
# compiler's own libs must match the host clang runs on). The two
# `llvm.sysroot(targets = [...])` tags below key by TARGET arch (what clang
# COMPILES FOR) and feed `--sysroot=` per cross-compile target.
#
# stdlib = stdc++ matches what the @libc_sysroot Debian sysroot ships
# (libstdc++-12-dev + libstdc++6); the same libstdc++ is used at link / runtime.

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    # `extra_compiler_files`: Debian clang at exec time needs its dynamic libs
    # (libLLVM-14.so.1, libclang-cpp.so.14, libedit.so.2, libxml2.so.2, etc.)
    # available in every compile/link action sandbox. The per-host adapter's
    # `:lib` filegroup carries them (hardlinked from Debian's multiarch dir);
    # `:compiler_runtime_libs` arch_selects the exec host's set and threads it
    # into every action's input tree. The cc_wrapper.sh patch sets
    # `LD_LIBRARY_PATH` so ld.so finds them when invoking clang.
    extra_compiler_files = "//toolchains/llvm_sysroot:compiler_runtime_libs",
    llvm_version = RELEASE["llvm_version"],
    stdlib = {"": "stdc++"},
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_toolchain_amd64//:BUILD",
    targets = ["linux-x86_64"],
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_toolchain_arm64//:BUILD",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@libc_sysroot//debian/{}/amd64:sysroot".format(RELEASE["version"]),
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@libc_sysroot//debian/{}/arm64:sysroot".format(RELEASE["version"]),
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

