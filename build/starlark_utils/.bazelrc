# /* vim: set filetype=sh : */

# Build cache
build --experimental_guard_against_concurrent_changes

# Disable `WORKSPACE`
build --noenable_workspace

# Prevent `PATH` and `LD_LIBRARY_PATH` leaking into action environment
build --incompatible_strict_action_env

# Prevent symlink forest under `.runfiles/wsname/external/repo`
build --nolegacy_external_runfiles

# Print relative paths where possible to reduce noise
common --attempt_to_print_relative_paths

common --check_direct_dependencies=error

# --- Hermetic Linux sandbox config (opt-in via --config=hermetic-linux) ---
# Strict sandbox + network + tag isolation, intended as a discovery
# layer for any implicit host dependencies that survive the cc_sysroot
# work.
build:hermetic-linux --announce_rc
test:hermetic-linux --announce_rc
build:hermetic-linux --spawn_strategy=sandboxed
build:hermetic-linux --genrule_strategy=sandboxed
build:hermetic-linux --worker_sandboxing
build:hermetic-linux --experimental_use_hermetic_linux_sandbox
# The chroot starts empty (no /bin, /lib, /lib64, /usr, /proc, /etc).
# The bind-mount manifest lives in the arch-independent file imported
# below; `common:hermetic-linux-<arch>` selectors layer the per-arch
# `--platforms` and toolchain registration on top. Activate with
# `--config=hermetic-linux-amd64` (or `-arm64`).
import %workspace%/.bazelrc.sandbox_linux
build:hermetic-linux --incompatible_sandbox_hermetic_tmp
build:hermetic-linux --sandbox_default_allow_network=false
test:hermetic-linux --sandbox_default_allow_network=false
common:hermetic-linux --incompatible_allow_tags_propagation

# User-specific .bazelrc
try-import %workspace%/.bazelrc.user
