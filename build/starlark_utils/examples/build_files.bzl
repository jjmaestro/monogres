"""
Examples: generating BUILD.bazel files with starlark_utils.

Each function is a "render helper" — the standard pattern for codegen. In a
repository rule, call these from the impl and write the result:

    rctx.file("pkg/BUILD.bazel", library_build("defs", ["defs.bzl"], deps))
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//:suite.bzl", _test_suite = "test_suite")

_HEADER = "Generated by my_module. DO NOT EDIT."

# ---------------------------------------------------------------------------
# Render helpers — one function per BUILD file type
# ---------------------------------------------------------------------------

def minimal_build():
    """Root BUILD.bazel: just package visibility.

    Typical use: the top-level package of a generated repo.
    """
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
    )

def library_build(name, srcs, deps):
    """BUILD.bazel for a bzl_library package with an alias target.

    Typical use: per-component packages inside a generated repo, each exposing a
    defs.bzl via a bzl_library target.
    """
    return Star.file(
        Star.load_("@bazel_skylib//:bzl_library.bzl", "bzl_library"),
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(srcs),
        Star.bzl_library(name = name, srcs = srcs, deps = deps),
        Star.alias(name = "lib", actual = ":" + name),
        header = _HEADER,
    )

def rules_build(name, srcs, deps):
    """BUILD.bazel with a custom rule call rendered via igen.

    Typical use: generated BUILD files that declare cc_library, genrule, or
    other rule targets with computed attributes.
    """
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.igen(Star.fn("cc_library", name = name, srcs = srcs, deps = deps)),
        header = _HEADER,
    )

def readme_root_build(srcs):
    """BUILD file from the README 'Getting Started' section."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(srcs),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Tests — verify expected output and serve as usage examples
# ---------------------------------------------------------------------------

TEST_SUITE_NAME = "build_files_examples"

def _minimal_build_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])
'''
    asserts.equals(env, expected, minimal_build())

    return unittest.end(env)

minimal_build_test = unittest.make(_minimal_build_test_impl)

def _library_build_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

bzl_library(
    name = "defs",
    srcs = [
        "defs.bzl",
    ],
    deps = [
        "//some:dep",
    ],
)

alias(name = "lib", actual = ":defs")
'''
    asserts.equals(
        env,
        expected,
        library_build("defs", ["defs.bzl"], ["//some:dep"]),
    )

    return unittest.end(env)

library_build_test = unittest.make(_library_build_test_impl)

def _rules_build_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mylib",
    srcs = [
        "lib.c",
        "util.c",
    ],
    deps = [
        ":base",
        "//third-party:zlib",
    ],
)
'''
    asserts.equals(env, expected, rules_build(
        "mylib",
        ["lib.c", "util.c"],
        [":base", "//third-party:zlib"],
    ))

    return unittest.end(env)

rules_build_test = unittest.make(_rules_build_test_impl)

def _readme_root_build_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

exports_files(["all.bzl"])
'''
    asserts.equals(env, expected, readme_root_build(["all.bzl"]))

    return unittest.end(env)

readme_root_build_test = unittest.make(_readme_root_build_test_impl)

TEST_SUITE_TESTS = dict(
    minimal_build = minimal_build_test,
    library_build = library_build_test,
    rules_build = rules_build_test,
    readme_root_build = readme_root_build_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
