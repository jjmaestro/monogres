"""
Examples: generating Starlark logic with starlark_utils.

Each function is a render helper that uses the statement-level builders (def_,
if_, for_, assign, return_, block) to generate Starlark source with control flow
and function definitions. In a repository rule:

    rctx.file("impl.bzl", simple_rule_impl())
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//:suite.bzl", _test_suite = "test_suite")

_HEADER = "Generated by example_module."

# ---------------------------------------------------------------------------
# Render helpers — one function per generated pattern
# ---------------------------------------------------------------------------

def simple_rule_impl():
    """Function definition with assignments and return.

    Generates:
        def _impl(ctx):
            out = ctx.actions.declare_file("out.txt") return DefaultInfo(files =
            depset([out]))
    """
    return Star.gen(
        Star.def_("_impl", "ctx").body_(
            Star.assign("out", Star.fn("ctx.actions.declare_file", "out.txt")),
            Star.return_(Star.fn(
                "DefaultInfo",
                files = Star.fn("depset", [Star.expr("out")]),
            )),
        ),
    )

def conditional_rule_impl():
    """Function definition with if/elif/else control flow.

    Generates:
        def _impl(ctx):
            if ctx.attr.mode == "fast":
                process_fast(ctx)
            elif ctx.attr.mode == "safe":
                process_safe(ctx)
            else:
                fail("unknown mode")
    """
    return Star.gen(
        Star.def_("_impl", "ctx").body_(
            Star.if_(Star.expr('ctx.attr.mode == "fast"')).then(
                Star.fn("process_fast", Star.expr("ctx")),
            ).elif_(Star.expr('ctx.attr.mode == "safe"')).then(
                Star.fn("process_safe", Star.expr("ctx")),
            ).else_(
                Star.fn("fail", "unknown mode"),
            ),
        ),
    )

def loop_example():
    """Function definition with a for loop and return.

    Generates:
        def _collect_srcs(ctx):
            srcs = [] for dep in ctx.attr.deps:
                srcs.extend(dep.files.to_list())
            return srcs
    """
    return Star.gen(
        Star.def_("_collect_srcs", "ctx").body_(
            Star.assign("srcs", []),
            Star.for_(Star.expr("dep"), Star.expr("ctx.attr.deps")).do_(
                Star.fn("srcs.extend", Star.fn("dep.files.to_list")),
            ),
            Star.return_(Star.expr("srcs")),
        ),
    )

def full_module():
    """Complete .bzl file with a def and a rule assignment.

    Demonstrates composing statement-level generation with existing Star.file()
    and Star.igen() for a complete module.
    """
    impl_def = Star.gen(
        Star.def_("_impl", "ctx").body_(
            Star.assign("out", Star.fn("ctx.actions.declare_file", "out.txt")),
            Star.return_(Star.fn(
                "DefaultInfo",
                files = Star.fn("depset", [Star.expr("out")]),
            )),
        ),
    )
    rule_call = "my_rule = " + Star.igen(Star.fn(
        "rule",
        implementation = Star.expr("_impl"),
        attrs = {"src": Star.fn("attr.label")},
    ))
    return Star.file(impl_def, rule_call, header = _HEADER)

# ---------------------------------------------------------------------------
# Tests — verify expected output and serve as usage examples
# ---------------------------------------------------------------------------

TEST_SUITE_NAME = "starlark_logic_examples"

def _simple_rule_impl_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = """\
def _impl(ctx):
    out = ctx.actions.declare_file("out.txt")
    return DefaultInfo(files = depset([out]))\
"""
    asserts.equals(env, expected, simple_rule_impl())

    return unittest.end(env)

simple_rule_impl_test = unittest.make(_simple_rule_impl_test_impl)

def _conditional_rule_impl_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = """\
def _impl(ctx):
    if ctx.attr.mode == "fast":
        process_fast(ctx)
    elif ctx.attr.mode == "safe":
        process_safe(ctx)
    else:
        fail("unknown mode")\
"""
    asserts.equals(env, expected, conditional_rule_impl())

    return unittest.end(env)

conditional_rule_impl_test = unittest.make(_conditional_rule_impl_test_impl)

def _loop_example_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = """\
def _collect_srcs(ctx):
    srcs = []
    for dep in ctx.attr.deps:
        srcs.extend(dep.files.to_list())
    return srcs\
"""
    asserts.equals(env, expected, loop_example())

    return unittest.end(env)

loop_example_test = unittest.make(_loop_example_test_impl)

def _full_module_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by example_module."""

def _impl(ctx):
    out = ctx.actions.declare_file("out.txt")
    return DefaultInfo(files = depset([out]))

my_rule = rule(
    implementation = _impl,
    attrs = {
        "src": attr.label(),
    },
)
'''
    asserts.equals(env, expected, full_module())

    return unittest.end(env)

full_module_test = unittest.make(_full_module_test_impl)

TEST_SUITE_TESTS = dict(
    simple_rule_impl = simple_rule_impl_test,
    conditional_rule_impl = conditional_rule_impl_test,
    loop_example = loop_example_test,
    full_module = full_module_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
