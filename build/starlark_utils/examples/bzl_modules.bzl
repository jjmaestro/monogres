"""
Examples: generating .bzl modules with starlark_utils.

Render helpers for .bzl files containing load statements, assignments, computed
references, and complex data structures. In a repository rule:

    rctx.file("defs.bzl", version_defs(["1.0", "2.0"], "2.0"))
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//:suite.bzl", _test_suite = "test_suite")

_HEADER = "Generated by my_module. DO NOT EDIT."

# ---------------------------------------------------------------------------
# Render helpers
# ---------------------------------------------------------------------------

def version_defs(versions, default_version):
    """Simple defs.bzl with version metadata as top-level assignments."""
    return Star.file(
        Star.gen(Star.block(
            Star.assign("VERSIONS", versions),
            Star.assign("DEFAULT_VERSION", default_version),
        )),
        header = _HEADER,
    )

def forwarding_stub(repo, pkg):
    """Load-forwarding stub: loads symbols from a lazy repo and re-exports.

    Star.load_() with kwargs produces renamed imports (_CONFIG = "CONFIG").
    Star.ref() emits bare identifiers for the re-export assignments. Pre-render
    the load with Star.igen() for multi-line output.

    Typical use: hub repo stubs that defer to per-version lazy repos.
    """
    return Star.file(
        Star.igen(Star.load_(
            "@%s//%s:defs.bzl" % (repo, pkg),
            _CONFIG = "CONFIG",
            _VERSIONS = "VERSIONS",
        )),
        Star.gen(Star.block(
            Star.assign("CONFIG", Star.ref("_CONFIG")),
            Star.assign("VERSIONS", Star.ref("_VERSIONS")),
        )),
        header = _HEADER,
    )

def hub_module(tools, default_name):
    """Hub module with nested structs and computed references.

    Star.assign() for each top-level constant; Star.gen() keeps simple values
    inline, Star.igen() forces multi-line for complex ones. Star.ref() wires
    cross-references without quoting.

    Typical use: the root all.bzl of a hub repo that exports a config struct.
    """
    return Star.file(
        Star.gen(Star.block(
            Star.assign("DEFAULT", default_name),
            Star.assign("NAMES", sorted(tools.keys())),
            Star.assign("_CONFIGS", Star.ref(Star.igen(tools))),
            Star.assign("REGISTRY", Star.ref(Star.igen(struct(
                name = "tools",
                default = Star.ref("DEFAULT"),
                configs = Star.ref("_CONFIGS"),
            )))),
        )),
        header = _HEADER,
    )

def aggregator_module(repos):
    """Aggregator that collects loads from multiple repos into a config dict.

    Shows the pattern of building up load statements and alias maps
    programmatically: each repo contributes one load (with a private alias) and
    one entry in the config dict (via Star.ref).

    Typical use: a root module that imports from N generated sub-repos.

    Args:
        repos: Dict mapping logical names to Bazel repo names.

    Returns:
        Pre-rendered .bzl file content.
    """
    loads = []
    configs = {}
    for i, name in enumerate(repos.keys()):
        repo = repos[name]
        alias = "_CFG_%d" % i
        loads.append(Star.igen(
            Star.load_("@%s//:defs.bzl" % repo, **{alias: "CFG"}),
        ))
        configs[name] = Star.ref(alias)

    parts = loads + [Star.igen(Star.assign("CONFIGS", configs))]
    return Star.file(header = _HEADER, *parts)

def readme_all_bzl(versions, default_version):
    """Module from the README 'Getting Started' section.

    Shows struct vs dict rendering: Star.igen(struct(**d)) renders as a struct()
    call, while Star.igen(d) renders as a dict literal.
    """
    struct_dict = dict(
        name = "my_tool",
        default = Star.ref("DEFAULT_VERSION"),
    )
    return Star.file(
        Star.gen(Star.block(
            Star.assign("VERSIONS", versions),
            Star.assign("DEFAULT_VERSION", default_version),
            Star.assign("CFG", Star.ref(Star.igen(struct(**struct_dict)))),
            Star.assign("CFG_DICT", Star.ref(Star.igen(struct_dict))),
        )),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Tests — verify expected output and serve as usage examples
# ---------------------------------------------------------------------------

TEST_SUITE_NAME = "bzl_modules_examples"

def _version_defs_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

VERSIONS = ["1.0", "2.0"]
DEFAULT_VERSION = "2.0"
'''
    asserts.equals(env, expected, version_defs(["1.0", "2.0"], "2.0"))

    return unittest.end(env)

version_defs_test = unittest.make(_version_defs_test_impl)

def _forwarding_stub_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

load(
    "@my_repo//pkg:defs.bzl",
    _CONFIG = "CONFIG",
    _VERSIONS = "VERSIONS",
)

CONFIG = _CONFIG
VERSIONS = _VERSIONS
'''
    asserts.equals(env, expected, forwarding_stub("my_repo", "pkg"))

    return unittest.end(env)

forwarding_stub_test = unittest.make(_forwarding_stub_test_impl)

def _hub_module_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

DEFAULT = "clang"
NAMES = ["clang", "gcc"]
_CONFIGS = {
    "clang": "17.0",
    "gcc": "13.2",
}
REGISTRY = struct(
    name = "tools",
    default = DEFAULT,
    configs = _CONFIGS,
)
'''
    asserts.equals(env, expected, hub_module(
        {"clang": "17.0", "gcc": "13.2"},
        "clang",
    ))

    return unittest.end(env)

hub_module_test = unittest.make(_hub_module_test_impl)

def _aggregator_module_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

load(
    "@clang_repo//:defs.bzl",
    _CFG_0 = "CFG",
)

load(
    "@gcc_repo//:defs.bzl",
    _CFG_1 = "CFG",
)

CONFIGS = {
    "clang": _CFG_0,
    "gcc": _CFG_1,
}
'''
    asserts.equals(env, expected, aggregator_module(
        {"clang": "clang_repo", "gcc": "gcc_repo"},
    ))

    return unittest.end(env)

aggregator_module_test = unittest.make(_aggregator_module_test_impl)

def _readme_all_bzl_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '''\
"""Generated by my_module. DO NOT EDIT."""

VERSIONS = ["1.0", "2.0"]
DEFAULT_VERSION = "2.0"
CFG = struct(
    name = "my_tool",
    default = DEFAULT_VERSION,
)
CFG_DICT = {
    "name": "my_tool",
    "default": DEFAULT_VERSION,
}
'''
    asserts.equals(env, expected, readme_all_bzl(["1.0", "2.0"], "2.0"))

    return unittest.end(env)

readme_all_bzl_test = unittest.make(_readme_all_bzl_test_impl)

TEST_SUITE_TESTS = dict(
    version_defs = version_defs_test,
    forwarding_stub = forwarding_stub_test,
    hub_module = hub_module_test,
    aggregator_module = aggregator_module_test,
    readme_all_bzl = readme_all_bzl_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
