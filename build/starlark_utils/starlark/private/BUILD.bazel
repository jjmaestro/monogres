load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//starlark:__pkg__"])

bzl_library(
    name = "node",
    srcs = ["node.bzl"],
)

bzl_library(
    name = "fn",
    srcs = ["fn.bzl"],
    deps = [":node"],
)

bzl_library(
    name = "gen",
    srcs = ["gen.bzl"],
    deps = [
        ":fn",
        ":node",
    ],
)

bzl_library(
    name = "expr",
    srcs = ["expr.bzl"],
    deps = [
        ":gen",
        ":node",
    ],
)

bzl_library(
    name = "stmt",
    srcs = ["stmt.bzl"],
    deps = [":node"],
)

bzl_library(
    name = "file",
    srcs = ["file.bzl"],
    deps = [
        ":expr",
        ":gen",
    ],
)

bzl_library(
    name = "bazel",
    srcs = ["bazel.bzl"],
    deps = [
        ":fn",
        ":gen",
    ],
)
