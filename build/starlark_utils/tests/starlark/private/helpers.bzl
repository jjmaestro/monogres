"""Tests for assignments and file helpers."""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
load("//starlark:starlark.bzl", Star = "starlark")

def _assignments_test_impl(ctx):
    env = unittest.begin(ctx)

    def test(assignments):
        # inline (default)
        expected = 'FOO = 42, BAR = "foobar"'
        actual = Star.assignments(assignments)

        asserts.equals(env, expected, actual)

        # multi-line
        expected = """
FOO = 42
BAR = "foobar"
        """.strip()
        actual = Star.assignments(assignments, inline = False)

        asserts.equals(env, expected, actual)

    # test all types
    params = [
        dict(FOO = 42, BAR = "foobar"),
        [("FOO", 42), ["BAR", "foobar"]],
        (["FOO", 42], ("BAR", "foobar")),
        (("FOO", 42), ("BAR", "foobar")),
    ]

    for assignments in params:
        test(assignments)

    return unittest.end(env)

assignments_test = unittest.make(_assignments_test_impl)

def _assignments_indent_test_impl(ctx):
    env = unittest.begin(ctx)

    assignments = dict(FOO = 42, BAR = "foobar")

    # indent_count=1 with default indent_size=4: NOTE: the leading whitespace
    # before FOO and BAR is the indent (4 spaces)
    expected = """\
    FOO = 42
    BAR = "foobar"\
"""
    actual = Star.assignments(assignments, inline = False, indent_count = 1)

    asserts.equals(env, expected, actual)

    # indent_count=2 with indent_size=3:
    # NOTE: the leading whitespace is 6 spaces (2 * 3)
    expected = """\
      FOO = 42
      BAR = "foobar"\
"""
    actual = Star.assignments(
        assignments,
        inline = False,
        indent_count = 2,
        indent_size = 3,
    )

    asserts.equals(env, expected, actual)

    # indent_count=0 (default) should behave like before
    expected = """
FOO = 42
BAR = "foobar"
    """.strip()
    actual = Star.assignments(assignments, inline = False, indent_count = 0)

    asserts.equals(env, expected, actual)

    return unittest.end(env)

assignments_indent_test = unittest.make(_assignments_indent_test_impl)

## --- file --------------------------------------------

def _file_no_header_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = "a\n\nb\n"
    actual = Star.file("a", "b")

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_no_header_test = unittest.make(_file_no_header_test_impl)

def _file_with_header_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '"""H"""\n\na\n'
    actual = Star.file("a", header = "H")

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_with_header_test = unittest.make(_file_with_header_test_impl)

def _file_header_only_test_impl(ctx):
    env = unittest.begin(ctx)

    expected = '"""H"""\n'
    actual = Star.file(header = "H")

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_header_only_test = unittest.make(_file_header_only_test_impl)

def _file_with_docstring_header_test_impl(ctx):
    """Integration: header built via Star.docstring."""
    env = unittest.begin(ctx)

    expected = '"""Generated by x. DO NOT EDIT."""\n\npackage()\n'
    actual = Star.file(
        "package()",
        header = "Generated by x. DO NOT EDIT.",
    )

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_with_docstring_header_test = unittest.make(
    _file_with_docstring_header_test_impl,
)

def _file_empty_parts_filtered_test_impl(ctx):
    """Empty strings between parts don't create extra blank lines."""
    env = unittest.begin(ctx)

    expected = "a\n\nb\n"
    actual = Star.file("", "a", "", "b")

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_empty_parts_filtered_test = unittest.make(
    _file_empty_parts_filtered_test_impl,
)

def _file_node_header_test_impl(ctx):
    """header can be a pre-built node value (e.g. Star.docstring())."""
    env = unittest.begin(ctx)

    expected = '"""H"""\n\na\n'
    actual = Star.file("a", header = Star.docstring("H"))

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_node_header_test = unittest.make(_file_node_header_test_impl)

def _file_node_comment_header_test_impl(ctx):
    """header can be a comment node value."""
    env = unittest.begin(ctx)

    expected = "# Generated\n\na\n"
    actual = Star.file("a", header = Star.comment("Generated"))

    asserts.equals(env, expected, actual)

    return unittest.end(env)

file_node_comment_header_test = unittest.make(
    _file_node_comment_header_test_impl,
)

TEST_SUITE_TESTS = dict(
    assignments = assignments_test,
    assignments_indent = assignments_indent_test,
    # file
    file_no_header = file_no_header_test,
    file_with_header = file_with_header_test,
    file_header_only = file_header_only_test,
    file_with_docstring_header = file_with_docstring_header_test,
    file_empty_parts_filtered = file_empty_parts_filtered_test,
    file_node_header = file_node_header_test,
    file_node_comment_header = file_node_comment_header_test,
)
