+def _dir_key(version, source, patches):
+    """The files whose contents decide what the extracted directory holds.
+
+    The repo `lock.json` carries the `url` and the `integrity` of the archive,
+    so it covers a version re-pinned in place. It carries the patches only by
+    label, so those are named one by one, to be taken by content: editing a
+    patch is the ordinary way to work on one.
+    """
+    return ["//:lock.json"] + [
+        "//patches/%s/%s:%s" % (version, source, patch.name)
+        for patch in patches
+    ]
