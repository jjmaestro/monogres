+```json
+{
+  "version": 1,
+  "sources": {
+    "static.rust-lang.org": {
+      "url": "https://{source}/dist/{component}-{version}-{triple}.tar.xz",
+      "strip_prefix": "{component}-{version}-{triple}/{piece}"
