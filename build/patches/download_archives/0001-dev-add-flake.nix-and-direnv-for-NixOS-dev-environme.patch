From c2e2fe6f69829e59b975812297ced57e15ed349d Mon Sep 17 00:00:00 2001
From: Javier Maestro <jjmaestro@ieee.org>
Date: Thu, 2 Apr 2026 22:23:49 +0000
Subject: [PATCH 01/14] dev: add flake.nix and direnv for NixOS dev environment

---
 .bazelignore |  1 +
 .envrc       |  2 ++
 .gitignore   |  3 +++
 flake.lock   | 27 +++++++++++++++++++++++++
 flake.nix    | 56 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 89 insertions(+)
 create mode 100644 .envrc
 create mode 100644 flake.lock
 create mode 100644 flake.nix

diff --git a/.bazelignore b/.bazelignore
index 37fa09a..9c4247c 100644
--- a/.bazelignore
+++ b/.bazelignore
@@ -1,2 +1,3 @@
+.direnv
 docs
 examples
diff --git a/.envrc b/.envrc
new file mode 100644
index 0000000..0f94eed
--- /dev/null
+++ b/.envrc
@@ -0,0 +1,2 @@
+# shellcheck shell=bash
+use flake
diff --git a/.gitignore b/.gitignore
index b508b13..e9c3147 100644
--- a/.gitignore
+++ b/.gitignore
@@ -11,3 +11,6 @@ MODULE.bazel.lock
 
 # ignore the CI cache dir
 .cache
+
+# ignore direnv
+/.direnv/
diff --git a/flake.lock b/flake.lock
new file mode 100644
index 0000000..5c1783a
--- /dev/null
+++ b/flake.lock
@@ -0,0 +1,27 @@
+{
+  "nodes": {
+    "nixpkgs": {
+      "locked": {
+        "lastModified": 1775823930,
+        "narHash": "sha256-ALT447J7FcxP/97J01A/gp/hgdO5lXRsm+zLMt+gIjc=",
+        "owner": "NixOS",
+        "repo": "nixpkgs",
+        "rev": "8c11f88bb9573a10a7d6bf87161ef08455ac70b9",
+        "type": "github"
+      },
+      "original": {
+        "owner": "NixOS",
+        "ref": "nixpkgs-unstable",
+        "repo": "nixpkgs",
+        "type": "github"
+      }
+    },
+    "root": {
+      "inputs": {
+        "nixpkgs": "nixpkgs"
+      }
+    }
+  },
