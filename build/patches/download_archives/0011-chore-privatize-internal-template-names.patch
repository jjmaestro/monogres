From 441c2310afecb2f8223d34498ce621ac0064df3d Mon Sep 17 00:00:00 2001
From: Javier Maestro <jjmaestro@ieee.org>
Date: Sat, 4 Apr 2026 18:01:59 +0000
Subject: [PATCH 11/14] chore: privatize internal template names

Rename REPO, BUILD_ROOT, BUILD_VERSION, SOURCE_BZL_LAZY, BUILD_SOURCE
to private (_REPO, _BUILD_ROOT, etc.) since they're only used within
repository.bzl.
---
 download/archives/repository.bzl | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/download/archives/repository.bzl b/download/archives/repository.bzl
index 37b0b60..a930b97 100644
--- a/download/archives/repository.bzl
+++ b/download/archives/repository.bzl
@@ -442,7 +442,7 @@ _DOC = (
     DOC_LINK_REFS
 )
 
-REPO = '''\
+_REPO = '''\
 """Generated by download_archives. DO NOT EDIT."""
 
 REPO_NAME = "{repo_name}"
@@ -483,7 +483,7 @@ bzl_library(
 )
 """
 
-BUILD_ROOT = '''\
+_BUILD_ROOT = '''\
 """Generated by download_archives. DO NOT EDIT."""
 
 load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
@@ -494,7 +494,7 @@ package(default_visibility = ["//visibility:public"])
 VERSION = "{version}"
 ''' + _BUILD_TARGETS
 
-BUILD_VERSION = '''\
+_BUILD_VERSION = '''\
 """Generated by download_archives. DO NOT EDIT."""
 
 load("//{version}:source.bzl", "SOURCE")
@@ -504,7 +504,7 @@ package(default_visibility = ["//visibility:public"])
 VERSION = "{version}"
 ''' + _BUILD_TARGETS
 
-SOURCE_BZL_LAZY = '''\
+_SOURCE_BZL_LAZY = '''\
 """Generated by download_archives. DO NOT EDIT."""
 
 load("@{dl_repo}//{version}:source.bzl", _SOURCE = "SOURCE", _URL = "URL")
@@ -513,7 +513,7 @@ SOURCE = _SOURCE
 URL = _URL
 '''
 
-BUILD_SOURCE = '''\
+_BUILD_SOURCE = '''\
 """Generated by download_archives. DO NOT EDIT."""
 
 # source packages are only visible to their version package
@@ -587,7 +587,7 @@ def _impl(rctx, _print = print, _fail = fail):
 
             rctx.file(
                 "%s/source.bzl" % version,
-                SOURCE_BZL_LAZY.format(dl_repo = dl_repo_name, version = version),
+                _SOURCE_BZL_LAZY.format(dl_repo = dl_repo_name, version = version),
                 executable = False,
             )
         else:
@@ -612,7 +612,7 @@ def _impl(rctx, _print = print, _fail = fail):
 
             rctx.file(
                 "%s/%s/BUILD.bazel" % (version, dl.source),
-                BUILD_SOURCE.format(alias = dl.source, version = version),
+                _BUILD_SOURCE.format(alias = dl.source, version = version),
                 executable = False,
             )
 
@@ -625,7 +625,7 @@ def _impl(rctx, _print = print, _fail = fail):
 
         rctx.file(
             "%s/BUILD.bazel" % version,
-            BUILD_VERSION.format(
+            _BUILD_VERSION.format(
                 version = version,
                 actual_prefix = actual_prefix,
                 alias = version,
@@ -647,7 +647,7 @@ def _impl(rctx, _print = print, _fail = fail):
 
     rctx.file(
         "BUILD.bazel",
-        BUILD_ROOT.format(
+        _BUILD_ROOT.format(
             version = default_version,
             actual_prefix = actual_prefix,
             alias = repo_name,
@@ -657,7 +657,7 @@ def _impl(rctx, _print = print, _fail = fail):
 
     rctx.file(
         "repo.bzl",
-        REPO.format(
+        _REPO.format(
             repo_name = repo_name,
             versions = versions,
             default_version = default_version,
