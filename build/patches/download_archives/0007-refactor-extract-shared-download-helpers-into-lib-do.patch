 lib/BUILD.bazel                  |   9 ++
 lib/download.bzl                 | 108 +++++++++++++
 tests/lib/BUILD.bazel            |   3 +
 tests/lib/download.bzl           | 258 +++++++++++++++++++++++++++++++
 6 files changed, 383 insertions(+), 96 deletions(-)
 create mode 100644 lib/download.bzl
 create mode 100644 tests/lib/download.bzl

