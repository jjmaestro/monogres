    "test_overrides": {
      "regress": {
        "exclude_tests": ["numa"],
        "note": "The numa test is excluded: IvorySQL 5.0's backport of PG18's pg_shmem_allocations_numa raises 'invalid NUMA node id outside of allowed range [0, 0]: -2' in a non-NUMA sandbox, where upstream PostgreSQL 18 tolerates NUMA_NO_NODE and passes the identical test in the same sandbox. An IvorySQL-specific divergence in the NUMA backport, not a hermeticity gap; --exclude-tests numa is a no-op on versions without the test."
      },
      "ivorysql_ora": {
        "exclude": true,
        "note": "Oracle-mode contrib suite, deferred (option C). See build/catalog/ivorysql/ORACLE_TESTING.md. Needs an initdb -m oracle cluster plus the oracle parser (oracle listener port); not run in the PG-mode lane."
      },
      "ora_btree_gin": {
        "exclude": true
      },
      "ora_btree_gist": {
        "exclude": true
      },
      "plisql": {
        "exclude": true,
        "note": "PL/iSQL is IvorySQL's oracle PL; its tests need an oracle-mode cluster (the plisql language is created by initdb -m oracle, and the suite uses oracle PL/SQL syntax). Deferred (option C); see build/catalog/ivorysql/ORACLE_TESTING.md."
      },
      "brin": {
        "exclude": true,
        "note": "src/test/modules suites are deferred: a pre-existing ivory test-variant staging-prefix gap stages module artifacts to bare lib/ + share/extension/ instead of ivory's lib/postgresql + share/postgresql/extension, so CREATE EXTENSION cannot find them. All test/modules excluded for a green lane. See build/catalog/ivorysql/MODULES_TESTING.md."
      },
