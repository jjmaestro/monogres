  "metadata": {
    "flavor": "openhalo",
    "patches": [
      {
        "label": "//catalog/openhalo/patches:0001-1beta1-tap-adapt-postgresnode-for-openhalo.patch",
        "spec": "*"
      }
    ],
    "test_overrides": {
      "unaccent": {
        "encoding": "UTF8"
      },
      "pgbench": {
        "tap_skip": {
          "002_pgbench_no_server": "openHalo rebrands the pgbench --help/--version banner to Halo, so the upstream output regex (which matches the pgbench PostgreSQL banner) diverges. Genuine fork divergence (postgres passes in the same harness); revisit if openHalo keeps the upstream banner or its expected output is accepted. Reason text avoids the apostrophe that Bazel args shell-tokenization rejects."
        }
      },
      "pg_dump": {
        "tap_skip": {
          "002_pg_dump": "create-postgres shim collateral: the TAP-adapt patch recreates the stock postgres db (the openHalo admin db is halo0root), but openHalo pg_dumpall excludes halo0root rather than postgres, so the recreated postgres db is dumped and the cluster-wide dump diffs from the upstream expectation. Skipped pending an openHalo-faithful shim.",
          "010_dump_connstr": "same create-postgres shim collateral as 002_pg_dump: openHalo pg_dumpall excludes halo0root (not postgres), so the recreated postgres db is dumped and the connstr dump diverges from upstream."
        }
      },
      "pg_ctl": {
        "tap_skip": {
          "004_logrotate": "csvlog-collector domain: openHalo defaults log_destination to csvlog with logging_collector on, so logrotate cycles the haloserver csv collector files while the upstream test greps the stderr logfile rotation. Fork logging-default divergence, out of hermetic-harness scope."
        }
      },
      "pg_rewind": {
        "tap_skip": {
          "002_databases": "openHalo behavioural divergence: the per-database rewind expectations diverge from upstream (postgres passes this in the same harness). Skipped pending openHalo-domain investigation."
        }
      },
      "isolation": {
        "exclude_tests": ["timeouts"],
        "note": "openHalo's lock_timeout/statement_timeout do not fire on a blocked LOCK TABLE, so the upstream `timeouts` spec (which expects 'canceling statement due to lock timeout') instead has isolationtester cancel each blocked step after its built-in 300s ('canceling statement due to user request'). That fails the spec AND makes the suite take ~620s, which also starves co-scheduled suites into false timeouts. postgres passes this spec in the same harness, so it is openHalo-behavioral, not hermetic. The harness filters `timeouts` out of isolation_schedule at run time (the other ~103 specs still run and pass); revisit if openHalo fixes timeout firing."
      },
      "pg_stat_statements": {
        "known_failure": "openHalo ships a fork-specific pg_stat_statements.untrack_dbnames feature; its expected output (db 'halo0root') does not reproduce against the hermetic temp instance, so this suite FAILS. Left enabled and failing on purpose (NOT excluded) pending openHalo-domain investigation; treat as an expected failure until then."
      },
      "pltcl": {
        "load_extension": ["pltcl"]
      },
      "plpython": {
        "exclude": "PG14 plpython core suite needs the build-tree python3 mangle (sql/python3/ rewrite + _3/_5 alternate goldens); only plpython3u is installed (plpythonu is Python-2-only) and the raw sql/ is Python-2 shaped, so it is not reproducible against the installed tree"
      },
      "hstore_plpython": {
        "exclude": "see plpython: Python-2-shaped raw sql/ + Python-2-only plpythonu transform; needs the build-tree python3 mangle, out of installed-tree harness scope"
      },
      "ltree_plpython": {
        "exclude": "see plpython: Python-2-shaped raw sql/ + Python-2-only plpythonu transform; needs the build-tree python3 mangle, out of installed-tree harness scope"
      },
      "jsonb_plpython": {
        "exclude": "see plpython: Python-2-shaped raw sql/ + Python-2-only plpythonu transform; needs the build-tree python3 mangle, out of installed-tree harness scope"
      },
      "pgrowlocks": {
        "load_extension": ["pgrowlocks"]
      },
      "tcn": {
        "load_extension": ["tcn"]
      },
      "postgres_fdw": {
        "regress": {
          "golden_cosmetic": true,
          "note": "openHalo's EXPLAIN renders the QUERY PLAN column at a slightly different width than upstream, so postgres_fdw.out diffs ONLY in psql table rendering (header trailing spaces + separator dash count) with no data-row differences. Accepted as a cosmetic golden diff via the harness --golden-cosmetic re-check, which still fails on any real content diff."
        },
        "isolation": {
          "load_extension": ["postgres_fdw"]
        }
      },
      "tablefunc": {
        "exclude": "openHalo's connectby() parses the start value as a column reference instead of a literal (connectby(..., 'row2', ...) -> ERROR: column \"row2\" does not exist), so the upstream tablefunc expected output diverges. Behavioral fork divergence (postgres passes in the same harness); excluded to revisit when openHalo's connectby is fixed or its golden output is accepted."
      },
      "sepgsql": {
        "exclude": "SELinux shell harness; impractical in the hermetic sandbox"
      }
    },
