{
  "version": 1,
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "pgRouting",
      "name": "pgrouting",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/pgRouting/pgrouting/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "4.0.1": {
      "sha256": "21c071983a682e048da28f0f211205a20f27ef3708c0b637b4e6e29994d7d699"
    }
  },
  "metadata": {
    "build_system": "cmake",
    "build_args": [
      "-DPOSTGRESQL_PG_CONFIG={pg_config}",
      "-DCMAKE_BUILD_TYPE=Release"
    ],
    "compatible_with": {
      "postgres": {
        "4.0.1": ">=16"
      }
    },
    "deps": {
      "buildtime": {
        "debian": {
          "12": {
            "*": ["libboost-dev"]
          },
          "13": {
            "*": ["libboost-dev"]
          }
        }
      }
    },
    "test_ext": {
      "requires": ["postgis"],
      "smoke": {
        "extensions": ["pgrouting"],
        "cascade": true
      }
    }
  }
}
