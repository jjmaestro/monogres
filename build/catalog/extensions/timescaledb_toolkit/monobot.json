{
  "version": 1,
  "name": "timescaledb_toolkit",
  "url": "https://github.com/timescale/timescaledb-toolkit",
  "sources": {
    "gh": {
      "tag": "{version}",
      "gh_org": "timescale",
      "name": "timescaledb-toolkit",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["1.24.0"]
  },
  "metadata": {
    "build_system": "pgrx",
    "crate_dir": "extension",
    "compatible_with": {
      "postgres": {
        "1.24.0": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["timescaledb_toolkit"]
      }
    }
  }
}
