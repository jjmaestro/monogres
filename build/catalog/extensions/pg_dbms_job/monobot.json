{
  "version": 1,
  "name": "pg_dbms_job",
  "url": "https://github.com/hexacluster/pg_dbms_job",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "hexacluster",
      "name": "pg_dbms_job",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/hexacluster/pg_dbms_job/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["2.0"]
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "2.0": ">=16"
      }
    },
    "deps": {
      "buildtime": {
        "debian": {
          "12": {
            "*": ["libpq-dev"]
          },
          "13": {
            "*": ["libpq-dev"]
          }
        }
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["pg_dbms_job"],
        "preload": ["pg_dbms_job"]
      },
      "test": {
        "*": {
          "integration": {
            "kind": "integration",
            "preload": ["pg_dbms_job"],
            "num_clusters": 1,
            "assertion_script": "//catalog/extensions/pg_dbms_job/tests:integration.sh"
          }
        }
      }
    }
  }
}
