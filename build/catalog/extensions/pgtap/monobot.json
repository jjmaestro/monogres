{
  "version": 1,
  "name": "pgtap",
  "url": "https://github.com/theory/pgtap",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "theory",
      "name": "pgtap",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["1.3.4"]
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "1.3.4": ">=16"
      }
    },
    "test_ext": {
      "test_overrides": {
        "regress": {
          "exclude": true
        }
      }
    }
  }
}
