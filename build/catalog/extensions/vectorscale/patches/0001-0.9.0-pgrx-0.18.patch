From d49bdba4c9a843bb6de6675f06e42b1c0f1b9880 Mon Sep 17 00:00:00 2001
From: Javier Maestro <jjmaestro@ieee.org>
Date: Sat, 25 Jul 2026 09:42:29 +0000
Subject: [PATCH] patch: move to pgrx 0.18 for an offline, sandboxed build

0.9.0 ships against pgrx 0.16, whose only route to the extension SQL is a
generated `pgrx_embed` binary: it is compiled in a second pass and RUN, and its
stdout is the SQL. A network-less sandbox cannot allow that, and a cross-compile
cannot do it at all. 0.18 instead records the SQL entity graph in a `.pgrxsc`
link section, so the same SQL can be read out of the built library as data
by a small external tool. `pgrx_embed` is gone in 0.18, so its `[[bin]]` and the
one-line source behind it go with it.

0.18.1 rather than 0.18.0: 0.18.0 emits the section but lets the linker garbage
collect it on aarch64 Linux, where nothing references it, leaving an extension
with no SQL at all (pgrx #2280).

The pin is exact because `pgrx-sql-entity-graph` owns both the `.pgrxsc` decoder
and the SQL emitter, so a generator built against a different version decodes
the section cleanly and then writes different SQL. `pgrx-tests` and
`pgrx-pg-config` move with it: they are dev-dependencies, but cargo still
resolves them into the lock, and leaving them at 0.16 makes the pin
unsatisfiable.

References: https://github.com/pgcentralfoundation/pgrx/issues/2280
---
 pgvectorscale/Cargo.toml            | 10 +++-------
 pgvectorscale/src/bin/pgrx_embed.rs |  1 -
 2 files changed, 3 insertions(+), 8 deletions(-)
 delete mode 100644 pgvectorscale/src/bin/pgrx_embed.rs

diff --git a/pgvectorscale/Cargo.toml b/pgvectorscale/Cargo.toml
index fd57cb2..d1c7f49 100644
--- a/pgvectorscale/Cargo.toml
+++ b/pgvectorscale/Cargo.toml
@@ -6,10 +6,6 @@ edition = "2021"
 [lib]
 crate-type = ["cdylib", "rlib"]
 
-[[bin]]
-name = "pgrx_embed_vectorscale"
-path = "./src/bin/pgrx_embed.rs"
-
 [features]
 default = ["pg18", "build_parallel"]
 pg14 = ["pgrx/pg14", "pgrx-tests/pg14"]
@@ -28,7 +24,7 @@ unexpected_cfgs = { level = "allow", check-cfg = [
 
 [dependencies]
 memoffset = "0.9.0"
-pgrx = "=0.16.1"
+pgrx = "=0.18.1"
 rkyv = { version = "0.7.43", features = ["validation"] }
 simdeez = { version = "1.0.8" }
 rand = { version = "0.8", features = ["small_rng"] }
@@ -39,8 +35,8 @@ once_cell = "1.20.1"
 lru = "0.14.0"
 
 [dev-dependencies]
-pgrx-tests = "=0.16.1"
-pgrx-pg-config = "=0.16.1"
+pgrx-tests = "=0.18.1"
+pgrx-pg-config = "=0.18.1"
 criterion = "0.5.1"
 tempfile = "3.15.0"
 
diff --git a/pgvectorscale/src/bin/pgrx_embed.rs b/pgvectorscale/src/bin/pgrx_embed.rs
deleted file mode 100644
index 5f5c4d8..0000000
--- a/pgvectorscale/src/bin/pgrx_embed.rs
+++ /dev/null
@@ -1 +0,0 @@
-::pgrx::pgrx_embed!();
