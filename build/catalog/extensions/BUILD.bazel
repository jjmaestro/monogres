load("@babelfish//:introspect.bzl", BABELFISH_INTROSPECTIONS = "INTROSPECTIONS")
load("@ivory//:introspect.bzl", IVORY_INTROSPECTIONS = "INTROSPECTIONS")
load("@openhalo//:introspect.bzl", OPENHALO_INTROSPECTIONS = "INTROSPECTIONS")
load("@pg//:introspect.bzl", PG_INTROSPECTIONS = "INTROSPECTIONS")
load("@pg_ext//:introspect.bzl", EXT_TEST_INTROSPECTIONS = "TEST_INTROSPECTIONS")
load("//tools:gen_contrib.bzl", "gen_contrib", "update_contrib")
load("//tools:gen_ext_introspect.bzl", "ext_introspect")
load("//tools:gen_index.bzl", "gen_index", "update_index")

package(default_visibility = ["//visibility:public"])

exports_files(
    ["index.json"] + glob([
        "**/repo.json",
        "*/introspect/*.json",
    ]) + glob(
        [
            # A pgrx extension's committed `Cargo.lock`, per version: read at
            # module-extension time to declare the crate pool, and staged as a
            # build input so `--locked` holds the build to the same lock.
            "*/cargo/*/Cargo.lock",
        ],
        # Its own glob, because this one is empty in a catalog that carries no
        # pgrx extension, and the workspace disallows an empty glob by default.
        allow_empty = True,
    ),
)

_EXT_REPO_JSONS = glob(["*/repo.json"])

_CONTRIB_REPO_JSONS = glob(["contrib/*/repo.json"])

gen_contrib(
    name = "gen_contrib",
    introspections = [
        BABELFISH_INTROSPECTIONS,
        IVORY_INTROSPECTIONS,
        OPENHALO_INTROSPECTIONS,
        PG_INTROSPECTIONS,
    ],
)

update_contrib(
    name = "update_contrib",
    srcs = [":gen_contrib"],
    dest = "catalog/extensions/contrib",
)

gen_index(
    name = "gen_index",
    out = "gen_index.json",
    contrib = _CONTRIB_REPO_JSONS,
    extensions = _EXT_REPO_JSONS,
)

update_index(
    name = "update_index",
    src = ":gen_index",
    dest = "catalog/extensions/index.json",
)

ext_introspect(
    name = "update_ext_introspect",
    check_name = "check_ext_introspect",
    entries = EXT_TEST_INTROSPECTIONS,
)
