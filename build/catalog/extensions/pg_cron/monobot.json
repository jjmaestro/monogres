{
  "version": 1,
  "name": "pg_cron",
  "url": "https://github.com/citusdata/pg_cron",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "citusdata",
      "name": "pg_cron",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["1.6.7"]
  },
  "metadata": {
    "patches": [
      {
        "label": "//catalog/extensions/pg_cron/patches:0001-1.6-hermetic-clang-c99-strict-ansi.patch",
        "spec": ">=1.6.7/*"
      }
    ],
    "compatible_with": {
      "postgres": {
        "1.6.7": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "preload": ["pg_cron"]
      }
    }
  }
}
