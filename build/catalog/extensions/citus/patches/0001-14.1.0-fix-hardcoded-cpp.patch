From 68f4cc3f02a32b46142b46acd43a19bbba3a9448 Mon Sep 17 00:00:00 2001
From: Javier Maestro <jjmaestro@ieee.org>
Date: Fri, 24 Jul 2026 05:44:07 +0000
Subject: [PATCH] patch: preprocess the generated SQL with $(CPP)

`src/backend/{columnar,distributed}/Makefile` build the concatenated SQL
migration files by piping them through the preprocessor, spelled as the
literal command `cpp`. That name is a GNU convention: it exists as a separate
binary in a gcc installation, and need not exist at all elsewhere. A clang
toolchain ships the preprocessor inside the compiler driver, so on a host with
clang and no gcc the recipe dies with `cpp: command not found`, and on a host
with both it silently preprocesses with a compiler that is not the one the
extension is being compiled with.

PGXS already exports `CPP`, the preprocessor PostgreSQL's own configure
resolved, so use it. Two flags come with the switch, because `$(CPP)` is
routinely a compiler driver rather than a dedicated preprocessor: `-E` to stop
after preprocessing, and `-x c` because the inputs are `.sql` files and a
driver infers the language from the suffix. Both are accepted by a real `cpp`
too, so the recipe works either way.

`src/test/regress/Makefile` preprocesses its own generated SQL the same way and
changes with them.
---
 src/backend/columnar/Makefile    | 4 ++--
 src/backend/distributed/Makefile | 4 ++--
 src/test/regress/Makefile        | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/backend/columnar/Makefile b/src/backend/columnar/Makefile
index ded52a98d..5771a4689 100644
--- a/src/backend/columnar/Makefile
+++ b/src/backend/columnar/Makefile
@@ -31,7 +31,7 @@ $(generated_sql_files): $(citus_abs_srcdir)/build/%: %
 	@# -P is used to inhibit generation of linemarkers in the output from the preprocessor.
 	@# -undef is used to not predefine any system-specific or GCC-specific macros.
 	@# `man cpp` for further information
-	cd $(citus_abs_srcdir) && cpp -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
+	cd $(citus_abs_srcdir) && $(CPP) -x c -E -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
 
 $(generated_downgrade_sql_files): $(citus_abs_srcdir)/build/sql/%: sql/downgrades/%
 	@mkdir -p $(citus_abs_srcdir)/$(SQL_DEPDIR) $(citus_abs_srcdir)/$(SQL_BUILDDIR)
@@ -40,7 +40,7 @@ $(generated_downgrade_sql_files): $(citus_abs_srcdir)/build/sql/%: sql/downgrade
 	@# -P is used to inhibit generation of linemarkers in the output from the preprocessor.
 	@# -undef is used to not predefine any system-specific or GCC-specific macros.
 	@# `man cpp` for further information
-	cd $(citus_abs_srcdir) && cpp -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
+	cd $(citus_abs_srcdir) && $(CPP) -x c -E -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
 
 .PHONY: install install-downgrades install-all
 
diff --git a/src/backend/distributed/Makefile b/src/backend/distributed/Makefile
index e0e23dc25..0052ef797 100644
--- a/src/backend/distributed/Makefile
+++ b/src/backend/distributed/Makefile
@@ -68,7 +68,7 @@ $(generated_sql_files): $(citus_abs_srcdir)/build/%: %
 	@# -P is used to inhibit generation of linemarkers in the output from the preprocessor.
 	@# -undef is used to not predefine any system-specific or GCC-specific macros.
 	@# `man cpp` for further information
-	cd $(citus_abs_srcdir) && cpp -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
+	cd $(citus_abs_srcdir) && $(CPP) -x c -E -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
 
 $(generated_downgrade_sql_files): $(citus_abs_srcdir)/build/sql/%: sql/downgrades/%
 	@mkdir -p $(citus_abs_srcdir)/$(SQL_DEPDIR) $(citus_abs_srcdir)/$(SQL_BUILDDIR)
@@ -77,7 +77,7 @@ $(generated_downgrade_sql_files): $(citus_abs_srcdir)/build/sql/%: sql/downgrade
 	@# -P is used to inhibit generation of linemarkers in the output from the preprocessor.
 	@# -undef is used to not predefine any system-specific or GCC-specific macros.
 	@# `man cpp` for further information
-	cd $(citus_abs_srcdir) && cpp -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
+	cd $(citus_abs_srcdir) && $(CPP) -x c -E -undef -w -P -MMD -MP -MF$(SQL_DEPDIR)/$(*F).Po -MT$@ $< > $@
 
 SQL_Po_files := $(wildcard $(SQL_DEPDIR)/*.Po)
 ifneq (,$(SQL_Po_files))
diff --git a/src/test/regress/Makefile b/src/test/regress/Makefile
index fc865ef4e..8a2ae23f0 100644
--- a/src/test/regress/Makefile
+++ b/src/test/regress/Makefile
@@ -91,7 +91,7 @@ $(generated_isolation_files): $(citus_abs_srcdir)/build/specs/%: $(citus_abs_src
 	@# -undef is used to not predefine any system-specific or GCC-specific macros.
 	@# `man cpp` for further information
 	@# sed is used to strip the final // comments, because OSX cpp is weird
-	cd $(citus_abs_srcdir) && cpp -undef -w -P -MMD -MP -MF$(ISOLATION_DEPDIR)/$(*F).Po -MT$@ $< | sed '/^\/\//d' | sed '/^$$/d' > $@
+	cd $(citus_abs_srcdir) && $(CPP) -x c -E -undef -w -P -MMD -MP -MF$(ISOLATION_DEPDIR)/$(*F).Po -MT$@ $< | sed '/^\/\//d' | sed '/^$$/d' > $@
 
 
 Isolation_Po_files := $(wildcard $(ISOLATION_DEPDIR)/*.Po)
