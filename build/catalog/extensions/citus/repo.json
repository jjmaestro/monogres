{
  "version": 1,
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "citusdata",
      "name": "citus",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/citusdata/citus/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "13.2.0": {
      "sha256": "82cc117bb1000da9eeea1499ee9a8f2706feccc19e2c5ca623274793d98a217a"
    }
  },
  "metadata": {
    "patches": [
      {
        "label": "//catalog/extensions/citus/patches:0001-13.2.0-fix-hardcoded-cpp.patch",
        "spec": ">=13.2.0/*"
      },
      {
        "label": "//catalog/extensions/citus/patches:0002-13.2.0-cross-compile-skip-pg_config-probe.patch",
        "spec": ">=13.2.0/*"
      }
    ],
    "compatible_with": {
      "postgres": {
        "13.2.0": "<=17"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["citus"],
        "preload": ["citus"],
        "cascade": true
      },
      "test": {
        "*": {
          "fullsuite": {
            "kind": "manual",
            "note": "citus pg_regress_multi.pl + mitmproxy; non-hermetic, run by hand"
          }
        }
      }
    },
    "deps": {
      "buildtime": {
        "debian": {
          "12": {
            "*": [
              "libcurl4-openssl-dev",
              "liblz4-dev",
              "libssl-dev",
              "libzstd-dev"
            ]
          },
          "13": {
            "*": [
              "libcurl4-openssl-dev",
              "liblz4-dev",
              "libssl-dev",
              "libzstd-dev"
            ]
          }
        }
      },
      "runtime": {
        "debian": {
          "12": {
            "*": [
              "libcurl4",
              "liblz4-1",
              "libssl3",
              "libzstd1"
            ]
          },
          "13": {
            "*": [
              "libcurl4",
              "liblz4-1",
              "libssl3",
              "libzstd1"
            ]
          }
        }
      }
    }
  }
}
