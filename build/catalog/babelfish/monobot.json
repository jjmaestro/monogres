{
  "version": 1,
  "name": "babelfish",
  "url": "https://github.com/babelfish-for-postgresql/postgresql_modified_for_babelfish",
  "sources": {
    "gh": {
      "owner": "babelfish-for-postgresql",
      "repo": "postgresql_modified_for_babelfish",
      "filename": "{tag}",
      "url": "https://github.com/{owner}/{repo}/archive/refs/tags/{filename}.tar.gz",
      "strip_prefix": "{repo}-{tag}"
    }
  },
  "versions": {
    "pin": {
      "4.0": {
        "tag": "BABEL_4_0_0__PG_16_1"
      },
      "5.1": {
        "tag": "BABEL_5_1_0__PG_17_4"
      }
    }
  },
  "metadata": {
    "flavor": "babelfish",
    "patches": [
      {
        "label": "//catalog/babelfish/patches:0003-4.0-fix-jit-llvmjit_inline-stringref-starts-with.patch",
        "spec": "<5.0/*"
      }
    ],
    "test_overrides": {
      "unaccent": {
        "encoding": "UTF8"
      },
      "pgrowlocks": {
        "load_extension": ["pgrowlocks"]
      },
      "tcn": {
        "load_extension": ["tcn"]
      },
      "pltcl": {
        "load_extension": ["pltcl"]
      },
      "hstore_plpython": {
        "load_extension": ["hstore"]
      },
      "ltree_plpython": {
        "load_extension": ["ltree"]
      },
      "postgres_fdw": {
        "isolation": {
          "load_extension": ["postgres_fdw"]
        }
      },
      "sepgsql": {
        "exclude": "SELinux shell harness; impractical in the hermetic sandbox"
      },
      "babelfishpg_money": {
        "exclude": "tests live in the separate babelfish_extensions repo (contrib/babelfishpg_money/test/), merged into contrib/ only inside the build action; not present in @babelfish//<v>/src:dir, so out of single-source-tree harness scope"
      },
      "babelfishpg_tsql": {
        "exclude": "tests live in babelfish_extensions (contrib/babelfishpg_tsql), build-action-merged only; also needs shared_preload_libraries='babelfishpg_tds, pg_stat_statements' + a Babelfish-initialized cluster"
      }
    },
    "test": {
      "*": {
        "babelfishpg_money": {
          "kind": "regress",
          "tests": ["aggregate", "cast", "comparison", "overflow", "index"]
        }
      }
    },
    "introspect": {
      "4.0": {
        "barebones": "//catalog/babelfish/introspect:babelfish~4.0~barebones.json",
        "minimal": "//catalog/babelfish/introspect:babelfish~4.0~minimal.json",
        "regular": "//catalog/babelfish/introspect:babelfish~4.0~regular.json",
        "full": "//catalog/babelfish/introspect:babelfish~4.0~full.json"
      },
      "5.1": {
        "barebones": "//catalog/babelfish/introspect:babelfish~5.1~barebones.json",
        "minimal": "//catalog/babelfish/introspect:babelfish~5.1~minimal.json",
        "regular": "//catalog/babelfish/introspect:babelfish~5.1~regular.json",
        "full": "//catalog/babelfish/introspect:babelfish~5.1~full.json"
      }
    },
    "extra_sources": {
      "ext": {
        "index": "//catalog/babelfish:ext.json",
        "contrib_dir": "contrib"
      }
    },
