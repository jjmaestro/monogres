load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "extract_deps.bzl",
    "monobot.json",
    "repo.json",
] + glob(
    ["metadata/*/*.json"],
    # Empty: a flavor's archives ship no .control, so no version has metadata
    # written beside it, and the workspace disallows an empty glob by default.
    allow_empty = True,
))

bzl_library(
    name = "extract_deps",
    srcs = ["extract_deps.bzl"],
    deps = [
        "@version_utils//spec",
        "@version_utils//version",
    ],
)
