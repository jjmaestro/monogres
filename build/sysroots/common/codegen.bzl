"""
`BUILD.bazel` codegen for the `//sysroots` hub repository.

Pure render-helpers: given a few parameters, return the rendered text of each
generated file. The hub repo `@<name>` is an external repo created by the
`//sysroots` module extension at evaluation time, so its `BUILD.bazel` files
have to be produced at repo-rule time.

`starlark_utils` gives a typed builder API that beats string templates and
shares its rendering rules with the rest of the repo (see
`@starlark_utils//docs:CODEGEN_GUIDE.md`).

The package-manager-specific bits (e.g. the `clang_wrapper` for `apt` consumers)
live next to that package manager's repo rule, not here.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load(":archs.bzl", "ARCH_CPU")

_HEADER = "Generated by //sysroots. DO NOT EDIT."

# ---------------------------------------------------------------------------
# Per-arch package inside the hub (`@<name>//<distro>/<version>/<arch>`)
# ---------------------------------------------------------------------------

SYSROOT_TAR_FILENAME = "sysroot.tar"

def sysroot_build(extra_files_paths = [], extra_exports = []):
    """Render `@<name>/<distro>/<version>/<arch>/BUILD.bazel`.

    Exposes the extracted sysroot tree two ways:

      * `:sysroot` filegroup: `glob(["**"])` over the on-disk tree. Used by
        `toolchains_llvm`'s `--sysroot=` consumer (which records the label's
        package path verbatim and pulls every file into action inputs via
        `DefaultInfo`). The repo rule prunes Bazel-unrepresentable basenames
        (e.g. `Dpkg::Arch.3perl.gz`) from the on-disk tree before the filegroup
        is materialized.
      * `:sysroot.tar`: single-file artifact (`exports_files`) capturing the
        complete normalized tree, including the files dropped from the
        filegroup. Used by buildtime consumers (e.g. `pg_build` / `pgxs_build`)
        that extract at action time, where the tar's opacity to Bazel sidesteps
        the filename-restriction issue entirely.

    Tier-2 `extra_files` paths are additionally `exports_files`-ed so consumers
    can take a label-typed dep on each individual injected file (e.g. for
    `$(execpath ...)` resolution in genrule-like contexts). The `extra_exports`
    list does the same for paths that already exist in the extracted tree
    (typically tool binaries like `usr/bin/perl`), making them addressable as
    single-file labels without an injection step.

    Args:
        extra_files_paths: List of in-sysroot paths (each with `{arch}` already
            substituted) that should also be exposed as single-file labels via
            `exports_files`. Empty when the tag has no `extra_files`.
        extra_exports: List of in-sysroot paths already present in the extracted
            tree to additionally `exports_files`-expose. Lets consumers address
            specific files (e.g. tool binaries) by label, analogously to
            `@bison//bin:bison` for built-from-source tools.

    Returns:
        The composed `BUILD.bazel` content as a string.
    """
    pkg = Star.package(default_visibility = ["//visibility:public"])
    filegroup = Star.fn(
        "filegroup",
        name = "sysroot",
        srcs = Star.glob(
            ["**"],
            exclude = ["BUILD.bazel", SYSROOT_TAR_FILENAME],
            allow_empty = False,
        ),
    )
    exports = Star.exports_files(
        sorted(
            [SYSROOT_TAR_FILENAME] + list(
                extra_files_paths,
            ) + list(extra_exports),
        ),
    )
    return Star.file(pkg, filegroup, exports, header = _HEADER)

# ---------------------------------------------------------------------------
# Hub repo wrappers (`@<name>/...`)
# ---------------------------------------------------------------------------

def hub_root_build():
    """Render `@<name>/BUILD.bazel` (just the package declaration)."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
    )

def distro_root_build():
    """Render `@<name>/<distro>/BUILD.bazel` (just the package declaration)."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
    )

def version_root_build(distro_version = "", archs = ()):
    """Render `@<name>/<distro>/<version>/BUILD.bazel`.

    The package declaration plus arch-selecting `:sysroot` and `:sysroot_tar`
    aliases over the per-arch subpackages
    (`@<name>//<distro>/<version>/<arch>:sysroot[._tar]`). Consumers get a
    single label whose select() resolves at analysis time:

        # arch chosen by @platforms//cpu at analysis time cc_library(deps =
        ["@libc_sysroot//debian/12:sysroot"], ...)

    Callers that want the per-arch label explicitly can still reach the
    underlying targets directly (`@<name>//debian/12/amd64:sysroot`).

    Args:
        distro_version: Path component for this version (e.g. `debian/12`). Used
            to construct the absolute labels inside the alias `select()`s.
        archs: Tuple/list of arch names (e.g. `("amd64", "arm64")`) materialized
            under this version. Empty omits the aliases (degenerate version dirs
            with no archs).

    Returns:
        The composed `BUILD.bazel` content as a string.
    """
    pkg = Star.package(default_visibility = ["//visibility:public"])

    if not archs:
        return Star.file(pkg, header = _HEADER)

    alias_nodes = [
        Star.alias(
            name = alias_name,
            actual = Star.select({
                "@platforms//cpu:%s" % ARCH_CPU[arch]: "//%s/%s:%s" % (distro_version, arch, target)
                for arch in archs
            }),
        )
        for alias_name, target in (("sysroot", "sysroot"), ("sysroot_tar", "sysroot.tar"))
    ]

    return Star.file(
        pkg,
        header = _HEADER,
        *alias_nodes
    )

def lock_build(lock_filename):
    """Render `@<name>/<distro>/<version>/lock/BUILD.bazel`.

    Holds the `:update` `sh_binary` that copies the lockfile back into the
    workspace at `lock_path` (see `update_script`).

    Args:
        lock_filename: Lockfile basename (e.g. `debian.lock`); lives in the same
            `lock/` package as the generated `BUILD.bazel`.
    """
    return Star.file(
        Star.fn(
            "sh_binary",
            name = "update",
            srcs = ["update.sh"],
            args = ["$(location :%s)" % lock_filename],
            data = [":%s" % lock_filename],
            visibility = ["//visibility:public"],
        ),
        header = _HEADER,
    )

_UPDATE_SCRIPT_TEMPLATE = """\
#!/usr/bin/env bash
set -euo pipefail
dest="${{BUILD_WORKSPACE_DIRECTORY}}/{lock_path}"
mkdir -p "$(dirname "$dest")"
cp --no-preserve=mode "$1" "$dest"
echo "Lockfile updated: {lock_path}"
"""

def update_script(lock_path):
    """Render `@<name>/<distro>/<version>/lock/update.sh`.

    The script copies its first argument (the lockfile artifact built by Bazel)
    back into the workspace at `lock_path`, used by `bazel run
    @<name>//<distro>/<version>/lock:update`.

    Args:
        lock_path: Workspace-relative path where the lockfile lives in the
            source tree (e.g. `sysroots/apt/locks/llvm_sysroot.lock`).
    """
    return _UPDATE_SCRIPT_TEMPLATE.format(lock_path = lock_path)
