"""
Golden-output tests for `//sysroots/common:codegen.bzl`.

Each codegen helper renders a small, deterministic `BUILD.bazel` (or shell
script) fragment; assert the exact string output so any drift in either the
helper or the underlying `starlark_utils` API is caught here.
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
load(
    "//common:codegen.bzl",
    "distro_root_build",
    "hub_root_build",
    "lock_build",
    "sysroot_build",
    "update_script",
    "version_root_build",
)
load("//tests:suite.bzl", _test_suite = "test_suite")

_EXPECTED_SYSROOT_BUILD = '''\
"""Generated by //sysroots. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sysroot",
    srcs = glob(
        [
            "**",
        ],
        exclude = [
            "BUILD.bazel",
            "sysroot.tar",
        ],
        allow_empty = False,
    ),
)

exports_files(["sysroot.tar"])
'''

_EXPECTED_HUB_ROOT_BUILD = '''\
"""Generated by //sysroots. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])
'''

_EXPECTED_DISTRO_ROOT_BUILD = _EXPECTED_HUB_ROOT_BUILD

_EXPECTED_VERSION_ROOT_BUILD_NO_ARCHS = _EXPECTED_HUB_ROOT_BUILD

_EXPECTED_VERSION_ROOT_BUILD = '''\
"""Generated by //sysroots. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

alias(
    name = "sysroot",
    actual = select({
        "@platforms//cpu:x86_64": "//debian/12/amd64:sysroot",
        "@platforms//cpu:aarch64": "//debian/12/arm64:sysroot",
    }),
)

alias(
    name = "sysroot_tar",
    actual = select({
        "@platforms//cpu:x86_64": "//debian/12/amd64:sysroot.tar",
        "@platforms//cpu:aarch64": "//debian/12/arm64:sysroot.tar",
    }),
)
'''

_EXPECTED_LOCK_BUILD = '''\
"""Generated by //sysroots. DO NOT EDIT."""

sh_binary(
    name = "update",
    srcs = [
        "update.sh",
    ],
    args = [
        "$(location :debian.lock)",
    ],
    data = [
        ":debian.lock",
    ],
    visibility = [
        "//visibility:public",
    ],
)
'''

_EXPECTED_UPDATE_SCRIPT = """\
#!/usr/bin/env bash
set -euo pipefail
dest="${BUILD_WORKSPACE_DIRECTORY}/sysroots/apt/locks/llvm_sysroot.lock"
mkdir -p "$(dirname "$dest")"
cp --no-preserve=mode "$1" "$dest"
echo "Lockfile updated: sysroots/apt/locks/llvm_sysroot.lock"
"""

def _sysroot_build_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, _EXPECTED_SYSROOT_BUILD, sysroot_build())
    return unittest.end(env)

sysroot_build_test = unittest.make(_sysroot_build_test_impl)

_EXPECTED_SYSROOT_BUILD_WITH_EXTRAS = '''\
"""Generated by //sysroots. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sysroot",
    srcs = glob(
        [
            "**",
        ],
        exclude = [
            "BUILD.bazel",
            "sysroot.tar",
        ],
        allow_empty = False,
    ),
)

exports_files([
    "etc/some_extra.cfg",
    "sysroot.tar",
    "usr/lib/llvm-14/bin/clang",
])
'''

def _sysroot_build_with_extras_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        _EXPECTED_SYSROOT_BUILD_WITH_EXTRAS,
        sysroot_build(extra_files_paths = [
            "usr/lib/llvm-14/bin/clang",
            "etc/some_extra.cfg",
        ]),
    )
    return unittest.end(env)

sysroot_build_with_extras_test = unittest.make(
    _sysroot_build_with_extras_test_impl,
)

_EXPECTED_SYSROOT_BUILD_WITH_EXPORTS = '''\
"""Generated by //sysroots. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sysroot",
    srcs = glob(
        [
            "**",
        ],
        exclude = [
            "BUILD.bazel",
            "sysroot.tar",
        ],
        allow_empty = False,
    ),
)

exports_files(["sysroot.tar", "usr/bin/perl"])
'''

def _sysroot_build_with_exports_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        _EXPECTED_SYSROOT_BUILD_WITH_EXPORTS,
        sysroot_build(extra_exports = ["usr/bin/perl"]),
    )
    return unittest.end(env)

sysroot_build_with_exports_test = unittest.make(
    _sysroot_build_with_exports_test_impl,
)

_EXPECTED_SYSROOT_BUILD_WITH_EXTRAS_AND_EXPORTS = '''\
"""Generated by //sysroots. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sysroot",
    srcs = glob(
        [
            "**",
        ],
        exclude = [
            "BUILD.bazel",
            "sysroot.tar",
        ],
        allow_empty = False,
    ),
)

exports_files([
    "etc/some_extra.cfg",
    "sysroot.tar",
    "usr/bin/perl",
    "usr/lib/llvm-14/bin/clang",
])
'''

def _sysroot_build_with_extras_and_exports_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        _EXPECTED_SYSROOT_BUILD_WITH_EXTRAS_AND_EXPORTS,
        sysroot_build(
            extra_files_paths = [
                "usr/lib/llvm-14/bin/clang",
                "etc/some_extra.cfg",
            ],
            extra_exports = ["usr/bin/perl"],
        ),
    )
    return unittest.end(env)

sysroot_build_with_extras_and_exports_test = unittest.make(
    _sysroot_build_with_extras_and_exports_test_impl,
)

def _hub_root_build_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, _EXPECTED_HUB_ROOT_BUILD, hub_root_build())
    return unittest.end(env)

hub_root_build_test = unittest.make(_hub_root_build_test_impl)

def _distro_root_build_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, _EXPECTED_DISTRO_ROOT_BUILD, distro_root_build())
    return unittest.end(env)

distro_root_build_test = unittest.make(_distro_root_build_test_impl)

def _version_root_build_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        _EXPECTED_VERSION_ROOT_BUILD,
        version_root_build(
            distro_version = "debian/12",
            archs = ("amd64", "arm64"),
        ),
    )
    return unittest.end(env)

version_root_build_test = unittest.make(_version_root_build_test_impl)

def _version_root_build_no_archs_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        _EXPECTED_VERSION_ROOT_BUILD_NO_ARCHS,
        version_root_build(),
    )
    return unittest.end(env)

version_root_build_no_archs_test = unittest.make(
    _version_root_build_no_archs_test_impl,
)

def _lock_build_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, _EXPECTED_LOCK_BUILD, lock_build("debian.lock"))
    return unittest.end(env)

lock_build_test = unittest.make(_lock_build_test_impl)

def _update_script_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        _EXPECTED_UPDATE_SCRIPT,
        update_script("sysroots/apt/locks/llvm_sysroot.lock"),
    )
    return unittest.end(env)

update_script_test = unittest.make(_update_script_test_impl)

TEST_SUITE_NAME = "codegen"

TEST_SUITE_TESTS = dict(
    distro_root_build = distro_root_build_test,
    hub_root_build = hub_root_build_test,
    lock_build = lock_build_test,
    sysroot_build = sysroot_build_test,
    sysroot_build_with_exports = sysroot_build_with_exports_test,
    sysroot_build_with_extras = sysroot_build_with_extras_test,
    sysroot_build_with_extras_and_exports = sysroot_build_with_extras_and_exports_test,
    update_script = update_script_test,
    version_root_build = version_root_build_test,
    version_root_build_no_archs = version_root_build_no_archs_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
