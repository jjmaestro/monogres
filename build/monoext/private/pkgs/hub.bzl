"""
Repository rule for the `@pkgs` hub repo.

Emits the type-namespaced view of resolved packages (cross-arch + per-arch
aliases). Called from `pkgs.bzl`.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/pkgs. DO NOT EDIT."

def _root_build():
    """Render BUILD.bazel / deb/BUILD.bazel"""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
    )

def _deb_pkg_build(pkg, deb_repo, arch_versions):
    """Render deb/{pkg}/BUILD.bazel"""

    # collect unique versions for cross-arch version aliases and sanitize
    # version strings (Bazel target names can't contain ':' but Debian versions
    # use ':' for epoch, e.g. "1:14.0.6-12").
    versions = sorted({v.replace(":", "_"): None for v in arch_versions}.keys())
    f = bind(repo = deb_repo, pkg = pkg)
    label = f("@{repo}//{pkg}:{pkg}")

    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        # cross-arch alias
        Star.alias(name = pkg, actual = label),
        header = _HEADER,
        # version aliases
        *[Star.alias(name = version, actual = label) for version in versions]
    )

def _deb_pkg_arch_build(pkg, arch, version, deb_repo):
    """Render deb/{pkg}/{arch}/BUILD.bazel"""
    f = bind(repo = deb_repo, pkg = pkg, arch = arch)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        # per-arch alias
        Star.alias(name = arch, actual = f("@{repo}//{pkg}/{arch}:{arch}")),
        # version alias
        Star.alias(
            name = version.replace(":", "_"),
            actual = ":%s" % arch,
        ),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Lock update helpers
# ---------------------------------------------------------------------------

_UPDATE_SCRIPT = """\
#!/usr/bin/env bash
set -euo pipefail
dest="${{BUILD_WORKSPACE_DIRECTORY}}/{lock_path}"
mkdir -p "$(dirname "$dest")"
cp --no-preserve=mode "$1" "$dest"
echo "Lockfile updated: {lock_path}"
"""

def _lock_build(lock_file):
    """Render deb/lock/BUILD.bazel with the update sh_binary."""
    return Star.file(
        Star.fn(
            "sh_binary",
            name = "update",
            srcs = ["update.sh"],
            args = ["$(location %s)" % lock_file],
            data = [lock_file],
            visibility = ["//visibility:public"],
        ),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Repository rule
# ---------------------------------------------------------------------------

def _impl(rctx):
    rctx.file("BUILD.bazel", _root_build())
    rctx.file("deb/BUILD.bazel", _root_build())

    deb_repo = rctx.attr.deb_repo

    for pkg in rctx.attr.deb_packages:
        info_json = rctx.attr.pkg_info.get(pkg)
        arch_versions = json.decode(info_json) if info_json else {}

        # --- deb/{pkg}/BUILD.bazel: cross-arch alias + version aliases ---
        rctx.file(
            "deb/%s/BUILD.bazel" % pkg,
            _deb_pkg_build(pkg, deb_repo, arch_versions.values()),
        )

        # --- deb/{pkg}/{arch}/BUILD.bazel: per-arch alias + version alias ---
        for arch, version in sorted(arch_versions.items()):
            rctx.file(
                "deb/%s/%s/BUILD.bazel" % (pkg, arch),
                _deb_pkg_arch_build(pkg, arch, version, deb_repo),
            )

    # --- deb/lock/: lockfile + update target ---
    if rctx.attr.lock_json:
        lock_file = "%s.lock" % rctx.name
        rctx.file("deb/lock/%s" % lock_file, rctx.attr.lock_json)
        rctx.file(
            "deb/lock/update.sh",
            _UPDATE_SCRIPT.format(lock_path = rctx.attr.lock_path),
            executable = True,
        )
        rctx.file("deb/lock/BUILD.bazel", _lock_build(lock_file))

_ATTRS = dict(
    deb_repo = attr.string(
        doc = "Internal deb_translate_lock repo name.",
    ),
    deb_packages = attr.string_list(
        doc = "Resolved Debian package names for //deb/ aliases.",
    ),
    # NOTE: maybe one day we will have attr.string_dict_dict
    # https://github.com/bazelbuild/bazel/issues/3862
    pkg_info = attr.string_dict(
        doc = "Map of package name to JSON-encoded {arch: version}.",
        default = {},
    ),
    lock_json = attr.string(
        doc = "Serialized lockfile JSON for the update target.",
        default = "",
    ),
    lock_path = attr.string(
        doc = "Workspace-relative output path for the lockfile.",
        default = "",
    ),
)

_pkgs_repo = repository_rule(
    implementation = _impl,
    attrs = _ATTRS,
)

testing = struct(
    _root_build = _root_build,
    _deb_pkg_build = _deb_pkg_build,
    _deb_pkg_arch_build = _deb_pkg_arch_build,
)

def pkgs_repo(
        name,
        deb_repo,
        deb_packages,
        pkg_info = {},
        lock_json = "",
        lock_path = ""):
    """Creates the `@pkgs` hub repo.

    Wraps the repository rule, handling JSON serialization of `pkg_info` so
    callers pass clean data.

    Args:
        name: Hub repo name.
        deb_repo: Internal deb_translate_lock repo name.
        deb_packages: List of resolved Debian package names.
        pkg_info: Dict of `{name: {arch: version}}`.
        lock_json: Serialized lockfile JSON for the update target.
        lock_path: Workspace-relative output path for the lockfile.
    """
    _pkgs_repo(
        name = name,
        deb_repo = deb_repo,
        deb_packages = deb_packages,
        pkg_info = {
            pkg: json.encode(info)
            for pkg, info in pkg_info.items()
        },
        lock_json = lock_json,
        lock_path = lock_path,
    )
