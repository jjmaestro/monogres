load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = [
    "//monoext/private:__pkg__",
    "//monoext/private/base:__pkg__",
    "//tests/monoext:__subpackages__",
])

exports_files([
    "configure_args.bzl",
    "flavors.bzl",
    "helpers.bzl",
    "pg.bzl",
])

bzl_library(
    name = "helpers",
    srcs = ["helpers.bzl"],
    deps = [
        "//monoext/private/base:compat",
    ],
)

bzl_library(
    name = "pg",
    srcs = ["pg.bzl"],
    deps = [
        ":helpers",
        "//monoext/private/base:compat",
    ],
)

bzl_library(
    name = "configure_args",
    srcs = ["configure_args.bzl"],
)

bzl_library(
    name = "flavors",
    srcs = ["flavors.bzl"],
    deps = [
        ":pg",
    ],
)
