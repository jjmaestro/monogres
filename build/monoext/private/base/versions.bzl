"""
Per-version file tree writers for the base hub repo (e.g. `@pg`).

Render helpers for one base version's hierarchy: version root, per-option-set
packages (with `pg_build` — the Postgres build macro is shared across flavors
since current flavors are PG-derived), source aliases, and dependency aliases.
Called from the hub repo rule in `hub.bzl`.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load("//platforms:targets.bzl", "ARCH_CPU")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/base. DO NOT EDIT."

def _pg_build(*args, **kwargs):
    return Star.igen(Star.fn("pg_build", *args, **kwargs))

def _platform_build(*args, **kwargs):
    return Star.igen(Star.fn("platform_build", *args, **kwargs))

def _pg_install_tree(*args, **kwargs):
    return Star.igen(Star.fn("pg_install_tree", *args, **kwargs))

def _filegroup(*args, **kwargs):
    return Star.igen(Star.fn("filegroup", *args, **kwargs))

# Dev-only install paths carved out of the meson runtime `:tar` (and kept in the
# `:tar.dev` SDK): the server / client headers, the PGXS build infrastructure,
# the pkg-config files, and the static archives. `:tar` is then the shippable
# runtime (backend + frontends + loadable modules); `:tar.dev` is the full
# `meson install` an out-of-tree extension or libpq client compiles against.
_MESON_DEV_PATHS = ["include", "lib/pgxs", "lib/pkgconfig", "lib/*.a"]

def _version_root_build(version, default_option_set):
    """Render {version}/BUILD.bazel"""
    f = bind(v = version, opt = default_option_set)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.alias(name = version, actual = f("//{v}/{opt}:{opt}")),
        Star.alias(name = "tar.dev", actual = f("//{v}/{opt}:tar.dev")),
        Star.alias(name = "dir", actual = f("//{v}/src:dir")),
        Star.alias(name = "files", actual = f("//{v}/src:files")),
        Star.alias(name = "toolchain", actual = f("//{v}/{opt}:toolchain")),
        Star.alias(name = "logs", actual = f("//{v}/{opt}:logs")),
        header = _HEADER,
    )

def _option_set_build(build_repo, target, source_repo, version, option_set):
    """Render {version}/{option_set}/BUILD.bazel.

    The production package exposes a runtime / SDK split: `:tar` (the shippable
    runtime: backend, frontends, loadable modules) and `:tar.dev` (the SDK: the
    full `meson install` an out-of-tree extension / libpq client compiles
    against, headers + PGXS + pkg-config + static archives). `:tar.dev` is the
    raw build and `:tar` carves the dev-only paths back out of it.
    """
    f = bind(build = build_repo, src = source_repo, v = version)
    return Star.file(
        Star.load_(
            f("@{build}//monoext/private/base:pg_build.bzl"),
            "pg_build",
        ),
        Star.load_(
            f("@{build}//monoext/private/base:install_tree.bzl"),
            "pg_install_tree",
        ),
        Star.package(default_visibility = ["//visibility:public"]),
        _pg_build(
            name = "tar.dev",
            pg_src = f("@{src}//{v}"),
            build_options = target.build_options,
            auto_features = target.auto_features,
            sysroot_tar = target.deps.buildtime.sysroot_tar,
            exec_sysroot_tar = target.deps.buildtime.exec_sysroot_tar,
        ),
        _filegroup(
            name = "tar.dev.gen_dir",
            srcs = [":tar.dev"],
            output_group = "gen_dir",
        ),
        _pg_install_tree(
            name = "tar",
            base = ":tar.dev.gen_dir",
            exclude = _MESON_DEV_PATHS,
        ),
        Star.alias(name = option_set, actual = ":tar"),
        header = _HEADER,
    )

def _arch_build(build_repo, actual, platform):
    """Render {version}/{option_set}/{arch}/BUILD.bazel: transition wrapper."""
    f = bind(build = build_repo)
    return Star.file(
        Star.load_(
            f("@{build}//platforms:platform_build.bzl"),
            "platform_build",
        ),
        Star.package(default_visibility = ["//visibility:public"]),
        _platform_build(
            name = "tar",
            actual = actual,
            platform = platform,
        ),
        header = _HEADER,
    )

def _src_build(source_repo, version):
    """Render {version}/src/BUILD.bazel"""
    f = bind(src = source_repo, v = version)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.alias(name = "dir", actual = f("@{src}//{v}:dir")),
        Star.alias(name = "files", actual = f("@{src}//{v}:files")),
        header = _HEADER,
    )

def _sysroot_select(labels_by_arch):
    """Build a `Star.select` node keyed by `@platforms//cpu:*` constraints.

    Args:
        labels_by_arch: `{arch_name: label_str}` from
            `DepsInfo.sysroot_labels_by_arch`.

    Returns:
        A `Star.select` node for use as an `alias(actual = ...)` value.
    """
    return Star.select({
        "@platforms//cpu:%s" % ARCH_CPU[arch]: label
        for arch, label in labels_by_arch.items()
    })

def _exec_files(*args, **kwargs):
    return Star.igen(Star.fn("exec_files", *args, **kwargs))

def _deps_kind_build(aliases, exec_files_targets = None):
    """Render {version}/deps/{kind}/BUILD.bazel.

    Args:
        aliases: `{name: actual_node}` mapping; each entry becomes an
            `alias(name = name, actual = actual_node)` in the rendered file.
        exec_files_targets: Optional `{name: target_label}` mapping; each entry
            becomes an `exec_files(name = name, target = target_label)` rule
            call (surfaces the EXEC-config resolution of an arch-selecting
            label). When non-empty, a
            `load("@sysroots//toolchains:sysroot_dir.bzl", "exec_files")`
            statement is emitted at the top of the file.
    """
    body = [Star.alias(name, actual) for name, actual in aliases.items()]
    head = [Star.package(default_visibility = ["//visibility:public"])]

    if exec_files_targets:
        head = [
            Star.load_("@sysroots//toolchains:sysroot_dir.bzl", "exec_files"),
        ] + head
        body.extend([
            _exec_files(name = name, target = target)
            for name, target in exec_files_targets.items()
        ])

    items = head + body
    return Star.file(header = _HEADER, *items)

# ---------------------------------------------------------------------------
# Writers
# ---------------------------------------------------------------------------

def write_base_version(rctx, version, entry, build_repo, option_sets, archs):
    """Generates the full directory hierarchy for one base version.

    Args:
        rctx: Repository context.
        version: Base version string (e.g. "18.1").
        entry: `BaseEntry` struct with targets, source_repo, versions_deps.
        build_repo: Name of the build repo (e.g. "monogres").
        option_sets: Ordered list of option set names.
        archs: List of architecture names for per-arch targets.
    """
    source_repo = entry.source_repo
    targets = entry.targets
    versions_deps = entry.versions_deps

    # --- {version}/BUILD.bazel: version root ---
    rctx.file(
        "%s/BUILD.bazel" % version,
        _version_root_build(version, option_sets[-1]),
    )

    # --- {version}/{option_set}/BUILD.bazel: pg_build + alias ---
    for target in targets:
        option_set = target.option_set
        rctx.file(
            "%s/%s/BUILD.bazel" % (version, option_set),
            _option_set_build(
                build_repo,
                target,
                source_repo,
                version,
                option_set,
            ),
        )

        # --- {version}/{option_set}/{arch}/BUILD.bazel ---
        for arch in archs:
            f = bind(
                v = version,
                opt = option_set,
                build = build_repo,
                arch = arch,
            )
            rctx.file(
                "%s/%s/%s/BUILD.bazel" % (version, option_set, arch),
                _arch_build(
                    build_repo,
                    actual = f("//{v}/{opt}:tar"),
                    platform = f("@{build}//platforms:linux_{arch}"),
                ),
            )

    # --- {version}/src/BUILD.bazel ---
    rctx.file(
        "%s/src/BUILD.bazel" % version,
        _src_build(source_repo, version),
    )

    # --- {version}/deps/ hierarchy ---
    for kind in _PkgsSchema.KINDS:
        deps_info = getattr(versions_deps, kind)
        if not deps_info:
            continue

        # --- {version}/deps/{kind}/BUILD.bazel: sysroot + sysroot_tar ---
        # `exec_sysroot_tar` mirrors `sysroot_tar` resolved in EXEC config (`cfg
        # = "exec"` on `exec_files.target`), so the inner arch select() picks
        # the host arch's tar regardless of `--platforms`. Consumers (pg_build,
        # pgxs_build) `srcs`-dep both for cross-builds: TARGET tar carries
        # libs/headers/target-arch tools, EXEC tar carries build-machine tools
        # (msgfmt, etc.) that meson's `find_program(..., native: true)` invokes
        # during configure.
        aliases = {
            "sysroot": _sysroot_select(deps_info.sysroot_labels_by_arch),
            "sysroot_tar": _sysroot_select(
                deps_info.sysroot_tar_labels_by_arch,
            ),
        }
        exec_files_targets = {"exec_sysroot_tar": ":sysroot_tar"} if kind == "buildtime" else None
        rctx.file(
            "%s/deps/%s/BUILD.bazel" % (version, kind),
            _deps_kind_build(aliases, exec_files_targets = exec_files_targets),
        )

        # --- {version}/deps/{kind}/pkgs/BUILD.bazel: per-package ---
        pkg_aliases = dict(zip(deps_info.packages, deps_info.pkgs_labels))

        if pkg_aliases:
            rctx.file(
                "%s/deps/%s/pkgs/BUILD.bazel" % (version, kind),
                _deps_kind_build(pkg_aliases),
            )

testing = struct(
    _version_root_build = _version_root_build,
    _option_set_build = _option_set_build,
    _arch_build = _arch_build,
    _src_build = _src_build,
    _deps_kind_build = _deps_kind_build,
)
