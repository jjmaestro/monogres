"""
Repository rule for the base hub repo (e.g. `@pg`).

Delegates per-version file tree generation to `versions.bzl` writers, emits the
top-level `all.bzl` with a fully baked-in CFG struct, and generates introspect
data (Layer 1: paths from checked-in JSONs, plus Layer 2 load-forwarding stubs
to per-version lazy repos).
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private/base:introspect.bzl", "write_introspect")
load("//monoext/private/base:schema.bzl", _BaseSchema = "schema")
load("//monoext/private/base:versions.bzl", "write_base_version")
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/base. DO NOT EDIT."

def _root_build():
    """Render root BUILD.bazel."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["all.bzl", "introspect.bzl"]),
        header = _HEADER,
    )

def _root_all_bzl(entries, option_sets, default_version, archs, flavor):
    """Render all.bzl with a baked-in CFG struct and module metadata."""
    all_targets = []
    all_sources = []
    default_target_idx = None
    default_source_idx = None

    for version in sorted(entries):
        entry = entries[version]
        if entry.source:
            if version == default_version:
                default_source_idx = len(all_sources)
            all_sources.append(entry.source)

        for target in entry.targets:
            if (
                target.version == default_version and
                target.option_set == option_sets[-1]
            ):
                default_target_idx = len(all_targets)
            all_targets.append(target)

    default_target_expr = (
        "_TARGETS[%d]" % default_target_idx if default_target_idx != None else "None"
    )
    default_source_expr = (
        "_SOURCES[%d]" % default_source_idx if default_source_idx != None else "None"
    )

    return Star.file(
        Star.gen(Star.block(
            Star.assign("ARCHS", list(archs)),
            Star.assign("DEFAULT_VERSION", default_version),
            Star.assign("KINDS", list(_PkgsSchema.KINDS)),
            Star.assign("OPTION_SETS", list(option_sets)),
            Star.assign("VERSIONS", sorted(entries.keys())),
            Star.assign("_SOURCES", Star.ref(Star.igen(all_sources))),
            Star.assign("_TARGETS", Star.ref(Star.igen(all_targets))),
            Star.assign("CFG", Star.ref(Star.igen(struct(
                name = flavor,
                default = Star.ref(default_target_expr),
                default_source = Star.ref(default_source_expr),
                sources = Star.ref("_SOURCES"),
                targets = Star.ref("_TARGETS"),
            )))),
        )),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Repository rule
# ---------------------------------------------------------------------------

def _impl(rctx):
    entries = {}
    option_sets = json.decode(rctx.attr.option_sets)
    archs = rctx.attr.archs

    for version in sorted(rctx.attr.entries):
        entry = _BaseSchema.BaseEntry.decode(rctx.attr.entries[version])
        entries[version] = entry
        write_base_version(
            rctx,
            version,
            entry,
            rctx.attr.build_repo,
            option_sets,
            archs,
        )

    rctx.file("BUILD.bazel", _root_build())
    rctx.file("all.bzl", _root_all_bzl(
        entries,
        option_sets,
        rctx.attr.default_version,
        archs,
        rctx.attr.flavor,
    ))

    write_introspect(rctx)

_ATTRS = dict(
    archs = attr.string_list(mandatory = True),
    entries = attr.string_dict(mandatory = True),
    option_sets = attr.string(mandatory = True),
    default_version = attr.string(mandatory = True),
    introspect_repos = attr.string_dict(default = {}),
    introspect_paths_repos = attr.string_dict(default = {}),
    pg_src = attr.label(
        doc = "Label of the base src hub repo (for reading index.json). " +
              "Attribute name keeps the `pg_` prefix because introspect " +
              "consumes it.",
        allow_single_file = True,
    ),
    build_repo = attr.string(default = "monogres"),
    flavor = attr.string(
        doc = "Flavor identity (e.g. `\"postgres\"`, `\"ivorysql\"`). " +
              "Baked into `CFG.name` in the generated `all.bzl`.",
        default = "postgres",
    ),
)

base_repo = repository_rule(
    implementation = _impl,
    attrs = _ATTRS,
)

testing = struct(
    _root_build = _root_build,
    _root_all_bzl = _root_all_bzl,
)
