load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# pg_build.bzl + toolchain.bzl are loaded from generated `@pg//...` BUILD files,
# so their files must be publicly visible. The other .bzl files here are
# internal to monoext.
package(default_visibility = [
    "//monoext/private:__pkg__",
    "//monoext/private/base/build_options:__pkg__",
    "//tests/monoext:__subpackages__",
])

exports_files(
    [
        "Config_overrides.pm",
        "exec_sysroot_setup.sh",
        "pg_build.bzl",
        "sysroot_setup.sh",
        "toolchain.bzl",
    ],
    visibility = ["//visibility:public"],
)

exports_files([
    "compat.bzl",
    "hub.bzl",
    "introspect.bzl",
    "schema.bzl",
    "versions.bzl",
])

bzl_library(
    name = "compat",
    srcs = ["compat.bzl"],
    deps = [
        "@version_utils//spec",
        "@version_utils//version",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = [
        "//toolchains:template_vars",
    ],
)

bzl_library(
    name = "pg_build",
    srcs = ["pg_build.bzl"],
    deps = [
        ":toolchain",
        "@protobuf//bazel:cc_proto_library_bzl",
        "@rules_foreign_cc//foreign_cc:meson",
    ],
)
