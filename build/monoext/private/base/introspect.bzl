"""
Three-layer introspect for the @pg hub repo.

## Hub: `write_introspect(rctx)`

Runs inside `base_repo._impl()`. Generates only stub files — no introspect JSONs
are read.  Produces `@pg//:introspect.bzl` (loads from all Layer 1 stubs,
exports INTROSPECTIONS dict) plus load-forwarding stubs under
`introspect/{version}/{option_set}/` that point to Layer 2 repos.

## Layer 1: `pg_introspect_paths_repo`

A `repository_rule` for ONE PG version. Reads that version's checked-in
introspect JSONs (no source downloads), computes installed paths, and generates
per-option_set `defs.bzl` with paths-only INTROSPECTION data. Only materializes
when a consumer loads `@pg//:introspect.bzl`.

## Layer 2: `pg_introspect_version_repo`

A `repository_rule` for ONE PG version. Fetches that version's source archive
(only), reads meson_options.txt and contrib/*/meson.build, and generates
per-option_set `defs.bzl` with the full dataset (features, MESON_OPTIONS). Only
triggered when a consumer loads the corresponding stub from `@pg`.
"""

load("@download_archives//lib:index.bzl", Index = "index")
load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")
load("//monoext/private/base/introspect:meson.bzl", MesonIntrospect = "meson")
load("//monoext/private/base/introspect:metadata.bzl", "FEATURES_TO_DEB_PKGS")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/base/introspect. DO NOT EDIT."

def _defs_bzl(loads, **assignments):
    """Render a defs.bzl with optional loads and a dict of assignments.

    Used for the Layer 1 inner per-combo defs, the Layer 1 root `introspect.bzl`
    aggregator, and the Layer 2 `defs.bzl` per-option-set. Values in
    `**assignments` are pre-rendered (`Star.igen(...)` output) or node values
    (`Star.ref(...)` markers).
    """
    lines = loads
    if assignments:
        body = Star.gen(Star.block(*[
            Star.assign(k, Star.ref(v) if type(v) == "string" else v)
            for k, v in assignments.items()
        ]))
        lines.append(body)

    return Star.file(header = _HEADER, *lines)

def _stub_bzl(introspect_repo, option_set):
    """Render a load-forwarding stub that re-exports the Layer 2 symbols."""
    f = bind(repo = introspect_repo, opt = option_set)
    return Star.file(
        Star.igen(Star.load_(
            f("@{repo}//{opt}:defs.bzl"),
            _FEATURES_TO_DEB_PKGS = "FEATURES_TO_DEB_PKGS",
            _INTROSPECTION = "INTROSPECTION",
            _MESON_OPTIONS = "MESON_OPTIONS",
        )),
        Star.gen(Star.block(
            Star.assign(
                "FEATURES_TO_DEB_PKGS",
                Star.ref("_FEATURES_TO_DEB_PKGS"),
            ),
            Star.assign("INTROSPECTION", Star.ref("_INTROSPECTION")),
            Star.assign("MESON_OPTIONS", Star.ref("_MESON_OPTIONS")),
        )),
        header = _HEADER,
    )

def _paths_stub_bzl(paths_repo, option_set):
    """Render a load-forwarding stub that re-exports paths-only INTROSPECTION."""
    f = bind(repo = paths_repo, opt = option_set)
    return Star.file(
        Star.igen(Star.load_(
            f("@{repo}//{opt}:defs.bzl"),
            _INTROSPECTION = "INTROSPECTION",
        )),
        "INTROSPECTION = _INTROSPECTION",
        header = _HEADER,
    )

def _option_set_build(option_set, deps):
    """Render {option_set}/BUILD.bazel: bzl_library + alias."""
    return Star.file(
        Star.load_("@bazel_skylib//:bzl_library.bzl", "bzl_library"),
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["defs.bzl"]),
        Star.bzl_library(
            name = "defs",
            srcs = ["defs.bzl"],
            deps = deps,
        ),
        Star.alias(name = option_set, actual = ":defs"),
        header = _HEADER,
    )

def _meson_options_build(option_set):
    """Render {option_set}/private/BUILD.bazel: meson_options bzl_library."""
    return Star.file(
        Star.load_("@bazel_skylib//:bzl_library.bzl", "bzl_library"),
        Star.package(default_visibility = ["//%s:__pkg__" % option_set]),
        Star.exports_files(["meson_options.bzl"]),
        Star.bzl_library(
            name = "meson_options",
            srcs = ["meson_options.bzl"],
        ),
        header = _HEADER,
    )

def _root_build():
    """Render the root BUILD.bazel for a per-version repo."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Layer 1: JSON-only introspect data in the @pg hub (no downloads)
# ---------------------------------------------------------------------------

def _installed_paths(introspect_json, version):
    """Compute contrib names and installed paths from a decoded introspect JSON."""
    contrib_names = MesonIntrospect.get_contrib_names(introspect_json)
    installed_paths = MesonIntrospect.get_installed_paths(introspect_json)

    contrib_paths = {
        name: MesonIntrospect.get_contrib_installed_paths(
            installed_paths,
            name,
            version,
        )
        for name in contrib_names
    }

    postgres_paths = MesonIntrospect.get_postgres_installed_paths(
        installed_paths,
    )

    return struct(
        contrib_names = contrib_names,
        contrib_paths = contrib_paths,
        postgres_paths = postgres_paths,
    )

def write_introspect(rctx):
    """Generate introspect.bzl and per-version stubs in the hub.

    Generates only stub files that forward-load from lazy per-version repos.  No
    introspect JSONs are read here — the actual parsing is deferred to
    `pg_introspect_paths_repo` (Layer 1, paths-only) and
    `pg_introspect_version_repo` (Layer 2, full data including features and
    meson options).  This keeps @pg materialization near-instant.

    Args:
        rctx: Repository context (base_repo).
    """
    hub_root = rctx.path(Label(rctx.attr.pg_src)).dirname

    def hub_read(subpath):
        return rctx.read(hub_root.get_child(subpath))

    index = Index.new(rctx.attr.name, hub_read("index.json"))
    introspect_meta = index.metadata.get("introspect", {})

    introspections = {}
    loads = []

    for repos in index.repos.values():
        if not repos:
            continue

        pg_version = repos[0].version

        introspect_jsons = introspect_meta.get(pg_version, {})

        if not introspect_jsons:
            continue

        paths_repo = rctx.attr.introspect_paths_repos.get(pg_version)

        for option_set in introspect_jsons:
            if not introspect_jsons[option_set]:
                continue

            # --- introspect/json/{version}/{option_set}/defs.bzl ---
            rctx.file(
                "introspect/json/%s/%s/defs.bzl" % (pg_version, option_set),
                _paths_stub_bzl(paths_repo, option_set),
            )

            key = (pg_version, option_set)
            key_load = "%s_%s" % (pg_version.replace(
                ".",
                "_",
            ), option_set.upper())
            alias_name = "INTROSPECTION_PG_%s" % key_load

            introspections[key] = alias_name

            f = bind(v = key[0], opt = key[1])
            loads.append(Star.load_(
                f("//:introspect/json/{v}/{opt}/defs.bzl"),
                **{alias_name: "INTROSPECTION"}
            ))

    # --- introspect.bzl (root: loads from all per-combo defs) ---
    rctx.file(
        "introspect.bzl",
        _defs_bzl(
            loads = loads,
            INTROSPECTIONS = Star.igen(
                introspections,
                quote_keys = False,
                quote_strings = False,
            ),
        ),
    )

    # --- introspect/{version}/{option_set}/defs.bzl (Layer 2 stubs) ---
    for version, introspect_repo in rctx.attr.introspect_repos.items():
        for option_set in introspect_meta.get(version, {}).keys():
            rctx.file(
                "introspect/%s/%s/defs.bzl" % (version, option_set),
                _stub_bzl(
                    introspect_repo = introspect_repo,
                    option_set = option_set,
                ),
            )

# ---------------------------------------------------------------------------
# Layer 2: per-version lazy repos for source-dependent data
# ---------------------------------------------------------------------------

def _pg_introspect_version_impl(rctx):
    version = rctx.attr.version

    # fetch ONE version's source archive.
    src_dir = rctx.path(rctx.attr.pg_src_version_dir).dirname

    def src_read(subpath):
        return rctx.read(src_dir.get_child(subpath))

    # process each option_set for this version.
    for label, option_set in rctx.attr.introspect_jsons.items():
        introspect_json = json.decode(rctx.read(label))
        paths = _installed_paths(introspect_json, version)

        contrib_features = {
            name: MesonIntrospect.get_contrib_features(
                name,
                src_read("contrib/%s/meson.build" % name),
            )
            for name in paths.contrib_names
        }

        fail_on_unknown_or_empty = option_set == "full"

        MesonIntrospect.validate_contrib_features(
            contrib_features,
            fail_on_unknown_or_empty,
        )

        MesonIntrospect.validate_contrib_paths(
            paths.contrib_paths,
            paths.contrib_names,
            fail_on_unknown_or_empty,
        )

        introspection = {
            "contrib": {
                name: {
                    "features": contrib_features[name],
                    "paths": paths.contrib_paths[name],
                }
                for name in paths.contrib_names
            },
            "postgres": {"paths": paths.postgres_paths},
        }

        meson_options_bzl = MesonIntrospect.meson_options_bzl(
            src_read("meson_options.txt"),
        )

        # --- {option_set}/private/meson_options.bzl ---
        rctx.file(
            "%s/private/meson_options.bzl" % option_set,
            meson_options_bzl,
        )

        # --- {option_set}/private/BUILD.bazel ---
        rctx.file(
            "%s/private/BUILD.bazel" % option_set,
            _meson_options_build(option_set),
        )

        dep = "//%s/private:meson_options" % option_set

        # --- {option_set}/defs.bzl ---
        rctx.file(
            "%s/defs.bzl" % option_set,
            _defs_bzl(
                loads = [Star.load_("%s.bzl" % dep, "OPTIONS")],
                FEATURES_TO_DEB_PKGS = Star.igen(FEATURES_TO_DEB_PKGS),
                INTROSPECTION = Star.igen(introspection),
                MESON_OPTIONS = Star.ref("OPTIONS"),
            ),
        )

        # --- {option_set}/BUILD.bazel ---
        rctx.file(
            "%s/BUILD.bazel" % option_set,
            _option_set_build(option_set, [dep]),
        )

    # --- BUILD.bazel (root) ---
    rctx.file("BUILD.bazel", _root_build())

_DOC = """
Per-version introspect repository rule.

Fetches ONE PG version's source archive, reads meson_options.txt and
contrib/*/meson.build, and generates per-option_set defs.bzl with the full
introspect dataset (features, MESON_OPTIONS).
"""

_ATTRS = dict(
    introspect_jsons = attr.label_keyed_string_dict(
        doc = """
        Introspect JSON labels for this version. Keys are labels pointing
        to checked-in introspect JSON files. Values are option_set strings.
        """,
        mandatory = True,
    ),
    pg_src_version_dir = attr.label(
        doc = """
        Label pointing to BUILD.bazel in this version's source dir
        (e.g. @pg_src-18.1//18.1/gh:BUILD.bazel). Resolving this label
        triggers the download of this version's source archive only.
        """,
        mandatory = True,
    ),
    version = attr.string(
        doc = "PG version string (e.g. '18.1').",
        mandatory = True,
    ),
)

pg_introspect_version_repo = repository_rule(
    implementation = _pg_introspect_version_impl,
    attrs = _ATTRS,
    doc = _DOC,
)

# ---------------------------------------------------------------------------
# Layer 1: per-version lazy repos for paths-only data (no source downloads)
# ---------------------------------------------------------------------------

def _paths_option_set_build():
    """Render {option_set}/BUILD.bazel for paths-only repos."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["defs.bzl"]),
        header = _HEADER,
    )

def _pg_introspect_paths_impl(rctx):
    version = rctx.attr.version

    for label, option_set in rctx.attr.introspect_jsons.items():
        introspect_json = json.decode(rctx.read(label))
        paths = _installed_paths(introspect_json, version)

        introspection = {
            "contrib": {
                name: {"paths": paths.contrib_paths[name]}
                for name in paths.contrib_names
            },
            "flavor": rctx.attr.flavor,
            "postgres": {"paths": paths.postgres_paths},
        }

        rctx.file(
            "%s/defs.bzl" % option_set,
            _defs_bzl(
                loads = [],
                INTROSPECTION = Star.igen(introspection),
            ),
        )
        rctx.file("%s/BUILD.bazel" % option_set, _paths_option_set_build())

    rctx.file("BUILD.bazel", _root_build())

_PATHS_DOC = """
Per-version paths-only introspect repository rule.

Reads ONE PG version's checked-in introspect JSONs (no source download) and
generates per-option_set defs.bzl with paths-only INTROSPECTION data. This is
the Layer 1 lazy counterpart that keeps @pg materialization instant — the
actual JSON parsing is deferred until a consumer loads introspect.bzl.
"""

_PATHS_ATTRS = dict(
    flavor = attr.string(
        doc = "Catalog flavor (e.g. 'postgres', 'ivorysql'). Rendered into " +
              "each INTROSPECTION so consumers (gen_contrib) read the flavor " +
              "from the data rather than a caller-supplied key.",
        mandatory = True,
    ),
    introspect_jsons = attr.label_keyed_string_dict(
        doc = """
        Introspect JSON labels for this version. Keys are labels pointing
        to checked-in introspect JSON files. Values are option_set strings.
        """,
        mandatory = True,
    ),
    version = attr.string(
        doc = "PG version string (e.g. '18.1').",
        mandatory = True,
    ),
)

pg_introspect_paths_repo = repository_rule(
    implementation = _pg_introspect_paths_impl,
    attrs = _PATHS_ATTRS,
    doc = _PATHS_DOC,
)

testing = struct(
    _defs_bzl = _defs_bzl,
    _stub_bzl = _stub_bzl,
    _paths_stub_bzl = _paths_stub_bzl,
    _option_set_build = _option_set_build,
    _meson_options_build = _meson_options_build,
    _root_build = _root_build,
    _installed_paths = _installed_paths,
)
