"""
Hub file generation for contrib extensions.

Render helpers for the contrib extension hierarchy in the extensions hub repo
(e.g. `@pg_ext`): extension root with default aliases and per-base-version BUILD
files with inlined packaging targets.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/ext. DO NOT EDIT."

def _declare_outputs(*args, **kwargs):
    return Star.igen(Star.fn("declare_outputs", *args, **kwargs))

def _mtree_spec(*args, **kwargs):
    return Star.igen(Star.fn("mtree_spec", *args, **kwargs))

def _mtree_mutate(*args, **kwargs):
    return Star.igen(Star.fn("mtree_mutate", *args, **kwargs))

def _tar(*args, **kwargs):
    return Star.igen(Star.fn("tar", *args, **kwargs))

def _platform_build(*args, **kwargs):
    return Star.igen(Star.fn("platform_build", *args, **kwargs))

def _contrib_root_build(name, default_base_version):
    """Render contrib/{name}/BUILD.bazel: extension root with default aliases."""
    f = bind(name = name, base_v = default_base_version)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["repo.bzl"]),
        Star.alias(name, actual = f("//contrib/{name}/{base_v}:tar")),
        Star.alias("files", actual = f("//contrib/{name}/{base_v}:files")),
        header = _HEADER,
    )

def _contrib_repo_bzl(sorted_base_versions, default_base_version, metadata):
    """Render contrib/{name}/repo.bzl: baked-in metadata."""
    return Star.file(
        "VERSIONS = %s" % Star.igen(sorted_base_versions),
        "DEFAULT_VERSION = %s" % Star.gen(default_base_version),
        "METADATA = %s" % Star.igen(metadata),
        header = _HEADER,
    )

def _arch_build(build_repo, actual, platform):
    """Render contrib/{name}/{base_v}/{arch}/BUILD.bazel: transition wrapper."""
    f = bind(build = build_repo)
    return Star.file(
        Star.load_(
            f("@{build}//platforms:platform_build.bzl"),
            "platform_build",
        ),
        Star.package(default_visibility = ["//visibility:public"]),
        _platform_build(
            name = "tar",
            actual = actual,
            platform = platform,
        ),
        header = _HEADER,
    )

def _contrib_pg_build(
        build_repo,
        name,
        base_hub_name,
        base_version,
        strip_prefix,
        files):
    """Render contrib/{name}/{base_version}/BUILD.bazel: inlined packaging targets."""
    f = bind(build = build_repo, hub = base_hub_name, base_v = base_version)
    return Star.file(
        Star.load_("@tar.bzl//tar:mtree.bzl", "mtree_mutate", "mtree_spec"),
        Star.load_("@tar.bzl//tar:tar.bzl", "tar"),
        Star.load_(f("@{build}//utils:declare_outputs.bzl"), "declare_outputs"),
        Star.package(default_visibility = ["//visibility:public"]),
        _declare_outputs(
            name = "files",
            src = f("@{hub}//{base_v}/full:tar.dev"),
            outs = files,
        ),
        _mtree_spec(
            name = "mtree-spec",
            srcs = ["files"],
            visibility = ["//visibility:private"],
        ),
        _mtree_mutate(
            name = "mtree",
            mtree = "mtree-spec",
            srcs = ["files"],
            strip_prefix = strip_prefix,
            ownername = "postgres",
            visibility = ["//visibility:private"],
        ),
        _tar(
            name = "tar",
            out = "%s.tar" % name,
            srcs = ["files"],
            mtree = "mtree",
        ),
        header = _HEADER,
    )

# ---------------------------------------------------------------------------
# Writers
# ---------------------------------------------------------------------------

def write_contrib_extension(rctx, name, entry, build_repo, base_hub_name, archs):
    """Generates the contrib package hierarchy in the hub repo.

    Args:
        rctx: Repository context.
        name: Contrib extension name.
        entry: `ExtContribEntry` struct with ext_versions and metadata.
        build_repo: Name of the build repo (e.g. `"monogres"`).
        base_hub_name: Apparent name of the base hub repo. Contrib targets
            reference `@{base_hub_name}//{base_version}/full:tar`.
        archs: List of architecture names for per-arch targets.
    """
    sorted_base_versions = sorted(entry.ext_versions)
    default_base_version = sorted_base_versions[-1] if sorted_base_versions else ""

    rctx.file(
        "contrib/%s/BUILD.bazel" % name,
        _contrib_root_build(name, default_base_version),
    )

    metadata = entry.metadata

    rctx.file(
        "contrib/%s/repo.bzl" % name,
        _contrib_repo_bzl(sorted_base_versions, default_base_version, metadata),
    )

    for base_version in sorted_base_versions:
        files = metadata.get("files", {}).get(base_version, [])
        hub_package = "contrib/%s/%s" % (name, base_version)
        strip_prefix = "%s/%s/%s" % (hub_package, "tar", "files")

        rctx.file(
            "%s/BUILD.bazel" % hub_package,
            _contrib_pg_build(
                build_repo = build_repo,
                name = name,
                base_hub_name = base_hub_name,
                base_version = base_version,
                strip_prefix = strip_prefix,
                files = files,
            ),
        )

        # --- contrib/{name}/{base_v}/{arch}/BUILD.bazel ---
        for arch in archs:
            f = bind(
                name = name,
                base_v = base_version,
                build = build_repo,
                arch = arch,
            )
            rctx.file(
                "%s/%s/BUILD.bazel" % (hub_package, arch),
                _arch_build(
                    build_repo = build_repo,
                    actual = f("//contrib/{name}/{base_v}:tar"),
                    platform = f("@{build}//platforms:linux_{arch}"),
                ),
            )

testing = struct(
    _contrib_root_build = _contrib_root_build,
    _contrib_repo_bzl = _contrib_repo_bzl,
    _contrib_pg_build = _contrib_pg_build,
    _arch_build = _arch_build,
)
