"""
Hub file generation for external extensions.

Render helpers for the external extension hierarchy in the extensions hub repo
(e.g. `@pg_ext`): extension root, per-version aliases, source aliases,
per-base-version packages (with `pgxs_build`), and dependency aliases.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load("//platforms:targets.bzl", "ARCH_CPU")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/ext. DO NOT EDIT."

# The hub package holding the pgrx SQL generators, one target per pgrx version
# (rendered by `hub.bzl::_pgrx_build_bzl`, named here as a build's
# `sql_generator`). Shared by every extension pinning that version, since what
# the generator has to match is the pgrx release, not the extension.
_PGRX_PACKAGE = "//_pgrx"

def pgrx_generator_name(pgrx_version):
    """Target name of the pgrx SQL generator built against `pgrx_version`."""
    return "pgrxsc-sql-%s" % pgrx_version

def _pgxs_build(*args, **kwargs):
    return Star.igen(Star.fn("pgxs_build", *args, **kwargs))

def _cmake_build(*args, **kwargs):
    return Star.igen(Star.fn("cmake_build", *args, **kwargs))

def _pgrx_build(*args, **kwargs):
    return Star.igen(Star.fn("pgrx_build", *args, **kwargs))

def _cargo_vendor(*args, **kwargs):
    return Star.igen(Star.fn("cargo_vendor", *args, **kwargs))

def _platform_build(*args, **kwargs):
    return Star.igen(Star.fn("platform_build", *args, **kwargs))

def _default_pg_alias(alias_name, name, version, compatible_base_versions):
    """Returns the rendered default-PG alias, or empty string.

    Empty string makes the part a no-op in Star.file composition.
    """
    compat = compatible_base_versions.get(version, [])
    default_base = sorted(compat)[-1] if compat else ""

    if not default_base:
        return ""

    f = bind(name = name, v = version, base_v = default_base)
    return Star.alias(
        name = alias_name,
        actual = f("//{name}/{v}/{base_v}:{base_v}"),
    )

def _ext_root_build(name, default_version, compatible_base_versions):
    """Render {name}/BUILD.bazel: extension root with convenience aliases."""
    f = bind(name = name, v = default_version)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["repo.bzl"]),
        _default_pg_alias(
            name,
            name,
            default_version,
            compatible_base_versions,
        ),
        Star.alias(name = "dir", actual = f("//{name}/{v}:dir")),
        Star.alias(name = "files", actual = f("//{name}/{v}:files")),
        header = _HEADER,
    )

def _repo_bzl(source_repo):
    """Render {name}/repo.bzl: re-export source_repo metadata."""
    f = bind(src = source_repo)
    return Star.file(
        Star.load_(
            f("@{src}//:repo.bzl"),
            _DEFAULT_VERSION = "DEFAULT_VERSION",
            _LOCK = "LOCK",
            _METADATA = "METADATA",
            _REPO_NAME = "REPO_NAME",
            _VERSIONS = "VERSIONS",
        ),
        Star.gen(Star.block(
            Star.assign("DEFAULT_VERSION", Star.ref("_DEFAULT_VERSION")),
            Star.assign("LOCK", Star.ref("_LOCK")),
            Star.assign("METADATA", Star.ref("_METADATA")),
            Star.assign("REPO_NAME", Star.ref("_REPO_NAME")),
            Star.assign("VERSIONS", Star.ref("_VERSIONS")),
        )),
        header = _HEADER,
    )

def _version_build(name, version, default_alias, build_repo = None, crates = []):
    """Render {name}/{version}/BUILD.bazel: version-level aliases.

    A pgrx extension also gets its `cargo_vendor` tree here, one level above the
    per-base-version packages that consume it: the Rust dependency closure is
    identical for every PG major (a major is only a cargo feature), so the three
    builds extract one tar instead of assembling three.
    """
    f = bind(name = name, v = version, build = build_repo)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.load_(
            f("@{build}//monoext/private/ext/crates:vendor.bzl"),
            "cargo_vendor",
        ) if crates else "",
        default_alias,
        Star.alias("dir", f("//{name}/{v}/src:dir")),
        Star.alias("files", f("//{name}/{v}/src:files")),
        _cargo_vendor(name = "vendor", crates = crates) if crates else "",
        header = _HEADER,
    )

def _src_build(name, version, source):
    """Render {name}/{version}/src/BUILD.bazel: source intermediary."""
    f = bind(name = name, v = version, source = source)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.alias("dir", f("//{name}/{v}/src/{source}:dir")),
        Star.alias("files", f("//{name}/{v}/src/{source}:files")),
        Star.alias("src", ":files"),
        header = _HEADER,
    )

def _src_leaf_build(source_repo, source, version):
    """Render {name}/{version}/src/{source}/BUILD.bazel: source leaf."""
    f = bind(src = source_repo, v = version)
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.alias("dir", f("@{src}//{v}:dir")),
        Star.alias("files", f("@{src}//{v}:files")),
        Star.alias(source, f("@{src}//{v}:{v}")),
        header = _HEADER,
    )

def _pg_build(
        build_repo,
        source_repo,
        version,
        base_v,
        base_hub_name,
        bt_sysroot,
        base_sysroot,
        base_flavor,
        base_prefix_distro = None,
        build_system = "pgxs",
        build_args = [],
        remap_paths = {},
        crate_dir = "",
        ext_name = None,
        cargo = None):
    """Render {name}/{version}/{base_version}/BUILD.bazel for the extension build.

    Dispatches on `build_system`: `"cmake"` renders a `cmake_build` (via
    rules_foreign_cc's `cmake` rule), `"pgrx"` a `pgrx_build` (cargo, against
    the version's `cargo_vendor` tree and the hub's SQL generator), and anything
    else (`"pgxs"`, the default) a `pgxs_build`. `build_args` is the extension's
    list of extra flags (autoconf/PGXS `configure` args for the pgxs path, CMake
    `-D` cache entries for the cmake path, `cargo build` arguments for the pgrx
    one); every build rule resolves the `{pg_config}` / `{sysroot}` placeholders
    to action-time sysroot paths. `remap_paths` (not the cmake path) is the
    `{file: {from: to}}` sysroot-script path remapping.

    The source tree is the download_archives `:dir`, a tree artifact keyed on
    the archive and the patches it was made from, so the build action is re-run
    when either changes.

    `base_sysroot` is the per-PG buildtime sysroot tar alias
    (`//_base/<base_v>:sysroot_tar` in the same hub), threaded into the build so
    Postgres-interface deps reach the extension compile via `-idirafter` / `-L`
    without each extension re-declaring them.

    `base_prefix_distro` defaults to `"/" + base_flavor`; every in-tree flavor
    follows that convention, so callers only need to pass it explicitly if a
    flavor's install prefix diverges from its name.

    `ext_name`, `cargo` and `crate_dir` are the pgrx path's: the extension name
    (to reach its vendor tree), this version's `{"lock", "crates",
    "git_sources", "pgrx"}` entry, and the crate's directory below the source
    root when the source tree is a cargo workspace whose root the crate is not.
    """
    prefix_distro = base_prefix_distro or "/" + base_flavor
    f = bind(
        build = build_repo,
        build_system = build_system,
        ext = ext_name,
        src = source_repo,
        v = version,
    )
    base_version = {"name": "%s~%s" % (base_flavor, base_v), "version": base_v}

    build_system_args = dict(
        name = base_v,
        src = f("@{src}//{v}:dir"),
        deps_buildtime = [bt_sysroot] if bt_sysroot else [],
        base_sysroot_tar = base_sysroot,
        base_version = base_version,
        base_hub = "@%s" % base_hub_name,
        prefix_distro = prefix_distro,
        build_args = build_args,
        remap_paths = remap_paths,
    )

    if build_system == "pgxs":
        build_call = _pgxs_build(**build_system_args)
    elif build_system == "cmake":
        build_call = _cmake_build(**build_system_args)
    elif build_system == "pgrx":
        # The vendor tree sits one package up, shared by every base version; the
        # SQL generator sits in `_pgrx`, shared by every extension pinning the
        # same pgrx (and only those: it is that release's decoder and emitter).
        pgrx_args = dict(
            vendor_tar = f("//{ext}/{v}:vendor.tar"),
            cargo_lock = cargo["lock"],
            sql_generator = "%s:%s" % (
                _PGRX_PACKAGE,
                pgrx_generator_name(cargo["pgrx"]),
            ),
            ext_version = version,
        )

        # Only a cargo workspace names one, so the single-crate case renders the
        # same call it did before workspaces were supported at all.
        if crate_dir:
            pgrx_args["crate_dir"] = crate_dir

        # Likewise for a lock that takes crates from a git revision: the source
        # replacement it needs is rendered only where there is one.
        if cargo["git_sources"]:
            pgrx_args["git_sources"] = cargo["git_sources"]

        pgrx_args.update(build_system_args)
        build_call = _pgrx_build(**pgrx_args)
    else:
        fail("Invalid build system: %s" % build_system)

    return Star.file(
        Star.load_(
            f("@{build}//monoext/private/ext/build:{build_system}.bzl"),
            f("{build_system}_build"),
        ),
        Star.package(default_visibility = ["//visibility:public"]),
        build_call,
        header = _HEADER,
    )

def _arch_build(build_repo, target_name, actual, platform):
    """Render {name}/{version}/{base_v}/{arch}/BUILD.bazel: transition wrapper."""
    f = bind(build = build_repo)
    return Star.file(
        Star.load_(
            f("@{build}//platforms:platform_build.bzl"),
            "platform_build",
        ),
        Star.package(default_visibility = ["//visibility:public"]),
        _platform_build(
            name = target_name,
            actual = actual,
            platform = platform,
        ),
        header = _HEADER,
    )

def _sysroot_select(labels_by_arch):
    """Build a `Star.select` node keyed by `@platforms//cpu:*` constraints.

    Args:
        labels_by_arch: `{arch_name: label_str}` from
            `DepsInfo.sysroot_labels_by_arch`.

    Returns:
        A `Star.select` node for use as an `alias(actual = ...)` value.
    """
    return Star.select({
        "@platforms//cpu:%s" % ARCH_CPU[arch]: label
        for arch, label in labels_by_arch.items()
    })

def _deps_kind_build(alias_pairs):
    """Render {name}/{version}/deps/{kind}/BUILD.bazel: package + N aliases."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
        *[Star.alias(name, actual) for name, actual in alias_pairs]
    )

# ---------------------------------------------------------------------------
# Writers
# ---------------------------------------------------------------------------

def _write_deps_package(rctx, name, version, version_deps):
    """Writes the {name}/{version}/deps/ hierarchy."""
    for kind in _PkgsSchema.KINDS:
        deps_info = getattr(version_deps, kind)
        if not deps_info:
            continue

        alias_pairs = [
            ("sysroot", _sysroot_select(deps_info.sysroot_labels_by_arch)),
            ("sysroot_tar", _sysroot_select(
                deps_info.sysroot_tar_labels_by_arch,
            )),
        ]
        rctx.file(
            "%s/%s/deps/%s/BUILD.bazel" % (name, version, kind),
            _deps_kind_build(alias_pairs),
        )

        if deps_info.packages:
            rctx.file(
                "%s/%s/deps/%s/pkgs/BUILD.bazel" % (name, version, kind),
                _deps_kind_build([
                    (pkg, deps_info.pkgs_labels[i])
                    for i, pkg in enumerate(deps_info.packages)
                ]),
            )

def write_extension_package(rctx, entry, name, archs):
    """Generates the full external extension directory hierarchy.

    Args:
        rctx: Repository context.
        entry: `ExtExternalEntry` struct with compatible_base_versions, deps,
            source_repo, lock, versions_deps.
        name: Extension name.
        archs: List of architecture names for per-arch targets.
    """
    compatible_base_versions = entry.compatible_base_versions
    source_repo = entry.source_repo
    lock = entry.lock
    versions_deps = entry.versions_deps

    sorted_versions = sorted(lock)
    default_version = sorted_versions[-1] if sorted_versions else ""

    rctx.file(
        "%s/BUILD.bazel" % name,
        _ext_root_build(name, default_version, compatible_base_versions),
    )

    rctx.file("%s/repo.bzl" % name, _repo_bzl(source_repo))

    for version in sorted_versions:
        cargo = entry.cargo.get(version)

        rctx.file(
            "%s/%s/BUILD.bazel" % (name, version),
            _version_build(
                name,
                version,
                _default_pg_alias(
                    version,
                    name,
                    version,
                    compatible_base_versions,
                ),
                build_repo = rctx.attr.build_repo,
                crates = cargo["crates"] if cargo else [],
            ),
        )

        source = lock[version]["source"]

        rctx.file(
            "%s/%s/src/BUILD.bazel" % (name, version),
            _src_build(name, version, source),
        )

        rctx.file(
            "%s/%s/src/%s/BUILD.bazel" % (name, version, source),
            _src_leaf_build(source_repo, source, version),
        )

        bt_sysroot = entry.deps.get(version).buildtime.sysroot_tar

        version_compat = compatible_base_versions.get(version, [])
        for base_v in sorted(version_compat):
            rctx.file(
                "%s/%s/%s/BUILD.bazel" % (name, version, base_v),
                _pg_build(
                    build_repo = rctx.attr.build_repo,
                    source_repo = source_repo,
                    version = version,
                    base_v = base_v,
                    base_hub_name = rctx.attr.base_hub_name,
                    bt_sysroot = bt_sysroot,
                    base_sysroot = "//_base/%s:sysroot_tar" % base_v,
                    base_flavor = rctx.attr.base_flavor,
                    build_system = entry.build_system,
                    build_args = entry.build_args,
                    remap_paths = entry.remap_paths,
                    crate_dir = entry.crate_dir,
                    ext_name = name,
                    cargo = cargo,
                ),
            )

            # --- {name}/{version}/{base_v}/{arch}/BUILD.bazel ---
            for arch in archs:
                f = bind(
                    name = name,
                    v = version,
                    base_v = base_v,
                    build = rctx.attr.build_repo,
                    arch = arch,
                )
                rctx.file(
                    "%s/%s/%s/%s/BUILD.bazel" % (name, version, base_v, arch),
                    _arch_build(
                        build_repo = rctx.attr.build_repo,
                        target_name = base_v,
                        actual = f("//{name}/{v}/{base_v}:{base_v}"),
                        platform = f("@{build}//platforms:linux_{arch}"),
                    ),
                )

        vd = versions_deps.get(version)
        if vd:
            _write_deps_package(rctx, name, version, vd)

testing = struct(
    _default_pg_alias = _default_pg_alias,
    _ext_root_build = _ext_root_build,
    _repo_bzl = _repo_bzl,
    _version_build = _version_build,
    _src_build = _src_build,
    _src_leaf_build = _src_leaf_build,
    _pg_build = _pg_build,
    _arch_build = _arch_build,
    _deps_kind_build = _deps_kind_build,
)
