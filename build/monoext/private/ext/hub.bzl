"""
Repository rule for the extensions hub repo (e.g. `@pg_ext`).

Delegates per-extension file tree generation to the external and contrib writers
(`external.bzl`, `contrib.bzl`), and emits the top-level `all.bzl` with CFGS,
REPOS, EXTENSIONS, CFGS_CONTRIB, REPOS_CONTRIB, and CONTRIB_EXTENSIONS.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")
load("//monoext/private/ext:contrib.bzl", "write_contrib_extension")
load(
    "//monoext/private/ext:external.bzl",
    "pgrx_generator_name",
    "write_extension_package",
)
load("//monoext/private/ext:schema.bzl", _ExtSchema = "schema")
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load(
    "//monoext/private/test:introspect.bzl",
    "INTROSPECT_ATTRS",
    "render_contrib_tests",
    "render_external_ext_tests",
)
load("//platforms:targets.bzl", "ARCH_CPU")

# ---------------------------------------------------------------------------
# File rendering helpers
# ---------------------------------------------------------------------------

_HEADER = "Generated by monoext/private/ext. DO NOT EDIT."

# The binary cargo produces for the SQL generator, i.e. its crate name. Shared
# by every version of it; only the Bazel target around it is versioned.
_PGRXSC_SQL_BIN = "pgrxsc-sql"

def _root_build_bzl():
    """Render root BUILD.bazel."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["all.bzl"]),
        header = _HEADER,
    )

def _base_build(sysroot_tar_labels_by_arch):
    """Render `_base/<base_v>/BUILD.bazel`.

    Exposes the per-base-version buildtime sysroot tar via a single
    `:sysroot_tar` alias that selects the per-arch label from
    `DepsInfo.sysroot_tar_labels_by_arch`. PGXS extensions reference this alias
    as `//_base/<base_v>:sysroot_tar`, threaded through
    `pgxs_build.base_sysroot_tar` so the action extracts Postgres's buildtime
    sysroot alongside the extension's own and layers it via `-idirafter` / `-L`.
    """
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.alias(
            name = "sysroot_tar",
            actual = Star.select({
                "@platforms//cpu:%s" % ARCH_CPU[arch]: label
                for arch, label in sysroot_tar_labels_by_arch.items()
            }),
        ),
        header = _HEADER,
    )

def _write_base_packages(rctx, base_versions_deps):
    """Render `_base/<base_v>/BUILD.bazel` per base version with buildtime deps.

    Args:
        rctx: Repository context.
        base_versions_deps: `{base_version: VersionDeps}` for this hub's flavor
            group from `PkgsResult.versions_deps`. Versions without buildtime
            deps (none expected for a base flavor) are skipped.
    """
    for base_v, vd in base_versions_deps.items():
        if not vd.buildtime:
            continue
        labels_by_arch = vd.buildtime.sysroot_tar_labels_by_arch
        if not labels_by_arch:
            continue
        rctx.file(
            "_base/%s/BUILD.bazel" % base_v,
            _base_build(labels_by_arch),
        )

def _pgrx_build_bzl(build_repo, crates):
    """Render `_pgrx/BUILD.bazel`: the SQL generators the pgrx builds run.

    Built here rather than in the build repo because their dependency closures
    are crate pool repos, which only a repo the module extension creates can
    name.

    One generator per pgrx version the catalog's extensions pin, because the
    `.pgrxsc` decoder and the SQL emitter behind it are both part of a pgrx
    release: an extension's SQL has to be emitted by the generator built against
    the same pgrx the extension itself was compiled against. Each carries its
    own vendor tree, since each resolves a different `pgrx-sql-entity-graph`.

    Args:
        build_repo: Repo containing the build rules.
        crates: `{pgrx_version: {package: dir_name}}`, one closure per pgrx
            version, as `ExtData.pgrx_crates`.
    """
    f = bind(build = build_repo)
    parts = [
        Star.load_(
            f("@{build}//monoext/private/ext/crates:cargo_bin.bzl"),
            "cargo_bin",
        ),
        Star.load_(
            f("@{build}//monoext/private/ext/crates:vendor.bzl"),
            "cargo_vendor",
        ),
        Star.package(default_visibility = ["//visibility:public"]),
    ]

    for pgrx_v in sorted(crates):
        vendor = "vendor-%s" % pgrx_v
        g = bind(build = build_repo, v = pgrx_v)

        parts.append(Star.igen(Star.fn(
            "cargo_vendor",
            name = vendor,
            crates = crates[pgrx_v],
        )))

        # `bin`: cargo names the binary after the crate, which is the same for
        # every version of the generator; only the Bazel target is versioned.
        parts.append(Star.igen(Star.fn(
            "cargo_bin",
            name = pgrx_generator_name(pgrx_v),
            bin = _PGRXSC_SQL_BIN,
            manifest = g("@{build}//tools/pgrxsc_sql/{v}:Cargo.toml"),
            srcs = g("@{build}//tools/pgrxsc_sql/{v}:srcs"),
            vendor_tar = ":%s.tar" % vendor,
        )))

    return Star.file(header = _HEADER, *parts)

def _root_all_bzl(entries, archs, contrib_entries = None):
    """Render all.bzl: loads + the base and contrib CFGS/REPOS/EXTENSIONS maps.

    Each `ExtExternalEntry` already carries pre-expanded `targets` and `sources`
    with fully-qualified `@{hub_name}//...` labels (baked by
    `//monoext/private:ext.bzl::_build_external`). Same for
    `ExtContribEntry.targets`. This renderer forwards them directly; contrib
    targets carry no `deps` or `source` (contribs are built inside PG and
    inherit PG's deps transitively).
    """
    loads = []
    cfgs = {}
    repos = {}

    for i, entry in enumerate(entries):
        name = entry.name
        idx = "E%d" % i

        load_args = {
            "DEFAULT_VERSION_%s" % idx: "DEFAULT_VERSION",
            "LOCK_%s" % idx: "LOCK",
            "METADATA_%s" % idx: "METADATA",
            "REPO_NAME_%s" % idx: "REPO_NAME",
            "VERSIONS_%s" % idx: "VERSIONS",
        }
        f = bind(name = name)
        loads.append(Star.load_(f("//{name}:repo.bzl"), **load_args))

        default_source = entry.sources[0] if entry.sources else None
        default_target = entry.targets[0] if entry.targets else None
        ext_cfg = struct(
            name = name,
            default = default_target,
            default_source = default_source,
            sources = entry.sources,
            targets = entry.targets,
        )
        cfgs[name] = [ext_cfg]

        repos[name] = struct(
            default_version = Star.ref("DEFAULT_VERSION_%s" % idx),
            lock = Star.ref("LOCK_%s" % idx),
            metadata = Star.ref("METADATA_%s" % idx),
            repo_name = Star.ref("REPO_NAME_%s" % idx),
            versions = Star.ref("VERSIONS_%s" % idx),
        )

    cfgs_contrib = {}
    repos_contrib = {}

    if contrib_entries:
        for j, name in enumerate(sorted(contrib_entries)):
            entry = contrib_entries[name]

            idx = "c%d" % j
            load_args = {
                "METADATA_%s" % idx: "METADATA",
                "VERSIONS_%s" % idx: "VERSIONS",
            }
            f = bind(name = name)
            loads.append(
                Star.load_(f("//contrib/{name}:repo.bzl"), **load_args),
            )

            default_target = entry.targets[0] if entry.targets else None
            contrib_cfg = struct(
                name = name,
                default = default_target,
                targets = entry.targets,
            )
            cfgs_contrib[name] = [contrib_cfg]

            repos_contrib[name] = struct(
                metadata = Star.ref("METADATA_%s" % idx),
                versions = Star.ref("VERSIONS_%s" % idx),
            )

    defs = [
        "ARCHS = %s" % Star.gen(list(archs)),
        "KINDS = %s" % Star.gen(list(_PkgsSchema.KINDS)),
        "CFGS = %s" % Star.igen(cfgs),
        "REPOS = %s" % Star.igen(repos),
        "EXTENSIONS = sorted(CFGS.keys())",
        "CFGS_CONTRIB = %s" % Star.igen(cfgs_contrib),
        "REPOS_CONTRIB = %s" % Star.igen(repos_contrib),
        "CONTRIB_EXTENSIONS = sorted(CFGS_CONTRIB.keys())",
    ]

    return Star.file(header = _HEADER, *(loads + defs))

# ---------------------------------------------------------------------------
# Repository rule
# ---------------------------------------------------------------------------

def _impl(rctx):
    external_entries = []
    contrib_entries = {}
    archs = rctx.attr.archs

    base_versions_deps = {
        base_v: _PkgsSchema.VersionDeps.from_dict(vd)
        for base_v, vd in json.decode(rctx.attr.base_versions_deps).items()
    }

    for name in sorted(rctx.attr.entries):
        entry_dict = json.decode(rctx.attr.entries[name])

        if entry_dict.get("is_contrib"):
            entry = _ExtSchema.ExtContribEntry.from_dict(entry_dict)
            contrib_entries[name] = entry
            write_contrib_extension(
                rctx,
                name,
                entry,
                rctx.attr.build_repo,
                base_hub_name = rctx.attr.base_hub_name,
                archs = archs,
            )
        else:
            entry_dict["lock"] = json.decode(
                rctx.read(rctx.path(rctx.attr.locks[name])),
            )
            entry = _ExtSchema.ExtExternalEntry.from_dict(entry_dict)
            external_entries.append(entry)
            write_extension_package(rctx, entry, name, archs = archs)

    _write_base_packages(rctx, base_versions_deps)

    pgrx_crates = json.decode(rctx.attr.pgrx_crates)
    if pgrx_crates:
        rctx.file("_pgrx/BUILD.bazel", _pgrx_build_bzl(
            rctx.attr.build_repo,
            pgrx_crates,
        ))

    rctx.file("BUILD.bazel", _root_build_bzl())
    rctx.file("all.bzl", _root_all_bzl(
        external_entries,
        contrib_entries = contrib_entries,
        archs = archs,
    ))

    # The committed test introspections, as a catalog-derived
    # `TEST_INTROSPECTIONS` manifest (`{ext: {ext_version: canonical_base}}`).
    # Mirrors the base hub's `@pg//:introspect.bzl` `INTROSPECTIONS`, and lets
    # `//catalog/extensions:BUILD.bazel` wire the `ext_introspect(...)` regen +
    # freshness targets without hand-enumerating extensions, versions, or bases.
    rctx.file("introspect.bzl", Star.file(
        "TEST_INTROSPECTIONS = %s" % Star.igen(
            json.decode(rctx.attr.ext_introspect_manifest),
        ),
        header = _HEADER,
    ))

    # The contrib test introspect: one `sh_test` per contrib suite under
    # `contrib/<name>/<v>/tests`, run against the base hub's install tree. A
    # no-op when the introspect is empty.
    render_contrib_tests(rctx, rctx.attr.base_flavor, rctx.attr.build_repo)

    # The external-extension test introspect: a smoke CREATE EXTENSION
    # exit-check plus the extension's own upstream regress suites, under
    # `<ext>/<ext_v>/<base_v>/tests`. A no-op when no external declares
    # `metadata.test_ext`.
    render_external_ext_tests(
        rctx,
        rctx.attr.base_flavor,
        rctx.attr.build_repo,
        external_entries,
        json.decode(rctx.attr.external_test_meta),
    )

_ATTRS = dict(
    archs = attr.string_list(mandatory = True),
    catalog = attr.label(mandatory = True),
    entries = attr.string_dict(mandatory = True),
    base_hub_name = attr.string(mandatory = True),
    base_flavor = attr.string(mandatory = True),
    locks = attr.string_keyed_label_dict(default = {}),
    build_repo = attr.string(default = "monogres"),
    # `{pgrx_version: {package: dir_name}}` (JSON): the crate pool repos backing
    # one SQL generator per pgrx version the extensions pin. Non-empty only when
    # some extension is pgrx, which is also when `_pgrx/` gets rendered at all.
    pgrx_crates = attr.string(default = "{}"),
    base_versions_deps = attr.string(mandatory = True),
    # The flavor's OPTION_SETS (JSON list); the contrib introspect runs against
    # the last (default) option set's install tree.
    option_sets = attr.string(default = "[]"),
    # `{ext_name: metadata.test_ext}` (JSON) for the external extensions; drives
    # the external test introspect (smoke + upstream regress) rendered alongside
    # the builds. Empty when no external declares a `test_ext` block.
    external_test_meta = attr.string(default = "{}"),
    # The regen + freshness manifest (JSON list of `[ext, ext_version,
    # base_version]`) for the committed test introspects, derived from the
    # catalog. Re-exposed as `introspect.bzl`'s `TEST_INTROSPECTIONS`.
    ext_introspect_manifest = attr.string(default = "[]"),
    # The test-introspect attrs (filled by `introspect.introspect_payload`,
    # pointing at the base hub). The extensions hub now renders the contrib
    # suites alongside the extension builds.
    **INTROSPECT_ATTRS
)

ext_repo = repository_rule(
    implementation = _impl,
    attrs = _ATTRS,
)

testing = struct(
    _root_build_bzl = _root_build_bzl,
    _root_all_bzl = _root_all_bzl,
    _pgrx_build_bzl = _pgrx_build_bzl,
)
