load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# `pgxs.bzl` / `cmake.bzl` / `pgrx.bzl` are loaded from generated
# `@{name}_ext//...` BUILD files, so their files (and the shared `build.bzl`
# they transitively load) must be publicly visible. `build_args.bzl` is internal
# to this package.
package(default_visibility = [
    "//monoext/private:__subpackages__",
    "//tests/monoext:__subpackages__",
])

exports_files(
    [
        "build.bzl",
        "pgxs.bzl",
        "cmake.bzl",
        "pgrx.bzl",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "build",
    srcs = ["build.bzl"],
    visibility = ["//visibility:public"],
    deps = [":build_args"],
)

bzl_library(
    name = "pgxs",
    srcs = ["pgxs.bzl"],
    visibility = ["//visibility:public"],
    deps = [":build"],
)

bzl_library(
    name = "cmake",
    srcs = ["cmake.bzl"],
    visibility = ["//visibility:public"],
    deps = [":build"],
)

bzl_library(
    name = "pgrx",
    srcs = ["pgrx.bzl"],
    visibility = ["//visibility:public"],
    deps = [":build"],
)

bzl_library(
    name = "build_args",
    srcs = ["build_args.bzl"],
)
