load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# `pgxs.bzl` is loaded from generated `@{name}_ext//...` BUILD files, so its
# file (and the shared `build.bzl` it transitively loads) must be publicly
# visible.
package(default_visibility = [
    "//monoext/private:__subpackages__",
    "//tests/monoext:__subpackages__",
])

exports_files(
    [
        "build.bzl",
        "pgxs.bzl",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "build",
    srcs = ["build.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "pgxs",
    srcs = ["pgxs.bzl"],
    visibility = ["//visibility:public"],
    deps = [":build"],
)
