"""
Repo rule for the crates ONE git revision publishes, a second pool spoke.

Most of a pgrx extension's closure comes from crates.io, which `crate_repo.bzl`
handles: the `Cargo.lock` records a sha256 per package, so each release is
content-pinned by the lock itself. A git dependency has no checksum there, only
`git+<url>?<ref>#<rev>`, so what pins it has to come from the catalog instead
(`cargo/<version>/git.json`): the archive URL for that revision and its sha256.

A revision is fetched ONCE, as a source archive from the forge (GitHub and
GitLab both serve one per commit), and that is also the unit of caching: a git
repository is usually a cargo workspace, and a lock that names one of its crates
tends to name several. So this repo holds the whole checkout and turns each
crate the catalog maps into its own Bazel package, which is what lets the vendor
tree take crates from a subdirectory rather than from a repo root.

The layout is the same [cargo directory source] `crate_repo` produces, with one
difference: `package` in `.cargo-checksum.json` is `null` rather than a hash.
Cargo compares that field against the checksum the lock records for the package,
and for a git dependency the lock records none.

[cargo directory source]: https://doc.rust-lang.org/cargo/reference/source-replacement.html
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")

_HEADER = "Generated by monoext/private/ext/crates. DO NOT EDIT."

# The forge archives are `tar.gz`, but the URL ends in the commit rather than in
# an extension Bazel can read the type off (`<rev>.tar.gz` for GitHub, a path
# component for GitLab), so name it.
_TYPE = "tar.gz"

# The root of the checkout, as `git.json` spells a crate that IS the repo root.
_ROOT = "."

def _join(subdir, path):
    return path if subdir == _ROOT else "%s/%s" % (subdir, path)

def _build_bzl(crate):
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.comment(
            """
            The crate's files, as they appear inside a cargo directory source.
            `.cargo-checksum.json` is named explicitly: it is generated here
            rather than extracted, and cargo rejects the source without it.

            A glob stops at a package boundary, so a crate that is the repo root
            excludes its workspace members here exactly as `cargo vendor` does,
            each member being a package of its own.
            """,
        ),
        Star.fn(
            "filegroup",
            name = "files",
            srcs = Star.glob(
                ["**", ".cargo-checksum.json"],
                exclude = ["BUILD.bazel"],
            ),
        ),
        Star.comment(
            """
            Every crate carries a `Cargo.toml` at its root, so this is the one
            label whose `execpath` names the crate's directory. The vendor tree
            is assembled from those dirnames, since neither the repo's canonical
            name nor the crate's subdirectory is spelled out anywhere else.
            """,
        ),
        Star.exports_files(["Cargo.toml"]),
        Star.assign("CRATE", crate),
        header = _HEADER,
    )

def _impl(rctx):
    rctx.report_progress("fetching git archive {}".format(rctx.attr.strip_prefix))

    rctx.download_and_extract(
        url = rctx.attr.url,
        sha256 = rctx.attr.sha256,
        type = _TYPE,
        stripPrefix = rctx.attr.strip_prefix,
    )

    # `null`, not a hash: cargo reads this before anything else in a directory
    # source and compares `package` against the checksum the lock records, which
    # for a git dependency is absent. The archive is still content-pinned, by
    # the sha256 Bazel just verified it against.
    checksum = json.encode({"files": {}, "package": None})

    for crate, subdir in rctx.attr.crates.items():
        rctx.file(_join(subdir, ".cargo-checksum.json"), checksum, executable = False)
        rctx.file(_join(subdir, "BUILD.bazel"), _build_bzl(crate), executable = False)

git_crates_repo = repository_rule(
    doc = """
    Fetch one git revision and expose the crates it publishes.

    Creates `@<NAME>` with the archive's extracted files and, for every crate in
    `crates`, a Bazel package holding a synthesized `.cargo-checksum.json`, a
    `:files` filegroup and an exported `Cargo.toml` whose `execpath` names the
    crate's directory in the vendor tree.
    """,
    attrs = dict(
        url = attr.string(
            doc = "Archive URL for the revision, from the catalog `git.json`.",
            mandatory = True,
        ),
        strip_prefix = attr.string(
            doc = "The archive's single top-level directory.",
            mandatory = True,
        ),
        sha256 = attr.string(
            doc = "The archive's sha256, from the catalog `git.json`.",
            mandatory = True,
        ),
        crates = attr.string_dict(
            doc = "`{crate: subdirectory}`, from the catalog `git.json`. `.` " +
                  "for a crate that is the repo root.",
            mandatory = True,
        ),
    ),
    implementation = _impl,
)
