load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# The pool itself is created from the module extension, but the two macros that
# consume it (`vendor.bzl`, `cargo_bin.bzl`) are loaded from generated
# `@{name}_ext//...` BUILD files, so those need to be publicly visible.
package(default_visibility = [
    "//monoext/private:__subpackages__",
    "//tests/monoext:__subpackages__",
])

exports_files([
    "crate_repo.bzl",
    "git_crates_repo.bzl",
    "manifest.bzl",
    "pool.bzl",
])

exports_files(
    [
        "cargo_bin.bzl",
        "vendor.bzl",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "crate_repo",
    srcs = ["crate_repo.bzl"],
)

bzl_library(
    name = "git_crates_repo",
    srcs = ["git_crates_repo.bzl"],
    deps = [":manifest"],
)

bzl_library(
    name = "manifest",
    srcs = ["manifest.bzl"],
    deps = ["@toml.bzl//:toml"],
)

bzl_library(
    name = "pool",
    srcs = ["pool.bzl"],
    deps = [
        ":crate_repo",
        ":git_crates_repo",
    ],
)

bzl_library(
    name = "vendor",
    srcs = ["vendor.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "cargo_bin",
    srcs = ["cargo_bin.bzl"],
    visibility = ["//visibility:public"],
)
