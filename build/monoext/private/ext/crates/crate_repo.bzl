"""
Repo rule for ONE crates.io crate, the spoke of the shared crate pool.

pgrx extensions are Rust crates, so building one means building its whole
dependency closure: a few hundred crates that overlap heavily between
extensions, between extension versions and between PG majors (a major is only a
cargo feature, so the closure is literally the same). Vendoring the closure per
build would multiply that by every combination.

So the pool is keyed on (crate, version), the way the shared apt package pool
(`@{hub}_pkgs`) is keyed on (package, version): one repo per unique crate
release, created lazily and shared by every extension that pins it. Unlike the
package pool it hangs off no hub, because a crate release is the same artifact
whichever hub pins it, so all of them share one pool.

Each crate is fetched by the sha256 that the extension's own `Cargo.lock`
already records, so the closure is content-pinned by the lock itself, with no
registry index, no `cargo` and no network at build time. The download goes
through `rctx.download_and_extract`, hence through the Bazel downloader, the
download proxy and the repo cache.

The extracted tree is laid out as a [cargo directory source]: the crate's own
files plus a `.cargo-checksum.json`. Cargo requires that file to exist and to
carry the package hash; the per-file map is allowed to be empty, which is what a
directory source assembled from a verified archive needs (there is no per-file
manifest in a `.crate`, and the archive hash already covers them).

[cargo directory source]: https://doc.rust-lang.org/cargo/reference/source-replacement.html
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")

_HEADER = "Generated by monoext/private/ext/crates. DO NOT EDIT."

# crates.io's CDN, the same endpoint cargo itself downloads from.
_URL = "https://static.crates.io/crates/{crate}/{crate}-{version}.crate"

# A `.crate` is a gzipped tar whose single top-level directory is
# `<crate>-<version>`; the extension is unknown to Bazel, so name the type.
_TYPE = "tar.gz"

def _build_bzl(crate, version):
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.comment(
            """
            The crate's files, as they appear inside a cargo directory source.
            `.cargo-checksum.json` is named explicitly: it is generated here
            rather than extracted, and cargo rejects the source without it.
            """,
        ),
        Star.fn(
            "filegroup",
            name = "files",
            srcs = Star.glob(
                ["**", ".cargo-checksum.json"],
                exclude = ["BUILD.bazel"],
            ),
        ),
        Star.comment(
            """
            Every published crate carries a `Cargo.toml` at its root, so this
            is the one label whose `execpath` names the crate's directory. The
            vendor tree is assembled from those dirnames, since the repo's own
            path is a canonical name the generated BUILD files never spell out.
            """,
        ),
        Star.exports_files(["Cargo.toml"]),
        Star.assign("CRATE", crate),
        Star.assign("VERSION", version),
        header = _HEADER,
    )

def _impl(rctx):
    crate, version = rctx.attr.crate, rctx.attr.version

    url = _URL.format(crate = crate, version = version)

    rctx.report_progress("fetching crate {}-{}".format(crate, version))

    rctx.download_and_extract(
        url = url,
        sha256 = rctx.attr.sha256,
        type = _TYPE,
        stripPrefix = "{}-{}".format(crate, version),
    )

    # Cargo reads this before it reads anything else in a directory source and
    # refuses the source without it. The package hash is the one Bazel just
    # verified the archive against; `files` is empty because a `.crate` carries
    # no per-file manifest and that hash already covers every file in it.
    rctx.file(
        ".cargo-checksum.json",
        json.encode({"files": {}, "package": rctx.attr.sha256}),
        executable = False,
    )

    rctx.file("BUILD.bazel", _build_bzl(crate, version), executable = False)

crate_repo = repository_rule(
    doc = """
    Fetch one crates.io crate as a cargo directory source.

    Creates `@<NAME>` with the crate's extracted files, a synthesized
    `.cargo-checksum.json`, a `:files` filegroup and an exported `Cargo.toml`
    whose `execpath` names the crate's directory in the vendor tree.
    """,
    attrs = dict(
        crate = attr.string(
            doc = "Crate name, as it appears in `Cargo.lock`.",
            mandatory = True,
        ),
        version = attr.string(
            doc = "Crate version, as it appears in `Cargo.lock`.",
            mandatory = True,
        ),
        sha256 = attr.string(
            doc = "The crate's `checksum` from `Cargo.lock`.",
            mandatory = True,
        ),
    ),
    implementation = _impl,
)
