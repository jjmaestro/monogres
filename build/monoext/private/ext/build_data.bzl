"""
Repo rule for the files an extension's build would otherwise download itself.

A build step that fetches its own inputs cannot run in this sandbox, and should
not: nothing content-pins what it fetched. The usual case is a Rust build script
that downloads a data set the crate then compiles in (pg_search embeds three
lindera CJK dictionaries that way, ~70 MB of MeCab source archives), which is
not a crate, so the crate pool cannot pin it and the `Cargo.lock` never mentions
it.

So the catalog pins it directly, in `metadata.build_data`: each file's URL, its
sha256, and the path it takes in a tree the build stages and points the fetching
step at (`LINDERA_CACHE` for lindera, whose build script treats that directory
as a cache and skips the download when the archive it wants is already there,
md5 included). Nothing is extracted here: what a build script looks for is
usually the archive, and it verifies and unpacks that itself.

One repo per extension, hub-independent like the crate pool: the files are the
same whichever flavor's catalog names them, and 70 MB per flavor is not.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")

_HEADER = "Generated by monoext/private/ext. DO NOT EDIT."

def _build_bzl(paths):
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.comment(
            """
            One label per pinned file, named by the path it takes in the staged
            tree, so a build stages it by `execpath` without spelling out this
            repo's canonical name.
            """,
        ),
        Star.exports_files(paths),
        header = _HEADER,
    )

def _impl(rctx):
    paths = sorted(rctx.attr.urls)

    for path in paths:
        rctx.report_progress("fetching build data {}".format(path))

        rctx.download(
            url = rctx.attr.urls[path],
            output = path,
            sha256 = rctx.attr.sha256s[path],
        )

    rctx.file("BUILD.bazel", _build_bzl(paths), executable = False)

build_data_repo = repository_rule(
    doc = """
    Fetch the files an extension's build needs pre-staged.

    Creates `@<NAME>` with each file at the path the catalog declares for it,
    exported under that same name so a build can `execpath` it.
    """,
    attrs = dict(
        urls = attr.string_dict(
            doc = "`{staged path: URL}`, from `metadata.build_data.files`.",
            mandatory = True,
        ),
        sha256s = attr.string_dict(
            doc = "`{staged path: sha256}`, from `metadata.build_data.files`.",
            mandatory = True,
        ),
    ),
    implementation = _impl,
)
