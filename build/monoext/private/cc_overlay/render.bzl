"""Render the native cc_* Postgres overlay BUILD files from the introspect
    JSON.

Pure rendering helpers consumed by `cc_overlay.bzl`'s repo rule. The committed
introspect JSON is a near-complete build graph (per-target sources, resolved
compile/link flags, the codegen command lines, the static-lib/executable/module
structure); these helpers translate it into cc_library / cc_binary / genrule
targets co-located with the symlinked Postgres source.

`render_overlay` returns a `{package: BUILD content}` dict: one BUILD per
target-owning directory (the per-directory "overlay pattern"), labels mirroring
the source tree. The package set comes from `overlay_layout` (layout.bzl); an
empty set collapses every target to the root package (the single-BUILD overlay),
which is how the layered refactor stays behavior-preserving until the real set
is fed in. Label resolution (source / generated / dependency references) lives
in labels.bzl, flag reconciliation in flags.bzl, codegen-genrule translation in
codegen.bzl, and external cc_import / static-dep resolution in imports.bzl; this
file wires them together into the per-category emitters and the top-level entry
point.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//toolchains/perl:perl_toolchain.bzl", _PERL_VERSION = "PERL_VERSION")
load(
    ":codegen.bzl",
    "CODEGEN_TARGETS",
    "codegen_genrule",
    "render_codegen_filegroups",
    "render_config_info_vals",
)
load(
    ":flags.bzl",
    "LLVM_VERSION",
    "MULTIARCH",
    "copts",
    "dedup",
    "includes",
    "linkopts",
    "rel_out",
    "rel_src",
)
load(
    ":imports.bzl",
    "crc_sibling_deps",
    "external_imports",
    "link_static_deps",
    "links_shared_libpq",
)
load(
    ":labels.bzl",
    "dep_label",
    "gen_label",
    "longest_pkg_prefix",
    "src_label",
    "target_home",
)
load(
    ":layout.bzl",
    "DEFERRED_EXES",
    "DEFERRED_LIBS",
    "DEFERRED_MODULES",
)

_HEADER = "Generated by monoext/private/base/cc_overlay. DO NOT EDIT."

_CONFIG_INFO_LIBS = [
    "libpgcommon_srv_config_info",
    "libpgcommon_config_info",
]

# Libraries linked whole (every object), via cc_library `alwayslink`. The
# backend is built from postgres_lib's objects extracted wholesale (meson's
# extract_all_objects), not the archive, so that -export-dynamic exports every
# backend symbol (modules resolve against symbols the linker would otherwise
# drop as unreferenced).
_ALWAYSLINK_LIBS = ["postgres_lib"]

# The backend executable, rendered on its own (link-only: its objects come from
# postgres_lib, so the link line carries no compile sources). The deferred-set
# constants (DEFERRED_LIBS / DEFERRED_EXES / DEFERRED_MODULES) live in
# layout.bzl so the renderer's filtering and overlay_layout's package set cannot
# drift.
_EXE_BACKEND = "postgres"

# Extra deps an executable links that its introspect link line omits (meson
# merges them via `objects:`). pg_config calls get_configdata() from the
# frontend config_info variant, which never appears on its link line.
_EXE_EXTRA_DEPS = {
    "pg_config": ["libpgcommon_config_info"],
}

# The shared libpq cc_library / cc_shared_library names (rendered in
# src/interfaces/libpq); frontends dep them by these names through the index.
_LIBPQ_SHARED = "libpq_shared"
_LIBPQ_SO = "libpq_so"

# The header-support libraries every compiled target depends on, all rendered in
# the root package.
_HDR_LIBS = [
    "pg_config_headers",
    "pg_headers",
    "pg_sysroot_headers",
    "pg_generated_headers",
]

# Loadable symbol -> (load source, order). The per-package BUILD emits exactly
# the loads its rendered rules use, grouped by source in this order (so the root
# overlay reproduces the historical load block).
_LOAD_SOURCES = [
    (
        "@rules_cc//cc:defs.bzl",
        ["cc_binary", "cc_import", "cc_library", "cc_shared_library"],
    ),
    ("@monogres//monoext/private/base:install_tree.bzl", ["pg_install_tree"]),
    ("@monogres//monoext/private/base:jit_bitcode.bzl", ["pg_jit_bitcode"]),
]

# Sources textually #included rather than compiled standalone (so they are not
# in any target's `sources`): the regex engine's split files (regc_*.c /
# rege_*.c, pulled in by regcomp.c / regexec.c), the adt string-match helpers
# (like_match.c, levenshtein.c), and the checked-in character-set conversion
# maps each encoding module #includes. Routed to the package that owns each (a
# `:textual` filegroup), with the rest staying root-globbed.
_TEXTUAL_PATTERNS = [
    "src/backend/regex/*.c",
    "src/backend/utils/adt/like_match.c",
    "src/backend/utils/adt/levenshtein.c",
    "src/backend/utils/mb/Unicode/*.map",
    "src/backend/utils/mb/conversion_procs/*/*.map",
]

# install_plan destination token -> install-tree top dir.
_INSTALL_BIN = "{bindir}/"
_INSTALL_LIB_SHARED = "{libdir_shared}/"
_INSTALL_MODULE = "{moduledir_shared}/"
_INSTALL_LIB = "{libdir}/"
_INSTALL_DATA = "{datadir}/"

# Regress-support modules (`shared module`s marked install:false, so absent from
# the install_plan) the harness needs in the tree under pkglibdir
# (lib/postgresql/): pg_regress dlopen's regress.so via the suite's --dlpath,
# and the trigger tests load refint.so / autoinc.so. Captured when rendered.
_REGRESS_SUPPORT_MODULES = ["regress", "refint", "autoinc"]

# msgfmt (gettext's message-catalog compiler), its runtime libs and glibc's
# charset converters, the NLS genrules use to compile each po/<lang>.po into a
# .mo catalog. gettext is a postgres buildtime dep, so msgfmt + its libgettext*
# / libunistring libs ride the buildtime sysroot the overlay exposes under
# sysroot/; libc and the loader resolve from the sandbox (like the @perl_sysroot
# interpreter).
_NLS_MSGFMT = "//:nls_msgfmt"
_NLS_LIBS = "//:nls_libs"
_NLS_GCONV = "//:nls_gconv"

def _cc_library(**kwargs):
    return Star.igen(Star.fn("cc_library", **kwargs))

def _cc_import(**kwargs):
    return Star.igen(Star.fn("cc_import", **kwargs))

def _cc_binary(**kwargs):
    return Star.igen(Star.fn("cc_binary", **kwargs))

def _new_state(packages, index):
    """The per-render accumulator: package nodes, loads, exports, providers."""
    return {
        "exports": {},  # package -> {rel: True} (cross-package source exports)
        "inc": {},  # package -> True (needs a `:include` provider)
        "index": index,  # {target_name: package} for dep-label resolution
        "infra": {},  # package -> [filegroup / include-provider nodes]
        "needs": {},  # codegen filegroup name -> glob pattern (root)
        "packages": packages,  # active package set (dict used as a set)
        "pkgs": {},  # package -> [target nodes]
        "root_inc": {},  # extra dirs for pg_headers.includes
        "syms": {},  # package -> {load_symbol: True}
        "sysroot_inc": {},  # extra dirs for pg_sysroot_headers.includes
    }

def _emit(st, pkg, node, sym = None):
    st["pkgs"].setdefault(pkg, []).append(node)
    if sym:
        st["syms"].setdefault(pkg, {})[sym] = True

def _emit_infra(st, pkg, node, sym = None):
    st["infra"].setdefault(pkg, []).append(node)
    if sym:
        st["syms"].setdefault(pkg, {})[sym] = True

def _dep(st, name, home):
    return dep_label(st["index"], name, home)

def _src(st, path, home):
    return src_label(st["packages"], st["exports"], path, home)

def _gen(st, out, home):
    return gen_label(st["packages"], out, home)

def _hdr_deps(st, home):
    return [dep_label(st["index"], h, home) for h in _HDR_LIBS]

def _find_target(introspect, name, type_):
    for t in introspect["targets"]:
        if t["name"] == name and t["type"] == type_:
            return t
    fail("introspect has no %s target named %r" % (type_, name))

def _is_gen_header(path):
    """A generated output to stage as a header (not compiled as a lib src)."""
    return (
        path.endswith(".h") or
        path.endswith(".funcs.c") or
        path.endswith(".switch.c")
    )

def _exe_link_ts(target):
    """The target_sources entry holding the executable's link line.

    Meson records a frontend as two entries (a compile entry with `sources` and
    a link entry); the backend has only the link entry. The link entry is the
    one carrying `linker`.
    """
    for ts in target["target_sources"]:
        if "linker" in ts:
            return ts
    fail("executable %r has no link target_sources" % target["name"])

def _exe_compile_ts(target):
    """The executable's compile target_sources entry (the one with `sources`).

    None for the backend, which compiles no sources of its own (its objects come
    from postgres_lib).
    """
    for ts in target["target_sources"]:
        if "sources" in ts:
            return ts
    return None

def _cpp_compile_ts(target):
    """The target's C++ compile entry, if it has one (None otherwise).

    A handful of targets mix C and C++ (llvmjit's LLVM C++ API wrappers); meson
    records the C++ sources in their own `target_sources` entry with C++ flags.
    """
    for ts in target["target_sources"]:
        if ts.get("language") == "cpp" and "sources" in ts:
            return ts
    return None

def _module_so_name(target):
    """A `shared module`'s output .so basename.

    Usually `<target name>.so`, but meson adds a `lib` prefix to a few
    (pqwalreceiver -> libpqwalreceiver.so), and the backend dlopen's the file by
    that name (`$libdir/libpqwalreceiver`), so derive it from the build output.
    """
    return target["filename"][0].rsplit("/", 1)[-1]

def _module_pl_dirs(module_specs):
    """The `src/pl/<lang>` dirs of the rendered PL modules.

    A core PL's extension packaging (its `.control` / `--<ver>.sql`, under
    `src/pl/<lang>/`) installs only when that PL's module is built; a deferred
    PL's files (and every contrib extension's) land with their own phase.
    """
    dirs = {}
    marker = "/gh/src/pl/"
    for target, _, _ in module_specs:
        defined_in = target["defined_in"]
        if marker in defined_in:
            lang = defined_in.split(marker, 1)[1].split("/", 1)[0]
            dirs["src/pl/" + lang] = True
    return dirs

def _classify_include(packages, d):
    """Classify a per-target `-I` dir for the post-split include strategy.

    Returns one of: ("covered", None) when a root header lib already supplies it
    root-anchored; ("sysroot", d) for a buildtime-sysroot subdir (added to
    pg_sysroot_headers); ("provider", pkg) when the dir is its own package (a
    `//pkg:include` provider supplies the `-I`); ("root", d) for any other dir
    (added to pg_headers root-anchored).

    Args:
        packages: the active overlay package set.
        d: an overlay-relative include dir.

    Returns:
        A (kind, value) tuple.
    """
    if d == "src/include" or d == "src/common" or d == "config_headers":
        return ("covered", None)
    if d.startswith("sysroot/"):
        return ("sysroot", d)
    owner = longest_pkg_prefix(packages, d)
    if owner == d:
        return ("provider", d)
    return ("root", d)

def _collect_extra_includes(introspect, st):
    """Pre-scan every rendered target's `-I` dirs into the root header libs.

    The header libs (pg_headers / pg_sysroot_headers) are rendered before the
    targets, so the buildtime-sysroot subdir includes and the non-package source
    includes that move from per-target `includes` to a root-anchored carrier are
    gathered up front. A no-op while the split is inactive (the per-target
    `includes` stay verbatim).

    Args:
        introspect: the decoded introspect JSON.
        st: the render state, mutated (root_inc / sysroot_inc).
    """
    if not st["packages"]:
        return
    for t in introspect["targets"]:
        type_ = t["type"]
        if type_ not in ("static library", "executable", "shared module"):
            continue
        for ts in t["target_sources"]:
            if "sources" not in ts:
                continue
            for d in includes(ts["parameters"]):
                kind, val = _classify_include(st["packages"], d)
                if kind == "sysroot":
                    st["sysroot_inc"][val] = True
                elif kind == "root":
                    st["root_inc"][val] = True

def _include_deps(st, params, home):
    """Resolve a target's `-I` dirs to (includes attr, `:include` provider deps).

    At the root package the introspect `-I` dirs stay the `includes` attr (they
    are already repo-root-relative). Once the target moves to its package they
    would be mangled package-relative, so they are re-expressed: the target's
    own dir becomes `["."]` (it must stay on the path so a generated source in
    genfiles resolves its source-tree siblings, which span both roots); the root
    header libs supply the shared / sysroot dirs root-anchored (see
    `_collect_extra_includes`); and each foreign source-dir package supplies its
    own via a `//pkg:include` provider, which this records and depends on.

    Args:
        st: the render state, mutated (`inc` providers).
        params: a target's introspect compile `parameters`.
        home: the consuming target's package.

    Returns:
        An (includes_attr, dep_labels) tuple.
    """
    inc_dirs = includes(params)
    if home == "":
        return inc_dirs, []
    attr = ["."] if home in inc_dirs else []
    deps = []
    for d in inc_dirs:
        kind, val = _classify_include(st["packages"], d)
        if kind == "provider" and val != home:
            st["inc"][val] = True
            deps.append("//%s:include" % val)
    return attr, dedup(deps)

def _route_textual(packages):
    """Map each textual-include pattern to the package that owns it.

    Args:
        packages: the active overlay package set.

    Returns:
        A {owner_pkg: [package-relative patterns]} dict ("" for the root).
    """
    routed = {}
    for pat in _TEXTUAL_PATTERNS:
        head = pat.split("*", 1)[0]
        base = head.rsplit("/", 1)[0] if "/" in head else ""
        owner = longest_pkg_prefix(packages, base)
        rel = pat[len(owner) + 1:] if owner else pat
        routed.setdefault(owner, []).append(rel)
    return routed

def _hdr_list(labels, glob_pats):
    """A hdrs/textual_hdrs value: aggregated `//pkg:x` labels plus a root glob."""
    if labels and glob_pats:
        return Star.binop("+", labels, Star.glob(glob_pats))
    if labels:
        return labels
    return Star.glob(glob_pats)

def _render_header_libs(st, gen_hdrs):
    """Render the four root header-support libraries.

    pg_config_headers (the captured pg_config*.h), pg_headers (the src/ header
    tree, aggregated per-package once the split is active), pg_sysroot_headers
    (the buildtime-sysroot external-dep headers), and pg_generated_headers (the
    codegen outputs). Every compiled target depends on all four; their
    `includes` are only correct rooted at the overlay root, so they stay in the
    root package.

    Args:
        st: the render state.
        gen_hdrs: the generated header outputs (overlay paths) to stage.
    """
    pkgs = sorted(st["packages"].keys())

    _emit(st, "", _cc_library(
        name = "pg_config_headers",
        hdrs = Star.glob(["config_headers/*.h"]),
        includes = ["config_headers"],
    ), "cc_library")

    routed = _route_textual(st["packages"])
    _emit(st, "", _cc_library(
        name = "pg_headers",
        # All source headers under src/: targets #include sibling headers from
        # many dirs that must be staged into the sandbox. Per-package `:hdrs`
        # filegroups carry each package's headers (a root glob stops at package
        # boundaries); the root glob catches the non-package src subtrees.
        hdrs = _hdr_list(["//%s:hdrs" % p for p in pkgs], ["src/**/*.h"]),
        textual_hdrs = _hdr_list(
            ["//%s:textual" % o for o in sorted([o for o in routed if o])],
            routed.get("", []),
        ),
        includes = ["src/include"] + sorted(st["root_inc"].keys()),
    ), "cc_library")

    _emit(st, "", _cc_library(
        name = "pg_sysroot_headers",
        # The include tree plus perl's CORE headers (EXTERN.h / perl.h /
        # XSUB.h), which Debian ships under usr/lib/<arch>/perl/<ver>/CORE
        # rather than usr/include; plperl's per-target -I points there.
        hdrs = Star.glob([
            "sysroot/usr/include/**",
            "sysroot/usr/lib/" + MULTIARCH + "/perl/" + _PERL_VERSION + "/CORE/**",
            "sysroot/usr/lib/llvm-" + LLVM_VERSION + "/include/**",
        ]),
        includes = [
            "sysroot/usr/include",
            "sysroot/usr/include/" + MULTIARCH,
        ] + sorted(st["sysroot_inc"].keys()),
    ), "cc_library")

    _emit(st, "", _cc_library(
        name = "pg_generated_headers",
        # Generated headers plus the node-support function bodies (textually
        # #included, not compiled standalone). kwlist_d.h lands under src/common
        # (included bare), the rest under src/include subdirs.
        hdrs = sorted(dedup([_gen(st, o, "") for o in gen_hdrs])),
        includes = ["src/include", "src/common"],
    ), "cc_library")

def _render_shared_libpq(st, introspect, lib_names):
    """Render the shared libpq (libpq.so.5.16) the way meson links it.

    meson builds libpq twice (a static_library and a shared_library) and the
    `libpq` dependency every frontend consumes is the shared one
    (declare_dependency(link_with: libpq_so)). Mirror that: a cc_library of the
    shared variant's sources (compiled -fPIC, linking the _shlib port / common
    variants), wrapped in a cc_shared_library that names the output
    libpq.so.5.16, sets the soname libpq.so.5, and applies libpq's symbol export
    map (gen_export.pl turns exports.txt into a GNU version script restricting
    the exported symbols to the public libpq API). Emitted into the libpq
    package; frontends dynamic_dep it.

    Args:
        st: the render state, mutated (libpq nodes emitted).
        introspect: the decoded introspect JSON.
        lib_names: the set of rendered convenience-lib names.

    Returns:
        The external cc_import specs the .so needs (so the caller renders them).
    """
    home = target_home(
        st["packages"],
        _find_target(introspect, "libpq", "shared library")["defined_in"],
    )

    # The GNU version script: perl gen_export.pl --format gnu exports.txt.
    exports = _find_target(introspect, "libpq.exports", "custom")
    exp_home, exports_node, exports_outs = codegen_genrule(
        exports,
        st["packages"],
        st["exports"],
        st["needs"],
    )
    _emit(st, exp_home, exports_node)
    version_script = _gen(st, exports_outs[0], home)

    so = _find_target(introspect, "libpq", "shared library")
    cts = _exe_compile_ts(so)
    link_params = _exe_link_ts(so)["parameters"]

    # libpq is pure C; its externals are all C shared libraries. The static
    # libstdc++ meson appends to every link line is unused here, and bundling it
    # (a static archive) into the .so would collide with the frontends that
    # genuinely link it (for ICU), so keep only the shared externals.
    imports = [i for i in external_imports(link_params) if i.shared]
    static_deps = link_static_deps(link_params)
    static_deps = static_deps + crc_sibling_deps(static_deps, lib_names)
    inc_attr, inc_deps = _include_deps(st, cts["parameters"], home)
    _emit(st, home, _cc_library(
        name = _LIBPQ_SHARED,
        srcs = sorted([_src(st, rel_src(s), home) for s in cts["sources"]]),
        copts = copts(cts["parameters"]),
        includes = inc_attr,
        deps = _hdr_deps(st, home) +
               [_dep(st, d[len(":"):], home) for d in static_deps] +
               inc_deps +
               [_dep(st, i.name, home) for i in imports],
    ), "cc_library")
    _emit(st, home, Star.igen(Star.fn(
        "cc_shared_library",
        name = _LIBPQ_SO,
        shared_lib_name = "libpq.so.5.16",
        deps = [_dep(st, _LIBPQ_SHARED, home)],
        additional_linker_inputs = [version_script],
        user_link_flags = [
            "-Wl,-soname,libpq.so.5",
            "-Wl,--version-script=$(location %s)" % version_script,
        ],
    )), "cc_shared_library")
    return imports

def _render_nls(st, introspect):
    """Render the NLS message catalogs (.mo) and return their install map.

    Each translatable component carries one `custom` target per language that
    runs msgfmt over its `po/<lang>.po` into a `<domain>-<major>.mo` catalog,
    installed under share/locale/<lang>/LC_MESSAGES/. The catalog is
    architecture-neutral, so each genrule renders in the package that owns the
    .po (the component's package, or the root for a domain whose dir is not a
    package) and runs msgfmt from the overlay sysroot. msgfmt's lib dir is
    recovered from its own execpath (../lib/<multiarch> from its bin dir) so the
    LD_LIBRARY_PATH holds whatever overlay repo the action stages.

    Args:
        st: the render state, mutated (the msgfmt filegroups + per-catalog
            genrules).
        introspect: the decoded introspect JSON.

    Returns:
        A {mo_label: install-rel dest} dict (empty when the build has no NLS).
    """
    mos = [
        t
        for t in introspect["targets"]
        if t["type"] == "custom" and t["name"].endswith(".mo")
    ]
    if not mos:
        return {}

    # msgfmt as a single-file target (so `$(execpath)` is unambiguous) plus its
    # runtime libs from the same sysroot, staged into every catalog genrule.
    _emit(st, "", Star.igen(Star.fn(
        "filegroup",
        name = "nls_msgfmt",
        srcs = ["sysroot/usr/bin/msgfmt"],
    )))

    # msgfmt's full transitive .so closure, globbed from both sysroot lib dirs
    # since the minimal sandbox provides only the loader. msgfmt itself loads
    # libgettextsrc + libgettextlib, and those pull libtextstyle (which needs
    # libtinfo), libacl / libattr, libunistring, libicu / libxml2 / liblzma;
    # nothing in the chain carries a RUNPATH, so the LD_LIBRARY_PATH below is
    # the only resolution path and has to cover every link of it.
    _nls_lib_dirs = ["sysroot/usr/lib/" + MULTIARCH, "sysroot/lib/" + MULTIARCH]
    _nls_lib_pats = [
        "libgettext*.so",
        "libunistring.so*",
        "libtextstyle.so*",
        "libtinfo.so*",
        "libacl.so*",
        "libattr.so*",
        "libicu*.so*",
        "libxml2.so*",
        "liblzma.so*",
        "libc.so*",
        "libm.so*",
        "libz.so*",
        "libstdc++.so*",
        "libgcc_s.so*",
    ]
    _emit(st, "", Star.igen(Star.fn(
        "filegroup",
        name = "nls_libs",
        srcs = Star.glob(
            [d + "/" + p for d in _nls_lib_dirs for p in _nls_lib_pats],
            allow_empty = True,
        ),
    )))

    # glibc's charset converter modules. iconv() loads them from the compiled-in
    # /usr/lib/<multiarch>/gconv, which the sandbox does not have, and msgfmt
    # needs them for every catalog whose .po is not already UTF-8 (nb.po is
    # ISO-8859-1). GCONV_PATH below redirects glibc to this staged copy; setting
    # it also makes glibc parse gconv-modules + gconv-modules.d/ instead of the
    # gconv-modules.cache it would only read from the compiled-in dir.
    _emit(st, "", Star.igen(Star.fn(
        "filegroup",
        name = "nls_gconv",
        srcs = Star.glob(
            ["sysroot/usr/lib/" + MULTIARCH + "/gconv/**"],
            allow_empty = True,
        ),
    )))

    nls_files = {}
    for t in mos:
        po = rel_src(t["target_sources"][0]["sources"][0])
        lang = po.rsplit("/", 1)[-1][:-len(".po")]
        home = longest_pkg_prefix(st["packages"], po.rsplit("/", 1)[0])
        out_full = (home + "/" + t["name"]) if home else t["name"]
        out_lbl = _gen(st, out_full, home)
        cmd = (
            'M="$(execpath %s)"\n' % _NLS_MSGFMT +
            'D="$$(pwd)/$$(dirname "$$M")"\n' +
            'export LD_LIBRARY_PATH="$$D/../lib/' + MULTIARCH + ":$$D/../../lib/" + MULTIARCH +
            '$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}"\n' +
            'export GCONV_PATH="$$D/../lib/' + MULTIARCH + '/gconv"\n' +
            '"$$M" -o $(execpath %s) $(execpath %s)\n' % (out_lbl, _src(
                st,
                po,
                home,
            ))
        )
        _emit(st, home, Star.igen(Star.fn(
            "genrule",
            name = "gen_" + t["name"].replace(
                "/",
                "_",
            ).replace(".", "_").replace("-", "_"),
            srcs = [_src(st, po, home), _NLS_LIBS, _NLS_GCONV],
            outs = [out_lbl],
            cmd = Star.tstr(cmd),
            tools = [_NLS_MSGFMT],
        )))
        install_base = t["name"][:-len("-" + lang + ".mo")] + ".mo"
        nls_files[_gen(
            st,
            out_full,
            "",
        )] = "share/locale/%s/LC_MESSAGES/%s" % (lang, install_base)
    return nls_files

def _render_install(
        st,
        introspect,
        exe_names,
        produced,
        module_so,
        pl_ext_dirs,
        nls_files):
    """Render the install tree as `:tar`, matching the RFCC install layout.

    Driven by the introspect install_plan: each entry's destination
    ({bindir}/{libdir_shared}/{moduledir_shared}/{datadir} -> bin/lib/lib/share,
    under prefix_distro /postgres/<version>) maps an artifact to its install
    path. Sources resolve by build-path root: an executable to its rendered
    cc_binary, libpq.so to the cc_shared_library, a core module to its
    linkshared cc_binary, a `build_tmpdir/` path to its generated output, a
    `/gh/` path to the symlinked source. This is the runnable tree: the backend,
    frontends, libpq, every loadable module (the core loadables, the PLs and the
    contrib extensions), the extension packaging ({datadir}/extension), the NLS
    catalogs ({datadir}/locale) and the bootstrap data initdb / postgres read.
    The server headers ({includedir}), the static archives ({libdir_static}) and
    the pgxs / pkg-config files land with their own phases.

    Emitted into the root package (the install rule is the validation contract,
    label `@<overlay>//:tar`); the install_subdir filegroups render in whichever
    package owns the globbed source directory.

    Args:
        st: the render state, mutated (filegroups emitted, `:tar` returned).
        introspect: the decoded introspect JSON.
        exe_names: the rendered executable names.
        produced: the set of generated outputs (overlay paths) rendered.
        module_so: the set of rendered module .so output names.
        pl_ext_dirs: the `src/pl/<lang>` dirs of the rendered PLs.
        nls_files: the {mo_label: share/locale dest} map from `_render_nls`.

    Returns:
        The pg_install_tree node.
    """
    files = {}
    for section in ("targets", "data", "configure"):
        for key, meta in introspect["install_plan"].get(section, {}).items():
            dest = meta["destination"]

            # `files` is a label-keyed dict: {source_label: install-rel dest}.
            if dest.startswith(_INSTALL_BIN):
                name = dest[len(_INSTALL_BIN):].rsplit("/", 1)[-1]
                if name in exe_names:
                    files[_dep(st, name, "")] = "bin/" + name
            elif dest.startswith(_INSTALL_LIB_SHARED):
                rel = dest[len(_INSTALL_LIB_SHARED):]
                if rel == "libpq.so.5.16":
                    files[_dep(st, _LIBPQ_SO, "")] = "lib/" + rel
            elif dest.startswith(_INSTALL_MODULE):
                # rel is the module's output .so basename; the rendered target
                # is named after the same build output.
                rel = dest[len(_INSTALL_MODULE):]
                if rel in module_so:
                    files[_dep(st, rel, "")] = "lib/" + rel
            elif dest.startswith(_INSTALL_LIB):
                # The regress drivers (pg_regress, pg_isolation_regress,
                # isolationtester) install under lib/pgxs/src/test/..., not
                # bin/; the harness finds them by name anywhere under lib/. The
                # JIT type bitcode (llvmjit_types.bc) lands at lib/ when llvmjit
                # is built. Other {libdir} entries (static archives, pgxs
                # makefiles) land later.
                rel = dest[len(_INSTALL_LIB):]
                name = rel.rsplit("/", 1)[-1]
                if name in exe_names:
                    files[_dep(st, name, "")] = "lib/" + rel
                elif rel == "llvmjit_types.bc" and "llvmjit.so" in module_so:
                    files[_dep(st, rel, "")] = "lib/" + rel
            elif dest.startswith(_INSTALL_DATA):
                sub = dest[len(_INSTALL_DATA):]
                if sub.startswith("locale/"):
                    continue

                # extension/ holds the .control / .sql packaging. A PL's
                # installs with its built module (its files live under
                # src/pl/<lang>/); every contrib extension's installs from
                # contrib/ (including the data-only ones, e.g. intagg, that
                # build no module). sepgsql's .sql is generated, so it arrives
                # as a build_tmpdir output rather than a /gh/ source.
                if sub.startswith("extension/"):
                    if "introspect.build_tmpdir/" in key:
                        edir = rel_out(key).rsplit("/", 1)[0]
                    elif "/gh/" in key:
                        edir = rel_src(key).rsplit("/", 1)[0]
                    else:
                        continue
                    in_pl = [
                        d
                        for d in pl_ext_dirs
                        if edir == d or edir.startswith(d + "/")
                    ]
                    if not edir.startswith("contrib/") and not in_pl:
                        continue
                src = None
                if "introspect.build_tmpdir/" in key:
                    out = rel_out(key)
                    if out in produced:
                        src = _gen(st, out, "")
                elif "/gh/" in key:
                    src = _src(st, rel_src(key), "")
                if src:
                    files[src] = "share/" + sub

    # The install:false regress-support modules the harness loads from pkglibdir
    # (lib/postgresql/); they have no install_plan entry, so capture them here.
    for mod in _REGRESS_SUPPORT_MODULES:
        if mod + ".so" in module_so:
            files[_dep(st, mod + ".so", "")] = "lib/postgresql/" + mod + ".so"

    # NLS catalogs (msgfmt-compiled .mo) install under share/locale/.
    for lbl, dest in nls_files.items():
        files[lbl] = dest

    # install_subdirs: meson install_subdir copies a source directory's contents
    # into a dest dir. The text-search data lands this way (the snowball
    # stopwords incl english.stop, the sample dictionaries incl
    # ispell_sample.*), which the FTS dictionaries read at run time. Glob each
    # (flat) data dir into a filegroup, in the package that owns the dir, and
    # install every file to the dest dir.
    subdir_files = {}
    for key, meta in introspect["install_plan"].get(
        "install_subdirs",
        {},
    ).items():
        dest = meta["destination"]
        if not dest.startswith(_INSTALL_DATA):
            continue
        sub = dest[len(_INSTALL_DATA):]
        if sub.startswith(
            "locale/",
        ) or sub.startswith("extension/") or "/gh/" not in key:
            continue
        srcdir = rel_src(key)
        owner = longest_pkg_prefix(st["packages"], srcdir)
        rel_dir = srcdir[len(owner) + 1:] if owner else srcdir
        excludes = [
            rel_dir + "/" + e
            for e in (meta.get("exclude_files") or [])
        ]
        fg = "instdir_" + srcdir.replace("/", "_")
        glob_srcs = Star.glob(
            [rel_dir + "/*"],
            exclude = excludes,
        ) if excludes else Star.glob([rel_dir + "/*"])
        _emit_infra(
            st,
            owner,
            Star.igen(Star.fn("filegroup", name = fg, srcs = glob_srcs)),
        )
        label = ("//%s:%s" % (owner, fg)) if owner else ":" + fg
        subdir_files[label] = "share/" + sub

    return Star.igen(Star.fn(
        "pg_install_tree",
        name = "tar",
        files = files,
        subdir_files = subdir_files,
        # libpq ships as the real libpq.so.5.16 plus the soname and dev symlinks
        # (the loader follows libpq.so.5; an install creates these).
        symlinks = {
            "lib/libpq.so": "libpq.so.5",
            "lib/libpq.so.5": "libpq.so.5.16",
        },
    ))

def _build_index(introspect, packages):
    """Map every rendered target's reference name to its overlay package.

    Static libs (by archive basename), installed executables (by name), and
    shared modules (by `.so` output name) each render in their `defined_in`
    package; the shared libpq targets render in src/interfaces/libpq. Used to
    resolve a `:name` dependency / install reference to `//pkg:name`.

    Args:
        introspect: the decoded introspect JSON.
        packages: the active overlay package set.

    Returns:
        A {target_name: package} dict.
    """
    index = {}
    for t in introspect["targets"]:
        type_ = t["type"]
        if type_ == "static library":
            index[t["name"]] = target_home(packages, t["defined_in"])
        elif type_ == "executable" and t.get("installed"):
            index[t["name"]] = target_home(packages, t["defined_in"])
        elif type_ == "shared module" and t["name"] not in DEFERRED_MODULES:
            index[_module_so_name(t)] = target_home(packages, t["defined_in"])
    libpq_home = target_home(
        packages,
        _find_target(introspect, "libpq", "shared library")["defined_in"],
    )
    index[_LIBPQ_SHARED] = libpq_home
    index[_LIBPQ_SO] = libpq_home
    return index

def _render_infra(st):
    """Render each package's header filegroups and `:include` provider.

    Every package contributes a `:hdrs` filegroup (its own header tree, a glob
    that stops at sub-package boundaries) so the root pg_headers can aggregate
    them; the packages that own textually-included sources add a `:textual`
    filegroup; the packages a foreign target adds to its include path get a
    `:include` cc_library provider (the `-I` propagates root-anchored). A no-op
    while the split is inactive (no packages exist).

    Args:
        st: the render state, mutated (infra nodes emitted).
    """
    routed = _route_textual(st["packages"])
    for p in sorted(st["packages"].keys()):
        # A package may own no headers (e.g. a frontend that is all .c), so the
        # header glob must tolerate an empty match.
        _emit_infra(st, p, Star.igen(Star.fn(
            "filegroup",
            name = "hdrs",
            srcs = Star.glob(["**/*.h"], allow_empty = True),
        )))
        if p in routed:
            _emit_infra(st, p, Star.igen(Star.fn(
                "filegroup",
                name = "textual",
                srcs = Star.glob(sorted(routed[p])),
            )))
        if p in st["inc"]:
            _emit_infra(st, p, _cc_library(
                name = "include",
                hdrs = Star.glob(["*.h"], allow_empty = True),
                includes = ["."],
            ), "cc_library")

def _assemble(st, header):
    """Compose the per-package BUILD content from the accumulated nodes.

    Args:
        st: the render state.
        header: the BUILD file header.

    Returns:
        A {package: BUILD content} dict.
    """
    all_pkgs = {}
    for bucket in ("pkgs", "infra", "exports"):
        for p in st[bucket].keys():
            all_pkgs[p] = True

    out = {}
    for p in sorted(all_pkgs.keys()):
        syms = st["syms"].get(p, {})
        parts = []
        for source, symbols in _LOAD_SOURCES:
            used = [s for s in symbols if s in syms]
            if used:
                parts.append(Star.load_(source, *used))
        parts.append(Star.package(default_visibility = ["//visibility:public"]))
        ex = st["exports"].get(p, {})
        if ex:
            parts.append(
                Star.exports_files(
                    sorted(ex.keys()),
                    visibility = ["//visibility:public"],
                ),
            )
        parts.extend(st["infra"].get(p, []))
        parts.extend(st["pkgs"].get(p, []))
        out[p] = Star.file(header = header, *parts)
    return out

def render_overlay(introspect, version, option_set, packages, src_prefix = ""):
    """Render the overlay BUILD files for one (version, option_set).

    Emits the header-support libraries, the codegen genrules, and a cc_* target
    per static lib / executable / shared module read from the introspect, each
    co-located with the source it builds. `packages` selects the per-directory
    layout: the real `overlay_layout` set splits the overlay into one BUILD per
    target-owning directory; an empty set collapses everything into a single
    root BUILD (the behavior-preserving baseline).

    Args:
        introspect: decoded introspect JSON for this (version, option_set).
        version: PG version string (e.g. "16.0"); recorded in the BUILD header.
        option_set: option set name (e.g. "full"); recorded in the header.
        packages: the overlay package paths (from `overlay_layout`); empty for
            the single-BUILD root layout.
        src_prefix: the overlay repo root to strip from `__FILE__` (e.g.
            "external/<repo>/"); empty disables the source-path remap.

    Returns:
        A {package: BUILD content} dict ("" is the root package).
    """
    header = "%s\nPostgres %s / %s native cc_* build." % (_HEADER, version, option_set)
    pkg_set = {p: True for p in packages}
    st = _new_state(pkg_set, _build_index(introspect, pkg_set))

    # Map the overlay source root out of `__FILE__`: the cc actions compile from
    # `external/<overlay-repo>/<pkg-rel>`, so without this the embedded source
    # path in `.rodata` (PostgreSQL bakes `__FILE__` into every elog/assert) is
    # overlay-repo-specific. Strip `src_prefix` to the package-relative path
    # (`src/...`, `contrib/...`) so the embedded source strings depend only on
    # the source tree. Generated sources (the flex/bison/xsubpp scanners and
    # parsers) compile from the genfiles tree
    # `$(BINDIR)/external/<overlay-repo>/<pkg-rel>`, so a second map strips that
    # root to the same package-relative form.
    st["copts_extra"] = [
        "-fmacro-prefix-map=%s=" % src_prefix,
        "-fmacro-prefix-map=$(BINDIR)/%s=" % src_prefix,
    ] if src_prefix else []

    _collect_extra_includes(introspect, st)

    # Producer index: every generated output mapped to the custom target that
    # emits it. Keying on the output (not the target name) keeps the two
    # same-named `gram` targets (backend parser vs plpgsql) distinct.
    producer = {}
    for t in introspect["targets"]:
        if t["type"] == "custom":
            for f in t["filename"]:
                producer[rel_out(f)] = t

    # The static libs to render (non-deferred) and the codegen targets they pull
    # in. Each lib's `generated_sources` lists its compiled generated .c; map
    # each back to its producer custom target (deduped by id). The perl header
    # generators are added unconditionally (no lib lists them as a compiled
    # source).
    want_ids = {}
    want = []
    for name in CODEGEN_TARGETS:
        t = _find_target(introspect, name, "custom")
        if t["id"] not in want_ids:
            want_ids[t["id"]] = True
            want.append(t)

    lib_specs = []
    for target in introspect["targets"]:
        if target["type"] != "static library":
            continue
        if target["name"] in DEFERRED_LIBS:
            continue
        ts = target["target_sources"][0]
        static_srcs = [rel_src(s) for s in ts.get("sources", [])]
        gen_srcs = [rel_out(s) for s in ts.get("generated_sources", [])]
        for gs in gen_srcs:
            p = producer.get(gs)
            if not p:
                fail(
                    "no producer for generated source %r (lib %r)" % (gs, target["name"]),
                )
            if p["id"] not in want_ids:
                want_ids[p["id"]] = True
                want.append(p)
        if not static_srcs and not gen_srcs:
            continue
        lib_specs.append((target, static_srcs, gen_srcs))

    # The installed frontends (initdb, psql, the pg_* tools, ...) and the
    # codegen they pull. Each compiles its own sources; resolve its compiled
    # `generated_sources` (psql's sql_help.c / psqlscanslash.c, pgbench's
    # exprparse.c / exprscan.c, ...) through the same producer index.
    frontend_specs = []
    for target in introspect["targets"]:
        if target["type"] != "executable" or not target.get("installed"):
            continue
        if target["name"] == _EXE_BACKEND or target["name"] in DEFERRED_EXES:
            continue
        cts = _exe_compile_ts(target)
        static_srcs = [rel_src(s) for s in cts.get("sources", [])]
        gen_srcs = [rel_out(s) for s in cts.get("generated_sources", [])]
        for gs in gen_srcs:
            p = producer.get(gs)
            if not p:
                fail(
                    "no producer for generated source %r (exe %r)" % (gs, target["name"]),
                )
            if p["id"] not in want_ids:
                want_ids[p["id"]] = True
                want.append(p)
        frontend_specs.append((target, static_srcs, gen_srcs))

    # The shared modules (loadable .so the backend dlopen's: the encoding
    # conversions, the PLs, dict_snowball, and every contrib extension). Same
    # producer-index resolution for their compiled generated sources (plpgsql's
    # pl_gram.c / pl_*kwlist.h, cube's / seg's bison + flex scanners).
    module_specs = []
    for target in introspect["targets"]:
        if target["type"] != "shared module":
            continue
        if target["name"] in DEFERRED_MODULES:
            continue
        cts = _exe_compile_ts(target)
        static_srcs = [rel_src(s) for s in cts.get("sources", [])]
        gen_srcs = [rel_out(s) for s in cts.get("generated_sources", [])]
        for gs in gen_srcs:
            p = producer.get(gs)
            if not p:
                fail(
                    "no producer for generated source %r (module %r)" % (gs, target["name"]),
                )
            if p["id"] not in want_ids:
                want_ids[p["id"]] = True
                want.append(p)
        module_specs.append((target, static_srcs, gen_srcs))

    # Codegen input closure: a genrule may consume a generated source as its
    # input (the ecpg preprocessor grammar is generated -- bison reads
    # preproc.y, which the perl parse.pl emits from the backend gram.y and the
    # ecpg addon files), so pull in the producer of every generated codegen
    # input until the set is closed (Starlark has no while loop; the bound is a
    # safe over-count).
    for _ in range(1000):
        added = False
        for t in list(want):
            for s in t["target_sources"][0]["sources"]:
                if "introspect.build_tmpdir/" not in s:
                    continue
                p = producer.get(rel_out(s))
                if p and p["id"] not in want_ids:
                    want_ids[p["id"]] = True
                    want.append(p)
                    added = True
        if not added:
            break

    # Render the codegen genrules into their packages; collect their header-like
    # outputs (real headers plus the textually-included node bodies) into
    # pg_generated_headers, and the produced-output set for the install tree.
    gen_hdrs = []
    produced = {}
    for t in want:
        home, node, outs = codegen_genrule(
            t,
            st["packages"],
            st["exports"],
            st["needs"],
        )
        _emit(st, home, node)
        for o in outs:
            produced[o] = True
            if _is_gen_header(o):
                gen_hdrs.append(o)

    # The native pg_config build strings (VAL_*), force-included into the
    # config_info libs. The VAL_* are identical across the config_info variants,
    # so render one header (from the frontend variant's parameters) and stage it
    # via pg_generated_headers.
    ci_home, ci_node, ci_header = render_config_info_vals(
        _find_target(
            introspect,
            "libpgcommon_config_info",
            "static library",
        )["target_sources"][0]["parameters"],
        st["packages"],
    )
    _emit(st, ci_home, ci_node)
    gen_hdrs.append(ci_header)

    # The header-support libraries, which aggregate the per-package header
    # filegroups and the generated outputs collected above.
    _render_header_libs(st, gen_hdrs)

    # Static libs: the libpgport / libpgcommon convenience family and their _srv
    # / _shlib / _crc / _ryu variants, and the parser libs (boot_parser, parser,
    # repl_parser, jsonpath, guc-file) and libpgfeutils, whose compiled bison /
    # flex sources come from the genrules above. The flag variants differ only
    # in their per-target `parameters`, which `copts` reproduces. The
    # include-only generated bodies stay out of srcs (they arrive via
    # pg_generated_headers).
    for target, static_srcs, gen_srcs in lib_specs:
        ts = target["target_sources"][0]
        home = target_home(st["packages"], target["defined_in"])
        compiled_gen = [s for s in gen_srcs if not _is_gen_header(s)]
        srcs = sorted(dedup(
            [_src(st, s, home) for s in static_srcs] +
            [_gen(st, s, home) for s in compiled_gen],
        ))
        copts_ = copts(ts["parameters"]) + st["copts_extra"]
        if target["name"] in _CONFIG_INFO_LIBS:
            # The sanitized -DVAL_* are dropped by copts; force-include the
            # native ones instead (resolved via -Isrc/common from the headers).
            copts_ = copts_ + ["-include", "config_info_vals.h"]
        inc_attr, inc_deps = _include_deps(st, ts["parameters"], home)
        kwargs = dict(
            name = target["name"],
            srcs = srcs,
            copts = copts_,
            includes = inc_attr,
            deps = _hdr_deps(st, home) + inc_deps,
        )
        if target["name"] in _ALWAYSLINK_LIBS:
            kwargs["alwayslink"] = True
        _emit(st, home, _cc_library(**kwargs), "cc_library")

    lib_names = {target["name"]: True for target, _, _ in lib_specs}

    # The shared libpq (libpq.so.5.16) the frontends dynamically link, plus the
    # external libraries it carries (rendered as cc_imports below).
    libpq_imports = _render_shared_libpq(st, introspect, lib_names)

    backend = _find_target(introspect, _EXE_BACKEND, "executable")
    backend_home = target_home(st["packages"], backend["defined_in"])
    exe_items = [(backend, [_dep(st, "postgres_lib", backend_home)], None)]
    for target, static_srcs, gen_srcs in frontend_specs:
        exe_items.append((target, None, (static_srcs, gen_srcs)))

    # Seed the imports with libpq.so's, so the cc_imports its cc_library depends
    # on are rendered even if no executable links them directly.
    all_imports = []
    seen_imp = {}
    for imp in libpq_imports:
        seen_imp[imp.name] = True
        all_imports.append(imp)

    # Executables: the backend (link-only, base dep on postgres_lib) and the
    # frontends (each compiling its own sources). Translate each introspect link
    # line the same way: the convenience archives become deps and the external
    # libraries become cc_imports. The backend's line omits postgres_lib itself
    # (meson links its objects wholesale, alwayslink here, so -export-dynamic
    # exports them), so that edge is pinned.
    for target, base_deps, compile_spec in exe_items:
        home = target_home(st["packages"], target["defined_in"])
        link_params = _exe_link_ts(target)["parameters"]
        static_deps = link_static_deps(link_params)
        static_deps = static_deps + crc_sibling_deps(static_deps, lib_names)
        imps = external_imports(link_params)
        for imp in imps:
            if imp.name not in seen_imp:
                seen_imp[imp.name] = True
                all_imports.append(imp)

        # Frontends linking libpq link the shared library dynamically (deps on
        # its cc_library, dynamic_deps on the shared library); the .so carries
        # libpq's own externals, so they are not relinked here.
        dynamic_deps = []
        libpq_deps = []
        if links_shared_libpq(link_params):
            dynamic_deps = [_dep(st, _LIBPQ_SO, home)]
            libpq_deps = [_dep(st, _LIBPQ_SHARED, home)]

        if base_deps == None:
            base_deps = _hdr_deps(st, home)
        bin_kwargs = dict(
            name = target["name"],
            deps = (
                base_deps +
                [_dep(st, d[len(":"):], home) for d in static_deps] +
                libpq_deps +
                [
                    _dep(st, n, home)
                    for n in _EXE_EXTRA_DEPS.get(target["name"], [])
                ] +
                [_dep(st, imp.name, home) for imp in imps]
            ),
            linkopts = linkopts(link_params),
        )
        if dynamic_deps:
            bin_kwargs["dynamic_deps"] = dynamic_deps
        if compile_spec != None:
            static_srcs, gen_srcs = compile_spec
            cts = _exe_compile_ts(target)
            compiled_gen = [s for s in gen_srcs if not _is_gen_header(s)]
            bin_kwargs["srcs"] = sorted(dedup(
                [_src(st, s, home) for s in static_srcs] +
                [_gen(st, s, home) for s in compiled_gen],
            ))
            inc_attr, inc_deps = _include_deps(st, cts["parameters"], home)
            bin_kwargs["copts"] = copts(cts["parameters"]) + st["copts_extra"]
            bin_kwargs["includes"] = inc_attr
            bin_kwargs["deps"] = bin_kwargs["deps"] + inc_deps
        _emit(st, home, _cc_binary(**bin_kwargs), "cc_binary")

    # Core shared modules: one cc_binary(linkshared) each, named "<mod>.so".
    # Backend symbols stay undefined (the backend exports them with
    # -export-dynamic, so the dynamic linker resolves them at dlopen), so a
    # module never links postgres_lib; its deps are the header libs, any
    # convenience archive it links, and its externals. A module that links libpq
    # (the *_plperl / *_plpython transforms, ...) binds the shared one the way
    # the frontends do.
    for target, static_srcs, gen_srcs in module_specs:
        home = target_home(st["packages"], target["defined_in"])
        link_params = _exe_link_ts(target)["parameters"]
        static_deps = link_static_deps(link_params)
        static_deps = static_deps + crc_sibling_deps(static_deps, lib_names)
        imps = external_imports(link_params)
        for imp in imps:
            if imp.name not in seen_imp:
                seen_imp[imp.name] = True
                all_imports.append(imp)

        dynamic_deps = []
        libpq_deps = []
        if links_shared_libpq(link_params):
            dynamic_deps = [_dep(st, _LIBPQ_SO, home)]
            libpq_deps = [_dep(st, _LIBPQ_SHARED, home)]

        # A module with C++ sources (llvmjit: the JIT inliner / error handler /
        # IR wrappers over the LLVM C++ API) carries them in a second compile
        # entry with its own -std=c++NN; render those into a cc_library the .so
        # links (alwayslink, as meson links the module's own objects whole), so
        # the C and C++ flags never collide on one target.
        cpp_deps = []
        cpp = _cpp_compile_ts(target)
        if cpp:
            cpp_name = _module_so_name(target)[:-len(".so")] + "_cpp"
            cpp_inc_attr, cpp_inc_deps = _include_deps(
                st,
                cpp["parameters"],
                home,
            )
            _emit(st, home, _cc_library(
                name = cpp_name,
                srcs = sorted(dedup([
                    _src(st, rel_src(s), home)
                    for s in cpp["sources"]
                ])),
                copts = copts(cpp["parameters"]) + st["copts_extra"],
                includes = cpp_inc_attr,
                deps = _hdr_deps(st, home) + cpp_inc_deps,
                alwayslink = True,
            ), "cc_library")
            cpp_deps = [":" + cpp_name]

        cts = _exe_compile_ts(target)
        compiled_gen = [s for s in gen_srcs if not _is_gen_header(s)]
        inc_attr, inc_deps = _include_deps(st, cts["parameters"], home)
        mod_kwargs = dict(
            name = _module_so_name(target),
            srcs = sorted(dedup(
                [_src(st, s, home) for s in static_srcs] +
                [_gen(st, s, home) for s in compiled_gen],
            )),
            copts = copts(cts["parameters"]) + st["copts_extra"],
            includes = inc_attr,
            deps = (
                _hdr_deps(st, home) +
                [_dep(st, d[len(":"):], home) for d in static_deps] +
                libpq_deps +
                cpp_deps +
                inc_deps +
                [_dep(st, imp.name, home) for imp in imps]
            ),
            linkopts = linkopts(link_params),
            linkshared = True,
        )
        if dynamic_deps:
            mod_kwargs["dynamic_deps"] = dynamic_deps
        _emit(st, home, _cc_binary(**mod_kwargs), "cc_binary")

    # External cc_imports (rendered at root, shared across every consumer).
    for imp in all_imports:
        ikw = dict(name = imp.name)
        if imp.shared:
            ikw["shared_library"] = imp.shared
        if imp.static:
            ikw["static_library"] = imp.static
        _emit(st, "", _cc_import(**ikw), "cc_import")

    exe_names = {target["name"]: True for target, _, _2 in exe_items}
    module_so = {
        _module_so_name(target): True
        for target, _, _2 in module_specs
    }

    # The JIT type-info bitcode (llvmjit_types.bc): a backend source compiled
    # through the cc_toolchain with -emit-llvm, which the backend loads at jit
    # init. Rendered (and installed below) when llvmjit is built.
    if "llvmjit.so" in module_so:
        bc = _find_target(introspect, "llvmjit_types.bc", "custom")
        bc_home = longest_pkg_prefix(
            st["packages"],
            rel_out(bc["filename"][0]).rsplit("/", 1)[0],
        )
        bc_out = rel_out(bc["filename"][0]).rsplit("/", 1)[-1]
        bc_src = rel_src(bc["target_sources"][0]["sources"][0])
        st["index"][bc_out] = bc_home
        _emit(st, bc_home, Star.igen(Star.fn(
            "pg_jit_bitcode",
            name = bc_out,
            src = _src(st, bc_src, bc_home),
            deps = _hdr_deps(st, bc_home),
            out = bc_out,
        )), "pg_jit_bitcode")

    # NLS message catalogs (.mo): one msgfmt genrule per (domain, language),
    # returning the {label: share/locale/... dest} map for the install tree.
    nls_files = _render_nls(st, introspect)

    # The install tree (`:tar`): the runnable core assembled from the
    # install_plan.
    _emit(st, "", _render_install(
        st,
        introspect,
        exe_names,
        produced,
        module_so,
        _module_pl_dirs(module_specs),
        nls_files,
    ), "pg_install_tree")

    # The filegroups relocated genrules stage cross-package inputs by (emitted
    # in the package that owns each glob), and the per-package header filegroups
    # / include providers.
    fg_by_pkg = render_codegen_filegroups(st["needs"])
    for owner in fg_by_pkg:
        for node in fg_by_pkg[owner]:
            _emit_infra(st, owner, node)
    _render_infra(st)

    return _assemble(st, header)

testing = struct(
    _copts = copts,
    _includes = includes,
    _rel_src = rel_src,
    _rel_out = rel_out,
    _find_target = _find_target,
    _codegen_genrule = codegen_genrule,
    render_overlay = render_overlay,
)
