"""
Shared test-introspect layer for the unified hubs.

Both hubs render a slice of the same `+test` introspect: `@{name}` (the base
hub) renders the core/pl/module suites under `<v>/<opt>/tests/`, and
`@{name}_ext` (the extensions hub) renders the contrib suites under
`contrib/<name>/<v>/tests`. This module holds the three pieces both hubs share
so the two repo rules do not duplicate them:

- `introspect_payload(name, base_data)` (module-extension context): assembles
  the introspect repo-rule attrs (the `+test` introspect labels rewritten from
  the production introspect, the per-(version, option_set) install-tree /
  runtime / source label maps, the per-suite overrides + the make-path
  `metadata.test` introspect, and the `introspect_jsons` label dict the rules
  `rctx.read`). Both `create_base` and `create_ext` merge the returned dict into
  their repo-rule call; the labels point at the BASE hub (`@{name}//...`), so
  `introspect_payload` is always called with the base hub name.
- `INTROSPECT_ATTRS`: the repo-rule attrs the payload fills; merged into both
  `base_repo` and `ext_repo` `_ATTRS`.
- `render_core_tests` / `render_contrib_tests` (repo-rule context): decode the
  attrs and run the per-version loop, delegating to the `suites.bzl` writers.

The introspect decode (`schema.bzl`) and the suite renderers (`suites.bzl`) are
reused whole.
"""

load("//monoext/private:repo_names.bzl", "bind")
load("//monoext/private/base/build_options:flavors.bzl", "FLAVORS")
load(
    "//monoext/private/test:suites.bzl",
    "write_ext_test_version",
    "write_external_ext_test_entry",
    "write_test_version",
)

# Flavors that opt into the test lane by setting `test = True` on their FLAVORS
# entry, once the `+test` introspect variant is generated and committed. That
# variant flips tap_tests/injection_points (regenerated by
# `//tools:gen_<flavor>_introspect_jsons`); the production introspect stays
# tap-disabled and drives the base build codegen, which fails on the test
# variant's extra installed binaries.
_TEST_INTROSPECT_FLAVORS = [
    f
    for f, m in FLAVORS.items()
    if getattr(m, "test", False)
]

def _test_introspect_label(prod_label):
    """Map a production introspect label to its `+test` variant sibling.

    `//catalog/<flavor>/introspect:<f>~<v>~<os>.json` becomes
    `//catalog/<flavor>/introspect:<f>~<v>~<os>+test.json`: the
    tap_tests/injection_points-enabled introspect lives in the same
    `introspect/` package under a `+test` filename variant.
    """
    return prod_label.replace(".json", "+test.json")

# Repo-rule attrs filled by `introspect_payload`, merged into both hubs'
# `_ATTRS`. All default-empty so a introspect-less flavor renders cleanly (the
# per-version loop is then a no-op). `option_sets` is supplied separately (the
# base hub already declares it; the ext hub adds it).
INTROSPECT_ATTRS = dict(
    # JSON `{version: {option_set: introspect_label_str}}` (the `+test` variant
    # for the opted-in flavors).
    introspect_labels = attr.string(default = "{}"),
    # JSON `{version: {option_set: pg_tar_label_str}}` -- the test build
    # (`@{name}//<v>/<opt>:tar.test`, carrying pg_regress + psql + the fixtures)
    # for the regress / isolation / pl suites.
    pg_tar_labels = attr.string(default = "{}"),
    # JSON `{version: {option_set: test_pg_tar_label_str}}` -- the test-enabled
    # build's fixtures tree (`@{name}//<v>/<opt>:tar.test`) for the modules: +
    # tap: suites.
    test_pg_tar_labels = attr.string(default = "{}"),
    # JSON `{version: runtime_sysroot_tar_label_str}` -- runtime closure base.
    runtime_tar_labels = attr.string(default = "{}"),
    # JSON `{version: src_dir_label_str}` -- source tree
    # (sql/expected/schedules).
    src_dir_labels = attr.string(default = "{}"),
    # JSON `{version: {option_set: test_libs_label_str}}` -- optional
    # `--dlpath`.
    test_libs_labels = attr.string(default = "{}"),
    # JSON `{suite: {...}}` from repo.json metadata.test_overrides.
    overrides = attr.string(default = "{}"),
    # JSON `{version_spec: {slug: decl|[decl]}}` from repo.json metadata.test
    # (the make-path introspect fallback + the IvorySQL oracle block).
    test_meta = attr.string(default = "{}"),
    # The checked-in introspect JSONs must be visible to `rctx.read`; declare
    # them as a label_keyed_string_dict so Bazel stages them in the repo
    # mapping. Values are the `"<version>~<option_set>"` keys (informational).
    introspect_jsons = attr.label_keyed_string_dict(default = {}),
)

def introspect_payload(name, base_data):
    """Assemble the introspect repo-rule attrs for a unified hub.

    Runs in module-extension context (called from `create_base` / `create_ext`).
    Returns a dict of `option_sets` + the `INTROSPECT_ATTRS` values, derived
    purely from `base_data`. The labels point at the base hub `@{name}` (its
    install trees, runtime sysroots, source trees), so `name` is always the base
    hub name even when the payload feeds the extensions hub.

    Args:
        name: the base hub name (e.g. `"pg"`); labels are `@{name}//...`.
        base_data: `BaseData` from `create_base_src`.

    Returns:
        a `dict` to splat into the `base_repo` / `ext_repo` call.
    """
    flavor = base_data.flavor
    option_sets = list(FLAVORS[flavor].OPTION_SETS)

    # {version: {option_set: introspect_label}} from repo.json; rewritten to the
    # tap_tests/injection_points-enabled `+test` introspect variant for the
    # opted-in flavors. The coordinate maps below key off (version, option_set)
    # only, so rewriting the label values does not perturb them. A separate map:
    # never mutate `base_data.metadata` (it feeds the build-side stub
    # introspect).
    introspect_meta = base_data.metadata.get("introspect", {})
    if flavor in _TEST_INTROSPECT_FLAVORS:
        introspect_meta = {
            v: {
                opt: (_test_introspect_label(lbl) if lbl else lbl)
                for opt, lbl in cols.items()
            }
            for v, cols in introspect_meta.items()
        }

    # Parallel label maps over the SAME (version, option_set) coordinates, so
    # the repo rules stay pure renderers.
    pg_tars = {}
    test_pg_tars = {}
    runtime_tars = {}
    src_dirs = {}
    for v, cols in introspect_meta.items():
        fv = bind(name = name, v = v)
        runtime_tars[v] = fv("@{name}//{v}/deps/runtime:sysroot_tar")
        src_dirs[v] = fv("@{name}//{v}/src:dir")

        # Both lanes run against the test build (`:tar.test`): it is the only
        # tree carrying the whole regress closure the harness drives -- the
        # pg_regress / pg_isolation_regress drivers (under `lib/pgxs`), psql
        # (which pg_regress shells out to, curated out of the production
        # out_binaries), regress.so, and the `install: false` module fixtures.
        # The shippable runtime `:tar` (psql, no pg_regress) and the `:tar.dev`
        # SDK (pg_regress, no psql) each hold only part of it. The two maps stay
        # separate so a lane could later diverge, but resolve alike today.
        pg_tars[v] = {
            opt: bind(
                name = name,
                v = v,
                opt = opt,
            )("@{name}//{v}/{opt}:tar.test")
            for opt in cols
        }
        test_pg_tars[v] = {
            opt: bind(
                name = name,
                v = v,
                opt = opt,
            )("@{name}//{v}/{opt}:tar.test")
            for opt in cols
        }

    introspect_jsons = {
        Label(lbl): "%s~%s" % (v, opt)
        for v, cols in introspect_meta.items()
        for opt, lbl in cols.items()
        if lbl
    }

    return dict(
        option_sets = json.encode(option_sets),
        introspect_labels = json.encode(introspect_meta),
        pg_tar_labels = json.encode(pg_tars),
        test_pg_tar_labels = json.encode(test_pg_tars),
        runtime_tar_labels = json.encode(runtime_tars),
        src_dir_labels = json.encode(src_dirs),
        # `:test-libs` is optional (regress.so rides `:tar` via pg_build's
        # postfix, and the harness defaults --dlpath to pkglibdir); empty today.
        test_libs_labels = json.encode({}),
        overrides = json.encode(base_data.metadata.get("test_overrides", {})),
        test_meta = json.encode(base_data.metadata.get("test", {})),
        introspect_jsons = introspect_jsons,
    )

def _decode(rctx):
    """Decode the introspect attrs into a struct of maps (repo-rule context)."""
    return struct(
        option_sets = json.decode(rctx.attr.option_sets),
        introspect = json.decode(rctx.attr.introspect_labels),
        pg_tars = json.decode(rctx.attr.pg_tar_labels),
        test_pg_tars = json.decode(rctx.attr.test_pg_tar_labels),
        runtime_tars = json.decode(rctx.attr.runtime_tar_labels),
        src_dirs = json.decode(rctx.attr.src_dir_labels),
        test_libs = json.decode(rctx.attr.test_libs_labels),
        overrides = json.decode(rctx.attr.overrides),
        test_meta = json.decode(rctx.attr.test_meta),
    )

def render_core_tests(rctx, flavor, build_repo):
    """Render the core/pl/module suites (the `@{name}` slice).

    Per version, delegate to `write_test_version`, which writes the
    source-mirrored packages under `<v>/<opt>/tests/`. A no-op when the
    introspect is empty.

    Args:
        rctx: the base hub repo-rule context (reads the introspect attrs, writes
            the generated `<v>/<opt>/tests/...` BUILD files).
        flavor: the flavor slug (e.g. `"postgres"`).
        build_repo: repo holding the harness scripts + bsdtar toolchain.
    """
    c = _decode(rctx)
    for version in sorted(c.introspect):
        introspect_labels = {
            opt: Label(lbl)
            for opt, lbl in c.introspect[version].items()
            if lbl
        }
        if not introspect_labels:
            continue
        write_test_version(
            rctx,
            version = version,
            flavor = flavor,
            build_repo = build_repo,
            option_sets = c.option_sets,
            introspect_labels = introspect_labels,
            pg_tar_by_opt = c.pg_tars[version],
            test_pg_tar_by_opt = c.test_pg_tars.get(version, {}),
            runtime_tar = c.runtime_tars[version],
            src_dir = c.src_dirs[version],
            overrides = c.overrides,
            test_meta = c.test_meta,
            test_libs_by_opt = c.test_libs.get(version, {}),
        )

def render_contrib_tests(rctx, flavor, build_repo):
    """Render the contrib suites (the `@{name}_ext` slice).

    Contrib is option-set-invariant; per version, read the DEFAULT option set's
    introspect (fall back to any present column) and delegate to
    `write_ext_test_version`, which writes `contrib/<name>/<v>/tests`. A no-op
    when the introspect is empty.

    Args:
        rctx: the extensions hub repo-rule context (reads the introspect attrs,
            writes the generated `contrib/<name>/<v>/tests` BUILD files).
        flavor: the flavor slug (e.g. `"postgres"`).
        build_repo: repo holding the harness scripts + bsdtar toolchain.
    """
    c = _decode(rctx)
    if not c.option_sets:
        return
    default_option_set = c.option_sets[-1]
    for version in sorted(c.introspect):
        cols = {
            opt: Label(lbl)
            for opt, lbl in c.introspect[version].items()
            if lbl
        }
        label = cols.get(default_option_set)
        if not label:
            present = [cols[o] for o in sorted(cols)]
            label = present[0] if present else None
        if not label:
            continue
        write_ext_test_version(
            rctx,
            version = version,
            flavor = flavor,
            build_repo = build_repo,
            default_option_set = default_option_set,
            introspect = json.decode(rctx.read(rctx.path(label))),
            pg_tar_default = c.pg_tars[version][default_option_set],
            runtime_tar = c.runtime_tars[version],
            src_dir = c.src_dirs[version],
            overrides = c.overrides,
            test_meta = c.test_meta,
            test_libs_default = c.test_libs.get(
                version,
                {},
            ).get(default_option_set),
        )

def render_external_ext_tests(rctx, flavor, build_repo, external_entries, ext_test_meta):
    """Render the external-extension test introspect (the `@{name}_ext` slice).

    Parallel to `render_contrib_tests`, but driven by the catalog
    `metadata.test_ext` (not the PG introspect): per external entry, per
    (ext_version, base_version) target, read the base hub's install tree +
    runtime sysroot for that base version and delegate to
    `write_external_ext_test_entry`, which writes
    `<ext>/<ext_v>/<base_v>/tests`. A no-op for an entry with no `test_ext`.

    Args:
        rctx: the extensions hub repo-rule context (reads the introspect attrs,
            writes the generated `<ext>/<ext_v>/<base_v>/tests` BUILD files).
        flavor: the base flavor slug (e.g. `"postgres"`).
        build_repo: repo holding the harness scripts + bsdtar toolchain.
        external_entries: the list of `ExtExternalEntry` decoded in
            `ext/hub.bzl`, each carrying pre-qualified `targets` (artifact /
            source / deps labels).
        ext_test_meta: `{ext_name: metadata.test_ext}` threaded from the catalog
            via the `external_test_meta` repo-rule attr.
    """
    c = _decode(rctx)
    if not c.option_sets:
        return
    default_option_set = c.option_sets[-1]
    for entry in external_entries:
        test_ext = ext_test_meta.get(entry.name)
        if not test_ext:
            continue
        for target in entry.targets:
            base_v = target.base_version.version
            pg_tar = c.pg_tars.get(base_v, {}).get(default_option_set)
            runtime_tar = c.runtime_tars.get(base_v)

            # An external is only built against base versions the base hub also
            # builds; skip defensively if the introspect lacks this base
            # version.
            if not pg_tar or not runtime_tar:
                continue

            # The artifact target is a genrule with two outputs (`<base_v>.tar`
            # + `<base_v>.log`), so reference the tar output FILE (target name +
            # `.tar`) for the single-rloc `--overlay-tar`; the bare `:base_v`
            # label would expand to both files.
            write_external_ext_test_entry(
                rctx,
                ext_name = entry.name,
                ext_version = target.version,
                base_version = base_v,
                flavor = flavor,
                build_repo = build_repo,
                default_option_set = default_option_set,
                pg_tar = pg_tar,
                runtime_tar = runtime_tar,
                overlay_tar = target.artifact + ".tar",
                ext_srcdir = target.source.dir,
                ext_runtime_tar = target.deps.runtime.sysroot_tar,
                pg_src_dir = c.src_dirs.get(base_v),
                test_ext = test_ext,
            )
