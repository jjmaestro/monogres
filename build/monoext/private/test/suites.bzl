"""
Per-(version, option_set) test BUILD writers for the `@{name}` and `@{name}_ext`
hubs.

Renders `sh_test` targets wrapping the shared `regress_runner.sh` harness, from
the `SuiteInfo`s `schema.bzl` decodes out of the introspect `.tests` array (or,
for the make path, the `test_suites`/`metadata.test` introspect).

`write_test_version` renders the core/pl/module introspect into `@{name}` under
a `tests/` namespace: a subtree-carrying introspect (meson's `.tests` or the
make `test_suites`) names each suite's source subtree, so the package layout
mirrors the PG tree 1:1 (`src/test/recovery` -> `tests/test/recovery`), a
regress/isolation suite emits one target and a TAP suite emits one target per
`.pl` under a `tap/` subpackage; only the subtree-less `metadata.test` fallback
keeps the category layout (core regress/isolation packages plus pl/modules). The
(IvorySQL) oracle main suite is synthesized from the catalog.
`write_ext_test_version` renders the contrib packages into `@{name}_ext` under
`contrib/<name>/<v>/tests`. This module only turns each `SuiteInfo` into
Starlark.

Mirrors `//monoext/private/base:versions.bzl`: a render helper per generated
file type (`_suite_test`, `_category_build`, ...), each returning
`Star.file(...)` / a node. All codegen is `Star.*`
(`file`/`fn`/`igen`/`load_`/`package`/`alias`) -- no string templates.

The emitted `args`/`data`/`env` follow the validated harness convention
(`build/monoext/private/test/regress_runner.sh`): positional `$(rlocationpath)`
runfiles (closure_setup.sh, sysroot_lib.sh, bsdtar, runtime sysroot tar, the
install tree, the source tree) resolved via `@bazel_tools//tools/bash/runfiles`,
then `--flag` selectors the harness reconstructs the real pg_regress command
from.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private:repo_names.bzl", "bind")
load("//monoext/private/base:compat.bzl", "is_compatible_with")
load("//monoext/private/test:schema.bzl", _TestSchema = "schema")

_HEADER = "Generated by monoext/private/test. DO NOT EDIT."

# ---------------------------------------------------------------------------
# Bazel attribute policy (sizing / tagging), driven by introspect signals.
# ---------------------------------------------------------------------------

# Suites whose temp-instance machinery initdb's many clusters, takes
# base-backups, or runs a heavy isolation/recovery/start-stop body. Sized
# `large` regardless of per-test timeout: a `large` reserves more of the
# executor's CPU budget than a `medium`, so the full lane co-schedules fewer of
# them and a heavy suite is not starved into a TIMEOUT or a timing-sensitive
# restart race (pg_basebackup, pg_ctl flake exactly that way under contention).
_BIG_SUITES = [
    "isolation",
    "oracle",
    "pg_basebackup",
    "pg_ctl",
    "pg_rewind",
    "pg_upgrade",
    "pg_verifybackup",
    "recovery",
    "subscription",
]

# Timeout band (seconds): a group whose max `.tests[].timeout` exceeds this is
# `large` even if not in `_BIG_SUITES` (1000 is the near-universal value; this
# only promotes the rare longer outliers).
_LARGE_TIMEOUT_S = 600

# Always-on test tag (lets `bazel test --test_tag_filters=regress //...` select
# the whole lane).
_TAG_REGRESS = "regress"

# Reserve N logical cores for the `--max-concurrent-tests` fan-out so the
# in-test parallelism does not oversubscribe the executor.
_CPU_TAG_20CONN = "cpu:20"

# pg_regress's intra-schedule concurrency for the 20-conn group, passed to the
# harness as `--max-conc 20` (the harness maps it to --max-concurrent-tests).
_MAX_CONC_20 = "20"

# CPU reservation for a heavy multi-cluster TAP suite (a `_BIG_SUITES` TAP slug:
# recovery, pg_rewind, pg_basebackup, pg_ctl, ...). Each per-.pl test initdb's
# and starts several postgres clusters; left at the default 1-core estimate the
# full lane co-schedules ~18 of them and the cluster-start storm saturates the
# CPU, so a `pg_ctl start` wait loop or a recovery cluster startup times out
# even though the test passes alone. The `cpu:N` tag makes Bazel reserve N cores
# per test, capping how many run at once (18 / N) so no start race is starved.
# Sizing them `large` only widens the timeout; this is what relieves the
# contention. N is a logical-core count, like the 20-conn fan-out reservation.
_CPU_TAG_BIG_TAP = "cpu:4"

# Surface pg_regress diffs / per-test .out/.diff / server logs as undeclared
# test outputs (Bazel zips them into outputs.zip on failure). The harness writes
# into $TEST_UNDECLARED_OUTPUTS_DIR; no `flaky` is ever emitted (flakes
# surface).
_ENV_INHERIT = ["TEST_UNDECLARED_OUTPUTS_DIR"]

# Per-.pl TAP tests that drive an interactive psql session through a
# controlling-terminal pty (IO::Pty / IPC::Run `<pty<`). The hermetic sandbox
# grants no controlling terminal: a bound devpts satisfies posix_openpt but
# TIOCSCTTY then fails, so interactive_psql hangs or dies, and a suite's own
# `skip unless IO::Pty` guard never fires because libipc-run-perl hard-depends
# on libio-pty-perl, so IO::Pty is always in the closure. These are
# host-capability tests in the same class as sepgsql (SELinux host) and the
# networked PG_TEST_EXTRA groups; the harness TAP-skips them (--skip-reason) so
# the suite stays green, and they keep a requires-terminal tag for discovery
# while staying runnable for real on a host with a terminal. Keyed by (source
# subtree, .pl basename).
_TAP_REQUIRES_TERMINAL = {
    ("src/test/authentication", "001_password"): True,
    ("src/bin/psql", "010_tab_completion"): True,
}

# A per-.pl TAP test gated on a PG_TEST_EXTRA group: the requirement is a
# runtime `$ENV{PG_TEST_EXTRA}` check inside the .pl, absent from the meson test
# metadata and so from the introspect, curated here as a sibling of
# _TAP_REQUIRES_TERMINAL. The hermetic sandbox cannot provision the external
# service the group needs (an SSL cert setup, an LDAP slapd, a Kerberos KDC,
# special DNS, a WAL-consistency build knob), so the suite is gated incompatible
# (Bazel SKIPPED) by default rather than self-skipping to a green PASS; the
# `//monoext/private/test:pg_test_extra_<group>` flag flips it compatible for a
# future non-hermetic lane. Keyed by (source subtree, .pl basename).
_TAP_REQUIRES_PG_TEST_EXTRA = {
    ("src/test/ssl", "001_ssltests"): "ssl",
    ("src/test/ssl", "002_scram"): "ssl",
    ("src/test/ssl", "003_sslinfo"): "ssl",
    ("src/test/ldap", "001_auth"): "ldap",
    ("src/test/ldap", "002_bindpasswd"): "ldap",
    ("src/test/modules/ldap_password_func", "001_mutated_bindpasswd"): "ldap",
    ("src/test/kerberos", "001_auth"): "kerberos",
    ("src/interfaces/libpq", "004_load_balance_dns"): "load_balance",
    ("src/test/recovery", "027_stream_regress"): "wal_consistency_checking",
}

def _repeated_flag(flag, values):
    """`[flag, value]` per value, in the order given.

    For any harness flag whose value is one item out of a list. NOT one flag
    with the items space-joined: a rule's `args` are Bourne-tokenized on the way
    to the harness, so `["--tests", "a b c"]` arrives as four argv entries, the
    flag takes `a`, and `b` and `c` fall through the harness's arg loop and are
    dropped without a word. Repeating the flag is what survives tokenization.

    Args:
        flag: The flag to repeat.
        values: Its values, one per occurrence.

    Returns:
        The flattened `args` list.
    """
    args = []

    for value in values:
        args += [flag, value]

    return args

def _bazel_size(info):
    """size = large (big or long) / medium (the floor for every suite).

    Every rendered suite starts a postgres server (pg_regress --temp-instance or
    a PostgreSQL::Test cluster), so none is unit-test-fast: the floor is
    `medium` (a 300s timeout). A trivial-but-server-starting suite (pg_config,
    initdb: a single fast .pl) would otherwise size `small` (60s) and flake to
    TIMEOUT when the full lane runs its many `large` suites concurrently and
    starves it of CPU for tens of seconds. Big/long suites stay `large`.
    """
    if info.slug in _BIG_SUITES or info.max_timeout > _LARGE_TIMEOUT_S:
        return "large"
    return "medium"

def _bazel_tags(info):
    tags = [_TAG_REGRESS]

    # Per-kind tag so a single kind can be selected with
    # `--test_tag_filters=tap` (or `isolation`). regress is the lane-wide tag
    # above, so the regress kind needs no extra tag.
    if info.kind == _TestSchema.KIND_TAP:
        tags.append("tap")

        # A heavy multi-cluster TAP suite reserves CPU so the full lane does not
        # co-schedule a cluster-start storm that starves a `pg_ctl start` /
        # recovery startup into a flaky timeout (see _CPU_TAG_BIG_TAP).
        if info.slug in _BIG_SUITES:
            tags.append(_CPU_TAG_BIG_TAP)
    elif info.kind == _TestSchema.KIND_ISOLATION:
        tags.append("isolation")

    if info.uses_20conn:
        tags.append(_CPU_TAG_20CONN)
    return tags

# ---------------------------------------------------------------------------
# Per-suite target node.
# ---------------------------------------------------------------------------

# Category-layout + contrib package naming. The category layout serves a
# subtree-less introspect (the `metadata.test` fallback): core regress and
# isolation are distinct PACKAGES, each holding one bare-named (`<kind>`)
# target; pl/modules namespace by slug inside a per-(v,opt) category package
# (slug is the TARGET name). Contrib lives in @{name}_ext under
# contrib/<name>/<v> with the kind as the target name. A subtree-carrying
# introspect (meson `.tests` or the make `test_suites`) derives its package
# paths from the suite subtree instead (see `_write_mirrored_suites`).

def _core_package(version, option_set, kind):
    """`<v>/<opt>/tests/regress` | `<v>/<opt>/tests/isolation`."""
    return "%s/%s/tests/%s" % (version, option_set, kind)

def _category_package(version, option_set, category):
    """`<v>/<opt>/tests/pl` | `<v>/<opt>/tests/modules` (category fallback)."""
    sub = "pl" if category == _TestSchema.CAT_PL else "modules"
    return "%s/%s/tests/%s" % (version, option_set, sub)

def _contrib_package(name, version):
    """`contrib/<name>/<version>/tests` (in the `@{name}_ext` hub).

    A `tests` sub-package so it does not collide with the contrib BUILD package
    `contrib/<name>/<version>` (which already holds the contrib `:tar`).
    """
    return "contrib/%s/%s/tests" % (name, version)

def _runner_args(
        version,
        flavor,
        option_set,
        info,
        rlocs,
        override,
        tc_rloc,
        tap_file = None):
    """The `args` list for one `sh_test` -- positionals THEN selector flags.

    `rlocs` is the ordered struct of `$(rlocationpath[s] ...)` strings the
    runner resolves with the runfiles library. The selector flags carry the
    introspect-derived identity the harness reconstructs the real pg_regress
    command from.

    `tap_file` is the single `.pl` basename a per-.pl TAP target runs (e.g.
    `001_stream_rep`); `None` runs every `t/*.pl` (the make path).
    """
    args = [
        # --- runfiles positionals ($1 $2 $3 $4, then mixed tree paths) ---
        rlocs.closure_setup,
        rlocs.sysroot_lib,
        rlocs.bsdtar,
        rlocs.runtime_tar,
        # the install tree + the source tree: each `$(rlocationpaths ...)`
        # expands to many tokens; the harness rlocation's them and locates
        # bin/initdb (install root) + src/test/regress/parallel_schedule (src
        # root) by content, exactly as the validated target does.
        rlocs.pg_tar,
        rlocs.src_dir,
    ]
    if rlocs.test_libs:
        # An explicit :test-libs label overrides the harness's default of
        # PGROOT/lib/postgresql (where pg_build's postfix captures regress.so).
        args += ["--dlpath-from", rlocs.test_libs]

    if info.kind == _TestSchema.KIND_TAP:
        # TAP runs the perl .pl scripts, which need IPC::Run from the `test`
        # deps sysroot layered onto the runtime closure (see regress_runner.sh's
        # TAP lane). Only the TAP kind carries it.
        args += ["--test-sysroot-from", rlocs.test_sysroot]

        # Build-config env gates (with_ldap, enable_injection_points, ...) the
        # .pl read, mirrored from the introspect TAP entry env (per option set).
        for k in sorted(info.tap_env):
            args += ["--tap-env", "%s=%s" % (k, info.tap_env[k])]

        # The per-.pl target runs exactly one `t/<basename>.pl`; absent, the
        # harness globs every `t/*.pl` (the make path).
        if tap_file:
            args += ["--tap-file", tap_file]

    # --- semantic selectors (introspect-derived) ---
    args += [
        "--version",
        version,
        "--flavor",
        flavor,
        "--option-set",
        option_set,
        "--suite",
        info.slug,
        "--kind",
        info.kind,
    ]

    # A subtree-carrying introspect (meson `.tests` or the make `test_suites`)
    # names the suite's source subtree (src/test/recovery, src/bin/pg_dump,
    # contrib/amcheck, ...), so the harness resolves the srcdir against it
    # directly instead of guessing from the slug. Empty only for the
    # subtree-less `metadata.test` fallback, where the harness keeps the slug
    # guess.
    if info.subtree:
        args += ["--srcdir-subtree", info.subtree]

    if info.schedule:
        args += ["--schedule", info.schedule]
    else:
        ov_tests = override.get("tests")
        names = ov_tests if ov_tests else info.test_names
        if names:
            # contrib / module groups carry no `--schedule` file: run their
            # inline, order-preserving test list. An override `tests` (catalog)
            # replaces a wrong/empty introspect list (e.g. ivorysql_ora, whose
            # meson.build defines no tests block).
            args += _repeated_flag("--tests", names)
    if info.uses_20conn:
        args += ["--max-conc", _MAX_CONC_20]

    # --- pg_regress value-flags, mirrored from the introspect cmd ---
    # The harness appends these verbatim (it does not re-derive encoding/locale
    # policy); a catalog override may still pin any of them for a fork whose
    # introspect cannot express it.

    # Database the suite runs in: core `regression`, isolation
    # `isolation_regression`, each group `regression_<slug>` (worker_spi:
    # `contrib_regression`). Honoring it keeps a temp-config GUC that names a
    # database (worker_spi.database) pointed at the database the test runs in.
    dbname = override.get("dbname") or info.dbname
    if dbname:
        args += ["--dbname", dbname]

    # The remaining value-flags ride --regress-opt (verbatim pass-through)
    # exactly as the cmd has them: --encoding, --no-locale, --load-extension
    # (per-kind:
    # e.g. postgres_fdw loads only in isolation), --create-role. pg_regress
    # issues CREATE EXTENSION / CREATE ROLE idempotently (IF NOT EXISTS /
    # DROP-then- CREATE), so pre-loading never collides with a suite's own
    # setup.
    enc = override.get("encoding") or info.encoding
    if enc:
        args += ["--regress-opt", "--encoding=%s" % enc]

    # locale_mode is "force"/"inherit" for the meson path (exact from the cmd),
    # "inherit" for a make TAP suite (matching meson TAP), and "" for the
    # remaining make/oracle suites (no cmd to mirror): force C, except oracle
    # (its template already bakes C; --no-locale would bypass it).
    if info.locale_mode == "force" or (
        info.locale_mode == "" and override.get("initdb_mode") != "oracle"
    ):
        args += ["--regress-opt", "--no-locale"]

    for ext in (info.load_extensions or override.get("load_extension", [])):
        args += ["--regress-opt", "--load-extension=%s" % ext]
    for role in info.create_roles:
        args += ["--regress-opt", "--create-role=%s" % role]

    # --temp-config overlay: a checked-in override .conf (contrib +
    # fork-specific) wins; else the upstream .conf the introspect cmd names,
    # resolved by the harness against the source root (it rides the PG :src
    # tree). This covers the modules whose extension needs
    # shared_preload_libraries (test_slru, snapshot_too_old) with no
    # hand-maintained .conf copy.
    if tc_rloc:
        args += ["--temp-config-from", tc_rloc]
    elif info.temp_config_srcrel:
        args += ["--temp-config-srcrel", info.temp_config_srcrel]

    # Drop specific tests from a schedule-driven suite (the codegen emits the
    # whole schedule; the harness filters it at run time).
    exclude_tests = override.get("exclude_tests")
    if exclude_tests:
        args += _repeated_flag("--exclude-tests", exclude_tests)

    # Accept a known cosmetic-only psql golden diff (the harness re-checks the
    # diff is table-rendering only -- trailing whitespace + separator width --
    # before letting the suite pass).
    if override.get("golden_cosmetic"):
        args += ["--golden-cosmetic", "1"]

    # IvorySQL oracle-mode: have the harness build an `initdb -m oracle`
    # template the suite clones (selects postgres_oracle.bki + the
    # liboracle_parser/ivorysql_ora preloads). `initdb_compat` (e.g. "normal")
    # is version-gated by the catalog (IvorySQL 3.0 has no `initdb -C`).
    mode = override.get("initdb_mode")
    if mode:
        args += ["--initdb-mode", mode]
    compat = override.get("initdb_compat")
    if compat:
        args += ["--initdb-compat", compat]

    # Explicit <inputdir> relative to the source root, for a suite whose tree
    # the harness name-resolver does not know (the main oracle suite at
    # src/oracle_test/regress).
    inputdir_rel = override.get("inputdir_rel")
    if inputdir_rel:
        args += ["--inputdir-rel", inputdir_rel]

    return args

def _runner_env(info):
    """The `env` dict for one `sh_test`.

    Single data-driven toggle: PG17/18 ship an installed `initdb-template` (fast
    path); PG16 does not, so the harness runs initdb itself. Sourced straight
    from `.tests[].env` (key presence), no version sniffing.
    """
    return {"REGRESS_INITDB_TEMPLATE": "1" if info.has_initdb_template else "0"}

def _suite_test(
        target_name,
        version,
        flavor,
        option_set,
        info,
        rlocs,
        runner,
        build_repo,
        override,
        tap_file = None):
    """Render ONE `sh_test(...)` node under the given package-local target_name.

    `target_name` is the `.pl` basename for a per-.pl TAP target, else the
    package's last path component (regress/isolation) or the kind (make/ext).
    `tap_file` is the single `.pl` basename a per-.pl TAP target runs.
    """

    # Per-suite --temp-config overlay: a checked-in .conf label resolved into
    # the suite target's runfiles (build-repo-relative `//...` ->
    # `@<build>//...`).
    extra_data = []
    tc_rloc = None
    tc = override.get("temp_config")
    if tc:
        conf = ("@%s%s" % (build_repo, tc)) if tc.startswith("//") else tc
        extra_data = [conf]
        tc_rloc = "$(rlocationpath %s)" % conf

    # initdb_compat may be version-gated ({version_spec: value}); IvorySQL 3.0
    # has no `initdb -C`, 4.0/5.0 do. Resolve to the matching version's value (a
    # flat string is accepted as-is for the version-invariant case).
    eff_override = dict(override)
    compat = eff_override.get("initdb_compat")
    if type(compat) == "dict":
        eff_override.pop("initdb_compat", None)
        for spec in sorted(compat):
            if is_compatible_with(version, spec):
                eff_override["initdb_compat"] = compat[spec]
                break

    # A per-.pl TAP test in _TAP_REQUIRES_TERMINAL needs a controlling-terminal
    # pty the hermetic sandbox cannot grant and cannot skip on its own (IO::Pty
    # rides the closure). The harness TAP-skips it via --skip-reason so the
    # hermetic suite stays green; the requires-terminal tag keeps it queryable.
    # It still runs for real on a host with a terminal (no --skip-reason there).
    tags = _bazel_tags(info)
    args = _runner_args(
        version,
        flavor,
        option_set,
        info,
        rlocs,
        eff_override,
        tc_rloc,
        tap_file = tap_file,
    )
    if tap_file and (info.subtree, tap_file) in _TAP_REQUIRES_TERMINAL:
        tags = tags + ["requires-terminal"]
        args = args + ["--skip-reason", "requires a controlling-terminal pty (unavailable in the hermetic sandbox)"]

    # A per-.pl TAP test the catalog marks as a genuine fork divergence (or
    # necessary fork-shim collateral) the hermetic suite cannot pass: a
    # `tap_skip` map (`{pl_basename: reason}`) on the suite's override skips it
    # via the same --skip-reason TAP skip-all. Catalog-driven (repo.json
    # metadata.test_overrides), so per-flavor without touching this codegen. The
    # reason rides `args`, which Bazel re-tokenizes through Bourne-shell quotes,
    # so a `tap_skip` reason carries no apostrophe / quote (an odd count is an
    # "unterminated quotation" analysis error) -- like the literal above.
    tap_skip = eff_override.get("tap_skip", {})
    if tap_file and tap_file in tap_skip:
        args = args + ["--skip-reason", tap_skip[tap_file]]

    # A per-.pl TAP test gated on a PG_TEST_EXTRA group: the external service it
    # needs is absent from the hermetic sandbox, so gate it incompatible by
    # default -- Bazel reports SKIPPED (an analysis-time decision) rather than
    # the self-skip's green PASS. The `pg_test_extra_<group>` flag flips it
    # compatible for a future non-hermetic lane; the requires-* tags keep it
    # queryable. Splat so the attr is simply absent for an ungated suite.
    compat_kwargs = {}
    group = _TAP_REQUIRES_PG_TEST_EXTRA.get(
        (info.subtree, tap_file),
    ) if tap_file else None
    if group:
        f = bind(build = build_repo)
        compat_kwargs["target_compatible_with"] = Star.select({
            f("@{build}//monoext/private/test:" + group + "_enabled"): [],
            "//conditions:default": ["@platforms//:incompatible"],
        })
        tags = tags + ["requires-pg-test-extra", "requires-" + group]

    sh_test_args = dict(
        name = target_name,
        srcs = [runner],
        args = args,
        env = _runner_env(info),
        data = rlocs.data + extra_data,
        size = _bazel_size(info),
        tags = tags,
        env_inherit = _ENV_INHERIT,
        # no `flaky` -- flakiness is surfaced as a failure, never papered over.
    )
    sh_test_args.update(compat_kwargs)
    return Star.igen(Star.fn("sh_test", **sh_test_args))

# ---------------------------------------------------------------------------
# Runfiles label plumbing (the `$(rlocationpath[s] ...)` args + the `data`
# list).
# ---------------------------------------------------------------------------

def _rloc(label):
    """`$(rlocationpath <label>)` make-variable string (single-file label)."""
    return "$(rlocationpath %s)" % label

def _rlocs(build_repo, pg_tar, runtime_tar, src_dir, test_libs = None):
    """Assemble the per-suite runfiles arg strings + the `data` list.

    The harness receives `$(rlocationpath[s] ...)` positionals and resolves them
    with `@bazel_tools//tools/bash/runfiles`; every such label is also in `data`
    so Bazel stages it.

    Args:
        build_repo: build repo holding the harness scripts + bsdtar toolchain.
        pg_tar: label of the installed PG tree (`@pg//{v}/{opt}:tar`).
        runtime_tar: label of the runtime sysroot tar
            (`@pg//{v}/deps/runtime:sysroot_tar`).
        src_dir: label of the source tree (`@pg//{v}/src:dir`); the harness
            reads `sql/`, `expected/`, the schedule + `data/` from it.
        test_libs: optional `:test-libs` label overriding the default --dlpath.

    Returns a struct of arg strings (consumed by `_runner_args`) plus the
    fully-built `data` list (consumed by `_suite_test`).
    """
    f = bind(build = build_repo)
    closure_setup = f("@{build}//monoext/private/test:closure_setup.sh")
    sysroot_lib = f("@{build}//monoext/private/base:sysroot_lib.sh")
    runner_srcs = f("@{build}//monoext/private/test:regress_runner.sh")
    bsdtar = "@bsd_tar_toolchains//:resolved_toolchain"
    runfiles = "@bazel_tools//tools/bash/runfiles"

    # The TAP lane layers the `test` deps sysroot (IPC::Run, kept out of the
    # production runtime closure) onto the runtime closure; derive its label
    # from the runtime tar (same `{v}/deps/<kind>:sysroot_tar` shape). Threaded
    # for every suite's runfiles but only passed to the harness for tap
    # (_runner_args).
    test_sysroot_tar = runtime_tar.replace("/deps/runtime:", "/deps/test:")

    data = [
        runner_srcs,
        closure_setup,
        sysroot_lib,
        runtime_tar,
        test_sysroot_tar,
        pg_tar,
        src_dir,
        bsdtar,
        runfiles,
    ]
    if test_libs:
        data.append(test_libs)

    return struct(
        runner = runner_srcs,
        closure_setup = _rloc(closure_setup),
        sysroot_lib = _rloc(sysroot_lib),
        bsdtar = _rloc(bsdtar),
        runtime_tar = _rloc(runtime_tar),
        test_sysroot = _rloc(test_sysroot_tar),
        # install tree + source tree are directory trees: pass EVERY file
        # (`rlocationpaths`, plural) so the harness rlocation's the roots then
        # locates bin/initdb + src/test/regress by content.
        pg_tar = "$(rlocationpaths %s)" % pg_tar,
        src_dir = "$(rlocationpaths %s)" % src_dir,
        test_libs = _rloc(test_libs) if test_libs else None,
        data = data,
    )

# ---------------------------------------------------------------------------
# Override resolution (per-kind scoping).
# ---------------------------------------------------------------------------

# Override keys that name a kind: their values are per-kind sub-overrides, not
# flags themselves. Everything else in a `test_overrides[slug]` dict is a flat
# flag applied to every kind of the slug.
_KIND_OVERRIDE_KEYS = [
    _TestSchema.KIND_REGRESS,
    _TestSchema.KIND_ISOLATION,
    _TestSchema.KIND_TAP,
    _TestSchema.KIND_SETUP,
]

def _effective_override(slug_override, kind):
    """Resolve a slug's `test_overrides` entry for one kind.

    A `test_overrides[slug]` carries flat flags (`encoding` / `temp_config` /
    `load_extension` / `exclude` / `exclude_tests` / `golden_cosmetic` /
    `tap_skip`; plus the documentation-only `note` / `known_failure`, which the
    codegen ignores) that apply to every kind, and may also carry per-kind
    sub-dicts (keyed by kind name) that add or override for just that kind. This
    overlays the kind sub-dict onto the flat flags. The motivating case is
    `postgres_fdw`, whose `--load-extension` is ISOLATION_OPTS only:
    pre-loading the extension into the isolation cluster is required, but doing
    it for the regress suite would make that suite's own `CREATE EXTENSION` fail
    "already exists". Scoping `load_extension` under `isolation` fixes it.
    """
    eff = {
        k: v
        for k, v in slug_override.items()
        if k not in _KIND_OVERRIDE_KEYS
    }
    eff.update(slug_override.get(kind, {}))
    return eff

# ---------------------------------------------------------------------------
# Per-file render helpers.
# ---------------------------------------------------------------------------

def _psql_binary(version, flavor, option_set, rlocs):
    """Render the `:psql` `bazel run`-able interactive psql for one (v, opt).

    Reuses the suite runfiles + closure; `regress_runner.sh --mode psql`
    initdb's a throwaway instance and execs psql (un-sandboxed, in the
    container). One `:psql` per package (not per suite).
    """
    args = [
        rlocs.closure_setup,
        rlocs.sysroot_lib,
        rlocs.bsdtar,
        rlocs.runtime_tar,
        rlocs.pg_tar,
        rlocs.src_dir,
        "--mode",
        "psql",
        "--version",
        version,
        "--flavor",
        flavor,
        "--option-set",
        option_set,
    ]
    sh_binary_args = dict(
        name = "psql",
        srcs = [rlocs.runner],
        args = args,
        data = rlocs.data,
        tags = ["manual"],  # run-only; never built by :all or a wildcard test
    )
    return Star.igen(Star.fn("sh_binary", **sh_binary_args))

def _category_build(rlocs, targets, names, version, flavor, option_set):
    """Render a category/core package BUILD file as a `Star.file` node.

    The file carries the loads, `package()`, the suite `targets`, and (unless a
    suite already claims that name) one `:psql` dev target for the package's (v,
    opt).
    """
    loads = [Star.load_("@rules_shell//shell:sh_test.bzl", "sh_test")]
    extra = []

    # The `bin/tap` package has a `psql` TAP suite that would collide with the
    # `:psql` dev convenience; skip the dev target (and its sh_binary load) when
    # a suite already claims the name. Any other package's `:psql` opens a shell
    # against the same (v, opt) tree.
    if "psql" not in names:
        loads.append(
            Star.load_("@rules_shell//shell:sh_binary.bzl", "sh_binary"),
        )
        extra.append(_psql_binary(version, flavor, option_set, rlocs))

    parts = loads + [
        Star.package(default_visibility = ["//visibility:public"]),
    ] + targets + extra
    return Star.file(header = _HEADER, *parts)

def _emit_suite_targets(
        version,
        flavor,
        option_set,
        slugs,
        groups,
        overrides,
        rlocs,
        build_repo,
        name_fn):
    """Build the `(targets, names)` pair for a set of slugs.

    `name_fn(slug, info)` yields each target name. Drops `exclude`d slugs and
    `-running` infos.
    """
    targets, names = [], []
    for slug in slugs:
        if overrides.get(slug, {}).get("exclude"):
            continue
        slug_override = overrides.get(slug, {})
        for i, info in enumerate(groups[slug]):
            # -running suites use a pre-existing server (--use-existing); the
            # --temp-instance lane cannot serve them, so they are not emitted
            # (the harness also SKIPs them defensively).
            if info.is_running:
                continue

            # `groups[slug]` is ordered primary-kind-first: the first info keeps
            # the bare slug name, each subsequent kind gets a `.<kind>` suffix
            # so a dual-kind module (e.g. brin/commit_ts: regress + isolation)
            # emits `:brin` + `:brin.isolation` instead of two `:brin`
            # duplicates.
            tn = name_fn(
                slug,
                info,
            ) if i == 0 else "%s.%s" % (name_fn(slug, info), info.kind)
            targets.append(_suite_test(
                target_name = tn,
                version = version,
                flavor = flavor,
                option_set = option_set,
                info = info,
                rlocs = rlocs,
                runner = rlocs.runner,
                build_repo = build_repo,
                override = _effective_override(slug_override, info.kind),
            ))
            names.append(tn)
    return targets, names

def _subtree_rlocs(subtree, rlocs, rlocs_modules):
    """Pick the runfiles tree for a suite by its source subtree.

    Core regress/isolation and the PL languages run against the PRODUCTION
    install tree; everything else (test modules, the per-component TAP suites
    under src/bin, src/test/recovery, src/interfaces, ...) needs the
    test-enabled variant, which installs the module fixtures + the TAP
    client/server tools.
    """
    is_core = subtree in ("src/test/regress", "src/test/isolation")
    if is_core or subtree.startswith("src/pl/"):
        return rlocs
    return rlocs_modules

def _pkg_node(pkg, store):
    """Fetch/create the `{names, targets}` accumulator for a package path."""
    node = store.get(pkg)
    if not node:
        node = {"names": [], "targets": []}
        store[pkg] = node
    return node

def _write_mirrored_suites(
        rctx,
        version,
        flavor,
        option_set,
        groups,
        overrides,
        rlocs,
        rlocs_modules,
        build_repo):
    """Render the `@{name}` packages, mirroring the PG source tree.

    Drives any subtree-carrying introspect (meson's `.tests` or the make
    `test_suites`): each suite's package is its source subtree with `src/`
    stripped (`src/test/recovery` -> `test/recovery`, `src/bin/pg_dump` ->
    `bin/pg_dump`); a regress/isolation suite emits ONE target named for the
    package's last path component, while a TAP suite emits one target per `.pl`
    (named the `.pl` basename) under a `tap/` subpackage. contrib is the
    `@{name}_ext` hub, handled by the sibling writer, so contrib subtrees are
    skipped here.
    """

    # Accumulate per-package `{targets, names}`, plus the package's chosen
    # runfiles tree (constant per package: one subtree per package). One
    # BUILD.bazel is rendered per package after the introspect is walked.
    pkgs = {}
    pkg_rlocs = {}
    for slug in sorted(groups):
        if overrides.get(slug, {}).get("exclude"):
            continue
        slug_override = overrides.get(slug, {})

        # Disambiguate a slug's NON-TAP kinds: the first keeps the bare
        # package-last name, each subsequent kind gets a `.<kind>` suffix (a
        # module like injection_points emits `:injection_points` regress +
        # `:injection_points.isolation`).
        non_tap_seen = 0
        for info in groups[slug]:
            # -running suites need a pre-existing server (--use-existing); the
            # --temp-instance lane cannot serve them (the harness SKIPs them
            # too).
            if info.is_running:
                continue

            # contrib is option-set-invariant and lives in @{name}_ext, so the
            # sibling writer emits it; skip it here.
            if info.subtree.startswith("contrib/"):
                continue

            # setup entries carry no subtree (and SKIP in the hermetic lane), so
            # they yield no package.
            pkg = _TestSchema.package_subtree(info.subtree)
            if not pkg:
                continue
            suite_rlocs = _subtree_rlocs(info.subtree, rlocs, rlocs_modules)

            if info.kind == _TestSchema.KIND_TAP:
                # One target per `.pl`, named the basename, under `<pkg>/tap`.
                tap_pkg = pkg + "/tap"
                pkg_rlocs[tap_pkg] = suite_rlocs
                node = _pkg_node(tap_pkg, pkgs)
                for pl in info.pl_names:
                    node["targets"].append(_suite_test(
                        target_name = pl,
                        version = version,
                        flavor = flavor,
                        option_set = option_set,
                        info = info,
                        rlocs = suite_rlocs,
                        runner = suite_rlocs.runner,
                        build_repo = build_repo,
                        override = _effective_override(
                            slug_override,
                            info.kind,
                        ),
                        tap_file = pl,
                    ))
                    node["names"].append(pl)
                continue

            # regress/isolation: ONE target named for the package's last path
            # component, in `<pkg>`.
            base = pkg.rsplit("/", 1)[-1]
            tn = base if non_tap_seen == 0 else "%s.%s" % (base, info.kind)
            non_tap_seen += 1
            pkg_rlocs[pkg] = suite_rlocs
            node = _pkg_node(pkg, pkgs)
            node["targets"].append(_suite_test(
                target_name = tn,
                version = version,
                flavor = flavor,
                option_set = option_set,
                info = info,
                rlocs = suite_rlocs,
                runner = suite_rlocs.runner,
                build_repo = build_repo,
                override = _effective_override(slug_override, info.kind),
            ))
            node["names"].append(tn)

    for pkg in sorted(pkgs):
        node = pkgs[pkg]
        if not node["names"]:
            continue
        rctx.file(
            "%s/%s/tests/%s/BUILD.bazel" % (version, option_set, pkg),
            _category_build(
                pkg_rlocs[pkg],
                node["targets"],
                node["names"],
                version,
                flavor,
                option_set,
            ),
        )

def _write_core(
        rctx,
        version,
        flavor,
        option_set,
        core_groups,
        overrides,
        rlocs,
        build_repo):
    """Render `<v>/<opt>/regress/BUILD.bazel` + `<v>/<opt>/isolation/BUILD.bazel`.

    Core has the regress + isolation slugs; each is its own package with one
    bare-named (`<kind>`) target.
    """
    for slug in sorted(core_groups):
        if overrides.get(slug, {}).get("exclude"):
            continue
        info = core_groups[slug][0]  # core slugs are single-kind
        if info.is_running:
            continue

        # setup/tap are SKIP-only in the hermetic lane, so emit no package.
        if info.kind in (_TestSchema.KIND_SETUP, _TestSchema.KIND_TAP):
            continue
        kind = info.kind  # "regress" | "isolation"
        target = _suite_test(
            target_name = kind,
            version = version,
            flavor = flavor,
            option_set = option_set,
            info = info,
            rlocs = rlocs,
            runner = rlocs.runner,
            build_repo = build_repo,
            override = _effective_override(overrides.get(slug, {}), kind),
        )
        rctx.file(
            "%s/BUILD.bazel" % _core_package(version, option_set, kind),
            _category_build(
                rlocs,
                [target],
                [kind],
                version,
                flavor,
                option_set,
            ),
        )

def _write_category_pkg(
        rctx,
        version,
        flavor,
        option_set,
        category,
        cat_groups,
        overrides,
        rlocs,
        build_repo):
    """Render `<v>/<opt>/pl/BUILD.bazel` or `<v>/<opt>/modules/BUILD.bazel`.

    The make-path category package: the per-suite target name is the slug.
    """
    if not cat_groups:
        return
    targets, names = _emit_suite_targets(
        version,
        flavor,
        option_set,
        sorted(cat_groups),
        cat_groups,
        overrides,
        rlocs,
        build_repo,
        name_fn = lambda slug, info: slug,
    )
    if not names:
        return
    rctx.file(
        "%s/BUILD.bazel" % _category_package(version, option_set, category),
        _category_build(rlocs, targets, names, version, flavor, option_set),
    )

def _oracle_suite_infos(test_meta, version):
    """Synthesize the main oracle suites `{slug: [SuiteInfo]}`.

    Reads the catalog `metadata.test.oracle` block (version-spec-keyed).
    IvorySQL's meson build never enters src/oracle_test, so this suite has no
    introspect entry; the catalog declares it. Returns {} when no oracle block
    matches.
    """
    oracle_meta = test_meta.get("oracle")
    if not oracle_meta:
        return {}

    # reuse the make-path decoder: {version_spec: [decl]} -> {slug:
    # [SuiteInfo]}. Each decl carries name/kind/schedule plus the oracle
    # override fields the caller threads into the per-suite override.
    return _TestSchema.suites_from_metadata_test(oracle_meta, version)

def _write_oracle_pkg(rctx, version, flavor, option_set, test_meta, rlocs, build_repo):
    """Render `<v>/<opt>/oracle/BUILD.bazel` (IvorySQL only).

    The target name is the kind (regress). The oracle override
    (initdb_mode/initdb_compat/inputdir_rel) is synthesized per-suite here from
    the catalog decl, not from `test_overrides`.
    """
    oracle_groups = _oracle_suite_infos(test_meta, version)
    if not oracle_groups:
        return
    targets, names = [], []
    for slug in sorted(oracle_groups):
        for info in oracle_groups[slug]:
            if info.is_running:
                continue

            # the oracle suite's mode/compat/inputdir live on the catalog decl;
            # surface them via the override dict _runner_args reads.
            ov = {
                "initdb_compat": {">=4.0": "normal"},
                "initdb_mode": "oracle",
                "inputdir_rel": "src/oracle_test/%s" % (
                    "isolation" if info.kind == _TestSchema.KIND_ISOLATION else "regress"
                ),
            }
            targets.append(_suite_test(
                target_name = info.kind,
                version = version,
                flavor = flavor,
                option_set = option_set,
                info = info,
                rlocs = rlocs,
                runner = rlocs.runner,
                build_repo = build_repo,
                override = ov,
            ))
            names.append(info.kind)
    if not names:
        return
    rctx.file(
        "%s/BUILD.bazel" % ("%s/%s/tests/oracle" % (version, option_set)),
        _category_build(rlocs, targets, names, version, flavor, option_set),
    )

# ---------------------------------------------------------------------------
# Writer (the repo-rule entry point per version).
# ---------------------------------------------------------------------------

def write_test_version(
        rctx,
        version,
        flavor,
        build_repo,
        option_sets,
        introspect_labels,
        pg_tar_by_opt,
        runtime_tar,
        src_dir,
        overrides = {},
        test_meta = {},
        test_libs_by_opt = {},
        test_pg_tar_by_opt = {}):
    """Generate the `@{name}` packages (+ the IvorySQL oracle suite).

    For each option set, decode the suites -- from the introspect `.tests` array
    (meson, PG >= 16), the make introspect's `test_suites` array, or the
    version-keyed `metadata.test` block (the remaining fallback). A
    subtree-carrying introspect (meson `.tests` or the make `test_suites`)
    drives the subtree-mirroring layout (`_write_mirrored_suites`); only the
    subtree-less `metadata.test` fallback keeps the category layout (core
    regress/isolation packages plus pl/modules). The IvorySQL oracle main suite
    is synthesized when the catalog declares it. Contrib is routed to
    `@{name}_ext` by the sibling writer.

    Args:
        rctx: the `test_repo` repo-rule context (reads/writes generated files).
        version: the PG `major.minor` (e.g. `"15.0"`).
        flavor: the flavor slug (e.g. `"postgres"`).
        build_repo: repo holding the harness scripts + bsdtar toolchain.
        option_sets: the flavor's option-set list (last = default root alias).
        introspect_labels: `{option_set: Label}` of the introspect JSONs.
        pg_tar_by_opt: `{option_set: install-tree label}`.
        runtime_tar: runtime sysroot tar label (test-exec closure base).
        src_dir: source-tree label (sql/expected/schedules/specs/data).
        overrides: `metadata.test_overrides`, resolved per kind by suite.
        test_meta: `metadata.test` introspect, read when `.tests` is empty.
        test_libs_by_opt: optional `{option_set: :test-libs label}`.
        test_pg_tar_by_opt: `{option_set: test-variant install-tree label}`
            (`@pg//<v>/<opt>:tar.test`), used by the `modules:` suites; empty
            falls back to `pg_tar_by_opt`.
    """

    # The `<v>` root alias is owned by the base hub's `write_base_version`
    # (`<v>` -> the default install tree); the introspect renders only the
    # `<v>/<opt>/tests/...` packages, never a `<v>/BUILD.bazel`.
    for option_set in option_sets:
        label = introspect_labels.get(option_set)
        if not label:
            continue

        introspect = json.decode(rctx.read(rctx.path(label)))

        # The meson `.tests` array and the make `test_suites` introspect both
        # name each suite's source subtree, so both drive the subtree-mirroring
        # layout; only the subtree-less `metadata.test` fallback keeps the flat
        # category layout.
        if introspect.get("tests"):
            groups = _TestSchema.suites_from_tests(introspect["tests"])
            mirror_source = True
        elif introspect.get("test_suites"):
            groups = _TestSchema.suites_from_test_suites(
                introspect["test_suites"],
            )
            mirror_source = True
        else:
            groups = _TestSchema.suites_from_metadata_test(test_meta, version)
            mirror_source = False
        if not groups:
            continue

        rlocs = _rlocs(
            build_repo,
            pg_tar_by_opt[option_set],
            runtime_tar,
            src_dir,
            test_libs = test_libs_by_opt.get(option_set),
        )

        # The module + TAP suites LOAD / CREATE EXTENSION src/test/modules
        # fixtures and run the TAP client/server tools, both of which only the
        # test-enabled build variant installs (see pg_build's
        # _TEST_MODULES_CAPTURE). Point them at `@pg//<v>/<opt>:tar.test`;
        # core/pl/oracle keep the production tree.
        rlocs_modules = _rlocs(
            build_repo,
            test_pg_tar_by_opt.get(option_set) or pg_tar_by_opt[option_set],
            runtime_tar,
            src_dir,
            test_libs = test_libs_by_opt.get(option_set),
        )

        if mirror_source:
            # The introspect names each suite's source subtree, so the package
            # layout mirrors the PG tree 1:1 and TAP splits per `.pl`. contrib
            # is routed to @{name}_ext by the sibling writer.
            _write_mirrored_suites(
                rctx,
                version,
                flavor,
                option_set,
                groups,
                overrides,
                rlocs,
                rlocs_modules,
                build_repo,
            )
        else:
            # A subtree-less introspect keeps the category-based layout: core
            # regress/isolation packages, plus a per-(version, option_set)
            # package per category.
            by_cat = _TestSchema.split_by_category(groups)
            _write_core(
                rctx,
                version,
                flavor,
                option_set,
                by_cat[_TestSchema.CAT_CORE],
                overrides,
                rlocs,
                build_repo,
            )
            for cat in sorted(by_cat):
                if cat in (_TestSchema.CAT_CORE, _TestSchema.CAT_CONTRIB):
                    continue
                cat_rlocs = rlocs if cat == _TestSchema.CAT_PL else rlocs_modules
                _write_category_pkg(
                    rctx,
                    version,
                    flavor,
                    option_set,
                    cat,
                    by_cat[cat],
                    overrides,
                    cat_rlocs,
                    build_repo,
                )

        # IvorySQL oracle main suite: synthesized from metadata.test.oracle (the
        # build never enters src/oracle_test, so it has no introspect entry).
        # Emitted only when the catalog declares it for this version.
        _write_oracle_pkg(
            rctx,
            version,
            flavor,
            option_set,
            test_meta,
            rlocs,
            build_repo,
        )

def write_ext_test_version(
        rctx,
        version,
        flavor,
        build_repo,
        default_option_set,
        introspect,
        pg_tar_default,
        runtime_tar,
        src_dir,
        overrides = {},
        test_meta = {},
        test_libs_default = None):
    """Render the contrib test packages for ONE version into @{name}_ext.

    Contrib is option-set-invariant (in PG's tree), so every contrib suite runs
    against the DEFAULT option set's `:tar` (`@{name}//<v>/<default_opt>:tar`).
    Layout: `contrib/<name>/<v>` with one target per kind (regress/isolation).
    The introspect + overrides come from the SAME PG introspect as @{name}.

    Args:
        rctx: the `ext_test_repo` repo-rule context (reads/writes generated
            files).
        version: the PG `major.minor` (e.g. `"15.0"`).
        flavor: the flavor slug (e.g. `"postgres"`).
        build_repo: repo holding the harness scripts + bsdtar toolchain.
        default_option_set: the option set whose `:tar` every contrib suite runs
            against (contrib is option-set-invariant in PG's tree).
        introspect: the decoded default-option-set introspect JSON.
        pg_tar_default: the default option set's install-tree label.
        runtime_tar: runtime sysroot tar label (test-exec closure base).
        src_dir: source-tree label (sql/expected/schedules/specs/data).
        overrides: `metadata.test_overrides`, resolved per kind by suite.
        test_meta: `metadata.test` introspect, read when `.tests` is empty.
        test_libs_default: optional default-option-set `:test-libs` label.
    """
    if introspect.get("tests"):
        groups = _TestSchema.suites_from_tests(introspect["tests"])
    elif introspect.get("test_suites"):
        groups = _TestSchema.suites_from_test_suites(introspect["test_suites"])
    else:
        groups = _TestSchema.suites_from_metadata_test(test_meta, version)
    if not groups:
        return

    contrib_groups = _TestSchema.split_by_category(
        groups,
    )[_TestSchema.CAT_CONTRIB]
    rlocs = _rlocs(
        build_repo,
        pg_tar_default,
        runtime_tar,
        src_dir,
        test_libs = test_libs_default,
    )

    for name in sorted(contrib_groups):
        if overrides.get(name, {}).get("exclude"):
            continue
        slug_override = overrides.get(name, {})
        targets, names = [], []
        for info in contrib_groups[name]:
            if info.is_running:
                continue
            tn = info.kind  # "regress" | "isolation"
            targets.append(_suite_test(
                target_name = tn,
                version = version,
                flavor = flavor,
                option_set = default_option_set,
                info = info,
                rlocs = rlocs,
                runner = rlocs.runner,
                build_repo = build_repo,
                override = _effective_override(slug_override, info.kind),
            ))
            names.append(tn)
        if not names:
            continue
        rctx.file(
            "%s/BUILD.bazel" % _contrib_package(name, version),
            _category_build(
                rlocs,
                targets,
                names,
                version,
                flavor,
                default_option_set,
            ),
        )

# ---------------------------------------------------------------------------
# External (non-contrib) extension test introspect.
#
# An external extension is built as a standalone PGXS artifact tar (the overlay)
# against a base PG, so its suites run against the BASE hub's install tree with
# the artifact overlaid onto a writable copy of PGROOT (the harness
# `--overlay-tar` lane). Two golden-free tiers against the fork-independent
# upstream: a smoke CREATE EXTENSION exit-check (the always-on floor) and the
# extension's own upstream pg_regress suite(s). Rendered into `@{name}_ext`
# under `<ext>/<ext_v>/<base_v>/tests`, parallel to the contrib packages.
# ---------------------------------------------------------------------------

def _ext_rlocs(
        build_repo,
        pg_tar,
        runtime_tar,
        overlay_tar,
        ext_srcdir = None,
        ext_runtime_tar = None,
        pg_src_dir = None,
        extra_overlay_tars = [],
        extra_runtime_tars = []):
    """Assemble the external-lane runfiles arg strings + the `data` list.

    Unlike `_rlocs` (core/contrib), the external lane runs against the
    extension's OWN source via `--ext-srcdir` (smoke reads none; a regress suite
    reads its `sql/`+`expected/`), and adds the extension artifact tar
    (`--overlay-tar`), optionally the extension source-tree root
    (`--ext-srcdir`, a single tree artifact), and optionally the extension's
    runtime-deps sysroot tar (`--ext-runtime-from`, absent for an extension with
    no third-party runtime deps). A TAP suite additionally needs the PG source
    tree (for `src/test/perl` = PostgreSQL::Test) and the base `test` deps
    sysroot (IPC::Run), both shipped only when `pg_src_dir` is set.

    Args:
        build_repo: build repo holding the harness scripts + bsdtar toolchain.
        pg_tar: the BASE hub install-tree label (`@{name}//<base_v>/<opt>:tar`);
            supplies initdb / pg_regress / the postmaster.
        runtime_tar: the base runtime sysroot tar (closure base).
        overlay_tar: the extension artifact tar
            (`@{name}_ext//<ext>/<ext_v>/<base_v>:<base_v>`).
        ext_srcdir: the extension source-tree root
            (`@{name}_ext//<ext>/<ext_v>:dir`), or None (smoke needs no source).
        ext_runtime_tar: the extension runtime-deps sysroot tar
            (`@{name}_ext//<ext>/<ext_v>/deps/runtime:sysroot_tar`), or None.
        pg_src_dir: the base hub PG source tree (`@{name}//<base_v>/src:dir`)
            for a TAP suite (PostgreSQL::Test lives in `src/test/perl`), or
            None; when set, the base `test` deps sysroot (IPC::Run) is shipped
            too.
        extra_overlay_tars: prerequisite extensions' artifact tars (from
            `test_ext.requires`), each overlaid alongside `overlay_tar` via an
            additional `--overlay-tar` so a hard dependency's files are present.
        extra_runtime_tars: those prerequisite extensions' runtime-deps sysroot
            tars, each layered onto the closure via an additional
            `--ext-runtime-from`.

    Returns a struct of arg strings + the `data` list.
    """
    f = bind(build = build_repo)
    closure_setup = f("@{build}//monoext/private/test:closure_setup.sh")
    sysroot_lib = f("@{build}//monoext/private/base:sysroot_lib.sh")
    runner_srcs = f("@{build}//monoext/private/test:regress_runner.sh")
    bsdtar = "@bsd_tar_toolchains//:resolved_toolchain"
    runfiles = "@bazel_tools//tools/bash/runfiles"

    data = [
        runner_srcs,
        closure_setup,
        sysroot_lib,
        runtime_tar,
        pg_tar,
        overlay_tar,
        bsdtar,
        runfiles,
    ]
    if ext_srcdir:
        data.append(ext_srcdir)
    if ext_runtime_tar:
        data.append(ext_runtime_tar)
    data += extra_overlay_tars + extra_runtime_tars

    # A TAP suite layers the base `test` deps sysroot (IPC::Run) onto the
    # runtime closure and ships the PG source tree for PostgreSQL::Test; derive
    # the test sysroot label from the runtime tar (same
    # `<base_v>/deps/<kind>:sysroot_tar` shape), exactly as the core lane does.
    test_sysroot_tar = None
    if pg_src_dir:
        test_sysroot_tar = runtime_tar.replace(
            "/deps/runtime:",
            "/deps/test:",
        )
        data += [pg_src_dir, test_sysroot_tar]

    return struct(
        runner = runner_srcs,
        closure_setup = _rloc(closure_setup),
        sysroot_lib = _rloc(sysroot_lib),
        bsdtar = _rloc(bsdtar),
        runtime_tar = _rloc(runtime_tar),
        # The base install tree is a directory tree: pass EVERY file
        # (`rlocationpaths`, plural) so the harness locates bin/initdb, as the
        # core lane does. The artifact tar + source tree are single file/tree
        # artifacts the harness resolves with a single rloc.
        pg_tar = "$(rlocationpaths %s)" % pg_tar,
        overlay_tar = _rloc(overlay_tar),
        ext_srcdir = _rloc(ext_srcdir) if ext_srcdir else None,
        ext_runtime_tar = _rloc(ext_runtime_tar) if ext_runtime_tar else None,
        # TAP-only: the PG source tree (a dir tree -> plural rloc) for
        # src/test/perl, and the base `test` deps sysroot the harness layers
        # onto the closure. Both None for smoke/regress.
        pg_src_dir = ("$(rlocationpaths %s)" % pg_src_dir) if pg_src_dir else None,
        test_sysroot = _rloc(test_sysroot_tar) if test_sysroot_tar else None,
        # Prerequisite extensions (from `test_ext.requires`): extra
        # `--overlay-tar` / `--ext-runtime-from` operands the runner accepts
        # repeatably, so each is staged before `CREATE EXTENSION`.
        extra_overlay_tars = [_rloc(t) for t in extra_overlay_tars],
        extra_runtime_tars = [_rloc(t) for t in extra_runtime_tars],
        data = data,
    )

def _ext_positionals(rlocs):
    """Return the runfiles positionals shared by the external test targets.

    The `$1`-`$4` closure args plus the base install tree, common to the smoke
    and regress external `sh_test`s.
    """
    return [
        rlocs.closure_setup,
        rlocs.sysroot_lib,
        rlocs.bsdtar,
        rlocs.runtime_tar,
        rlocs.pg_tar,
    ]

def _overlay_args(rlocs):
    """Build the `--overlay-tar` operands for a test target.

    The extension's own artifact tar plus any prerequisite extension tars
    (`test_ext.requires`), which the runner overlays in order onto the tree.
    """
    args = ["--overlay-tar", rlocs.overlay_tar]
    for t in rlocs.extra_overlay_tars:
        args += ["--overlay-tar", t]
    return args

def _ext_runtime_args(rlocs):
    """Build the `--ext-runtime-from` operands for a test target.

    The extension's own runtime-deps tar (if any) plus any prerequisite
    extensions' runtime-deps tars, each layered onto the closure so every
    overlaid `.so` resolves its NEEDED libraries.
    """
    args = []
    if rlocs.ext_runtime_tar:
        args += ["--ext-runtime-from", rlocs.ext_runtime_tar]
    for t in rlocs.extra_runtime_tars:
        args += ["--ext-runtime-from", t]
    return args

def _ext_test_build(targets):
    """Render an external extension's `<ext>/<ext_v>/<base_v>/tests/BUILD.bazel`.

    sh_test load + package + the suite targets. No `:psql` dev target (the base
    hub already exposes one per (version, option_set)).
    """
    parts = [
        Star.load_("@rules_shell//shell:sh_test.bzl", "sh_test"),
        Star.package(default_visibility = ["//visibility:public"]),
    ] + targets
    return Star.file(header = _HEADER, *parts)

def _smoke_test(base_version, flavor, default_option_set, rlocs, ext_name, smoke):
    """Render the `:smoke` `sh_test` for one (ext, ext_v, base_v).

    The always-on floor: `--kind smoke` boots a temp instance off the overlaid
    tree and runs CREATE EXTENSION for each name. The extension name defaults to
    the catalog dir name; `smoke.extensions` overrides it (pgvector -> vector).
    `smoke.preload` populates shared_preload_libraries; `smoke.cascade` adds
    CASCADE. An explicit empty `smoke.extensions` returns None (no smoke
    target): the extension has no CREATE EXTENSION entry point, e.g. an
    output-plugin-only ext whose *.control ships no install script.
    """
    if "extensions" in smoke and not smoke["extensions"]:
        return None
    extensions = smoke.get("extensions") or [ext_name]
    preload = smoke.get("preload", [])
    cascade = smoke.get("cascade", False)

    args = _ext_positionals(rlocs) + ["--kind", "smoke"] + _overlay_args(rlocs)
    args += _ext_runtime_args(rlocs)
    args += [
        "--version",
        base_version,
        "--flavor",
        flavor,
        "--option-set",
        default_option_set,
    ]
    for e in extensions:
        args += ["--ext-name", e]
    for lib in preload:
        args += ["--preload", lib]
    if cascade:
        args.append("--cascade")

    return Star.igen(Star.fn("sh_test", **dict(
        name = "smoke",
        srcs = [rlocs.runner],
        args = args,
        data = rlocs.data,
        size = "medium",
        tags = [_TAG_REGRESS, "smoke", "external"],
        env_inherit = _ENV_INHERIT,
    )))

def _ext_regress_test(
        target_name,
        base_version,
        flavor,
        default_option_set,
        info,
        rlocs):
    """Render one external upstream `pg_regress` suite `sh_test`.

    The extension's own suite (from `metadata.test_ext.test`), run against the
    overlaid tree with `--ext-srcdir`/`--ext-inputdir` pointing pg_regress at
    the extension's own `sql/`+`expected/`. Golden-free against the
    fork-independent upstream: the `.out` files ship with the extension source.
    """
    args = _ext_positionals(rlocs)
    args += _ext_runtime_args(rlocs)
    args += [
        "--kind",
        info.kind,
        "--suite",
        info.slug,
    ] + _overlay_args(rlocs) + [
        "--ext-srcdir",
        rlocs.ext_srcdir,
    ]
    if info.inputdir:
        args += ["--ext-inputdir", info.inputdir]
    args += [
        "--version",
        base_version,
        "--flavor",
        flavor,
        "--option-set",
        default_option_set,
    ]
    args += _repeated_flag("--tests", info.test_names)
    if info.dbname:
        args += ["--dbname", info.dbname]
    for ext in info.load_extensions:
        args += ["--regress-opt", "--load-extension=%s" % ext]

    # Locale/encoding: a suite that names an encoding (e.g. age's UTF-8) manages
    # its own locale, so pass it through; otherwise force the C locale upstream
    # `make installcheck` runs under (LC_ALL=C), like the core regress lane.
    if info.encoding:
        args += ["--regress-opt", "--encoding=%s" % info.encoding]
    else:
        args += ["--regress-opt", "--no-locale"]

    # The suite's own --temp-config (a .conf in the extension source tree), any
    # shared_preload_libraries it needs but ships no .conf for, and an
    # expected/-dir override for a suite that keeps expected/ outside
    # --inputdir.
    if info.temp_config:
        args += ["--ext-temp-config", info.temp_config]
    for lib in info.preload:
        args += ["--preload", lib]
    if info.expecteddir:
        args += ["--ext-expecteddir", info.expecteddir]

    # A suite whose upstream --temp-instance sits inside its own source tree, so
    # a test that names the datadir relatively resolves (see the harness).
    if info.temp_instance:
        args += ["--ext-temp-instance", info.temp_instance]

    tags = [_TAG_REGRESS, "external"]
    if info.exclusive_suite:
        # A suite carrying a wall-clock assertion is deterministic only without
        # concurrent CPU/IO contention (pgmq asserts a read completes within
        # 100ms), and a regress suite's tests share one target, so the whole
        # suite goes into bazel's exclusive phase.
        tags.append("exclusive")
    return Star.igen(Star.fn("sh_test", **dict(
        name = target_name,
        srcs = [rlocs.runner],
        args = args,
        data = rlocs.data,
        size = "medium",
        tags = tags,
        env_inherit = _ENV_INHERIT,
    )))

def _ext_tap_test(
        target_name,
        base_version,
        flavor,
        default_option_set,
        slug,
        tap_file,
        tap_locale,
        exclusive,
        rlocs):
    """Render one external upstream PostgreSQL::Test TAP `.pl` as an `sh_test`.

    Runs the extension's own `t/<tap_file>.pl` against the overlaid tree with
    `--kind tap`: the PG source tree (`rlocs.pg_src_dir`, a positional) supplies
    `src/test/perl` = PostgreSQL::Test, `--test-sysroot-from` layers IPC::Run
    onto the closure, and `--ext-srcdir` roots the run at the extension source
    so `use lib 't'` finds the suite's own helper modules. One target per `.pl`
    (the decl's `tests` list), so a non-hermetic test is dropped by omitting it.
    """
    args = _ext_positionals(rlocs) + [rlocs.pg_src_dir]
    args += _ext_runtime_args(rlocs)
    args += [
        "--test-sysroot-from",
        rlocs.test_sysroot,
        "--kind",
        "tap",
        "--suite",
        slug,
    ] + _overlay_args(rlocs) + [
        "--ext-srcdir",
        rlocs.ext_srcdir,
        "--tap-file",
        tap_file,
        "--version",
        base_version,
        "--flavor",
        flavor,
        "--option-set",
        default_option_set,
    ]
    if tap_locale:
        args += ["--tap-locale", tap_locale]
    tags = [_TAG_REGRESS, "tap", "external"]
    if exclusive:
        # A timing-sensitive .pl is deterministic only without concurrent CPU
        # contention (pg_stat_monitor's histogram buckets by real response
        # time), so run it in bazel's exclusive phase, alone.
        tags.append("exclusive")
    return Star.igen(Star.fn("sh_test", **dict(
        name = target_name,
        srcs = [rlocs.runner],
        args = args,
        data = rlocs.data,
        size = "medium",
        tags = tags,
        env_inherit = _ENV_INHERIT,
    )))

def _manual_placeholder_test(target_name, build_repo):
    """Render a tier-3 non-hermetic external suite placeholder `sh_test`.

    A `kind: manual` external decl declares a suite that is not hermetically
    runnable (e.g. citus's pg_regress_multi + mitmproxy). The placeholder is
    tagged `manual` + `non-hermetic` so `bazel test //...` skips it; an explicit
    run fails via the stub. It carries no runfiles closure (it never boots PG).
    """
    f = bind(build = build_repo)
    placeholder = f("@{build}//monoext/private/test:manual_placeholder.sh")
    return Star.igen(Star.fn("sh_test", **dict(
        name = target_name,
        srcs = [placeholder],
        args = [target_name],
        tags = ["manual", "non-hermetic", "external"],
    )))

def write_external_ext_test_entry(
        rctx,
        ext_name,
        ext_version,
        base_version,
        flavor,
        build_repo,
        default_option_set,
        pg_tar,
        runtime_tar,
        overlay_tar,
        ext_srcdir,
        ext_runtime_tar,
        pg_src_dir,
        test_ext,
        extra_overlay_tars = [],
        extra_runtime_tars = []):
    """Render the external-extension test package for one (ext, ext_v, base_v).

    Writes `<ext>/<ext_v>/<base_v>/tests/BUILD.bazel` into `@{name}_ext` with a
    `:smoke` target (when `test_ext.smoke` is present) plus a target per
    `test_ext.test` suite (regress, TAP `.pl`, manual, or integration). A no-op
    when `test_ext` declares neither.

    Args:
        rctx: the `ext_repo` repo-rule context.
        ext_name: the extension (catalog dir) name.
        ext_version: the extension version string.
        base_version: the base PG version the artifact was built against.
        flavor: the base flavor slug (e.g. `"postgres"`).
        build_repo: repo holding the harness scripts + bsdtar toolchain.
        default_option_set: the base hub option set the artifact matches.
        pg_tar: the base install-tree label (default option set).
        runtime_tar: the base runtime sysroot tar label.
        overlay_tar: the extension artifact tar label.
        ext_srcdir: the extension source-tree root label.
        ext_runtime_tar: the extension runtime-deps sysroot tar label, or None.
        pg_src_dir: the base hub PG source tree label (a TAP suite's
            PostgreSQL::Test lives in `src/test/perl`), or None.
        test_ext: the extension's `metadata.test_ext` dict (`smoke` + `test`).
        extra_overlay_tars: prerequisite extensions' artifact tars (resolved by
            the caller from `test_ext.requires` for this base version), overlaid
            into every test instance alongside `overlay_tar`.
        extra_runtime_tars: those prerequisite extensions' runtime-deps sysroot
            tars, layered onto the closure alongside `ext_runtime_tar`.
    """
    targets = []

    smoke = test_ext.get("smoke")
    if smoke != None:
        smoke_rlocs = _ext_rlocs(
            build_repo,
            pg_tar,
            runtime_tar,
            overlay_tar,
            ext_runtime_tar = ext_runtime_tar,
            extra_overlay_tars = extra_overlay_tars,
            extra_runtime_tars = extra_runtime_tars,
        )
        smoke_target = _smoke_test(
            base_version = base_version,
            flavor = flavor,
            default_option_set = default_option_set,
            rlocs = smoke_rlocs,
            ext_name = ext_name,
            smoke = smoke,
        )
        if smoke_target:
            targets.append(smoke_target)

    # The upstream pg_regress suites (version-spec-keyed, reusing the make-path
    # introspect decoder); each runs against the extension's own source tree.
    groups = _TestSchema.suites_from_metadata_test(
        test_ext.get("test", {}),
        base_version,
    )
    if groups:
        reg_rlocs = _ext_rlocs(
            build_repo,
            pg_tar,
            runtime_tar,
            overlay_tar,
            ext_srcdir = ext_srcdir,
            ext_runtime_tar = ext_runtime_tar,
            extra_overlay_tars = extra_overlay_tars,
            extra_runtime_tars = extra_runtime_tars,
        )
        for slug in sorted(groups):
            for info in groups[slug]:
                if info.kind == _TestSchema.KIND_REGRESS:
                    targets.append(_ext_regress_test(
                        target_name = slug,
                        base_version = base_version,
                        flavor = flavor,
                        default_option_set = default_option_set,
                        info = info,
                        rlocs = reg_rlocs,
                    ))
                elif info.kind == _TestSchema.KIND_MANUAL:
                    # Tier-3: a non-hermetic suite, declared only as a tagged
                    # placeholder (no hermetic runner; run by hand).
                    targets.append(_manual_placeholder_test(
                        target_name = slug,
                        build_repo = build_repo,
                    ))
                elif info.kind == _TestSchema.KIND_TAP:
                    # The extension's own PostgreSQL::Test TAP suite: one target
                    # per `.pl`. Needs the PG source tree (PostgreSQL::Test) +
                    # the base `test` deps sysroot (IPC::Run); skip if the base
                    # hub did not expose its source for this version.
                    if pg_src_dir:
                        tap_rlocs = _ext_rlocs(
                            build_repo,
                            pg_tar,
                            runtime_tar,
                            overlay_tar,
                            ext_srcdir = ext_srcdir,
                            ext_runtime_tar = ext_runtime_tar,
                            pg_src_dir = pg_src_dir,
                            extra_overlay_tars = extra_overlay_tars,
                            extra_runtime_tars = extra_runtime_tars,
                        )
                        for pl in info.pl_names:
                            targets.append(_ext_tap_test(
                                target_name = pl,
                                base_version = base_version,
                                flavor = flavor,
                                default_option_set = default_option_set,
                                slug = slug,
                                tap_file = pl,
                                tap_locale = info.tap_locale,
                                exclusive = pl in info.tap_exclusive,
                                rlocs = tap_rlocs,
                            ))

    if not targets:
        return
    rctx.file(
        "%s/%s/%s/tests/BUILD.bazel" % (ext_name, ext_version, base_version),
        _ext_test_build(targets),
    )

# Exposed for unit tests (mirrors the `testing = struct(...)` in base/ext).
testing = struct(
    _repeated_flag = _repeated_flag,
    _bazel_size = _bazel_size,
    _bazel_tags = _bazel_tags,
    _effective_override = _effective_override,
    _suite_test = _suite_test,
    _category_build = _category_build,
    _write_core = _write_core,
    _write_category_pkg = _write_category_pkg,
    _write_mirrored_suites = _write_mirrored_suites,
    _rlocs = _rlocs,
    _ext_rlocs = _ext_rlocs,
    _smoke_test = _smoke_test,
    _ext_regress_test = _ext_regress_test,
    _ext_tap_test = _ext_tap_test,
)
