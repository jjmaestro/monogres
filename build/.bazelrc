# /* vim: set filetype=sh : */

common --show_timestamps
common --progress_in_terminal_title
common --incompatible_disallow_empty_glob
common --attempt_to_print_relative_paths
common --check_direct_dependencies=error
common --keep_going

common:debug --announce_rc
common:debug --experimental_ui_max_stdouterr_bytes=52428800
common:debug --nokeep_going

common:remote --ui_actions_shown 100

# Add mirrors for certain download URLs
common --downloader_config=.bazel_downloader.cfg

# rules_python defaults to the system_python bootstrap, whose py_binary
# launchers exec `#!/usr/bin/env python3` and so depend on an ambient
# system python3 on PATH (not hermetic). Select the script bootstrap so
# the launchers exec the rules_python toolchain interpreter directly, with
# no dependency on a system python3.
common --@rules_python//python/config_settings:bootstrap_impl=script

build --nostamp
build --incompatible_strict_action_env
build --reuse_sandbox_directories
build --incompatible_default_to_explicit_init_py
build --nolegacy_external_runfiles
build --nobuild_runfile_links
build --noaction_cache_store_output_metadata
build --guard_against_concurrent_changes
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Default to `bazel test //...` ONLY building and running test targets and
# their deps, never every target matched by the pattern. This way it stays fast
# and never kicks off the full Postgres x option_set x extension matrix by
# accident.
test --build_tests_only

# Explicit config to opt back into building EVERY matched target alongside the
# tests (the full matrix).
test:build-all --nobuild_tests_only

# Build Event Service (BES):
# build events can be uploaded to services like BuildBuddy to get
# a nice UI and a URL that you can share with others to debug or
# review the results of a build.
# https://bazel.build/remote/bep#build-event-service
build:bes-buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:bes-buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:bes-buildbuddy --bes_upload_mode=nowait_for_upload_complete

build:debug --config=bes-buildbuddy
build:debug --show_result=9999
build:debug --verbose_failures
build:debug --verbose_explanations
build:debug --explain=/tmp/verbose_explanations
build:debug --sandbox_debug
build:debug --subcommands

# --- Hermetic Linux sandbox config (opt-in via --config=hermetic-linux) ---
# Strict sandbox + network + tag isolation, intended as a discovery
# layer for any implicit host dependencies that survive the cc_sysroot
# work.
build:hermetic-linux --announce_rc
test:hermetic-linux --announce_rc
build:hermetic-linux --spawn_strategy=sandboxed
build:hermetic-linux --genrule_strategy=sandboxed
build:hermetic-linux --worker_sandboxing
build:hermetic-linux --experimental_use_hermetic_linux_sandbox
# The chroot starts empty (no /bin, /lib, /lib64, /usr, /proc, /etc).
# `sandbox_linux` carries the whole manifest: the arch-independent
# entries (bash-static, busybox-static, /proc, /etc/passwd, ...) plus
# the single arch-specific irreducible (the dynamic loader, one entry
# per arch via `:hermetic-linux-amd64` / `:hermetic-linux-arm64`
# config selectors that auto-include `:hermetic-linux`). Activate with
# `--config=hermetic-linux-amd64` (or `-arm64`).
import %workspace%/.bazelrc.sandbox_linux
build:hermetic-linux --incompatible_sandbox_hermetic_tmp
build:hermetic-linux --sandbox_default_allow_network=false
test:hermetic-linux --sandbox_default_allow_network=false
common:hermetic-linux --incompatible_allow_tags_propagation

# Hermetic execution is the project default: plain `bazel build` / `bazel test`
# run in the empty-chroot sandbox with the amd64 loader + platform. RBE and
# cross invocations pass their own `--config=` (e.g. `--config=remote-buildbarn
# --config=linux-arm64-buildbarn`), whose strategy + platform override the
# defaults set here.
build --config=hermetic-linux-amd64

common:linux-amd64 --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
common:linux-arm64 --extra_toolchains=@llvm_toolchain//:cc-toolchain-aarch64-linux

common:linux-amd64-buildbuddy --config=linux-amd64
common:linux-amd64-buildbuddy --platforms=//platforms:linux_amd64_rbe_buildbuddy
common:linux-amd64-buildbuddy --extra_execution_platforms=//platforms:linux_amd64_rbe_buildbuddy

common:linux-arm64-buildbuddy --config=linux-arm64
common:linux-arm64-buildbuddy --platforms=//platforms:linux_arm64_rbe_buildbuddy
common:linux-arm64-buildbuddy --extra_execution_platforms=//platforms:linux_arm64_rbe_buildbuddy

common:linux-amd64-buildbarn --config=linux-amd64
common:linux-amd64-buildbarn --platforms=//platforms:linux_amd64_rbe_buildbarn
common:linux-amd64-buildbarn --extra_execution_platforms=//platforms:linux_amd64_rbe_buildbarn

common:linux-arm64-buildbarn --config=linux-arm64
common:linux-arm64-buildbarn --platforms=//platforms:linux_arm64_rbe_buildbarn
common:linux-arm64-buildbarn --extra_execution_platforms=//platforms:linux_arm64_rbe_buildbarn

build:remote --define=EXECUTOR=remote
build:remote --strategy=remote
build:remote --spawn_strategy=remote
build:remote --genrule_strategy=remote
build:remote --jobs=50
build:remote --nolegacy_important_outputs
build:remote --noslim_profile
build:remote --experimental_profile_include_target_label
build:remote --experimental_profile_include_primary_output
build:remote --noremote_upload_local_results
build:remote --remote_timeout=5m

build:remote-buildbuddy --config=remote --config=bes-buildbuddy
build:remote-buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
build:remote-buildbuddy --experimental_remote_cache_compression
build:remote-buildbuddy --experimental_remote_cache_compression_threshold=100  # bytes

build:remote-buildbarn --config=remote --config=bes-buildbuddy
build:remote-buildbarn --remote_executor=grpcs://rbe.monogres.dev

# custom bazelrc where each user can add their customizations and/or
# e.g. authentication parts that shouldn't be committed to the repo.
# see .bazelrc.user.tmpl for a sample template you can use
try-import .bazelrc.user
