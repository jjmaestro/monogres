"""
Unit tests for monoext/private/base/versions.bzl render helpers.

Covers the per-PG-version BUILD file writers:
- `_version_root_build(version, default_option_set)`
- `_option_set_build(build_repo, target, source_repo, version, option_set)`
- `_src_build(source_repo, version)`
- `_deps_kind_build(**aliases)`: variable-arity alias block
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//monoext/private/base:schema.bzl", _BaseSchema = "schema")

# buildifier: disable=bzl-visibility
load("//monoext/private/base:versions.bzl", _BaseVersions = "testing")

# buildifier: disable=bzl-visibility
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load("//tests:suite.bzl", _test_suite = "test_suite")

# --- version_root_build ----------------------------------------------------

def _version_root_build_test_impl(ctx):
    """{version}/BUILD.bazel aliases version: full, dir/files→src, toolchain, logs."""
    env = unittest.begin(ctx)

    out = _BaseVersions._version_root_build("18.1", "full")

    asserts.true(env, "Generated by monoext/private/base. DO NOT EDIT." in out)

    # version alias → //18.1/full:full
    asserts.true(env, 'name = "18.1"' in out)
    asserts.true(env, 'actual = "//18.1/full:full"' in out)

    # SDK alias → //18.1/full:tar.dev
    asserts.true(env, 'name = "tar.dev"' in out)
    asserts.true(env, 'actual = "//18.1/full:tar.dev"' in out)

    # source aliases
    asserts.true(env, 'name = "dir"' in out)
    asserts.true(env, 'actual = "//18.1/src:dir"' in out)
    asserts.true(env, 'name = "files"' in out)
    asserts.true(env, 'actual = "//18.1/src:files"' in out)

    # toolchain & logs aliases
    asserts.true(env, 'name = "toolchain"' in out)
    asserts.true(env, 'actual = "//18.1/full:toolchain"' in out)
    asserts.true(env, 'name = "logs"' in out)
    asserts.true(env, 'actual = "//18.1/full:logs"' in out)

    return unittest.end(env)

version_root_build_test = unittest.make(_version_root_build_test_impl)

# --- option_set_build ------------------------------------------------------

def _option_set_build_test_impl(ctx):
    """{version}/{option_set}/BUILD.bazel: :tar.dev build + runtime :tar carve."""
    env = unittest.begin(ctx)

    bt = _PkgsSchema.DepsInfo.new(
        packages = ["libssl-dev"],
        pkgs_labels = ["@pg_pkgs//deb/libssl-dev:libssl-dev"],
        sysroot_labels_by_arch = {
            "amd64": "@pgbuildtime-bt//debian/12/amd64:sysroot",
            "arm64": "@pgbuildtime-bt//debian/12/arm64:sysroot",
        },
        sysroot_tar_labels_by_arch = {
            "amd64": "@pgbuildtime-bt//debian/12/amd64:sysroot.tar",
            "arm64": "@pgbuildtime-bt//debian/12/arm64:sysroot.tar",
        },
    )
    vd = _PkgsSchema.VersionDeps.new(buildtime = bt)
    target = _BaseSchema.BaseTarget.new(
        hub_name = "pg",
        version = "18.1",
        option_set = "full",
        auto_features = "enabled",
        build_options = {"libdir": "lib", "rpath": "false"},
        version_deps = vd,
    )
    out = _BaseVersions._option_set_build(
        build_repo = "monogres",
        target = target,
        source_repo = "pg_src",
        version = "18.1",
        option_set = "full",
    )

    # loads: pg_build + pg_install_tree
    asserts.true(
        env,
        '"@monogres//monoext/private/base:pg_build.bzl"' in out,
    )
    asserts.true(env, '"pg_build"' in out)
    asserts.true(
        env,
        '"@monogres//monoext/private/base:install_tree.bzl"' in out,
    )
    asserts.true(env, '"pg_install_tree"' in out)

    # the full meson install is the SDK tree :tar.dev
    asserts.true(env, "pg_build(" in out)
    asserts.true(env, 'name = "tar.dev"' in out)
    asserts.true(env, 'pg_src = "@pg_src//18.1"' in out)
    asserts.true(env, 'auto_features = "enabled"' in out)
    asserts.true(
        env,
        'sysroot_tar = "@pg//18.1/deps/buildtime:sysroot_tar"' in out,
    )

    # the runtime :tar carves the dev-only paths out of :tar.dev's gen_dir
    asserts.true(env, 'output_group = "gen_dir"' in out)
    asserts.true(env, "pg_install_tree(" in out)
    asserts.true(env, 'name = "tar"' in out)
    asserts.true(env, 'base = ":tar.dev.gen_dir"' in out)
    asserts.true(env, '"lib/pgxs"' in out)

    # alias: :full → :tar
    asserts.true(env, 'name = "full"' in out)
    asserts.true(env, 'actual = ":tar"' in out)

    # no overlay → no flag-switched test-lane selector
    asserts.false(env, "tar.test.lane" in out)

    return unittest.end(env)

option_set_build_test = unittest.make(_option_set_build_test_impl)

# --- option_set_build (cc overlay) -----------------------------------------

def _option_set_build_cc_overlay_test_impl(ctx):
    """A scoped (v, opt) emits the :tar.test.lane flag selector."""
    env = unittest.begin(ctx)

    bt = _PkgsSchema.DepsInfo.new(
        packages = ["libssl-dev"],
        pkgs_labels = ["@pg_pkgs//deb/libssl-dev:libssl-dev"],
        sysroot_labels_by_arch = {"amd64": "@pgbuildtime-bt//debian/12/amd64:sysroot"},
        sysroot_tar_labels_by_arch = {"amd64": "@pgbuildtime-bt//debian/12/amd64:sysroot.tar"},
    )
    vd = _PkgsSchema.VersionDeps.new(buildtime = bt)
    target = _BaseSchema.BaseTarget.new(
        hub_name = "pg",
        version = "16.0",
        option_set = "full",
        auto_features = "enabled",
        build_options = {"libdir": "lib", "rpath": "false"},
        version_deps = vd,
    )
    out = _BaseVersions._option_set_build(
        build_repo = "monogres",
        target = target,
        source_repo = "pg_src",
        version = "16.0",
        option_set = "full",
        cc_overlay = True,
    )

    # the single flag-switched test-lane selector
    asserts.true(env, 'name = "tar.test.lane"' in out)

    # it select()s on the tree flag, defaulting to the overlay's :tar.test
    asserts.true(env, "select(" in out)
    asserts.true(env, '"@monogres//monoext/private/test:tree_meson"' in out)
    asserts.true(env, '"//conditions:default"' in out)
    asserts.true(env, '"//16.0/full/cc:tar.test"' in out)

    return unittest.end(env)

option_set_build_cc_overlay_test = unittest.make(
    _option_set_build_cc_overlay_test_impl,
)

# --- src_build -------------------------------------------------------------

def _src_build_test_impl(ctx):
    """{version}/src/BUILD.bazel: dir/files aliases to the external source repo."""
    env = unittest.begin(ctx)

    out = _BaseVersions._src_build("pg_src", "18.1")

    asserts.true(env, 'name = "dir"' in out)
    asserts.true(env, 'actual = "@pg_src//18.1:dir"' in out)
    asserts.true(env, 'name = "files"' in out)
    asserts.true(env, 'actual = "@pg_src//18.1:files"' in out)

    return unittest.end(env)

src_build_test = unittest.make(_src_build_test_impl)

# --- deps_kind_build -------------------------------------------------------

def _deps_kind_build_single_alias_test_impl(ctx):
    """A single sysroot alias renders cleanly."""
    env = unittest.begin(ctx)

    out = _BaseVersions._deps_kind_build(
        {"sysroot": "@pg_pkgs//deb/sysroots:sysroot-abc"},
    )

    asserts.true(env, 'name = "sysroot"' in out)
    asserts.true(
        env,
        'actual = "@pg_pkgs//deb/sysroots:sysroot-abc"' in out,
    )

    return unittest.end(env)

deps_kind_build_single_alias_test = unittest.make(
    _deps_kind_build_single_alias_test_impl,
)

def _deps_kind_build_multiple_aliases_test_impl(ctx):
    """A per-package alias block renders each pkg→label pair."""
    env = unittest.begin(ctx)

    out = _BaseVersions._deps_kind_build({
        "libc6-dev": "@pg_pkgs//deb/libc6-dev:libc6-dev",
        "libssl-dev": "@pg_pkgs//deb/libssl-dev:libssl-dev",
    })

    asserts.true(env, 'name = "libssl-dev"' in out)
    asserts.true(
        env,
        'actual = "@pg_pkgs//deb/libssl-dev:libssl-dev"' in out,
    )
    asserts.true(env, 'name = "libc6-dev"' in out)
    asserts.true(
        env,
        'actual = "@pg_pkgs//deb/libc6-dev:libc6-dev"' in out,
    )

    return unittest.end(env)

deps_kind_build_multiple_aliases_test = unittest.make(
    _deps_kind_build_multiple_aliases_test_impl,
)

def _arch_build_test_impl(ctx):
    """{version}/{option_set}/{arch}/BUILD.bazel: platform_build transition wrapper."""
    env = unittest.begin(ctx)

    out = _BaseVersions._arch_build(
        build_repo = "monogres",
        actual = "//18.1/full:tar",
        platform = "@monogres//platforms:linux_amd64",
    )

    asserts.true(env, '"@monogres//platforms:platform_build.bzl"' in out)
    asserts.true(env, '"platform_build"' in out)
    asserts.true(env, "platform_build(" in out)
    asserts.true(env, 'name = "tar"' in out)
    asserts.true(env, 'actual = "//18.1/full:tar"' in out)
    asserts.true(env, 'platform = "@monogres//platforms:linux_amd64"' in out)

    return unittest.end(env)

arch_build_test = unittest.make(_arch_build_test_impl)

TEST_SUITE_NAME = "versions"

TEST_SUITE_TESTS = dict(
    arch_build = arch_build_test,
    deps_kind_build_multiple_aliases = deps_kind_build_multiple_aliases_test,
    deps_kind_build_single_alias = deps_kind_build_single_alias_test,
    option_set_build = option_set_build_test,
    option_set_build_cc_overlay = option_set_build_cc_overlay_test,
    src_build = src_build_test,
    version_root_build = version_root_build_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
