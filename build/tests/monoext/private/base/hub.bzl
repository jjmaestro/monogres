"""
Unit tests for monoext/private/base/hub.bzl render helpers.

Covers the two pure helpers:
- `_root_build()`: top-level BUILD.bazel
- `_root_all_bzl(entries, option_sets, default_version)`: the baked-in
  `CFG` struct (with `sources` + `default_source`), `VERSIONS`, `OPTION_SETS`,
  `DEFAULT_VERSION` assignments
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//monoext/private/base:hub.bzl", _BaseHub = "testing")

# buildifier: disable=bzl-visibility
load("//monoext/private/base:schema.bzl", _BaseSchema = "schema")

# buildifier: disable=bzl-visibility
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load("//platforms:targets.bzl", "ARCHS")
load("//tests:suite.bzl", _test_suite = "test_suite")

def _di(packages):
    return _PkgsSchema.DepsInfo.new(
        packages = packages,
        pkgs_labels = [
            "@pg_pkgs//deb/%s:%s" % (p, p)
            for p in packages
        ],
        sysroot_labels_by_arch = {
            "amd64": "@pgbuildtime-abc//debian/12/amd64:sysroot",
            "arm64": "@pgbuildtime-abc//debian/12/arm64:sysroot",
        },
    )

def _vd_full():
    return _PkgsSchema.VersionDeps.new(
        buildtime = _di(["libssl-dev", "libzstd-dev"]),
        runtime = _di(["libssl3", "libzstd1"]),
    )

def _target(version, option_set, versions_deps = None, hub_name = "pg"):
    return _BaseSchema.BaseTarget.new(
        hub_name = hub_name,
        version = version,
        option_set = option_set,
        auto_features = "disabled",
        build_options = {"libdir": "lib"},
        version_deps = versions_deps,
    )

def _entry(version, option_sets, versions_deps = None, hub_name = "pg"):
    vd = versions_deps or _PkgsSchema.VersionDeps.new()
    return _BaseSchema.BaseEntry.new(
        hub_name = hub_name,
        version = version,
        source_repo = "pg_src",
        targets = [_target(version, os, vd, hub_name) for os in option_sets],
        versions_deps = vd,
    )

# --- root_build ------------------------------------------------------------

def _root_build_test_impl(ctx):
    """Root BUILD exposes all.bzl + introspect.bzl with public visibility."""
    env = unittest.begin(ctx)

    out = _BaseHub._root_build()

    asserts.true(env, "Generated by monoext/private/base. DO NOT EDIT." in out)
    asserts.true(env, '"//visibility:public"' in out)
    asserts.true(env, '"all.bzl"' in out)
    asserts.true(env, '"introspect.bzl"' in out)

    return unittest.end(env)

root_build_test = unittest.make(_root_build_test_impl)

# --- root_all_bzl ----------------------------------------------------------

_OPTION_SETS = ["barebones", "minimal", "regular", "full"]

def _root_all_bzl_top_level_assignments_test_impl(ctx):
    """`all.bzl` contains DEFAULT_VERSION, OPTION_SETS, VERSIONS, _SOURCES, _TARGETS, CFG."""
    env = unittest.begin(ctx)

    entries = {"18.1": _entry("18.1", _OPTION_SETS)}
    out = _BaseHub._root_all_bzl(entries, _OPTION_SETS, "18.1", ARCHS)

    asserts.true(env, "DEFAULT_VERSION = " in out)
    asserts.true(env, 'KINDS = ["buildtime", "runtime"]' in out)
    asserts.true(env, "OPTION_SETS = " in out)
    asserts.true(env, "VERSIONS = " in out)
    asserts.true(env, "_SOURCES = " in out)
    asserts.true(env, "_TARGETS = " in out)
    asserts.true(env, "CFG = " in out)

    # baked values
    asserts.true(env, '"18.1"' in out)
    asserts.true(env, '"barebones"' in out and '"full"' in out)

    # CFG refs _TARGETS and _SOURCES
    asserts.true(env, "_TARGETS[" in out)
    asserts.true(env, "_SOURCES[" in out)
    asserts.true(env, 'name = "postgres"' in out)

    # per-target artifact + introspect + source baked
    asserts.true(env, '"@pg//18.1/full:tar"' in out)
    asserts.true(env, '"@pg//18.1/full:introspect"' in out)
    asserts.true(env, '"@pg//18.1:dir"' in out)
    asserts.true(env, '"@pg//18.1:files"' in out)

    return unittest.end(env)

root_all_bzl_top_level_assignments_test = unittest.make(
    _root_all_bzl_top_level_assignments_test_impl,
)

def _root_all_bzl_default_index_is_last_option_set_test_impl(ctx):
    """CFG.default = _TARGETS[N] where N is the default_version × last-option-set target.

    CFG.default_source = _SOURCES[M] where M is the default_version's source
    index.
    """
    env = unittest.begin(ctx)

    entries = {
        "17.0": _entry("17.0", _OPTION_SETS),  # 4 targets (indices 0..3)
        "18.1": _entry("18.1", _OPTION_SETS),  # 4 targets (indices 4..7)
    }
    out = _BaseHub._root_all_bzl(entries, _OPTION_SETS, "18.1", ARCHS)

    # default_version=18.1 × last option_set=full → target index 7
    asserts.true(env, "_TARGETS[7]" in out)

    # default source for 18.1 → _SOURCES[1] (sources are sorted: 17.0, 18.1)
    asserts.true(env, "_SOURCES[1]" in out)

    return unittest.end(env)

root_all_bzl_default_index_is_last_option_set_test = unittest.make(
    _root_all_bzl_default_index_is_last_option_set_test_impl,
)

def _root_all_bzl_sorted_versions_test_impl(ctx):
    """VERSIONS list is sorted ascending."""
    env = unittest.begin(ctx)

    entries = {
        "16.5": _entry("16.5", _OPTION_SETS),
        "17.0": _entry("17.0", _OPTION_SETS),
        "18.1": _entry("18.1", _OPTION_SETS),
    }
    out = _BaseHub._root_all_bzl(entries, _OPTION_SETS, "18.1", ARCHS)

    asserts.true(
        env,
        'VERSIONS = ["16.5", "17.0", "18.1"]' in out,
    )

    return unittest.end(env)

root_all_bzl_sorted_versions_test = unittest.make(
    _root_all_bzl_sorted_versions_test_impl,
)

def _root_all_bzl_deps_struct_populated_test_impl(ctx):
    """Targets with deps emit `deps = struct(buildtime, runtime)` with qualified labels."""
    env = unittest.begin(ctx)

    entries = {"18.1": _entry("18.1", _OPTION_SETS, versions_deps = _vd_full())}
    out = _BaseHub._root_all_bzl(entries, _OPTION_SETS, "18.1", ARCHS)

    # buildtime kind
    asserts.true(env, '"@pg//18.1/deps/buildtime:sysroot"' in out)
    asserts.true(
        env,
        '"@pg//18.1/deps/buildtime/pkgs:libssl-dev"' in out,
    )
    asserts.true(
        env,
        '"@pg//18.1/deps/buildtime/pkgs:libzstd-dev"' in out,
    )

    # runtime kind
    asserts.true(env, '"@pg//18.1/deps/runtime:sysroot"' in out)
    asserts.true(env, '"@pg//18.1/deps/runtime/pkgs:libssl3"' in out)
    asserts.true(env, '"@pg//18.1/deps/runtime/pkgs:libzstd1"' in out)

    return unittest.end(env)

root_all_bzl_deps_struct_populated_test = unittest.make(
    _root_all_bzl_deps_struct_populated_test_impl,
)

def _root_all_bzl_deps_struct_empty_test_impl(ctx):
    """Target with no VersionDeps renders `sysroot = None` and `packages = []`."""
    env = unittest.begin(ctx)

    entries = {"18.1": _entry("18.1", _OPTION_SETS)}
    out = _BaseHub._root_all_bzl(entries, _OPTION_SETS, "18.1", ARCHS)

    asserts.true(env, "sysroot = None" in out)
    asserts.true(env, "packages = []" in out)

    # No qualified deps labels should appear.
    asserts.false(env, "@pg//18.1/deps/" in out)

    return unittest.end(env)

root_all_bzl_deps_struct_empty_test = unittest.make(
    _root_all_bzl_deps_struct_empty_test_impl,
)

def _root_all_bzl_hub_name_is_baked_test_impl(ctx):
    """The hub_name baked on labels (deps, artifact, source) flows through unchanged."""
    env = unittest.begin(ctx)

    entries = {
        "18.1": _entry(
            "18.1",
            _OPTION_SETS,
            versions_deps = _vd_full(),
            hub_name = "mypg",
        ),
    }
    out = _BaseHub._root_all_bzl(entries, _OPTION_SETS, "18.1", ARCHS)

    asserts.true(env, '"@mypg//18.1/deps/buildtime:sysroot"' in out)
    asserts.true(env, '"@mypg//18.1/full:tar"' in out)
    asserts.true(env, '"@mypg//18.1/full:introspect"' in out)
    asserts.true(env, '"@mypg//18.1:dir"' in out)
    asserts.false(env, '"@pg//18.1/deps/buildtime:sysroot"' in out)
    asserts.false(env, '"@pg//18.1/full:tar"' in out)
    asserts.false(env, '"@pg//18.1/full:introspect"' in out)

    return unittest.end(env)

root_all_bzl_hub_name_is_baked_test = unittest.make(
    _root_all_bzl_hub_name_is_baked_test_impl,
)

TEST_SUITE_NAME = "hub"

TEST_SUITE_TESTS = dict(
    root_all_bzl_default_index_is_last_option_set = root_all_bzl_default_index_is_last_option_set_test,
    root_all_bzl_deps_struct_empty = root_all_bzl_deps_struct_empty_test,
    root_all_bzl_deps_struct_populated = root_all_bzl_deps_struct_populated_test,
    root_all_bzl_hub_name_is_baked = root_all_bzl_hub_name_is_baked_test,
    root_all_bzl_sorted_versions = root_all_bzl_sorted_versions_test,
    root_all_bzl_top_level_assignments = root_all_bzl_top_level_assignments_test,
    root_build = root_build_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
