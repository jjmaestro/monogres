"""
Unit tests for monoext/private/base/introspect.bzl render helpers.

Covers the pure helpers used by both Layer 1 (JSON-only hub generation) and
Layer 2 (per-version lazy repos):
- `_defs_bzl(loads, **assignments)`: defs.bzl aggregator
- `_stub_bzl(introspect_repo, option_set)`: load-forwarding stub
- `_option_set_build(option_set, deps)`: per-option-set BUILD.bazel
- `_meson_options_build(option_set)`: private/BUILD.bazel
- `_root_build()`: root BUILD.bazel
- `_installed_paths(introspect_json, version, arch)`: meson introspection
  composition
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//monoext/private/base:introspect.bzl", _Introspect = "testing")
load("//tests:suite.bzl", _test_suite = "test_suite")

# --- defs_bzl --------------------------------------------------------------

def _defs_bzl_with_loads_and_assignments_test_impl(ctx):
    """defs.bzl renders loads then an assignments block."""
    env = unittest.begin(ctx)

    out = _Introspect._defs_bzl(
        loads = [],
        INTROSPECTION = '{"postgres": {"paths": ["bin/postgres"]}}',
    )

    asserts.true(env, "Generated by monoext/private/base/introspect" in out)
    asserts.true(env, "INTROSPECTION = " in out)
    asserts.true(env, '"bin/postgres"' in out)

    return unittest.end(env)

defs_bzl_with_loads_and_assignments_test = unittest.make(
    _defs_bzl_with_loads_and_assignments_test_impl,
)

def _defs_bzl_empty_assignments_test_impl(ctx):
    """defs.bzl with no assignments and no loads is still a valid header-only file."""
    env = unittest.begin(ctx)

    out = _Introspect._defs_bzl(loads = [])

    asserts.true(env, "Generated by monoext/private/base/introspect" in out)

    return unittest.end(env)

defs_bzl_empty_assignments_test = unittest.make(
    _defs_bzl_empty_assignments_test_impl,
)

# --- stub_bzl --------------------------------------------------------------

def _stub_bzl_load_forwards_test_impl(ctx):
    """Stub emits a load re-exporting the three Layer-2 symbols."""
    env = unittest.begin(ctx)

    out = _Introspect._stub_bzl(
        introspect_repo = "pg_introspect--18.1",
        option_set = "full",
    )

    asserts.true(env, '"@pg_introspect--18.1//full:defs.bzl"' in out)
    asserts.true(env, '"FEATURES_TO_DEB_PKGS"' in out)
    asserts.true(env, '"INTROSPECTION"' in out)
    asserts.true(env, '"MESON_OPTIONS"' in out)

    return unittest.end(env)

stub_bzl_load_forwards_test = unittest.make(_stub_bzl_load_forwards_test_impl)

# --- paths_stub_bzl --------------------------------------------------------

def _paths_stub_bzl_load_forwards_test_impl(ctx):
    """Paths stub emits a load re-exporting only INTROSPECTION."""
    env = unittest.begin(ctx)

    out = _Introspect._paths_stub_bzl(
        paths_repo = "pg_introspect_paths--18.1",
        option_set = "full",
    )

    asserts.true(env, '"@pg_introspect_paths--18.1//full:defs.bzl"' in out)
    asserts.true(env, '"INTROSPECTION"' in out)
    asserts.false(env, '"FEATURES_TO_DEB_PKGS"' in out)
    asserts.false(env, '"MESON_OPTIONS"' in out)

    return unittest.end(env)

paths_stub_bzl_load_forwards_test = unittest.make(
    _paths_stub_bzl_load_forwards_test_impl,
)

# --- option_set_build ------------------------------------------------------

def _option_set_build_has_bzl_library_and_alias_test_impl(ctx):
    """{option_set}/BUILD.bazel: bzl_library(defs) + alias(:option_set → :defs)."""
    env = unittest.begin(ctx)

    out = _Introspect._option_set_build(
        option_set = "full",
        deps = ["//full/private:meson_options"],
    )

    asserts.true(env, '"@bazel_skylib//:bzl_library.bzl"' in out)
    asserts.true(env, '"bzl_library"' in out)
    asserts.true(env, 'name = "defs"' in out)
    asserts.true(env, '"defs.bzl"' in out)
    asserts.true(env, '"//full/private:meson_options"' in out)

    # alias :full → :defs
    asserts.true(env, 'name = "full"' in out)
    asserts.true(env, 'actual = ":defs"' in out)

    return unittest.end(env)

option_set_build_has_bzl_library_and_alias_test = unittest.make(
    _option_set_build_has_bzl_library_and_alias_test_impl,
)

# --- meson_options_build ---------------------------------------------------

def _meson_options_build_test_impl(ctx):
    """private/BUILD.bazel exposes meson_options.bzl as a bzl_library."""
    env = unittest.begin(ctx)

    out = _Introspect._meson_options_build("full")

    asserts.true(env, '"@bazel_skylib//:bzl_library.bzl"' in out)
    asserts.true(env, 'name = "meson_options"' in out)
    asserts.true(env, '"meson_options.bzl"' in out)
    asserts.true(env, '"//full:__pkg__"' in out)

    return unittest.end(env)

meson_options_build_test = unittest.make(_meson_options_build_test_impl)

# --- root_build ------------------------------------------------------------

def _root_build_test_impl(ctx):
    """Per-version repo root BUILD has only public visibility + header."""
    env = unittest.begin(ctx)

    out = _Introspect._root_build()

    asserts.true(env, "Generated by monoext/private/base/introspect" in out)
    asserts.true(env, '"//visibility:public"' in out)

    return unittest.end(env)

root_build_test = unittest.make(_root_build_test_impl)

# --- installed_paths -------------------------------------------------------

def _installed_paths_composes_helpers_test_impl(ctx):
    """`_installed_paths` composes meson helpers into (contrib_names, contrib_paths, postgres_paths)."""
    env = unittest.begin(ctx)

    introspect_json = {
        "buildoptions": [
            {
                "description": "Installation prefix",
                "machine": "host",
                "name": "prefix",
                "section": "core",
                "type": "string",
                "value": "/usr/local/pgsql",
            },
        ],
        "buildsystem_files": [
            "/src/contrib/pgcrypto/meson.build",
            "/src/contrib/hstore/meson.build",
        ],
        "installed": {
            "/build/contrib/hstore/hstore.so": "/usr/local/pgsql/lib/hstore.so",
            "/build/contrib/pgcrypto/pgcrypto.so": "/usr/local/pgsql/lib/pgcrypto.so",
            "/build/src/backend/postgres": "/usr/local/pgsql/bin/postgres",
        },
        "targets": [
            {
                "defined_in": "/src/meson.build",
                "filename": ["/build/postgres"],
                "id": "bin@run",
                "name": "postgres",
                "type": "executable",
            },
        ],
    }

    result = _Introspect._installed_paths(introspect_json, "18.1")

    asserts.equals(env, ["hstore", "pgcrypto"], result.contrib_names)
    asserts.equals(env, ["lib/pgcrypto.so"], result.contrib_paths["pgcrypto"])
    asserts.equals(env, ["lib/hstore.so"], result.contrib_paths["hstore"])
    asserts.equals(env, ["bin/postgres"], result.postgres_paths)

    return unittest.end(env)

installed_paths_composes_helpers_test = unittest.make(
    _installed_paths_composes_helpers_test_impl,
)

TEST_SUITE_NAME = "introspect_top"

TEST_SUITE_TESTS = dict(
    defs_bzl_empty_assignments = defs_bzl_empty_assignments_test,
    defs_bzl_with_loads_and_assignments = defs_bzl_with_loads_and_assignments_test,
    installed_paths_composes_helpers = installed_paths_composes_helpers_test,
    meson_options_build = meson_options_build_test,
    option_set_build_has_bzl_library_and_alias = option_set_build_has_bzl_library_and_alias_test,
    paths_stub_bzl_load_forwards = paths_stub_bzl_load_forwards_test,
    root_build = root_build_test,
    stub_bzl_load_forwards = stub_bzl_load_forwards_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
