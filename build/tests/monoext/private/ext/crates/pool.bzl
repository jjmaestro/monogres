)

def _parse_lock__missing_checksum_fails_test_impl(ctx):
    """A crates.io package without a checksum is an unpinnable lock."""
    env = unittest.begin(ctx)

    lock = """\
[[package]]
name = "ahash"
version = "0.8.12"
source = "registry+https://github.com/rust-lang/crates.io-index"
"""

    res = pool.parse_lock(lock, lock_label = "l.lock", _fail = Mock.fail)
    asserts.true(env, "no checksum in the lock" in res, res)

    return unittest.end(env)

parse_lock__missing_checksum_fails_test = unittest.make(
    _parse_lock__missing_checksum_fails_test_impl,
)

def _mock_crate_repo(created):
    return lambda **kwargs: created.append(kwargs)

def _declare__creates_one_repo_per_crate_test_impl(ctx):
    """Each (crate, version) becomes one repo, named after that release."""
    env = unittest.begin(ctx)

    created, declared = [], {}

    names = pool.declare(
        pool.parse_lock(_LOCK),
        declared,
        _crate_repo = _mock_crate_repo(created),
    )

    asserts.equals(env, {
        "@crate--ahash-0.8.12//": "ahash-0.8.12",
        "@crate--aho-corasick-1.1.4//": "aho-corasick-1.1.4",
    }, names)

    asserts.equals(env, 2, len(created))
    asserts.equals(env, "ahash", created[0]["crate"])
    asserts.equals(env, "0.8.12", created[0]["version"])
    asserts.equals(env, _SHA_A, created[0]["sha256"])

    return unittest.end(env)

declare__creates_one_repo_per_crate_test = unittest.make(
    _declare__creates_one_repo_per_crate_test_impl,
)

def _declare__shared_across_locks_test_impl(ctx):
    """A crate pinned by two extensions is fetched once, and named once."""
    env = unittest.begin(ctx)

    created, declared = [], {}

    kwargs = dict(_crate_repo = _mock_crate_repo(created))
    crates = pool.parse_lock(_LOCK)

    first = pool.declare(crates, declared, **kwargs)
    second = pool.declare(crates[:1], declared, **kwargs)

    # the second lock creates nothing new ...
    asserts.equals(env, 2, len(created))

    # ... and still resolves to the same packages
    asserts.equals(
        env,
        {"@crate--ahash-0.8.12//": first["@crate--ahash-0.8.12//"]},
        second,
    )

    return unittest.end(env)

declare__shared_across_locks_test = unittest.make(
    _declare__shared_across_locks_test_impl,
)

def _declare__build_metadata_version_test_impl(ctx):
    """A `+` in the version is illegal in a repo name but real in the tree."""
    env = unittest.begin(ctx)

    lock = """\
[[package]]
name = "toml"
version = "0.9.12+spec-1.1.0"
source = "{registry}"
checksum = "{sha}"
""".format(registry = pool.__test__._REGISTRY, sha = _SHA_A)

    created = []
    names = pool.declare(
        pool.parse_lock(lock),
        {},
        _crate_repo = _mock_crate_repo(created),
    )

    # The repo name spells `+` as `_`; the vendor directory, which is what cargo
    # resolves the crate by, keeps the version verbatim.
    asserts.equals(
        env,
        {"@crate--toml-0.9.12_spec-1.1.0//": "toml-0.9.12+spec-1.1.0"},
        names,
    )
    asserts.equals(env, "0.9.12+spec-1.1.0", created[0]["version"])

    return unittest.end(env)

declare__build_metadata_version_test = unittest.make(
    _declare__build_metadata_version_test_impl,
)

def _declare__git_revision_test_impl(ctx):
    """One repo per revision, and one Bazel package per crate inside it."""
    env = unittest.begin(ctx)

    created, git_created = [], []

    names = pool.declare(
        pool.parse_lock(_LOCK_GIT, git = _GIT),
        {},
        _crate_repo = _mock_crate_repo(created),
        _git_crates_repo = _mock_crate_repo(git_created),
    )

    # The root crate is the repo's own package; a member is a subpackage. Both
    # keep the `<crate>-<version>` vendor directory a registry crate gets, since
    # that is what cargo resolves the crate by.
    asserts.equals(env, {
        "@crate_git--tantivy-2c73e8ca//": "tantivy-0.26.0",
        "@crate_git--tantivy-2c73e8ca//bitpacker": "tantivy-bitpacker-0.9.0",
    }, names)

    # Two crates, ONE fetch: a revision is a whole checkout, and the crates in
    # it are the subdirectories it hands to the vendor tree.
    asserts.equals(env, [], created)
    asserts.equals(env, 1, len(git_created))
    asserts.equals(env, "crate_git--tantivy-2c73e8ca", git_created[0]["name"])
    asserts.equals(env, _SHA_A, git_created[0]["sha256"])
    asserts.equals(env, "tantivy-2c73e8ca", git_created[0]["strip_prefix"])
    asserts.equals(env, {
        "tantivy": ".",
        "tantivy-bitpacker": "bitpacker",
    }, git_created[0]["crates"])

    return unittest.end(env)

declare__git_revision_test = unittest.make(_declare__git_revision_test_impl)

def _declare__git_revision_shared_test_impl(ctx):
    """A revision two extensions pin is fetched once, as a crate release is."""
    env = unittest.begin(ctx)

    git_created, declared = [], {}

    kwargs = dict(_git_crates_repo = _mock_crate_repo(git_created))
    crates = pool.parse_lock(_LOCK_GIT, git = _GIT)

    first = pool.declare(crates, declared, **kwargs)
    second = pool.declare(crates, declared, **kwargs)

    asserts.equals(env, 1, len(git_created))
    asserts.equals(env, first, second)

    return unittest.end(env)

declare__git_revision_shared_test = unittest.make(
    _declare__git_revision_shared_test_impl,
)

def _pinned_version__found_test_impl(ctx):
    """The version a lock pins for one crate, which selects the SQL generator."""
    env = unittest.begin(ctx)

    crates = pool.parse_lock(_LOCK_PGRX)

    asserts.equals(env, "0.19.1", pool.pinned_version(crates, "pgrx"))

    return unittest.end(env)

pinned_version__found_test = unittest.make(_pinned_version__found_test_impl)

def _pinned_version__missing_fails_test_impl(ctx):
    """A pgrx extension whose lock pins no pgrx cannot have its SQL emitted."""
    env = unittest.begin(ctx)

    crates = pool.parse_lock(_LOCK)

    res = pool.pinned_version(
        crates,
        "pgrx",
        lock_label = "l.lock",
        _fail = Mock.fail,
    )
    asserts.true(env, "no `pgrx` in the lock" in res, res)

    return unittest.end(env)

pinned_version__missing_fails_test = unittest.make(
    _pinned_version__missing_fails_test_impl,
)

