"""
Unit tests for monoext/private/ext/crates/pool.bzl.

Tests `parse_lock` (the `Cargo.lock` reader) and `declare` (the dedup that makes
the pool shared instead of per-extension).
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//monoext/private/ext/crates:pool.bzl", "pool")
load("//tests:mock.bzl", Mock = "mock")
load("//tests:suite.bzl", _test_suite = "test_suite")

_SHA_A = "5a15f179cd60c4584b8a8c596927aadc462e27f2ca70c04e0071964a73ba7a75"
_SHA_B = "ddd31a130427c27518df266943a5308ed92d4b226cc639f5a8f1002816174301"

_LOCK = """\
# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 4

[[package]]
name = "ahash"
version = "0.8.12"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "{sha_a}"
dependencies = [
 "cfg-if",
 "once_cell",
]

[[package]]
name = "aho-corasick"
version = "1.1.4"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "{sha_b}"

[[package]]
name = "pg_jsonschema"
version = "0.3.4"
dependencies = [
 "pgrx",
]
""".format(sha_a = _SHA_A, sha_b = _SHA_B)

def _parse_lock__registry_packages_test_impl(ctx):
    """Every crates.io package, in lock order, with its pinned checksum."""
    env = unittest.begin(ctx)

    crates = pool.parse_lock(_LOCK)

    asserts.equals(env, 2, len(crates))

    asserts.equals(env, "ahash", crates[0].crate)
    asserts.equals(env, "0.8.12", crates[0].version)
    asserts.equals(env, _SHA_A, crates[0].sha256)

    asserts.equals(env, "aho-corasick", crates[1].crate)
    asserts.equals(env, "1.1.4", crates[1].version)
    asserts.equals(env, _SHA_B, crates[1].sha256)

    return unittest.end(env)

parse_lock__registry_packages_test = unittest.make(
    _parse_lock__registry_packages_test_impl,
)

def _parse_lock__skips_workspace_members_test_impl(ctx):
    """A package with no `source` is the extension's own crate, not a dep."""
    env = unittest.begin(ctx)

    crates = pool.parse_lock(_LOCK)

    asserts.false(env, "pg_jsonschema" in [crate.crate for crate in crates])

    return unittest.end(env)

parse_lock__skips_workspace_members_test = unittest.make(
    _parse_lock__skips_workspace_members_test_impl,
)

def _parse_lock__ignores_dependency_lists_test_impl(ctx):
    """`dependencies` entries look like values but are not package keys."""
    env = unittest.begin(ctx)

    crates = pool.parse_lock(_LOCK)

    # "cfg-if" and "once_cell" are ahash's dependency list, and they have no
    # [[package]] table of their own in this lock
    asserts.equals(env, ["ahash", "aho-corasick"], [c.crate for c in crates])

    return unittest.end(env)

parse_lock__ignores_dependency_lists_test = unittest.make(
    _parse_lock__ignores_dependency_lists_test_impl,
)

def _parse_lock__empty_test_impl(ctx):
    """A lock with no packages yields no crates, rather than failing."""
    env = unittest.begin(ctx)

    asserts.equals(env, [], pool.parse_lock("version = 4\n"))

    return unittest.end(env)

parse_lock__empty_test = unittest.make(_parse_lock__empty_test_impl)

def _parse_lock__git_dependency_fails_test_impl(ctx):
    """A git dep has no checksum in the lock, so it cannot be pinned here."""
    env = unittest.begin(ctx)

    lock = """\
[[package]]
name = "tantivy"
version = "0.24.2"
source = "git+https://github.com/paradedb/tantivy?rev=41d1a5c#41d1a5c"
"""

    res = pool.parse_lock(lock, lock_label = "l.lock", _fail = Mock.fail)
    asserts.true(env, "unsupported source" in res, res)
    asserts.true(env, "tantivy 0.24.2" in res, res)

    return unittest.end(env)

parse_lock__git_dependency_fails_test = unittest.make(
    _parse_lock__git_dependency_fails_test_impl,
)

def _parse_lock__missing_checksum_fails_test_impl(ctx):
    """A crates.io package without a checksum is an unpinnable lock."""
    env = unittest.begin(ctx)

    lock = """\
[[package]]
name = "ahash"
version = "0.8.12"
source = "registry+https://github.com/rust-lang/crates.io-index"
"""

    res = pool.parse_lock(lock, lock_label = "l.lock", _fail = Mock.fail)
    asserts.true(env, "no checksum in the lock" in res, res)

    return unittest.end(env)

parse_lock__missing_checksum_fails_test = unittest.make(
    _parse_lock__missing_checksum_fails_test_impl,
)

def _mock_crate_repo(created):
    return lambda **kwargs: created.append(kwargs)

def _declare__creates_one_repo_per_crate_test_impl(ctx):
    """Each (crate, version) becomes one repo, named after that release."""
    env = unittest.begin(ctx)

    created, declared = [], {}

    names = pool.declare(
        pool.parse_lock(_LOCK),
        declared,
        _crate_repo = _mock_crate_repo(created),
    )

    asserts.equals(env, {
        "crate--ahash-0.8.12": "ahash-0.8.12",
        "crate--aho-corasick-1.1.4": "aho-corasick-1.1.4",
    }, names)

    asserts.equals(env, 2, len(created))
    asserts.equals(env, "ahash", created[0]["crate"])
    asserts.equals(env, "0.8.12", created[0]["version"])
    asserts.equals(env, _SHA_A, created[0]["sha256"])

    return unittest.end(env)

declare__creates_one_repo_per_crate_test = unittest.make(
    _declare__creates_one_repo_per_crate_test_impl,
)

def _declare__shared_across_locks_test_impl(ctx):
    """A crate pinned by two extensions is fetched once, and named once."""
    env = unittest.begin(ctx)

    created, declared = [], {}

    kwargs = dict(_crate_repo = _mock_crate_repo(created))
    crates = pool.parse_lock(_LOCK)

    first = pool.declare(crates, declared, **kwargs)
    second = pool.declare(crates[:1], declared, **kwargs)

    # the second lock creates nothing new ...
    asserts.equals(env, 2, len(created))

    # ... and still resolves to the same repos
    asserts.equals(env, {"crate--ahash-0.8.12": first["crate--ahash-0.8.12"]}, second)

    return unittest.end(env)

declare__shared_across_locks_test = unittest.make(
    _declare__shared_across_locks_test_impl,
)

def _declare__build_metadata_version_test_impl(ctx):
    """A `+` in the version is illegal in a repo name but real in the tree."""
    env = unittest.begin(ctx)

    lock = """\
[[package]]
name = "toml"
version = "0.9.12+spec-1.1.0"
source = "{registry}"
checksum = "{sha}"
""".format(registry = pool.__test__._REGISTRY, sha = _SHA_A)

    created = []
    names = pool.declare(
        pool.parse_lock(lock),
        {},
        _crate_repo = _mock_crate_repo(created),
    )

    # The repo name spells `+` as `_`; the vendor directory, which is what cargo
    # resolves the crate by, keeps the version verbatim.
    asserts.equals(
        env,
        {"crate--toml-0.9.12_spec-1.1.0": "toml-0.9.12+spec-1.1.0"},
        names,
    )
    asserts.equals(env, "0.9.12+spec-1.1.0", created[0]["version"])

    return unittest.end(env)

declare__build_metadata_version_test = unittest.make(
    _declare__build_metadata_version_test_impl,
)

TEST_SUITE_NAME = "monoext/private/ext/crates/pool"

TEST_SUITE_TESTS = {
    "declare/build_metadata_version": declare__build_metadata_version_test,
    "declare/creates_one_repo_per_crate": declare__creates_one_repo_per_crate_test,
    "declare/shared_across_locks": declare__shared_across_locks_test,
    "parse_lock/empty": parse_lock__empty_test,
    "parse_lock/git_dependency_fails": parse_lock__git_dependency_fails_test,
    "parse_lock/ignores_dependency_lists": parse_lock__ignores_dependency_lists_test,
    "parse_lock/missing_checksum_fails": parse_lock__missing_checksum_fails_test,
    "parse_lock/registry_packages": parse_lock__registry_packages_test,
    "parse_lock/skips_workspace_members": parse_lock__skips_workspace_members_test,
}

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
