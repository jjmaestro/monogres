"""
Unit tests for monoext/private/ext/hub.bzl render helpers.

Covers:
- `_root_build_bzl()`
- `_root_all_bzl(entries, contrib_entries)`: the most complex renderer:
  loads, CFGS, REPOS, EXTENSIONS (externals), CFGS_CONTRIB, REPOS_CONTRIB,
  CONTRIB_EXTENSIONS. Each entry now carries pre-expanded `targets` + `sources`
  (externals) or `targets` (contribs); this renderer forwards them directly
  rather than synthesizing structs inline.
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//monoext/private/ext:hub.bzl", _ExtHub = "testing")

# buildifier: disable=bzl-visibility
load("//monoext/private/ext:schema.bzl", _ExtSchema = "schema")

# buildifier: disable=bzl-visibility
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load("//platforms:targets.bzl", "ARCHS")
load("//tests:suite.bzl", _test_suite = "test_suite")

def _external_entry(hub_name = "pg_ext"):
    bt = _PkgsSchema.DepsInfo.new(
        packages = ["libssl-dev"],
        pkgs_labels = ["@pg_pkgs//deb/libssl-dev:libssl-dev"],
        sysroot_labels_by_arch = {
            "amd64": "@pgbuildtime-bt//debian/12/amd64:sysroot",
            "arm64": "@pgbuildtime-bt//debian/12/arm64:sysroot",
        },
    )
    rt = _PkgsSchema.DepsInfo.new(
        packages = ["libssl3"],
        pkgs_labels = ["@pg_pkgs//deb/libssl3:libssl3"],
        sysroot_labels_by_arch = {
            "amd64": "@pgbuildtime-rt//debian/12/amd64:sysroot",
            "arm64": "@pgbuildtime-rt//debian/12/arm64:sysroot",
        },
    )
    vd = _PkgsSchema.VersionDeps.new(buildtime = bt, runtime = rt)
    return _ExtSchema.ExtExternalEntry.new(
        ext_hub_name = hub_name,
        ext_name = "citus",
        ext_versions = ["13.2.0"],
        compatible_base_versions = {"13.2.0": ["17.0", "18.1"]},
        source_repo = "pg_ext_src--citus",
        ext_versions_deps = {"13.2.0": vd},
        lock = {"13.2.0": {"source": "gh"}},
    )

def _contrib_entry(hub_name = "pg_ext"):
    return _ExtSchema.ExtContribEntry.new(
        ext_hub_name = hub_name,
        ext_name = "pgcrypto",
        ext_versions = ["17.0", "18.1"],
        metadata = {"files": {"18.1": ["lib/pgcrypto.so"]}},
    )

# --- root_build_bzl --------------------------------------------------------

def _root_build_bzl_test_impl(ctx):
    """Root BUILD exposes all.bzl with public visibility."""
    env = unittest.begin(ctx)

    out = _ExtHub._root_build_bzl()

    asserts.true(env, "Generated by monoext/private/ext. DO NOT EDIT." in out)
    asserts.true(env, '"//visibility:public"' in out)
    asserts.true(env, '"all.bzl"' in out)

    return unittest.end(env)

root_build_bzl_test = unittest.make(_root_build_bzl_test_impl)

# --- root_all_bzl ----------------------------------------------------------

def _root_all_bzl_externals_only_test_impl(ctx):
    """CFGS/REPOS/EXTENSIONS assigned; CFGS_CONTRIB/REPOS_CONTRIB/CONTRIB_EXTENSIONS empty."""
    env = unittest.begin(ctx)

    out = _ExtHub._root_all_bzl(entries = [_external_entry()], archs = ARCHS)

    # header
    asserts.true(env, "Generated by monoext/private/ext. DO NOT EDIT." in out)

    # per-ext repo.bzl load
    asserts.true(env, '"//citus:repo.bzl"' in out)
    asserts.true(env, "DEFAULT_VERSION_E0" in out)
    asserts.true(env, "LOCK_E0" in out)
    asserts.true(env, "METADATA_E0" in out)
    asserts.true(env, "REPO_NAME_E0" in out)
    asserts.true(env, "VERSIONS_E0" in out)

    # top-level assignments
    asserts.true(env, 'KINDS = ["buildtime", "runtime", "test"]' in out)
    asserts.true(env, "CFGS = " in out)
    asserts.true(env, "REPOS = " in out)
    asserts.true(env, "EXTENSIONS = sorted(CFGS.keys())" in out)
    asserts.true(env, "CFGS_CONTRIB = " in out)
    asserts.true(env, "REPOS_CONTRIB = " in out)
    asserts.true(env, "CONTRIB_EXTENSIONS = sorted(CFGS_CONTRIB.keys())" in out)

    # the external's target: one per (ext_v × compatible pg_v), pg_version synth
    asserts.true(env, '"citus"' in out)
    asserts.true(env, '"postgres~17.0"' in out)
    asserts.true(env, '"postgres~18.1"' in out)

    # artifact + source labels baked on targets
    asserts.true(env, '"@pg_ext//citus/13.2.0/17.0:17.0"' in out)
    asserts.true(env, '"@pg_ext//citus/13.2.0/18.1:18.1"' in out)
    asserts.true(env, '"@pg_ext//citus/13.2.0:dir"' in out)
    asserts.true(env, '"@pg_ext//citus/13.2.0:files"' in out)

    # deps struct: qualified buildtime + runtime sysroot + packages aliases
    asserts.true(
        env,
        '"@pg_ext//citus/13.2.0/deps/buildtime:sysroot"' in out,
    )
    asserts.true(
        env,
        '"@pg_ext//citus/13.2.0/deps/buildtime/pkgs:libssl-dev"' in out,
    )
    asserts.true(
        env,
        '"@pg_ext//citus/13.2.0/deps/runtime:sysroot"' in out,
    )
    asserts.true(
        env,
        '"@pg_ext//citus/13.2.0/deps/runtime/pkgs:libssl3"' in out,
    )

    return unittest.end(env)

root_all_bzl_externals_only_test = unittest.make(
    _root_all_bzl_externals_only_test_impl,
)

def _root_all_bzl_contribs_only_test_impl(ctx):
    """With only contrib entries: CFGS empty, CFGS_CONTRIB populated."""
    env = unittest.begin(ctx)

    out = _ExtHub._root_all_bzl(
        entries = [],
        archs = ARCHS,
        contrib_entries = {"pgcrypto": _contrib_entry()},
    )

    # contrib repo.bzl load
    asserts.true(env, '"//contrib/pgcrypto:repo.bzl"' in out)
    asserts.true(env, "METADATA_c0" in out)
    asserts.true(env, "VERSIONS_c0" in out)

    # contrib target per PG version + artifact labels
    asserts.true(env, '"postgres~17.0"' in out)
    asserts.true(env, '"postgres~18.1"' in out)
    asserts.true(env, '"@pg_ext//contrib/pgcrypto/17.0:tar"' in out)
    asserts.true(env, '"@pg_ext//contrib/pgcrypto/18.1:tar"' in out)

    return unittest.end(env)

root_all_bzl_contribs_only_test = unittest.make(
    _root_all_bzl_contribs_only_test_impl,
)

def _root_all_bzl_empty_test_impl(ctx):
    """No entries at all: all top-level assignments still present with empty values."""
    env = unittest.begin(ctx)

    out = _ExtHub._root_all_bzl(
        entries = [],
        archs = ARCHS,
        contrib_entries = None,
    )

    for name in (
        'KINDS = ["buildtime", "runtime", "test"]',
        "CFGS = ",
        "REPOS = ",
        "EXTENSIONS = sorted(CFGS.keys())",
        "CFGS_CONTRIB = ",
        "REPOS_CONTRIB = ",
        "CONTRIB_EXTENSIONS = sorted(CFGS_CONTRIB.keys())",
    ):
        asserts.true(env, name in out, "missing: %s" % name)

    return unittest.end(env)

root_all_bzl_empty_test = unittest.make(_root_all_bzl_empty_test_impl)

def _root_all_bzl_hub_name_is_baked_test_impl(ctx):
    """Hub-qualified labels on targets/sources/deps flow through unchanged."""
    env = unittest.begin(ctx)

    out = _ExtHub._root_all_bzl(
        entries = [_external_entry(hub_name = "myext")],
        archs = ARCHS,
    )

    asserts.true(
        env,
        '"@myext//citus/13.2.0/deps/buildtime:sysroot"' in out,
    )
    asserts.true(env, '"@myext//citus/13.2.0/18.1:18.1"' in out)
    asserts.true(env, '"@myext//citus/13.2.0:dir"' in out)
    asserts.false(
        env,
        '"@pg_ext//citus/13.2.0/deps/buildtime:sysroot"' in out,
    )
    asserts.false(env, '"@pg_ext//citus/13.2.0/18.1:18.1"' in out)

    return unittest.end(env)

root_all_bzl_hub_name_is_baked_test = unittest.make(
    _root_all_bzl_hub_name_is_baked_test_impl,
)

TEST_SUITE_NAME = "hub"

TEST_SUITE_TESTS = dict(
    root_all_bzl_contribs_only = root_all_bzl_contribs_only_test,
    root_all_bzl_empty = root_all_bzl_empty_test,
    root_all_bzl_externals_only = root_all_bzl_externals_only_test,
    root_all_bzl_hub_name_is_baked = root_all_bzl_hub_name_is_baked_test,
    root_build_bzl = root_build_bzl_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
