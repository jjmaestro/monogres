"""`debian_releases`: expose a Debian release table as a loadable repo.

Given a release table and the key of the active release (both as attrs), this
repo rule generates a `versions.bzl` that exports `RELEASE` (the active
release's profile struct), `VERSIONS` (all release keys, in order), and the
backing `_RELEASES` dict-of-structs, so `.bzl` and `BUILD` files can `load()`
the release facts.

A repo-rule attr cannot carry a nested dict, so each release's fields arrive as
a `["field=value", ...]` string list and are decoded back into a struct here.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")

_HEADER = """\
@generated by the `debian_releases` repo rule - do not edit.
Edit the release table passed to the rule and re-run Bazel.\
"""

def _versions_bzl(releases, active):
    releases_dict = {
        version: Star.fn("struct", **fields)
        for version, fields in releases.items()
    }
    return Star.file(
        Star.igen(Star.assign("_RELEASES", releases_dict)),
        'RELEASE = _RELEASES["%s"]' % active,
        "VERSIONS = _RELEASES.keys()",
        header = _HEADER,
    )

def _repo_build():
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        Star.exports_files(["versions.bzl"]),
        header = _HEADER,
    )

def _decode(encoded):
    # {release_key: ["field=value", ...]} -> {release_key: {field: value}}
    releases = {}
    for version, pairs in encoded.items():
        fields = {}
        for pair in pairs:
            field, _, value = pair.partition("=")
            fields[field] = value
        releases[version] = fields
    return releases

def _debian_releases_impl(rctx):
    releases = _decode(rctx.attr.releases)
    rctx.file("versions.bzl", _versions_bzl(releases, rctx.attr.active))
    rctx.file("BUILD.bazel", _repo_build())

debian_releases = repository_rule(
    implementation = _debian_releases_impl,
    attrs = {
        "active": attr.string(mandatory = True),
        "releases": attr.string_list_dict(mandatory = True),
    },
    doc = """
    Generate a `versions.bzl` exposing the given release table to `.bzl` and
    `BUILD` consumers.
    """,
)
