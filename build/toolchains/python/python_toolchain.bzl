"""Project-side glue for the Python toolchain backed by `@python_sysroot`.

Re-exports the generic `sysroot_tool` rule from `@sysroots//toolchains` as
`python_toolchain` and instantiates the python-specific
`current_python_toolchain` resolver via the `make_current_sysroot_tool` factory.
The `python_toolchains` macro fans the version + arch matrix out across per-arch
instances, toolchain registrations, and the `:python3` alias so the version
string lives in exactly one place.

Python, like Perl, is a dual dependency: a build-time interpreter (meson's
`find_program('python3')` + `find_installation()` for plpython, PG's configure
build scripts) and a runtime ABI target (plpython links `libpython`). The
version is coupled with the rest of the toolchain via `@python_sysroot` sourcing
from the release profile's apt snapshot, so the interpreter meson runs and the
`python-<ver>-embed.pc` the per-PG sysroot ships always agree. This mirrors the
`@perl_sysroot` (plperl) and Debian-LLVM (JIT) locksteps.

The `toolchain_type` is at `//toolchains/python:toolchain_type`. See
`README.md`.
"""

load("@platform_debian//:versions.bzl", "RELEASE")
load("@sysroots//apt:layout.bzl", "multiarch")
load(
    "@sysroots//toolchains:sysroot_tool.bzl",
    _make_current_sysroot_tool = "make_current_sysroot_tool",
    _sysroot_tool = "sysroot_tool",
)
load("//platforms:targets.bzl", "ARCH_CPU", "arch_select")

# Python MAJOR.MINOR for the active Debian release, from the release profile.
# Every per-arch instance generated by `python_toolchains(...)` and any consumer
# that loads `PYTHON_VERSION` (notably `pg_build.bzl`) tracks the profile.
PYTHON_VERSION = RELEASE.python_version

# Debian release version path component for the `@python_sysroot` hub labels.
_DISTRO_VERSION = RELEASE.version

python_toolchain = _sysroot_tool

current_python_toolchain = _make_current_sysroot_tool(
    toolchain_type = Label("//toolchains/python:toolchain_type"),
)

def python_toolchains(name = "python3", version = PYTHON_VERSION, distro_version = _DISTRO_VERSION):
    """Declare per-arch `python_toolchain` instances, `toolchain` registrations, and the `:<name>` alias.

    Single point where the Python version string is declared. Bumping `version`
    updates the `SysrootToolInfo.version` reported via the toolchain.

    Generates per arch in `ARCH_CPU` (`//platforms:targets.bzl`):
      * `:<name>_<arch>_impl` - per-arch `python_toolchain` instance.
      * `:<name>_<arch>` - matching `toolchain` registration.

    Plus a single `:<name>` alias selecting the right `_impl` by target CPU.

    Args:
        name: Prefix for every generated label. Defaults to `"python3"`; the
            resulting binary alias is `:python3`, the per-arch instances are
            `:python3_amd64_impl` / `:python3_arm64_impl`, and the toolchain
            registrations are `:python3_amd64` / `:python3_arm64`.
        version: Python MAJOR.MINOR string (e.g. `"3.13"`).
        distro_version: Debian release version path component for the
            `@python_sysroot` hub labels (e.g. `"12"`). Defaults to the active
            release from `@platform_debian//:versions.bzl`.
    """
    for arch, cpu in ARCH_CPU.items():
        python_toolchain(
            name = "{}_{}_impl".format(name, arch),
            binary = "@python_sysroot//debian/{}/{}:usr/bin/python3".format(
                distro_version,
                arch,
            ),
            env_var = "PYTHON",
            runtime = "@python_sysroot//debian/{}/{}:sysroot".format(
                distro_version,
                arch,
            ),
            vars = {"MULTIARCH": multiarch(arch)},
            version = version,
        )
        native.toolchain(
            name = "{}_{}".format(name, arch),
            exec_compatible_with = ["@platforms//cpu:" + cpu],
            toolchain = ":{}_{}_impl".format(name, arch),
            toolchain_type = ":toolchain_type",
        )

    native.alias(
        name = name,
        actual = arch_select({
            arch: ":{}_{}_impl".format(name, arch)
            for arch in ARCH_CPU
        }),
    )
