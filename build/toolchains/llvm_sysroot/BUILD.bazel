load("@platform_debian//:versions.bzl", "RELEASE", "VERSIONS")
load("@sysroots//toolchains:sysroot_dir.bzl", "exec_files", "sysroot_dir", "sysroot_exec_dir")
load("//platforms:targets.bzl", "ARCH_CPU", "arch_select")

package(default_visibility = ["//visibility:public"])

# `@llvm_sysroot` is the Debian-snapshot-sourced LLVM-14 toolchain hub:
# clang-14, lld-14, llvm-14-dev, libllvm14, libclang-cpp14,
# libclang-common-14-dev plus the linter / completion tools (clang-format-14,
# clang-tidy-14, clangd-14) that `toolchains_llvm` unconditionally symlinks (per
# `BUILD.llvm_repo.tpl` + `_toolchain_tools` in
# `@toolchains_llvm//toolchain/internal/common.bzl`). See `debian12.json`.
#
# Debian installs everything under `usr/lib/llvm-14/...` rather than the
# canonical clang+llvm tarball shape (`bin/...`, `lib/clang/<ver>/...`); the
# layout adapter in `//toolchains/llvm_sysroot:cc_toolchain_layout.bzl`
# materializes the canonical shape via symlinks so this hub can be consumed by
# `llvm.toolchain_root(label = ...)`.

exports_files(["debian{}.json".format(v) for v in VERSIONS])

# `extra_compiler_files` for the mode-4 `llvm.toolchain`: the clang binary's own
# dynamic libs (libLLVM-14.so.1, libclang-cpp.so.14, libedit.so.2, ...), which
# must match the arch of the host that RUNS clang. A cc_toolchain's
# `compiler_files` are analyzed in the TARGET configuration, so a bare
# `arch_select` would wrongly pick the target arch; wrapping it in `exec_files`
# forces resolution in the EXEC configuration, yielding the build host's libs
# (amd64 on an amd64 host, arm64 on an arm64 host) regardless of the target arch
# being cross-compiled for.
exec_files(
    name = "compiler_runtime_libs",
    target = arch_select({
        arch: "@llvm_toolchain_%s//:lib" % arch
        for arch in ARCH_CPU
    }),
)

# Arch-selecting `:sysroot` alias lives at `@llvm_sysroot//debian/12:sysroot`
# (generated by `//sysroots/common:codegen.bzl::version_root_build`). PGXS
# extensions whose install step invokes `$(LLVM_BINPATH)/llvm-lto` (ThinLTO
# bitcode index) reach the binary via the persistent
# `external/<canonical_repo>/debian/12/<arch>/usr/lib/llvm-14/bin/` path baked
# into Postgres's `Makefile.global` by `_STRIP_SANDBOX_PATHS_POSTFIX` in
# `pg_build.bzl`; consumers (today `pgxs_build.bzl`) take a label dep on the
# codegen-emitted alias so the LLVM tools tree lands in the action's hermetic
# input set.

# `$(LLVM_SYSROOT_DIR)` make-variable bindings. Per-arch `sysroot_dir` instances
# resolve the per-arch sysroot's execroot-relative package path
# (`external/<canonical_repo>/debian/12/<arch>`) from the label at analysis
# time, so the canonical bzlmod name never appears in human-authored source.
# `:llvm_sysroot_dir` selects the right per-arch instance based on the target
# arch; PGXS extensions list it in their genrule's `toolchains` attr and
# reference `$(LLVM_SYSROOT_DIR)` in `cmd` for, e.g., the action's
# `LD_LIBRARY_PATH` covering llvm-lto's NEEDED libs.
[
    sysroot_dir(
        name = "llvm_sysroot_dir_%s" % arch,
        target = "@llvm_sysroot//debian/%s/%s:sysroot" % (
            RELEASE.version,
            arch,
        ),
        var = "LLVM_SYSROOT_DIR",
    )
    for arch in ARCH_CPU
]

alias(
    name = "llvm_sysroot_dir",
    actual = arch_select({
        arch: ":llvm_sysroot_dir_%s" % arch
        for arch in ARCH_CPU
    }),
)

# `$(LLVM_SYSROOT_EXEC_DIR)`: EXEC host arch's LLVM sysroot. Same pattern as
# `libc_sysroot_exec_dir`; consumers (today `pg_build` for meson's cross-file
# `[binaries].llvm-config`) need the EXEC arch's `llvm-config-14` because the
# TARGET arch's binary can't run on a host of a different arch.
sysroot_exec_dir(
    name = "llvm_sysroot_exec_dir",
    target = ":llvm_sysroot_dir",
)
