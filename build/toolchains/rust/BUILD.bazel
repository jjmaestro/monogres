load("//platforms:targets.bzl", "arch_select")
load(":rust.bzl", "rust_bin")

package(default_visibility = ["//visibility:public"])

# Hermetic Rust toolchain for the pgrx extension engine: the upstream component
# archives (`rustc`, `cargo`, `rust-std`, `rustfmt`), sha256-pinned in
# `rust.json` and merged by the index `matrix` into one prefix per target
# triple.
#
# Deliberately NOT apt-sourced, unlike `//toolchains/perl` and
# `//toolchains/python`: those exist to hold a Debian ABI lockstep because they
# are also RUNTIME dependencies of what we ship. Rust is only ever a build tool
# here, so the constraint does not apply and we track upstream stable instead.

exports_files(["rust.json"])

# The active exec arch's prefix, i.e. the `matrix` partition of its triple.
# `cargo` drives `rustc` and reads `rust-std` out of the same tree, so consumers
# stage `:files` as a unit and run `bin/cargo` from it. Selected on the EXEC
# arch (where cargo RUNS); the target arch is chosen per build with `--target`.
alias(
    name = "files",
    actual = arch_select({
        "amd64": "@rust_toolchain//:x86_64-unknown-linux-gnu",
        "arm64": "@rust_toolchain//:aarch64-unknown-linux-gnu",
    }),
)

# `cargo` on its own, so an action can name it with `execpath` and reach the
# rest of the prefix from there. Stage `:files` alongside it.
rust_bin(
    name = "cargo",
    bin = "cargo",
    toolchain = ":files",
)

# The same two targets again, for a consumer that needs the TARGET arch's tree
# rather than the EXEC arch's. `arch_select` resolves per configuration, so
# these are only distinct labels, not distinct definitions: what separates them
# is that a consumer puts these in `srcs` (TARGET) and the pair above in `tools`
# (EXEC). Two labels rather than one because `$(execpath)` could not otherwise
# tell which configuration's path is being asked for.
#
# Cross-compiling is what needs this. rustup ships one `rust-std` per prefix,
# for that prefix's own arch, so the EXEC tree cannot compile TARGET code: an
# action has to borrow `lib/rustlib/<target-triple>` from here.
alias(
    name = "target_files",
    actual = ":files",
)

alias(
    name = "target_cargo",
    actual = ":cargo",
)
