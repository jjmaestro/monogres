"""Project-side glue for the Perl toolchain backed by `@perl_sysroot`.

Re-exports the generic `sysroot_tool` rule from `@sysroots//toolchains` as
`perl_toolchain` and instantiates the perl-specific `current_perl_toolchain`
resolver via the `make_current_sysroot_tool` factory. The `perl_toolchains`
macro fans the version + arch matrix out across per-arch instances, toolchain
registrations, and the `:perl` alias so the version string lives in exactly one
place.

The `toolchain_type` is at `//toolchains/perl:toolchain_type`. See `README.md`
and `/REPORT-Postgres_build_and_Perl.md` for the ABI lockstep rationale.
"""

load("@platform_debian//:versions.bzl", "RELEASE")
load("@sysroots//apt:layout.bzl", "multiarch")
load(
    "@sysroots//toolchains:sysroot_tool.bzl",
    _make_current_sysroot_tool = "make_current_sysroot_tool",
    _sysroot_tool = "sysroot_tool",
)
load("//platforms:targets.bzl", "ARCH_CPU", "arch_select")

# Perl MAJOR.MINOR for the active Debian release, from the release profile.
# Every per-arch instance generated by `perl_toolchains(...)` and any consumer
# that loads `PERL_VERSION` (notably `pg_build.bzl`) tracks the profile.
PERL_VERSION = RELEASE.perl_version

# Debian release version path component for the `@perl_sysroot` hub labels.
_DISTRO_VERSION = RELEASE.version

perl_toolchain = _sysroot_tool

current_perl_toolchain = _make_current_sysroot_tool(
    toolchain_type = Label("//toolchains/perl:toolchain_type"),
)

def perl_toolchains(name = "perl", version = PERL_VERSION, distro_version = _DISTRO_VERSION):
    """Declare per-arch `perl_toolchain` instances, `toolchain` registrations, and the `:<name>` alias.

    Single point where the Perl version string is declared. Bumping `version`
    updates the `SysrootToolInfo.version` reported via the toolchain.

    Generates per arch in `ARCH_CPU` (`//platforms:targets.bzl`):
      * `:<name>_<arch>_impl` - per-arch `perl_toolchain` instance.
      * `:<name>_<arch>` - matching `toolchain` registration.

    Plus a single `:<name>` alias selecting the right `_impl` by target CPU.

    Args:
        name: Prefix for every generated label. Defaults to `"perl"`; the
            resulting binary alias is `:perl`, the per-arch instances are
            `:perl_amd64_impl` / `:perl_arm64_impl`, and the toolchain
            registrations are `:perl_amd64` / `:perl_arm64`.
        version: Perl MAJOR.MINOR string (e.g. `"5.36"`).
        distro_version: Debian release version path component for the
            `@perl_sysroot` hub labels (e.g. `"12"`). Defaults to the active
            release from `@platform_debian//:versions.bzl`.
    """
    for arch, cpu in ARCH_CPU.items():
        perl_toolchain(
            name = "{}_{}_impl".format(name, arch),
            binary = "@perl_sysroot//debian/{}/{}:usr/bin/perl".format(
                distro_version,
                arch,
            ),
            env_var = "PERL",
            runtime = "@perl_sysroot//debian/{}/{}:sysroot".format(
                distro_version,
                arch,
            ),
            vars = {"MULTIARCH": multiarch(arch)},
            version = version,
        )
        native.toolchain(
            name = "{}_{}".format(name, arch),
            exec_compatible_with = ["@platforms//cpu:" + cpu],
            toolchain = ":{}_{}_impl".format(name, arch),
            toolchain_type = ":toolchain_type",
        )

    native.alias(
        name = name,
        actual = arch_select({
            arch: ":{}_{}_impl".format(name, arch)
            for arch in ARCH_CPU
        }),
    )
