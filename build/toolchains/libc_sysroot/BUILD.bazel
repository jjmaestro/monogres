load("@platform_debian//:versions.bzl", "RELEASE", "VERSIONS")
load("@sysroots//toolchains:sysroot_dir.bzl", "sysroot_dir")
load("//platforms:targets.bzl", "ARCH_CPU", "arch_select")
load("//toolchains/llvm_sysroot:llvm_version.bzl", "LLVM_MAJOR")

package(default_visibility = ["//visibility:public"])

exports_files(
    ["clang_wrapper.sh"] + ["debian{}.json".format(v) for v in VERSIONS],
)

# Per-target-arch alias for the @libc_sysroot clang wrapper. The wrapper is
# exposed as a single-file label by `//sysroots/common:codegen.bzl::
# sysroot_build`'s `extra_files_paths` `exports_files` block. Consumers (today:
# `pg_build.bzl`) take a label dep on this alias and resolve the path via
# `$(execpath ...)`, so the per-arch path mangling stays out of build files.
#
# Arch-selecting `:sysroot` / `:sysroot_tar` aliases live at
# `@libc_sysroot//debian/12:sysroot[._tar]` (emitted by
# `//sysroots/common:codegen.bzl::version_root_build`).
alias(
    name = "active_clang_wrapper",
    actual = arch_select({
        arch: "@libc_sysroot//debian/{}/{}:usr/lib/llvm-{}/bin/clang".format(
            RELEASE.version,
            arch,
            LLVM_MAJOR,
        )
        for arch in ARCH_CPU
    }),
)

# `$(LIBC_SYSROOT_DIR)` make-variable bindings. Per-arch `sysroot_dir` instances
# resolve the per-arch sysroot's execroot-relative package path from the label
# at analysis time; `:libc_sysroot_dir` selects the right per-arch instance.
# Consumers list it in their action's `toolchains` attr and reference
# `$(LIBC_SYSROOT_DIR)` in `cmd` (e.g. `pg_build`'s
# `_STRIP_SANDBOX_PATHS_POSTFIX` rewrites Postgres's installed `Makefile.global`
# to point at the persistent libc-sysroot clang wrapper).
[
    sysroot_dir(
        name = "libc_sysroot_dir_%s" % arch,
        target = "@libc_sysroot//debian/%s/%s:sysroot" % (
            RELEASE.version,
            arch,
        ),
        var = "LIBC_SYSROOT_DIR",
    )
    for arch in ("amd64", "arm64")
]

alias(
    name = "libc_sysroot_dir",
    actual = arch_select({
        arch: ":libc_sysroot_dir_%s" % arch
        for arch in ARCH_CPU
    }),
)
