module(
    name = "examples",
    bazel_compatibility = [">=8.4.2"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "monogres", version = "", dev_dependency = True)
bazel_dep(name = "rules_python", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "sysroots", version = "0.0.1", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.7.0", dev_dependency = True)

monoext = use_extension("@monogres//monoext:monoext.bzl", "monoext")
monoext.monogres(
    name = "pg",
    base = "@monogres//catalog/postgres:repo.json",
    deb_lock = "@monogres//catalog/locks:pg_pkgs.lock",
    extensions = "@monogres//catalog/extensions:index.json",
)
use_repo(monoext, "pg", "pg_ext", "pg_pkgs")

local_path_override(
    module_name = "monogres",
    path = "..",
)

local_path_override(
    module_name = "starlark_utils",
    path = "../starlark_utils",
)

local_path_override(
    module_name = "sysroots",
    path = "../sysroots",
)

BDA_VERSION = "0.1.0"

archive_override(
    module_name = "download_archives",
    patch_strip = 1,
    patches = [
        "//patches/download_archives:0001-dev-add-flake.nix-and-direnv-for-NixOS-dev-environme.patch",
        "//patches/download_archives:0002-fix-missing-continue-after-integrity-check-wrong-app.patch",
        "//patches/download_archives:0003-docs-fix-SOURCES-VERSIONS-in-repo.bzl-doc.patch",
        "//patches/download_archives:0004-test-add-multi-source-index-test.patch",
        "//patches/download_archives:0005-docs-use-NAME-consistently-in-doc-placeholders.patch",
        "//patches/download_archives:0006-refactor-centralize-patch-matching-in-lib-utils.bzl.patch",
        "//patches/download_archives:0007-refactor-extract-shared-download-helpers-into-lib-do.patch",
        "//patches/download_archives:0008-refactor-extract-Download.try_sources.patch",
        "//patches/download_archives:0009-feat-add-lazy-mode-to-download_archives.patch",
        "//patches/download_archives:0010-feat-add-download_archives-module-extension.patch",
        "//patches/download_archives:0011-chore-privatize-internal-template-names.patch",
        "//patches/download_archives:0012-docs-rewrite-README.patch",
        "//patches/download_archives:0013-feat-support-a-matrix-of-archives-per-version.patch",
        "//patches/download_archives:0014-feat-key-the-extracted-directory-on-the-archive-and-.patch",
    ],
    sha256 = "185e9e328ba59ccdc6f97968b2bbe31d7d2f64590aa321df7ca754cf5777f9e4",
    strip_prefix = "bazel_download_archives-{}".format(BDA_VERSION),
    url = "https://github.com/jjmaestro/bazel_download_archives/archive/refs/tags/v{}.tar.gz".format(BDA_VERSION),
)

# Root-module overrides do not propagate through dependencies, so the examples
# workspace must mirror the monogres RFCC override to exercise the same tool
# stack as a downstream consumer.
RFCC_COMMIT = "006ae82d9b4953a9b1c170827aef660f9f0f9ec0"

archive_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = [
        "//patches/rules_foreign_cc:0001-workaround-rfcc-0.15.1-ninja-version-breaks-with-gli.patch",
        "//patches/rules_foreign_cc:0002-meson-wrapper-clear-runfiles-for-children.patch",
    ],
    sha256 = "6cfda69786df4c539384b1c0031c13bb8d666b0042a4eab59841fa7a6c21fca9",
    strip_prefix = "rules_foreign_cc-{}".format(RFCC_COMMIT),
    url = "https://github.com/bazel-contrib/rules_foreign_cc/archive/{}.tar.gz".format(RFCC_COMMIT),
)

TOOLCHAINS_LLVM_VERSION = "1.7.0"

archive_override(
    module_name = "toolchains_llvm",
    patch_strip = 1,
    patches = [
        "//patches/toolchains_llvm:0001-cc_wrapper-handle-response-files-without-trailing-newline.patch",
        "//patches/toolchains_llvm:0002-cc_wrapper-default-lld-when-no-explicit-linker.patch",
        "//patches/toolchains_llvm:0003-cc_wrapper-export-LD_LIBRARY_PATH-from-toolchain-lib.patch",
    ],
    sha256 = "85c341e957ba58482892a8088e4a34391d15bd98917f0993ecb62f008d6986d6",
    strip_prefix = "toolchains_llvm-v{}".format(TOOLCHAINS_LLVM_VERSION),
    url = "https://github.com/bazel-contrib/toolchains_llvm/releases/download/v{v}/toolchains_llvm-v{v}.tar.gz".format(v = TOOLCHAINS_LLVM_VERSION),
)

# Mirror the monogres root mode-4 wiring: `toolchains_llvm` consumes the
# Debian-sourced clang via `llvm.toolchain_root(label = ...)` against the
# `cc_toolchain_layout` adapter wrapping `@llvm_sysroot`. The clang wrapper
# injected into `@libc_sysroot` resolves through
# `external/+_repo_rules+llvm_toolchain_<arch>/bin/clang`, so the adapter must
# be materialized here too.

# Mirror of the `RELEASES` table in the root `monogres` `MODULE.bazel`; kept in
# sync by hand because MODULE files cannot `load()` shared data.
RELEASES = {
    "12": {
        "apt_snapshot": "20250113T000000Z",
        "llvm_major": "14",
        "llvm_version": "14.0.6",
        "version": "12",
    },
    "13": {
        "apt_snapshot": "20260316T000000Z",
        "llvm_major": "19",
        "llvm_version": "19.1.7",
        "version": "13",
    },
}

RELEASE = RELEASES["12"]

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    extra_compiler_files = "@llvm_toolchain_amd64//:lib",
    llvm_version = RELEASE["llvm_version"],
    stdlib = {"": "stdc++"},
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_toolchain_amd64//:BUILD",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@libc_sysroot//debian/{}/amd64:sysroot".format(RELEASE["version"]),
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@libc_sysroot//debian/{}/arm64:sysroot".format(RELEASE["version"]),
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

# sysroots/
#
# Mirrors the monogres root tags; `_impl` dedups identical re-declarations.
sysroots = use_extension("@sysroots//:extension.bzl", "sysroots")
sysroots.apt(
    name = "libc_sysroot",
    extra_files = {
        "@monogres//toolchains/libc_sysroot:clang_wrapper.sh": "usr/lib/llvm-{}/bin/clang".format(
            RELEASE["llvm_major"],
        ),
    },
    lock = "@monogres//toolchains/libc_sysroot/locks:libc_sysroot.lock",
    manifest = "@monogres//toolchains/libc_sysroot:debian{}.json".format(RELEASE["version"]),
    snapshot = RELEASE["apt_snapshot"],
)
sysroots.apt(
    name = "llvm_sysroot",
    lock = "@monogres//toolchains/llvm_sysroot/locks:llvm_sysroot.lock",
    manifest = "@monogres//toolchains/llvm_sysroot:debian{}.json".format(RELEASE["version"]),
    snapshot = RELEASE["apt_snapshot"],
)
use_repo(sysroots, "libc_sysroot", "llvm_sysroot")

cc_toolchain_layout = use_repo_rule(
    "@monogres//toolchains/llvm_sysroot:cc_toolchain_layout.bzl",
    "cc_toolchain_layout",
)

cc_toolchain_layout(
    name = "llvm_toolchain_amd64",
    arch = "amd64",
    llvm_version = RELEASE["llvm_version"],
    sysroot = "@llvm_sysroot//debian/{}/amd64:BUILD.bazel".format(RELEASE["version"]),
)

cc_toolchain_layout(
    name = "llvm_toolchain_arm64",
    arch = "arm64",
    llvm_version = RELEASE["llvm_version"],
    sysroot = "@llvm_sysroot//debian/{}/arm64:BUILD.bazel".format(RELEASE["version"]),
)
