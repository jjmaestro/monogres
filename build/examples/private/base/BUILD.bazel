# --- Make-build integration tests -------------------------------------------
#
# Asserts the autoconf+make introspect-synth pipeline shipped expected overlay
# contribs. Catches regressions in:
#
# - `pg_build_make`'s `pgxs_install_extras` (whether the overlay's contribs
# actually install when contrib=true).
# - `pg_build_make_introspect.py` (whether the synth attributes the installed
# files to the right contrib).
# - Layer-1 paths repo (whether the synthesized JSONs flow through the
# `installed_paths` -> INTROSPECTIONS pipeline).
#
# `babelfishpg_unit` is included in the expected list even though upstream
# excludes it from its `contrib/Makefile` SUBDIRS — the merge step
# auto-discovers all subdirs of the overlay's `contrib/`, so it ships.

make_build_required_contribs_test(
    name = "babelfish_4.0_full_contribs",
    introspections = babelfish_INTROSPECTIONS,
    option_set = "full",
    required_contribs = [
        "babelfishpg_common",
        "babelfishpg_money",
        "babelfishpg_tds",
        "babelfishpg_tsql",
        "babelfishpg_unit",
    ],
    version = "4.0",
)

make_build_required_contribs_test(
    name = "babelfish_5.1_full_contribs",
    introspections = babelfish_INTROSPECTIONS,
    option_set = "full",
    required_contribs = [
        "babelfishpg_common",
        "babelfishpg_money",
        "babelfishpg_tds",
        "babelfishpg_tsql",
        "babelfishpg_unit",
    ],
    version = "5.1",
)

make_build_required_contribs_test(
    name = "openhalo_1beta1_full_contribs",
    introspections = openhalo_INTROSPECTIONS,
    option_set = "full",
    required_contribs = ["aux_mysql"],
    version = "1beta1",
)
