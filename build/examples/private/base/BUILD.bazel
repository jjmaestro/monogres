e2e_tests(
    name = "babelfish",
    cfg = babelfish_CFG,
    default_version = babelfish_DEFAULT_VERSION,
    expected_flavor = "babelfish",
    introspections = babelfish_INTROSPECTIONS,
    option_sets = babelfish_OPTION_SETS,
    versions = babelfish_VERSIONS,
